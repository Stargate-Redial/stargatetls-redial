# Windows scripts and the game's own text formats: CRLF (cmd.exe needs CRLF in .bat files)
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.psd1  text eol=crlf
*.cfg   text eol=crlf
*.ini   text eol=crlf
*.vdf   text eol=crlf
THIRD-PARTY.txt text eol=crlf
LICENSE text eol=crlf

# Sources and docs: LF
# The patch keeps the CRLF lines of the Botrix files that have them: stored byte for byte
*.patch -text
*.cpp   text eol=lf
*.h     text eol=lf
*.c     text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.service text eol=lf
*.md    text eol=lf
VERSION text eol=lf

# Binary data: never touch
*.way   binary
*.vtf   binary
*.jpg   binary
*.png   binary
*.dll   binary
*.so    binary
*.zip   binary
