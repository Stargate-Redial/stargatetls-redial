+    void FeatureCommand( const CCommand& args )
+    {
+        if ( args.ArgC() > 2 && !sgtls::SetFeature( args.Arg( 1 ), atoi( args.Arg( 2 ) ) != 0 ) )
+            Msg( "Unknown feature: %s\n", args.Arg( 1 ) );
+        for ( int i = 0; i < iFeatureCount; ++i )
