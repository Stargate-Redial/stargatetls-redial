+//----------------------------------------------------------------------------------------------------------------
+bool CBot_SGTLS::OpenDoor()
+{
+    // tls_stargate_atlantis_fixed: the city doors open with a wall panel beside them (+use) and close again after 4-5
+    // seconds. The waypoints go through them (sgtls_wpgen ... doors); a bot opens the one on its way. Per map
+    // (sgtls_opendoors 1 in the map's cfg).
+    if ( !sgtls::bOpenDoors )
+    {
+        m_iDoor = -1;
+        return false;
+    }
+    if ( m_iDoor < 0 )
+    {
+        // On the path: to the next waypoint. Walking straight somewhere (a teleporter's button): to there.
+        if ( !m_bNeedMove )
+            return false;
+        Vector vNext = m_vDestination;
+        if ( m_bUseNavigatorToMove )
+        {
+            if ( !CWaypoint::IsValid( iNextWaypoint ) || iNextWaypoint == iCurrentWaypoint )
+                return false;
+            vNext = CWaypoints::Get( iNextWaypoint ).vOrigin;
+        }
+        int iDoor = sgtls::CObjectives::ClosedDoorOnPath( m_vHead, vNext, 160.0f );
+        if ( iDoor < 0 || ( iDoor == m_iDoorGaveUp && CBotrixPlugin::fTime < m_fDoorGaveUpEnd ) ||
+             ( iDoor == m_iDoorPassed && CBotrixPlugin::fTime < m_fDoorPassedEnd ) )
+            return false;
+        m_iDoor = iDoor;
+        m_fDoorStart = CBotrixPlugin::fTime;
+        m_fDoorPressed = 0.0f;
+        m_vDoorFrom = m_vHead;
+        m_vDoorTo = vNext;
+        m_iDoorDestination = m_bUseNavigatorToMove ? m_iDestinationWaypoint : EWaypointIdInvalid;
+        BLOG_I( "%s -> Door %d closed on the way, opening it.", GetName(), iDoor );
+    }
+
+    bool bDoorOpen = !sgtls::CObjectives::DoorBlocks( m_iDoor, m_vDoorFrom, m_vDoorTo );
+    if ( !bDoorOpen && sgtls::Feature( sgtls::FeatDoorClear ) && m_iDoor < (int)sgtls::ButtonDoors().size() )
+    {
+        // tls_stargate_atlantis_fixed's hangar doors: a bot beside the doorway's middle had the open leaf's edge on its
+        // line (by 2 units) and gave the door up after 15 seconds (35 times in an hour). The line through the
+        // doorway's middle counts too; the crossing below then goes by the middle.
+        const sgtls::CButtonDoor& cDoor = sgtls::ButtonDoors()[m_iDoor];
+        int o = 1 - cDoor.iAxis;
+        Vector vFrom = m_vDoorFrom, vTo = m_vDoorTo;
+        vFrom[o] = vTo[o] = ( cDoor.vDoorwayMins[o] + cDoor.vDoorwayMaxs[o] ) * 0.5f;
+        bDoorOpen = !sgtls::CObjectives::DoorBlocks( m_iDoor, vFrom, vTo );
+    }
+    if ( bDoorOpen )
+    {
+        BLOG_I( "%s -> Door %d open, going through.", GetName(), m_iDoor );
+        // Not found closed again at once: open through its doorway's middle, the bot's own line can still clip a
+        // leaf, and it went "closed" / "open" every frame without moving (tlsdm_sgc_b1: 81000 times in 30 minutes).
+        if ( sgtls::Feature( sgtls::FeatDoorClear ) )
+        {
+            m_iDoorPassed = m_iDoor;
+            m_fDoorPassedEnd = CBotrixPlugin::fTime + 3.0f;
+        }
+        if ( m_iDoor < (int)sgtls::ButtonDoors().size() )
+        {
+            // Through the doorway's middle only when the hull can't pass straight from here but can there.
+            const sgtls::CButtonDoor& cDoor = sgtls::ButtonDoors()[m_iDoor];
+            int a = cDoor.iAxis, o = 1 - a;
+            float fPlane = ( cDoor.pDoor->vMins[a] + cDoor.pDoor->vMaxs[a] ) * 0.5f;
+            float fSide = ( m_vHead[a] > fPlane ) ? 1.0f : -1.0f;
+            Vector vFrom = m_vHead, vTo = m_vHead;
+            vFrom[a] = fPlane + fSide * 48.0f;
+            vTo[a] = fPlane - fSide * 48.0f;
+            bool bCrouch = false;
+            Vector vEnd = vTo;
+            if ( CUtil::GetReachableInfoFromTo( vFrom, vEnd, bCrouch, 0, 1e9f, false ) == EReachNotReachable )
+            {
+                float fMiddle = ( cDoor.vDoorwayMins[o] + cDoor.vDoorwayMaxs[o] ) * 0.5f;
+                vFrom[o] = vTo[o] = fMiddle;
+                vEnd = vTo;
+                bCrouch = false;
+                if ( CUtil::GetReachableInfoFromTo( vFrom, vEnd, bCrouch, 0, 1e9f, false ) != EReachNotReachable && !bCrouch )
+                {
+                    m_iCrossDoor = m_iDoor;
+                    m_fCrossDoorEnd = CBotrixPlugin::fTime + 3.0f;
+                    m_fCrossDoorSide = fSide;
+                }
+            }
+        }
+        m_iDoor = -1;
+        // The walk to the panel left the path: search it again, to the same destination. A new task here picked a
+        // new random destination, often back behind the bot: tls_omega_b1's Daedalus doors, 52 panel presses and
+        // bots turning back at the open door until the watchdog.
+        if ( CWaypoint::IsValid( m_iDoorDestination ) && sgtls::Feature( sgtls::FeatDoorDest ) )
+        {
+            m_iDestinationWaypoint = m_iDoorDestination;
+            m_bDestinationChanged = m_bUseNavigatorToMove = m_bNeedMove = true;
+            m_bMoveFailure = false;
+        }
+        else
+        {
+            m_iCurrentTask = EBotTaskInvalid;
+            m_bNeedTaskCheck = true;
+        }
+        return false;
+    }
+    Vector vOpener;
+    bool bDoorItself = false;
+    edict_t* pOpener = sgtls::CObjectives::DoorOpener( m_iDoor, m_vHead, vOpener, bDoorItself );
+    // A panel that opens its door late (tls_stargate_atlantis_fixed's Tür3: 8.5 s after the press, closed again 20 s
+    // after it): pressed again only once the door had time to answer, and not given up before. Pressed every 3 s, the
+    // bots queued opens and closes, and the door went up and down for minutes.
+    float fOpenDelay = ( sgtls::Feature( sgtls::FeatDoorClear ) && m_iDoor < (int)sgtls::ButtonDoors().size() )
+                     ? sgtls::ButtonDoors()[m_iDoor].fOpenDelay : 0.0f;
+    if ( !pOpener || CBotrixPlugin::fTime > m_fDoorStart + 15.0f + fOpenDelay )
+    {
+        // Locked (Atlantis's quarantine), or no panel on this side: the path will fail and become costly.
+        BLOG_W( "%s -> Door %d: %s, leaving it for 30 seconds.", GetName(), m_iDoor,
+                pOpener ? "still closed after 15 seconds" : "nothing opens it from this side" );
+        m_iDoorGaveUp = m_iDoor;
+        m_fDoorGaveUpEnd = CBotrixPlugin::fTime + 30.0f;
+        m_iDoor = -1;
+        m_iCurrentTask = EBotTaskInvalid;
+        m_bNeedTaskCheck = true;
+        return false;
+    }
+
+    m_vLook = vOpener;
+    m_bNeedAim = true;
+    m_fEndAimTime = CBotrixPlugin::fTime + 0.3f;
+    if ( m_fDoorPressed > 0.0f && CBotrixPlugin::fTime < m_fDoorPressed + 3.0f + fOpenDelay )
+    {
+        m_bNeedMove = false; // Pressed: the door slides open in 1-2 seconds.
+        StepOffDoor();
+        return true;
+    }
+    // To the panel: by the waypoints when it is far (tls_stargate_atlantis's prison: the panel inside is 320 units
+    // from the door), then straight; then press it (a panel can sit high on the wall: 80 units up or down).
+    Vector vToOpener = vOpener - m_vHead;
+    if ( vToOpener.Length2D() > 130.0f )
+    {
+        TWaypointId wPanel = CWaypoints::GetNearestWaypoint( vOpener, NULL, true, 200.0f );
+        if ( CWaypoint::IsValid( wPanel ) && iCurrentWaypoint != wPanel )
+        {
+            if ( m_iDestinationWaypoint != wPanel || !m_bUseNavigatorToMove || m_bMoveFailure )
+            {
+                m_iDestinationWaypoint = wPanel;
+                m_bDestinationChanged = true;
+                m_bMoveFailure = false;
+            }
+            m_bUseNavigatorToMove = m_bNeedMove = true;
+            return true;
+        }
+    }
+    if ( vToOpener.Length2D() > 40.0f )
+    {
+        m_vDestination = Vector( vOpener.x, vOpener.y, m_vHead.z );
+        iNextWaypoint = EWaypointIdInvalid;
+        m_bUseNavigatorToMove = m_bDestinationChanged = false;
+        m_bNeedMove = true;
+    }
+    else
+        m_bNeedMove = false;
+    if ( vToOpener.Length2D() < 72.0f && fabs( vToOpener.z ) < 80.0f && ButtonInSight( pOpener, vOpener ) )
+    {
+        if ( bDoorItself )
+        {
+            // +use on the door, one frame: aim at once (PerformMove presses IN_USE once the aim is done).
+            m_fEndAimTime = CBotrixPlugin::fTime;
+            m_bNeedUse = true;
+            m_bAlreadyUsed = m_bUsingButton = m_bUsingHealthMachine = m_bUsingArmorMachine = false;
+            m_fDoorPressed = CBotrixPlugin::fTime;
+            BLOG_I( "%s -> +use on door %d.", GetName(), m_iDoor );
+        }
+        else if ( sgtls::CObjectives::PressDoorButton( m_iDoor, pOpener, m_pEdict ) )
+        {
+            m_fDoorPressed = CBotrixPlugin::fTime;
+            BLOG_I( "%s -> Pressed the panel of door %d.", GetName(), m_iDoor );
+        }
+    }
+    return true;
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+void CBot_SGTLS::Respawned()
+{
+    CBot_HL2DM::Respawned();
+    m_bHoldingButton = false;
+    m_bBreakingGlass = false;
+    m_fGlassAimTime = 0.0f;
+    m_pSpot = NULL;
+    m_iTeleporter = -1;
+    m_iDoor = -1;
+    m_vLastHead.Init(); // A respawn is not a teleport.
+    m_iCrossGate = -1;
+    m_fUnderwaterSince = 0.0f;
+    m_fSpawnTime = CBotrixPlugin::fTime;
+    m_bLoadoutChecked = false;
+    m_bSpawnOriginSet = m_bRegroupDone = false;
+    m_fRegroupEnd = 0.0f;
+    m_iGuardWaypoint = EWaypointIdInvalid;
+    m_fGuardEnd = 0.0f;
+}
+
+#endif // BOTRIX_SGTLS
diff --git a/mods/sgtls/bot_sgtls.h b/mods/sgtls/bot_sgtls.h
new file mode 100644
index 0000000..3f0f933
--- /dev/null
+++ b/mods/sgtls/bot_sgtls.h
@@ -0,0 +1,209 @@
+#ifdef BOTRIX_SGTLS
+
+#ifndef __BOTRIX_BOT_SGTLS_H__
+#define __BOTRIX_BOT_SGTLS_H__
+
+#include "mods/hl2dm/bot_hl2dm.h"
+
+
+//****************************************************************************************************************
+/// Bot for Stargate: The Last Stand. Fights like the HL2DM bot, and joins the game the sgtls way:
+/// "jointeam <2|3>", "joinclass <id>", then "setequipcode <bitmask>" (bit b = equipment id b+1).
+//****************************************************************************************************************
+class CBot_SGTLS: public CBot_HL2DM
+{
+
+public:
+    enum
+    {
+        ETeamTauri = 2,
+        ETeamGoauld = 3,
+    };
+
+    /// iTeam / iClass: -1 to let the bot choose (the less populated team, a random class).
+    CBot_SGTLS( edict_t* pEdict, TBotIntelligence iIntelligence, TTeam iTeam, int iClassId );
+
+    virtual void PreThink();
+
+    virtual void Respawned();
+
+protected:
+    /// Go attack / defend the active capture area instead of a random waypoint.
+    virtual TWaypointId GetRoamDestination();
+
+    /// Not for far enemies on the way to an objective the bot attacks: it shoots while walking.
+    virtual bool ShouldEngage();
+    virtual bool KeepGoingThrough() const;
+    virtual bool SideStepLeft() const;
+    virtual bool FollowRatherThanStep( const CPlayer* pOther ) const;
+
+    /// Hold +use on the button of a hold-button objective when in range (and no enemy), else the HL2DM think.
+    virtual void Think();
+
+    /// Walking into a gate whose plane must be touched deep enough (sgtls::CButtonTeleporter::fSafeDepth): straight at
+    /// the plane, full speed, a frame without moving keys now and then so that the first touch is deep enough (it
+    /// happens a whole number of steps from here); too close without that, back off and come again.
+    virtual void FinalMove();
+
+    /// FinalMove for every bot: no step toward a stargate's plane (any thin trigger_teleport) within reach of its hull,
+    /// but the one of the ready gate on its path: walking in a fight near a closed gate, by its edge, the bots went
+    /// through its incoming plane or touched a travel plane by the corner (tlsdm_glass_gate_final).
+    void KeepOffPlanes( const Vector& vOrigin );
+
+    /// FinalMove: the timed crossing itself.
+    void CrossGate( const Vector& vOrigin );
+
+    /// FinalMove: on a ring station while its rings work, stand still on the axis (inside the rings) or walk out of
+    /// their sweep, whichever is nearer; the bot that pressed their button has 1.8 s to get to the axis.
+    void KeepOffRings( const Vector& vOrigin );
+
+    /// FinalMove: a closed model door (prop_door_rotating) within 96 units on the way to the next waypoint: look at
+    /// it and +use it, at most every 1.5 s (another press closes it).
+    void UsePropDoor();
+
+    /// FinalMove: away from a damaging laser beam that is on (within 24 units of the body), and no step toward one
+    /// within 64 units.
+    void KeepOffLasers( const Vector& vOrigin );
+
+    /// FinalMove: walking straight (to a button, a panel, a ring), not by the path: away from a permanent fire's reach.
+    void KeepOffFires();
+    /// GetRoamDestination ("reachdest"): m_aReach from the current waypoint (again after 10 s or when it changed).
+    void UpdateReach();
+    /// OpenDoor, while the pressed door opens: out of its leaf's way.
+    void StepOffDoor();
+
+    /// FinalMove: right after a door opened on the way, through its doorway's middle (the leaves of a pair slide into
+    /// the walls and the hull fits only near the seam), for 3 seconds at most.
+    void CrossDoorway( const Vector& vOrigin );
+
+    /// FinalMove: in water, a next waypoint more than 32 units above or below: look at it and swim to it (swimming
+    /// follows the eyes; up with jump).
+    void Swim( const Vector& vOrigin );
+
+    /// Shoot a window (func_breakable_surf) between the bot and its next waypoint. Return true if shooting.
+    bool BreakGlass();
+
+    /// On a crouch path (an air vent), knife the physics prop just ahead (a grate). Return true if hitting it.
+    bool BreakGrate();
+
+    /// Nothing between the eye and vButton but the button itself (or what holds it).
+    bool ButtonInSight( edict_t* pButton, const Vector& vButton ) const;
+
+    /// The bot's path takes a teleporter that is still off (tls_lockdown's gate 1): stop before it, go press its
+    /// button (the DHD), wait until it is on and its kawoosh is over. Return true while doing that.
+    bool OpenTeleporter();
+
+    /// OpenTeleporter for a transporter booth (on for a moment, some seconds after its button inside is pressed): go
+    /// in, press the button, wait inside until teleported. Return true while doing that.
+    bool UseTransporter( int iTeleporter );
+    /// PreThink ("teleported"): after a jump of 1000+ units, a transporter it waited for is done, and a path left on the
+    /// other side starts again from the nearest waypoint here.
+    void AfterTeleport();
+
+    /// A closed door (sgtls::ButtonDoors) between the bot and its next waypoint: go press the wall panel that opens it
+    /// on this side (or +use the door), wait until it is open, then search the path again. Return true while doing
+    /// that.
+    bool OpenDoor();
+
+    /// In a stargate's kill box (kawoosh, back, plane) and not walking into the gate while it is ready: walk out to the
+    /// nearest waypoint out of it, even while fighting. Return true while doing that.
+    bool LeaveGateKillBox();
+
+    /// An attacker that came from far stops short of its spot until teammates join it. Return true while waiting.
+    bool Regroup();
+
+    /// A defender of a hold button that reached its guard spot waits there, watching the button. Return true while
+    /// waiting.
+    bool Guard();
+
+    /// On a path with the jump flag, jump (crouched) at the step: the next waypoint more than a step higher and close.
+    void JumpAtStep();
+
+    bool m_bHoldingButton;         ///< Holding +use on an objective button.
+    Vector m_vSpawnOrigin;         ///< Where the bot spawned (taken half a second after the spawn).
+    bool m_bSpawnOriginSet;        ///< m_vSpawnOrigin is set for this life.
+    bool m_bRegroupDone;           ///< Regrouped (or gave up) in this life.
+    float m_fRegroupEnd;           ///< Time limit of the current wait, 0 = not waiting.
+    TWaypointId m_iGuardWaypoint;  ///< Guard spot the bot walks to (defender of a hold button), invalid = none.
+    float m_fGuardEnd;             ///< End of the wait at the guard spot, 0 = not there yet.
+    Vector m_vGuardLook;           ///< What the bot watches from its guard spot (the place of the button it guards).
+    float m_fNextStepJump;         ///< No new jump at a step before this time.
+    Vector m_vBlockedPos;          ///< JumpAtStep: where the bot was when it last moved 8 units.
+    int m_iDoorPassed;             ///< OpenDoor ("doorclear"): the door found open last, not checked again before...
+    float m_fDoorPassedEnd;        ///< ...this time.
+    std::vector<char> m_aReach;    ///< GetRoamDestination ("reachdest"): waypoints reachable from m_iReachSource.
+    TWaypointId m_iReachSource;    ///< Where m_aReach was computed from.
+    float m_fReachTime;            ///< When.
+    float m_fFallenCheck;          ///< Think: next check of the bot being below its waypoints ("fallen").
+    int m_iFallenChecks;           ///< Think: checks in a row that found it below them.
+    float m_fBlockedSince;         ///< JumpAtStep: since when it is within 8 units of m_vBlockedPos.
+    edict_t* m_pSpot;              ///< Objective spot the bot works on (sgtls::CObjectives::PickWaypoint).
+    int m_iStageSeen;              ///< sgtls::CObjectives::StageChanges() when the bot last checked.
+    float m_fGlassAimTime;         ///< When the bot is aimed at the window it found, 0 = none.
+    int m_iTeleporter;             ///< Teleporter the bot opens (sgtls::CObjectives::TeleporterOnPath), -1 = none.
+    float m_fTeleporterStart;      ///< When it started, to log a teleporter that doesn't open.
+    float m_fTeleporterPressed;    ///< Transporter booth: when the bot pressed its button (or found it pressed), 0 = not yet.
+    Vector m_vTeleporterPressPos;  ///< Where the bot was then: teleported once far from there.
+    int m_iTeleporterGaveUp;       ///< Transporter that didn't work, left alone until m_fTeleporterGaveUpEnd.
+    float m_fTeleporterGaveUpEnd;
+    bool m_bLeavingKillBox;        ///< Walking out of a stargate's kill box (LeaveGateKillBox).
+    int m_iCrossGate;              ///< FinalMove: the gate walked into (sgtls::ButtonTeleporters index), -1 = none.
+    Vector m_vCrossLast;           ///< Origin at the previous frame of the crossing.
+    float m_fCrossDist;            ///< Hull to plane at the previous frame.
+    float m_fCrossStep, m_fCrossPrevStep; ///< Last two steps toward the plane (units per frame).
+    int m_iCrossFull;              ///< Frames in a row with full moving keys.
+    int m_iCrossCoasts, m_iCrossBackOffs;
+    bool m_bCrossBackOff;          ///< Backing off from the plane, to come again.
+    float m_fCrossExpected;        ///< Depth of the first touch expected at the last full step.
+    float m_fCrossSafe;            ///< The depth needed (the side the bot comes from).
+    float m_fEntryFixTime;         ///< Last time the current waypoint, a closed gate's entry, was replaced.
+    float m_fPropDoorUseTime;      ///< Last +use on a prop_door_rotating (UsePropDoor).
+    TWaypointId m_iDoorDestination; ///< OpenDoor: where the bot was going (the walk to a panel changes it).
+    int m_iCrossDoor;              ///< CrossDoorway: the door whose doorway the bot goes through, -1 = none.
+    float m_fCrossDoorEnd, m_fCrossDoorSide; ///< Until when; the side of the door the bot came from (-1 / 1).
+    float m_fUnderwaterSince;      ///< Since when the eyes are under water (Swim), 0 = not.
+    float m_fAirCheckTime;         ///< Last check for air straight above (Swim).
+    bool m_bAirAbove;              ///< Air straight above, nothing solid in between.
+    Vector m_vLastHead;            ///< Eye position at the previous think: a jump of 1000+ units is logged (teleported).
+    TWaypointId m_iLastCurrent, m_iLastNext;
+    float m_fTeleporterDiag;       ///< UseTransporter: next diagnostic line (sgtls_hurtlog 1).
+    float m_fMoveDiag;             ///< FinalMove: next diagnostic line (sgtls_hurtlog 1).
+    int m_iDoor;                   ///< Door the bot opens (sgtls::CObjectives::ClosedDoorOnPath), -1 = none.
+    float m_fDoorStart;            ///< When it started.
+    float m_fDoorPressed;          ///< Last press of its opener, 0 = none yet.
+    Vector m_vDoorFrom, m_vDoorTo; ///< The way the door blocked (eye level): open once nothing of it is on this line.
+    int m_iDoorGaveUp;             ///< Door the bot couldn't open, left alone until m_fDoorGaveUpEnd.
+    float m_fDoorGaveUpEnd;
+
+public:
+
+    /// First class id of a team (classes of a team are this one and the 3 next ones), -1 for other teams.
+    static int FirstClassOfTeam( TTeam iTeam )
+    {
+        return iTeam == ETeamTauri ? 1 : ( iTeam == ETeamGoauld ? 5 : -1 );
+    }
+
+protected:
+    /// Team / class / equipment handshake. Return true while the bot isn't ready to play.
+    bool CheckJoin();
+
+    TTeam ChooseTeam() const;
+    int ChooseClass( TTeam iTeam, int iExclude = -1 ) const;
+
+    TTeam m_iWantedTeam;           ///< -1 = balance teams.
+    int m_iWantedClassId;          ///< -1 = random.
+    int m_iClassId;                ///< Class id the bot asked for (1..8), -1 if none yet.
+    int m_iEquipCode;              ///< Equipment code chosen for m_iEquipClass.
+    int m_iEquipClass;             ///< Class id of m_iEquipCode, -1 if none.
+    bool m_bEquipSent;             ///< setequipcode sent for m_iClassId.
+    float m_fNextJoinCommand;      ///< Don't flood the server with join commands.
+    float m_fEquipTime;            ///< When the equipment was sent, to detect a bot that didn't respawn.
+    float m_fNextKill;             ///< Last resort respawn, at most every 15 seconds.
+    float m_fSpawnTime;            ///< Last spawn.
+    bool m_bLoadoutChecked;        ///< The weapons given at the last spawn were checked (knife only = loadout refused).
+
+};
+
+#endif // __BOTRIX_BOT_SGTLS_H__
+
+#endif // BOTRIX_SGTLS
diff --git a/mods/sgtls/crash_handler.cpp b/mods/sgtls/crash_handler.cpp
new file mode 100644
index 0000000..2bea70a
--- /dev/null
+++ b/mods/sgtls/crash_handler.cpp
@@ -0,0 +1,133 @@
+// Crash logger for the old-engine ports: on a fatal exception, write the faulting address and a stack
+// walk (module+offset, plus symbol names where a .pdb is found) to <botrix dir>/crash.log.
+#ifdef _WIN32
+
+#include <windows.h>
+#include <dbghelp.h>
+#include <stdio.h>
+#include <string.h>
+
+#pragma comment(lib, "dbghelp.lib")
+
+static char s_szLogPath[MAX_PATH];
+static char s_szSymPath[MAX_PATH];
+static volatile LONG s_iReports = 0;
+
+static void DescribeAddress( FILE* f, HANDLE hProcess, DWORD64 addr )
+{
+    HMODULE hMod = NULL;
+    char szMod[MAX_PATH] = "?";
+    DWORD64 base = 0;
+    if ( GetModuleHandleExA( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                             (LPCSTR)(DWORD_PTR)addr, &hMod ) )
+    {
+        GetModuleFileNameA( hMod, szMod, sizeof(szMod) );
+        base = (DWORD64)(DWORD_PTR)hMod;
+    }
+    const char* szShort = strrchr( szMod, '\\' );
+    szShort = szShort ? szShort + 1 : szMod;
+
+    char aSymBuf[sizeof(SYMBOL_INFO) + 256];
+    SYMBOL_INFO* pSym = (SYMBOL_INFO*)aSymBuf;
+    memset( aSymBuf, 0, sizeof(aSymBuf) );
+    pSym->SizeOfStruct = sizeof(SYMBOL_INFO);
+    pSym->MaxNameLen = 255;
+    DWORD64 disp = 0;
+    if ( SymFromAddr( hProcess, addr, &disp, pSym ) )
+    {
+        IMAGEHLP_LINE64 line;
+        DWORD lineDisp = 0;
+        memset( &line, 0, sizeof(line) );
+        line.SizeOfStruct = sizeof(line);
+        if ( SymGetLineFromAddr64( hProcess, addr, &lineDisp, &line ) )
+            fprintf( f, "  %08llx %s+0x%llx  %s+0x%llx  (%s:%lu)\n", addr, szShort, addr - base, pSym->Name, disp,
+                     line.FileName, line.LineNumber );
+        else
+            fprintf( f, "  %08llx %s+0x%llx  %s+0x%llx\n", addr, szShort, addr - base, pSym->Name, disp );
+    }
+    else
+        fprintf( f, "  %08llx %s+0x%llx\n", addr, szShort, addr - base );
+}
+
+static LONG CALLBACK CrashHandler( EXCEPTION_POINTERS* pInfo )
+{
+    DWORD code = pInfo->ExceptionRecord->ExceptionCode;
+    if ( code != EXCEPTION_ACCESS_VIOLATION && code != EXCEPTION_ILLEGAL_INSTRUCTION &&
+         code != EXCEPTION_INT_DIVIDE_BY_ZERO && code != EXCEPTION_STACK_OVERFLOW &&
+         code != EXCEPTION_PRIV_INSTRUCTION && code != 0xC0000409 /* STATUS_STACK_BUFFER_OVERRUN */ )
+        return EXCEPTION_CONTINUE_SEARCH;
+    if ( InterlockedIncrement( &s_iReports ) > 5 )
+        return EXCEPTION_CONTINUE_SEARCH;
+
+    FILE* f = fopen( s_szLogPath, "a" );
+    if ( !f )
+        return EXCEPTION_CONTINUE_SEARCH;
+
+    SYSTEMTIME st;
+    GetLocalTime( &st );
+    CONTEXT ctx = *pInfo->ContextRecord;
+    fprintf( f, "==== %04d-%02d-%02d %02d:%02d:%02d exception 0x%08lx at %p", st.wYear, st.wMonth, st.wDay,
+             st.wHour, st.wMinute, st.wSecond, code, pInfo->ExceptionRecord->ExceptionAddress );
+    if ( code == EXCEPTION_ACCESS_VIOLATION && pInfo->ExceptionRecord->NumberParameters >= 2 )
+        fprintf( f, " (%s %p)", pInfo->ExceptionRecord->ExceptionInformation[0] ? "write" : "read",
+                 (void*)pInfo->ExceptionRecord->ExceptionInformation[1] );
+    fprintf( f, "\n  eax=%08lx ebx=%08lx ecx=%08lx edx=%08lx esi=%08lx edi=%08lx ebp=%08lx esp=%08lx\n",
+             ctx.Eax, ctx.Ebx, ctx.Ecx, ctx.Edx, ctx.Esi, ctx.Edi, ctx.Ebp, ctx.Esp );
+
+    HANDLE hProcess = GetCurrentProcess();
+    SymSetOptions( SYMOPT_UNDNAME | SYMOPT_DEFERRED_LOADS | SYMOPT_LOAD_LINES );
+    SymInitialize( hProcess, s_szSymPath, TRUE );
+
+    fprintf( f, "Stack walk:\n" );
+    STACKFRAME64 frame;
+    memset( &frame, 0, sizeof(frame) );
+    frame.AddrPC.Offset = ctx.Eip;
+    frame.AddrPC.Mode = AddrModeFlat;
+    frame.AddrFrame.Offset = ctx.Ebp;
+    frame.AddrFrame.Mode = AddrModeFlat;
+    frame.AddrStack.Offset = ctx.Esp;
+    frame.AddrStack.Mode = AddrModeFlat;
+    for ( int i = 0; i < 40; ++i )
+    {
+        if ( !StackWalk64( IMAGE_FILE_MACHINE_I386, hProcess, GetCurrentThread(), &frame, &ctx, NULL,
+                           SymFunctionTableAccess64, SymGetModuleBase64, NULL ) || frame.AddrPC.Offset == 0 )
+            break;
+        DescribeAddress( f, hProcess, frame.AddrPC.Offset );
+    }
+
+    // Optimized engine code often breaks the frame chain: also list every stack value that points into code.
+    fprintf( f, "Stack scan (return address candidates):\n" );
+    DWORD* pStack = (DWORD*)(DWORD_PTR)pInfo->ContextRecord->Esp;
+    int iFound = 0;
+    for ( int i = 0; i < 2048 && iFound < 40; ++i )
+    {
+        MEMORY_BASIC_INFORMATION mbi;
+        if ( !VirtualQuery( pStack + i, &mbi, sizeof(mbi) ) || mbi.State != MEM_COMMIT )
+            break;
+        DWORD v = pStack[i];
+        if ( VirtualQuery( (void*)(DWORD_PTR)v, &mbi, sizeof(mbi) ) && mbi.Type == MEM_IMAGE &&
+             (mbi.Protect & (PAGE_EXECUTE | PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE)) )
+        {
+            fprintf( f, "  [esp+%04x]", i * 4 );
+            DescribeAddress( f, hProcess, v );
+            ++iFound;
+        }
+    }
+    SymCleanup( hProcess );
+    fclose( f );
+    return EXCEPTION_CONTINUE_SEARCH;
+}
+
+void InstallCrashHandler( const char* szBotrixPath )
+{
+    _snprintf( s_szLogPath, sizeof(s_szLogPath) - 1, "%s\\crash.log", szBotrixPath );
+    // Symbols: botrix.pdb sits next to botrix.dll in addons/.
+    _snprintf( s_szSymPath, sizeof(s_szSymPath) - 1, "%s\\..", szBotrixPath );
+    AddVectoredExceptionHandler( 1, CrashHandler );
+}
+
+#else
+
+void InstallCrashHandler( const char* ) {}
+
+#endif
diff --git a/mods/sgtls/linux_server.cpp b/mods/sgtls/linux_server.cpp
new file mode 100644
index 0000000..2318dec
--- /dev/null
+++ b/mods/sgtls/linux_server.cpp
@@ -0,0 +1,79 @@
+// Linux: the mod's server .so (sgtls and StargateTC 2: GCC builds, all symbols exported) is patched by symbol name
+// instead of Windows addresses. Both .so have text relocations: their vtables are in .rodata, in the read-only
+// text segment. Not built on Windows.
+#ifdef __linux__
+
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE // dladdr1
+#endif
+#include <dlfcn.h>
+#include <link.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include "mods/sgtls/sgtls_util.h"
+
+namespace
+{
+    void* m_hServer = NULL;
+
+    // dl_iterate_phdr callback: the loaded module whose file is <mod>/bin/server_i486.so.
+    int FindServerModule( struct dl_phdr_info* pInfo, size_t, void* pData )
+    {
+        const char* szSuffix = "/bin/server_i486.so";
+        size_t iLength = pInfo->dlpi_name ? strlen( pInfo->dlpi_name ) : 0;
+        if ( iLength < strlen( szSuffix ) || strcmp( pInfo->dlpi_name + iLength - strlen( szSuffix ), szSuffix ) != 0 )
+            return 0;
+        *(const char**)pData = pInfo->dlpi_name;
+        return 1;
+    }
+}
+
+namespace sgtls
+{
+    void* ServerSymbol( const char* szName )
+    {
+        if ( !m_hServer )
+        {
+            // The game DLL interface's vtable lies in the server .so: its file name gives the loaded module.
+            // StargateTC 2's .so has no ServerGameDLL006 (Botrix's version): then look for the file name.
+            const char* szFile = NULL;
+            Dl_info cInfo;
+            if ( pServerGameDll && dladdr( *(void**)pServerGameDll, &cInfo ) && cInfo.dli_fname )
+                szFile = cInfo.dli_fname;
+            else
+                dl_iterate_phdr( FindServerModule, &szFile );
+            if ( szFile )
+                m_hServer = dlopen( szFile, RTLD_NOW | RTLD_NOLOAD );
+        }
+        return m_hServer ? dlsym( m_hServer, szName ) : NULL;
+    }
+
+    int VtableSlot( void** pVtable, void* pFunction )
+    {
+        Dl_info cInfo;
+        const ElfW(Sym)* pSym = NULL;
+        if ( !pVtable || !dladdr1( pVtable, &cInfo, (void**)&pSym, RTLD_DL_SYMENT ) || !pSym || !cInfo.dli_saddr )
+            return -1;
+        int iCount = (int)( ( (char*)cInfo.dli_saddr + pSym->st_size - (char*)pVtable ) / sizeof(void*) );
+        for ( int i = 0; i < iCount; ++i )
+            if ( pVtable[i] == pFunction )
+                return i;
+        return -1;
+    }
+
+    bool WriteCode( void* pAddress, const void* pData, int iSize )
+    {
+        long iPage = sysconf( _SC_PAGESIZE );
+        char* pStart = (char*)( (unsigned long)pAddress & ~( (unsigned long)iPage - 1 ) );
+        size_t iLength = (char*)pAddress + iSize - pStart;
+        if ( mprotect( pStart, iLength, PROT_READ | PROT_WRITE | PROT_EXEC ) != 0 )
+            return false;
+        memcpy( pAddress, pData, iSize );
+        mprotect( pStart, iLength, PROT_READ | PROT_EXEC ); // The text segment's protection.
+        return true;
+    }
+}
+
+#endif // __linux__
diff --git a/mods/sgtls/mod_sgtls.cpp b/mods/sgtls/mod_sgtls.cpp
new file mode 100644
