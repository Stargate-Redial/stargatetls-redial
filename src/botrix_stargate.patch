+
+void sgtls::CObjectives::DiagTeleporters()
+{
+    static float fLast = -1.0f;
+    static std::vector<char> aOn;
+    if ( CBotrixPlugin::fTime == fLast )
+        return;
+    fLast = CBotrixPlugin::fTime;
+    if ( aOn.size() != m_aTeleporters.size() )
+        aOn.assign( m_aTeleporters.size(), 0 );
+    // The func_doors within 150 units of a teleporter (rings): their height when it changes by 8 units.
+    static std::vector<edict_t*> aDoors;
+    static std::vector<float> aDoorZ;
+    static std::string sDoorsMap;
+    if ( sDoorsMap != CBotrixPlugin::instance->sMapName.c_str() )
+    {
+        sDoorsMap = CBotrixPlugin::instance->sMapName.c_str();
+        aDoors.clear(); aDoorZ.clear();
+        for ( int e = 1; e < CBotrixPlugin::pEngineServer->GetEntityCount(); ++e )
+        {
+            edict_t* pDoor = CBotrixPlugin::pEngineServer->PEntityOfEntIndex( e );
+            if ( !pDoor || pDoor->IsFree() || !pDoor->GetCollideable() || strcmp( pDoor->GetClassName(), "func_door" ) != 0 )
+                continue;
+            Vector vD = pDoor->GetCollideable()->GetCollisionOrigin();
+            for ( size_t i = 0; i < m_aTeleporters.size(); ++i )
+            {
+                edict_t* pT = m_aTeleporters[i].pTeleporter;
+                if ( pT && !pT->IsFree() && pT->GetCollideable() &&
+                     ( pT->GetCollideable()->GetCollisionOrigin() - vD ).Length2D() < 150.0f )
+                {
+                    aDoors.push_back( pDoor ); aDoorZ.push_back( vD.z );
+                    break;
+                }
+            }
+        }
+    }
+    for ( size_t d = 0; d < aDoors.size(); ++d )
+    {
+        if ( aDoors[d]->IsFree() || !aDoors[d]->GetCollideable() )
+            continue;
+        float fZ = aDoors[d]->GetCollideable()->GetCollisionOrigin().z;
+        static std::vector<float> aStill;
+        static std::vector<float> aPrevZ;
+        if ( aStill.size() != aDoors.size() ) { aStill.assign( aDoors.size(), 0.0f ); aPrevZ.assign( aDoors.size(), 0.0f ); }
+        if ( fZ != aPrevZ[d] ) { aPrevZ[d] = fZ; aStill[d] = CBotrixPlugin::fTime; }
+        // Stopped part way (not at rest) for 0.5 s: what is in its box.
+        else if ( CBotrixPlugin::fTime - aStill[d] > 0.5f && CBotrixPlugin::fTime - aStill[d] < 0.6f )
+        {
+            Vector vMins, vMaxs;
+            aDoors[d]->GetCollideable()->WorldSpaceSurroundingBounds( &vMins, &vMaxs );
+            for ( int e = 1; e < CBotrixPlugin::pEngineServer->GetEntityCount(); ++e )
+            {
+                edict_t* pEnt = CBotrixPlugin::pEngineServer->PEntityOfEntIndex( e );
+                if ( !pEnt || pEnt->IsFree() || !pEnt->GetCollideable() || pEnt == aDoors[d] )
+                    continue;
+                Vector a, b;
+                pEnt->GetCollideable()->WorldSpaceSurroundingBounds( &a, &b );
+                if ( a.x > vMaxs.x || b.x < vMins.x || a.y > vMaxs.y || b.y < vMins.y || a.z > vMaxs.z + 4 || b.z < vMins.z )
+                    continue;
+                if ( pEnt->GetCollideable()->GetSolid() == SOLID_NONE || ( pEnt->GetCollideable()->GetSolidFlags() & 0x4 ) )
+                    continue;
+                int iGround = sgtls::GetInt( pEnt, "m_hGroundEntity", -2 );
+                Msg( "[Botrix] Ring door %d still at z %.0f: %d %s (%s), ground %d, at %.0f %.0f %.0f .. %.0f %.0f %.0f.\n",
+                     CBotrixPlugin::pEngineServer->IndexOfEdict( aDoors[d] ), fZ, e, pEnt->GetClassName(),
+                     pEnt->GetIServerEntity() ? STRING( pEnt->GetIServerEntity()->GetModelName() ) : "?",
+                     iGround < 0 ? iGround : ( iGround & 0xFFF ),
+                     a.x, a.y, a.z, b.x, b.y, b.z );
+            }
+        }
+        if ( fabs( fZ - aDoorZ[d] ) >= 8.0f )
+        {
+            aDoorZ[d] = fZ;
+            Msg( "[Botrix] Ring door %d at z %.0f at %.2f.\n", CBotrixPlugin::pEngineServer->IndexOfEdict( aDoors[d] ), fZ, CBotrixPlugin::fTime );
+        }
+    }
+    for ( size_t i = 0; i < m_aTeleporters.size(); ++i )
+    {
+        char bOn = IsOn( m_aTeleporters[i] ) ? 1 : 0;
+        if ( bOn != aOn[i] )
+        {
+            aOn[i] = bOn;
+            Msg( "[Botrix] Teleporter %d %s at %.2f.\n", (int)i, bOn ? "on" : "off", CBotrixPlugin::fTime );
+        }
+    }
+}
