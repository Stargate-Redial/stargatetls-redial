+//----------------------------------------------------------------------------------------------------------------
+namespace
+{
+#ifdef _WIN32
+    // Bot_RunAll() of the SDK test bots (hl2mp_bot_temp.cpp): for every player with FL_FAKECLIENT it runs
+    // Bot_Think(), which sends a second usercmd per frame: forward at 600 with 100 hp, standing still when hurt
+    // (bots slowed down after each hit), random turns, and fire (bot_attack). No arguments, plain ret: a ret as its
+    // first instruction turns it off. Checked bytes: mov eax, [gpGlobals]; push esi|edi; mov esi|edi, 1.
+    #if defined(BOTRIX_SGTC2)
+    const unsigned int iBotRunAllRva = 0x221a54a0 - 0x22000000;
+    const unsigned char aBotRunAllTail[6] = { 0x57, 0xBF, 0x01, 0x00, 0x00, 0x00 };
+    #else
+    const unsigned int iBotRunAllRva = 0x102424f0 - 0x10000000;
+    const unsigned char aBotRunAllTail[6] = { 0x56, 0xBE, 0x01, 0x00, 0x00, 0x00 };
+    #endif
+    unsigned char* pBotRunAll = NULL;
+
+    bool WriteCodeByte( unsigned char* p, unsigned char c )
+    {
+        unsigned long iOld;
+        if ( !VirtualProtect( p, 1, 0x40 /* PAGE_EXECUTE_READWRITE */, &iOld ) )
+            return false;
+        *p = c;
+        VirtualProtect( p, 1, iOld, &iOld );
+        return true;
+    }
+#elif defined(__linux__)
+    // The same ret over Bot_RunAll() of server_i486.so, found by name (exported).
+    unsigned char* pBotRunAll = NULL;
+    unsigned char iBotRunAllFirst = 0;
+#endif
+}
+
+void sgtls::DisableSdkBotThink()
+{
+#ifdef __linux__
+    unsigned char* p = (unsigned char*)ServerSymbol( "_Z10Bot_RunAllv" );
+    const unsigned char iRet = 0xC3;
+    if ( !p )
+    {
+        Warning( "[Botrix] SDK test bots: Bot_RunAll not found in this server .so, left on.\n" );
+        return;
+    }
+    iBotRunAllFirst = *p;
+    if ( WriteCode( p, &iRet, 1 ) )
+    {
+        pBotRunAll = p;
+        Msg( "[Botrix] SDK test bots: Bot_RunAll turned off (it drove Botrix's bots too).\n" );
+    }
+#endif
+#ifdef _WIN32
+    unsigned char* pBase = (unsigned char*)GetModuleHandleA( "server.dll" );
+    unsigned char* p = pBase ? pBase + iBotRunAllRva : NULL;
+    if ( !p || p[0] != 0xA1 || memcmp( p + 5, aBotRunAllTail, sizeof(aBotRunAllTail) ) != 0 )
+    {
+        Warning( "[Botrix] SDK test bots: Bot_RunAll not found in this server.dll, left on.\n" );
+        return;
+    }
+    if ( WriteCodeByte( p, 0xC3 ) )
+    {
+        pBotRunAll = p;
+        Msg( "[Botrix] SDK test bots: Bot_RunAll turned off (it drove Botrix's bots too).\n" );
+    }
+#endif
+}
+
+void sgtls::EnableSdkBotThink()
+{
+#ifdef _WIN32
+    if ( pBotRunAll && WriteCodeByte( pBotRunAll, 0xA1 ) )
+        pBotRunAll = NULL;
+#elif defined(__linux__)
+    if ( pBotRunAll && WriteCode( pBotRunAll, &iBotRunAllFirst, 1 ) )
+        pBotRunAll = NULL;
+#endif
+}
