+namespace
+{
+    std::vector<sgtls::CButtonDoor> m_aButtonDoors;
+    std::string m_sButtonDoorsMap;
+
+    bool SameText( const std::string& s, const char* sz )
+    {
+        size_t i = 0;
+        for ( ; i < s.size() && sz[i]; ++i )
+            if ( tolower( (unsigned char)s[i] ) != tolower( (unsigned char)sz[i] ) )
+                return false;
+        return i == s.size() && !sz[i];
+    }
+
+    // An output of e (szOutput, or any "On..." output if NULL) that opens the door named sDoor: directly (Open,
+    // Toggle), or through iDepth logic_relay / logic_branch (tls_revelation_a6: button -> logic_branch Test ->
+    // OnFalse -> func_movelinear Open; the branch toggles).
+    bool OpensDoor( const sgtls::CBspEntity& e, const char* szOutput, const std::string& sDoor, int iDepth )
+    {
+        std::string sTarget, sInput, sParam;
+        const std::vector<sgtls::CBspEntity>& aEnts = sgtls::BspEntities();
+        for ( std::multimap<std::string, std::string>::const_iterator it = e.aKeys.begin(); it != e.aKeys.end(); ++it )
+        {
+            if ( szOutput ? it->first != szOutput : it->first.compare( 0, 2, "On" ) != 0 )
+                continue;
+            if ( !ParseOutput( it->second, sTarget, sInput, sParam ) )
+                continue;
+            if ( sTarget == sDoor && ( SameText( sInput, "Open" ) || SameText( sInput, "Toggle" ) ) )
+                return true;
+            for ( size_t r = 0; iDepth > 0 && r < aEnts.size(); ++r )
+                if ( sTarget == aEnts[r].Get( "targetname" ) && &aEnts[r] != &e &&
+                     ( strcmp( aEnts[r].Get( "classname" ), "logic_relay" ) == 0 ||
+                       strcmp( aEnts[r].Get( "classname" ), "logic_branch" ) == 0 ) &&
+                     OpensDoor( aEnts[r], NULL, sDoor, iDepth - 1 ) )
+                    return true;
+        }
+        return false;
+    }
+}
+
+
+namespace
+{
+    // The longest delay of e's szOutput outputs that open or toggle sDoor directly ("target,input,param,delay,times",
+    // fields separated by commas or ESC).
+    float OpenDelay( const sgtls::CBspEntity& e, const char* szOutput, const std::string& sDoor )
+    {
+        float fDelay = 0.0f;
+        for ( std::multimap<std::string, std::string>::const_iterator it = e.aKeys.begin(); it != e.aKeys.end(); ++it )
+        {
+            if ( it->first != szOutput )
+                continue;
+            std::vector<std::string> aFields( 1 );
+            for ( size_t c = 0; c < it->second.size(); ++c )
+            {
+                if ( it->second[c] == ',' || it->second[c] == 27 )
+                    aFields.push_back( std::string() );
+                else
+                    aFields.back() += it->second[c];
+            }
+            if ( aFields.size() >= 4 && aFields[0] == sDoor &&
+                 ( SameText( aFields[1], "Open" ) || SameText( aFields[1], "Toggle" ) ) )
+            {
+                float f = (float)atof( aFields[3].c_str() );
+                if ( f > fDelay )
+                    fDelay = f;
+            }
+        }
+        return fDelay;
+    }
+}
