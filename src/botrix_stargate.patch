+
+int sgtls::CObjectives::ClosedDoorOnPath( const Vector& vFrom, const Vector& vTo, float fNear )
+{
+    Refresh();
+    const std::vector<sgtls::CButtonDoor>& aDefs = sgtls::ButtonDoors();
+    for ( size_t i = 0; i < m_aDoors.size() && i < aDefs.size(); ++i )
+    {
+        const sgtls::CButtonDoor& def = aDefs[i];
+        if ( def.bTouchOpens || !m_aDoors[i].pDoor || m_aDoors[i].pDoor->IsFree() ||
+             DistanceToBox( vFrom, def.pDoor->vMins, def.pDoor->vMaxs ) > fNear )
+            continue;
+        if ( DoorBlocks( (int)i, vFrom, vTo ) )
+            return (int)i;
+    }
+    return -1;
+}
+
+
+bool sgtls::CObjectives::DoorBlocks( int iDoor, const Vector& vFrom, const Vector& vTo )
+{
+    if ( iDoor < 0 || iDoor >= (int)m_aDoors.size() )
+        return false;
+    edict_t* pDoor = m_aDoors[iDoor].pDoor;
+    if ( !pDoor || pDoor->IsFree() || !pDoor->GetUnknown() )
+        return false;
+    // A box 28 units wide at waist height, against the door only: a door open a crack still blocks the way.
+    float fDown = CMod::GetVar( EModVarPlayerEye ) - 36.0f;
+    Vector a( vFrom.x, vFrom.y, vFrom.z - fDown ), b( vTo.x, vTo.y, vTo.z - fDown );
+    Ray_t ray;
+    ray.Init( a, b, Vector( -14.0f, -14.0f, -14.0f ), Vector( 14.0f, 14.0f, 14.0f ) );
+    trace_t tr;
+    CBotrixPlugin::pEngineTrace->ClipRayToEntity( ray, MASK_PLAYERSOLID, pDoor->GetUnknown(), &tr );
+    if ( tr.fraction < 1.0f || tr.startsolid )
+        return true;
+    if ( !sgtls::Feature( sgtls::FeatDoorClear ) || !pDoor->GetCollideable() )
+        return false;
+    // tls_stargate_atlantis_fixed's base: blast doors rise at 15 units a second and crush (dmg 300) on the way down,
+    // 10 seconds after they opened. Open only once the bottom clears a standing player (from a step above the feet to
+    // 8 units over the head), and never while it comes down.
+    CDoor& d = m_aDoors[iDoor];
+    Vector vMins, vMaxs;
+    WorldBox( pDoor, vMins, vMaxs );
+    if ( CBotrixPlugin::fTime >= d.fLastZTime + 0.1f || d.fLastZTime < 0.0f )
+    {
+        if ( d.fLastZTime >= 0.0f && CBotrixPlugin::fTime < d.fLastZTime + 2.0f )
+        {
+            if ( vMins.z < d.fLastZ - 0.2f )
+                d.bGoingDown = true;
+            else if ( vMins.z > d.fLastZ + 0.2f )
+                d.bGoingDown = false;
+        }
+        else
+            d.bGoingDown = false;
+        d.fLastZ = vMins.z;
+        d.fLastZTime = CBotrixPlugin::fTime;
+    }
+    if ( d.bGoingDown )
+        return true;
+    float fEye = CMod::GetVar( EModVarPlayerEye );
+    Vector a2( vFrom.x, vFrom.y, vFrom.z - fEye + 49.0f ), b2( vTo.x, vTo.y, vTo.z - fEye + 49.0f );
+    ray.Init( a2, b2, Vector( -14.0f, -14.0f, -31.0f ), Vector( 14.0f, 14.0f, 31.0f ) );
+    CBotrixPlugin::pEngineTrace->ClipRayToEntity( ray, MASK_PLAYERSOLID, pDoor->GetUnknown(), &tr );
+    return tr.fraction < 1.0f || tr.startsolid;
+}
+
+
+bool sgtls::CObjectives::DoorWorldBox( int iDoor, Vector& vMins, Vector& vMaxs )
+{
+    if ( iDoor < 0 || iDoor >= (int)m_aDoors.size() )
+        return false;
+    edict_t* pDoor = m_aDoors[iDoor].pDoor;
+    if ( !pDoor || pDoor->IsFree() || !pDoor->GetCollideable() )
+        return false;
+    WorldBox( pDoor, vMins, vMaxs );
+    return true;
+}
+
+
+edict_t* sgtls::CObjectives::DoorOpener( int iDoor, const Vector& vEye, Vector& vOpener, bool& bDoorItself )
+{
+    bDoorItself = false;
+    if ( iDoor < 0 || iDoor >= (int)m_aDoors.size() )
+        return NULL;
+    const sgtls::CButtonDoor& def = sgtls::ButtonDoors()[iDoor];
+    const CDoor& d = m_aDoors[iDoor];
+    // A panel on the bot's side of the door (or in its plane: on the frame).
+    Vector vCenter = ( def.pDoor->vMins + def.pDoor->vMaxs ) * 0.5f;
+    float fSide = vEye[def.iAxis] - vCenter[def.iAxis];
+    edict_t* pBest = NULL;
+    float fBest = 400.0f * 400.0f;
+    for ( size_t b = 0; b < d.aButtons.size(); ++b )
+    {
+        edict_t* pButton = d.aButtons[b];
+        if ( !pButton || pButton->IsFree() || !pButton->GetCollideable() )
+            continue;
+        Vector vMins, vMaxs;
+        WorldBox( pButton, vMins, vMaxs );
+        Vector vButton = ( vMins + vMaxs ) * 0.5f;
+        float fButtonSide = vButton[def.iAxis] - vCenter[def.iAxis];
+        if ( fabs( fButtonSide ) > 2.0f && fButtonSide * fSide < 0.0f )
+            continue;
+        float fDist = vButton.DistToSqr( vEye );
+        if ( fDist < fBest )
+        {
+            fBest = fDist;
+            pBest = pButton;
+            vOpener = NearestInside( vEye, vMins, vMaxs );
+        }
+    }
+    if ( pBest )
+        return pBest;
+    if ( def.bUseOpens && d.pDoor && !d.pDoor->IsFree() && d.pDoor->GetCollideable() )
+    {
+        Vector vMins, vMaxs;
+        WorldBox( d.pDoor, vMins, vMaxs );
+        vOpener = NearestInside( vEye, vMins, vMaxs );
+        bDoorItself = true;
+        return d.pDoor;
+    }
+    return NULL;
+}
+
+
+bool sgtls::CObjectives::PressDoorButton( int iDoor, edict_t* pButton, edict_t* pActivator )
+{
+    if ( iDoor < 0 || iDoor >= (int)m_aDoors.size() )
+        return false;
+    CDoor& d = m_aDoors[iDoor];
+    if ( CBotrixPlugin::fTime < d.fNextPress || !pButton || pButton->IsFree() )
+        return false;
+    d.fNextPress = CBotrixPlugin::fTime + 1.0f;
+    return sgtls::UseEntity( pButton, pActivator );
+}
