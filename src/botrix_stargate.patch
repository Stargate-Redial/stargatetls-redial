+bool sgtls::InFire( const Vector& vEye )
+{
+    if ( m_sFireMap != CBotrixPlugin::instance->sMapName.c_str() )
+        return false;
+    for ( size_t k = 0; k < m_aFireReach.size(); ++k )
+    {
+        const CFireReach& f = m_aFireReach[k];
+        if ( vEye.z >= f.fMinZ && vEye.z <= f.fMaxZ && ( vEye.AsVector2D() - f.vCenter ).LengthSqr() < f.fReach * f.fReach )
+            return true;
+    }
+    return false;
+}
+
+bool sgtls::FireInReach( const Vector& vEye, Vector2D& vFire )
+{
+    if ( m_sFireMap != CBotrixPlugin::instance->sMapName.c_str() )
+        return false;
+    float fBest = 1e18f;
+    for ( size_t k = 0; k < m_aFireReach.size(); ++k )
+    {
+        const CFireReach& f = m_aFireReach[k];
+        float fDist = ( vEye.AsVector2D() - f.vCenter ).LengthSqr();
+        if ( vEye.z >= f.fMinZ && vEye.z <= f.fMaxZ && fDist < f.fReach * f.fReach && fDist < fBest )
+        {
+            fBest = fDist;
+            vFire = f.vCenter;
+        }
+    }
+    return fBest < 1e18f;
+}
+
+bool sgtls::InFireBox( const Vector& vEye, float fMargin )
+{
+    // The SDK's CFire::Update burns every player whose box touches the fire's box: at full heat its half side is
+    // firesize * FIRE_WIDTH / FIRE_HEIGHT / 2 * FIRE_SPREAD_DAMAGE_MULTIPLIER = firesize / 2, at least 16, its height
+    // firesize above the fire's origin. A player's box: 16 units each side of the origin, 72 high from the feet.
+    if ( m_sFireMap != CBotrixPlugin::instance->sMapName.c_str() )
+        return false;
+    float fFeet = vEye.z - CMod::GetVar( EModVarPlayerEye );
+    for ( size_t k = 0; k < m_aFireReach.size(); ++k )
+    {
+        const CFireReach& f = m_aFireReach[k];
+        float fHalf = ( f.fSize * 0.5f > 16.0f ? f.fSize * 0.5f : 16.0f ) + 16.0f + fMargin;
+        if ( fabs( vEye.x - f.vCenter.x ) < fHalf && fabs( vEye.y - f.vCenter.y ) < fHalf &&
+             fFeet < f.fZ + f.fSize + fMargin && fFeet + 72.0f > f.fZ - fMargin )
+            return true;
+    }
+    return false;
+}
+
+bool sgtls::InAnyFireBox( const Vector& vEye, float fMargin, Vector2D& vFire )
+{
+    if ( m_sFireMap != CBotrixPlugin::instance->sMapName.c_str() )
+        return false;
+    float fFeet = vEye.z - CMod::GetVar( EModVarPlayerEye );
+    for ( size_t k = 0; k < m_aAllFires.size(); ++k )
+    {
+        const CFireReach& f = m_aAllFires[k];
+        float fHalf = ( f.fSize * 0.5f > 16.0f ? f.fSize * 0.5f : 16.0f ) + 16.0f + fMargin;
+        if ( fabs( vEye.x - f.vCenter.x ) < fHalf && fabs( vEye.y - f.vCenter.y ) < fHalf &&
+             fFeet < f.fZ + f.fSize + fMargin && fFeet + 72.0f > f.fZ - fMargin )
+        {
+            vFire = f.vCenter;
+            return true;
+        }
+    }
+    return false;
+}
+
+bool sgtls::FireNear( const Vector& v, float fDistance )
+{
+    if ( m_sFireMap != CBotrixPlugin::instance->sMapName.c_str() )
+        return false;
+    for ( size_t k = 0; k < m_aFireReach.size(); ++k )
+    {
+        const CFireReach& f = m_aFireReach[k];
+        if ( ( v.AsVector2D() - f.vCenter ).LengthSqr() < fDistance * fDistance && fabs( v.z - f.fZ ) < 128.0f )
+            return true;
+    }
+    return false;
+}
+
+int sgtls::AvoidFires()
+{
+    // env_fire on from the start with infinite fuel (spawnflags 1 + 4) burns for the whole map: tls_lockdown has
+    // three in the corridor east of the gate room, where bots walked through and burned (13 deaths in 8 minutes,
+    // 2026-10-28). Removing the waypoints there cut the map in two (a player walks past the fires): the paths within
+    // reach get costly instead, A* goes round when it can. The SDK's damage radius is firesize / 2 at full heat,
+    // plus half a player and a little. Path lengths are computed at load: redone at every map load.
+    const std::vector<CBspEntity>& aEnts = BspEntities();
+    float fEye = CMod::GetVar( EModVarPlayerEye );
+    good::vector<TWaypointId> aTargets;
+    int iPaths = 0;
+    m_aFireReach.clear();
+    m_aAllFires.clear();
+    m_sFireMap = CBotrixPlugin::instance->sMapName.c_str();
+    for ( size_t i = 0; i < aEnts.size(); ++i )
+    {
+        const CBspEntity& e = aEnts[i];
+        if ( strcmp( e.Get( "classname" ), "env_fire" ) == 0 && ( atoi( e.Get( "spawnflags", "0" ) ) & 5 ) == 5 )
+        {
+            float fAllSize = atof( e.Get( "firesize", "64" ) );
+            CFireReach a = { e.vOrigin.AsVector2D(), e.vOrigin.z, e.vOrigin.z + fAllSize + fEye, fAllSize * 0.5f + 24.0f,
+                             e.vOrigin.z, fAllSize };
+            m_aAllFires.push_back( a );
+        }
+        // Not the harmless ones (damagescale 0: tls_hatak's 109 torches on pillars made a maze of its halls).
+        if ( strcmp( e.Get( "classname" ), "env_fire" ) != 0 || ( atoi( e.Get( "spawnflags", "0" ) ) & 5 ) != 5 ||
+             atof( e.Get( "damagescale", "1" ) ) <= 0.0f )
+            continue;
+        float fSize = atof( e.Get( "firesize", "64" ) );
+        float fReach = fSize * 0.5f + 24.0f;
+        Vector2D vFire = e.vOrigin.AsVector2D();
+        CFireReach r = { vFire, e.vOrigin.z, e.vOrigin.z + fSize + fEye, fReach, e.vOrigin.z, fSize };
+        m_aFireReach.push_back( r );
+        for ( TWaypointId w = 0; w < CWaypoints::Size(); ++w )
+        {
+            const Vector& a = CWaypoints::Get( w ).vOrigin;
+            if ( a.z < e.vOrigin.z || a.z > e.vOrigin.z + fSize + fEye )
+                continue;
+            aTargets.clear();
+            CWaypoints::GetPathTargets( w, aTargets );
+            for ( int t = 0; t < aTargets.size(); ++t )
+            {
+                // Distance from the fire to the segment a -> b, on the ground plane.
+                Vector2D vA = a.AsVector2D(), vAB = CWaypoints::Get( aTargets[t] ).vOrigin.AsVector2D() - vA;
+                float fLengthSqr = vAB.LengthSqr();
+                float f = fLengthSqr > 0.0f ? clamp( ( vFire - vA ).Dot( vAB ) / fLengthSqr, 0.0f, 1.0f ) : 0.0f;
+                if ( ( vA + vAB * f - vFire ).LengthSqr() < fReach * fReach )
+                {
+                    CWaypointPath* pPath = CWaypoints::GetPath( w, aTargets[t] );
+                    if ( pPath )
+                    {
+                        pPath->fLength += 3000.0f;
+                        ++iPaths;
+                    }
+                }
+            }
+        }
+    }
+    return iPaths;
+}
+
+
+const std::vector<sgtls::CBspEntity>& sgtls::BspEntities()
+{
+    if ( m_sEntitiesMap == CBotrixPlugin::instance->sMapName.c_str() )
+        return m_aEntities;
+    m_sEntitiesMap = CBotrixPlugin::instance->sMapName.c_str();
+    m_aEntities.clear();
+
+    char szPath[512];
+    CBotrixPlugin::pEngineServer->GetGameDir( szPath, sizeof(szPath) );
+    std::string sPath = std::string( szPath ) + "/maps/" + m_sEntitiesMap + ".bsp";
+    FILE* f = fopen( sPath.c_str(), "rb" );
+#ifndef _WIN32
+    // The map name is lower-cased (server_plugin.cpp), the file system isn't: tls_Thebes_rc2, tls_MoonDragon_10b.
+    if ( !f )
+    {
+        std::string sDir = std::string( szPath ) + "/maps";
+        DIR* pDir = opendir( sDir.c_str() );
+        std::string sWanted = m_sEntitiesMap + ".bsp";
+        for ( struct dirent* pEnt = pDir ? readdir( pDir ) : NULL; pEnt && !f; pEnt = readdir( pDir ) )
+            if ( strcasecmp( pEnt->d_name, sWanted.c_str() ) == 0 )
+            {
+                sPath = sDir + "/" + pEnt->d_name;
+                f = fopen( sPath.c_str(), "rb" );
+            }
+        if ( pDir )
+            closedir( pDir );
+    }
+#endif
+    if ( !f )
+    {
+        Warning( "[Botrix] sgtls: can't open %s\n", sPath.c_str() );
+        return m_aEntities;
+    }
+    int aHeader[2 + 64 * 4]; // ident, version, 64 lumps of (offset, length, version, fourCC).
+    std::string sEnts;
+    std::vector<float> aModels; // 12 floats per model (mins, maxs, origin, 3 ints).
+    if ( fread( aHeader, sizeof(aHeader), 1, f ) == 1 )
+    {
+        int iEntOfs = aHeader[2], iEntLen = aHeader[3];
+        int iMdlOfs = aHeader[2 + 14 * 4], iMdlLen = aHeader[3 + 14 * 4];
+        if ( iEntLen > 0 && iEntLen < 32 * 1024 * 1024 )
+        {
+            // Keep a short read: tls_sgtc_temple's entity lump ends one byte past the end of the file (the engine
+            // reads it anyway).
+            sEnts.resize( iEntLen );
+            fseek( f, iEntOfs, SEEK_SET );
+            sEnts.resize( fread( &sEnts[0], 1, iEntLen, f ) );
+        }
+        if ( iMdlLen > 0 && iMdlLen < 4 * 1024 * 1024 )
+        {
+            aModels.resize( iMdlLen / 4 );
+            fseek( f, iMdlOfs, SEEK_SET );
+            if ( fread( &aModels[0], 1, iMdlLen, f ) != (size_t)iMdlLen )
+                aModels.clear();
+        }
+    }
+    fclose( f );
+
+    size_t iPos = 0;
+    while ( ( iPos = sEnts.find( '{', iPos ) ) != std::string::npos )
+    {
+        size_t iEnd = sEnts.find( '}', iPos );
+        if ( iEnd == std::string::npos )
+            break;
+        CBspEntity cEnt;
+        cEnt.bBrush = false;
+        cEnt.vOrigin.Init();
+        // "key" "value" pairs.
+        size_t q = iPos;
+        while ( true )
+        {
+            size_t k0 = sEnts.find( '"', q );
+            if ( k0 == std::string::npos || k0 > iEnd ) break;
+            size_t k1 = sEnts.find( '"', k0 + 1 );
+            size_t v0 = sEnts.find( '"', k1 + 1 );
+            size_t v1 = sEnts.find( '"', v0 + 1 );
+            if ( v1 == std::string::npos || v1 > iEnd ) break;
+            cEnt.aKeys.insert( std::make_pair( sEnts.substr( k0 + 1, k1 - k0 - 1 ), sEnts.substr( v0 + 1, v1 - v0 - 1 ) ) );
+            q = v1 + 1;
+        }
+        iPos = iEnd;
+        sscanf( cEnt.Get( "origin", "0 0 0" ), "%f %f %f", &cEnt.vOrigin.x, &cEnt.vOrigin.y, &cEnt.vOrigin.z );
+        const char* szModel = cEnt.Get( "model" );
+        int iModel = ( szModel[0] == '*' ) ? atoi( szModel + 1 ) : -1;
+        if ( iModel >= 0 && ( iModel + 1 ) * 12 <= (int)aModels.size() )
+        {
+            cEnt.bBrush = true;
+            const float* m = &aModels[ iModel * 12 ];
+            cEnt.vMins.Init( m[0] + cEnt.vOrigin.x, m[1] + cEnt.vOrigin.y, m[2] + cEnt.vOrigin.z );
+            cEnt.vMaxs.Init( m[3] + cEnt.vOrigin.x, m[4] + cEnt.vOrigin.y, m[5] + cEnt.vOrigin.z );
+        }
+        m_aEntities.push_back( cEnt );
+    }
+    return m_aEntities;
+}
