+// What an explosive shot would hit first: everything solid but the shooter and projectiles / items.
+class CShotTraceFilter: public ITraceFilter
+{
+public:
+    CShotTraceFilter( int iShooter ): m_iShooter( iShooter ) {}
+
+    virtual TraceType_t GetTraceType() const { return TRACE_EVERYTHING; } // Static props always hit.
+
+    virtual bool ShouldHitEntity( IHandleEntity *pEntity, int /*contentsMask*/ )
+    {
+        if ( CBotrixPlugin::pStaticPropMgr && CBotrixPlugin::pStaticPropMgr->IsStaticProp( pEntity ) )
+            return true;
+        int index = pEntity->GetRefEHandle().GetEntryIndex();
+        if ( index == m_iShooter )
+            return false;
+        if ( index == 0 || index >= MAX_EDICTS || index <= CPlayers::Size() )
+            return true; // World, players.
+        edict_t *pEdict = CBotrixPlugin::instance->pEngineServer->PEntityOfEntIndex( index );
+        return pEdict == NULL || pEdict->IsFree() || !CUtil::IsSeeThrough( pEdict );
+    }
+
+protected:
+    int m_iShooter;
+};
+
+bool CUtil::IsSeeThrough( edict_t* pEdict )
+{
+    const char* szClassName = pEdict->GetClassName();
+    if ( strncmp( szClassName, "weapon_", 7 ) == 0 || strncmp( szClassName, "item_", 5 ) == 0 ||
+         strstr( szClassName, "blast" ) || strstr( szClassName, "projectile" ) || strstr( szClassName, "grenade" ) ||
+         strstr( szClassName, "rocket" ) || strstr( szClassName, "bolt" ) )
+        return true;
+    // Other small things in flight.
+    ICollideable* pCollide = pEdict->GetCollideable();
+    if ( pCollide )
+    {
+        Vector vSize = pCollide->OBBMaxs() - pCollide->OBBMins();
+        if ( vSize.x < 12.0f && vSize.y < 12.0f && vSize.z < 12.0f )
+            return true;
+    }
+    return false;
+}
+
+float CUtil::ShotClearDistance( edict_t* pShooter, const Vector& vSrc, const Vector& vDir, float fDistance,
+                                float fHalfSize )
+{
+    CShotTraceFilter filter( CBotrixPlugin::pEngineServer->IndexOfEdict( pShooter ) );
+    if ( fHalfSize > 0.0f ) // A projectile's size.
+        TraceHull( vSrc, vSrc + vDir * fDistance, Vector( -fHalfSize, -fHalfSize, -fHalfSize ),
+                   Vector( fHalfSize, fHalfSize, fHalfSize ), MASK_SHOT, &filter );
+    else
+        TraceLine( vSrc, vSrc + vDir * fDistance, MASK_SHOT, &filter );
+    return m_TraceResult.fraction * fDistance;
+}
