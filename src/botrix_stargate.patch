+
+int sgtls::AvoidFires()
+{
+    // env_fire on from the start with infinite fuel (spawnflags 1 + 4) burns for the whole map: tls_lockdown has
+    // three in the corridor east of the gate room, where bots walked through and burned (13 deaths in 8 minutes,
+    // 2026-10-28). Removing the waypoints there cut the map in two (a player walks past the fires): the paths within
+    // reach get costly instead, A* goes round when it can. The SDK's damage radius is firesize / 2 at full heat,
+    // plus half a player and a little. Path lengths are computed at load: redone at every map load.
+    const std::vector<CBspEntity>& aEnts = BspEntities();
+    float fEye = CMod::GetVar( EModVarPlayerEye );
+    good::vector<TWaypointId> aTargets;
+    int iPaths = 0;
+    for ( size_t i = 0; i < aEnts.size(); ++i )
+    {
+        const CBspEntity& e = aEnts[i];
+        if ( strcmp( e.Get( "classname" ), "env_fire" ) != 0 || ( atoi( e.Get( "spawnflags", "0" ) ) & 5 ) != 5 )
+            continue;
+        float fSize = atof( e.Get( "firesize", "64" ) );
+        float fReach = fSize * 0.5f + 24.0f;
+        Vector2D vFire = e.vOrigin.AsVector2D();
+        for ( TWaypointId w = 0; w < CWaypoints::Size(); ++w )
+        {
+            const Vector& a = CWaypoints::Get( w ).vOrigin;
+            if ( a.z < e.vOrigin.z || a.z > e.vOrigin.z + fSize + fEye )
+                continue;
+            aTargets.clear();
+            CWaypoints::GetPathTargets( w, aTargets );
+            for ( int t = 0; t < aTargets.size(); ++t )
+            {
+                // Distance from the fire to the segment a -> b, on the ground plane.
+                Vector2D vA = a.AsVector2D(), vAB = CWaypoints::Get( aTargets[t] ).vOrigin.AsVector2D() - vA;
+                float fLengthSqr = vAB.LengthSqr();
+                float f = fLengthSqr > 0.0f ? clamp( ( vFire - vA ).Dot( vAB ) / fLengthSqr, 0.0f, 1.0f ) : 0.0f;
+                if ( ( vA + vAB * f - vFire ).LengthSqr() < fReach * fReach )
+                {
+                    CWaypointPath* pPath = CWaypoints::GetPath( w, aTargets[t] );
+                    if ( pPath )
+                    {
+                        pPath->fLength += 3000.0f;
+                        ++iPaths;
+                    }
+                }
+            }
+        }
+    }
+    return iPaths;
+}
+
+
+const std::vector<sgtls::CBspEntity>& sgtls::BspEntities()
+{
+    if ( m_sEntitiesMap == CBotrixPlugin::instance->sMapName.c_str() )
+        return m_aEntities;
+    m_sEntitiesMap = CBotrixPlugin::instance->sMapName.c_str();
+    m_aEntities.clear();
+
+    char szPath[512];
+    CBotrixPlugin::pEngineServer->GetGameDir( szPath, sizeof(szPath) );
+    std::string sPath = std::string( szPath ) + "/maps/" + m_sEntitiesMap + ".bsp";
+    FILE* f = fopen( sPath.c_str(), "rb" );
+    if ( !f )
+    {
+        Warning( "[Botrix] sgtls: can't open %s\n", sPath.c_str() );
+        return m_aEntities;
+    }
+    int aHeader[2 + 64 * 4]; // ident, version, 64 lumps of (offset, length, version, fourCC).
+    std::string sEnts;
+    std::vector<float> aModels; // 12 floats per model (mins, maxs, origin, 3 ints).
+    if ( fread( aHeader, sizeof(aHeader), 1, f ) == 1 )
+    {
+        int iEntOfs = aHeader[2], iEntLen = aHeader[3];
+        int iMdlOfs = aHeader[2 + 14 * 4], iMdlLen = aHeader[3 + 14 * 4];
+        if ( iEntLen > 0 && iEntLen < 32 * 1024 * 1024 )
+        {
+            sEnts.resize( iEntLen );
+            fseek( f, iEntOfs, SEEK_SET );
+            if ( fread( &sEnts[0], 1, iEntLen, f ) != (size_t)iEntLen )
+                sEnts.clear();
+        }
+        if ( iMdlLen > 0 && iMdlLen < 4 * 1024 * 1024 )
+        {
+            aModels.resize( iMdlLen / 4 );
+            fseek( f, iMdlOfs, SEEK_SET );
+            if ( fread( &aModels[0], 1, iMdlLen, f ) != (size_t)iMdlLen )
+                aModels.clear();
+        }
+    }
+    fclose( f );
+
+    size_t iPos = 0;
+    while ( ( iPos = sEnts.find( '{', iPos ) ) != std::string::npos )
+    {
+        size_t iEnd = sEnts.find( '}', iPos );
+        if ( iEnd == std::string::npos )
+            break;
+        CBspEntity cEnt;
+        cEnt.bBrush = false;
+        cEnt.vOrigin.Init();
+        // "key" "value" pairs.
+        size_t q = iPos;
+        while ( true )
+        {
+            size_t k0 = sEnts.find( '"', q );
+            if ( k0 == std::string::npos || k0 > iEnd ) break;
+            size_t k1 = sEnts.find( '"', k0 + 1 );
+            size_t v0 = sEnts.find( '"', k1 + 1 );
+            size_t v1 = sEnts.find( '"', v0 + 1 );
+            if ( v1 == std::string::npos || v1 > iEnd ) break;
+            cEnt.aKeys.insert( std::make_pair( sEnts.substr( k0 + 1, k1 - k0 - 1 ), sEnts.substr( v0 + 1, v1 - v0 - 1 ) ) );
+            q = v1 + 1;
+        }
+        iPos = iEnd;
+        sscanf( cEnt.Get( "origin", "0 0 0" ), "%f %f %f", &cEnt.vOrigin.x, &cEnt.vOrigin.y, &cEnt.vOrigin.z );
+        const char* szModel = cEnt.Get( "model" );
+        int iModel = ( szModel[0] == '*' ) ? atoi( szModel + 1 ) : -1;
+        if ( iModel >= 0 && ( iModel + 1 ) * 12 <= (int)aModels.size() )
+        {
+            cEnt.bBrush = true;
+            const float* m = &aModels[ iModel * 12 ];
+            cEnt.vMins.Init( m[0] + cEnt.vOrigin.x, m[1] + cEnt.vOrigin.y, m[2] + cEnt.vOrigin.z );
+            cEnt.vMaxs.Init( m[3] + cEnt.vOrigin.x, m[4] + cEnt.vOrigin.y, m[5] + cEnt.vOrigin.z );
+        }
+        m_aEntities.push_back( cEnt );
+    }
+    return m_aEntities;
+}
+
+
+int sgtls::AddAnalyzeSeeds()
+{
+    // sgtls, then StargateTC 2 (spawns, objective points, artefacts, gates and their DHD).
+    static const char* aSeedClasses[] = { "info_player_teamspawn", "info_player_start", "info_player_deathmatch",
+                                          "info_tls_objective", "info_player_tauri", "info_player_goa",
+                                          "objective_trigger_filter", "bfl_objectivepoint_tauri",
+                                          "bfl_objectivepoint_goa", "point_artifact", "weapon_artfact", "point_balise",
+                                          "bfl_dhdbutton" };
+    float fEye = CMod::GetVar( EModVarPlayerEye );
+    int iCount = 0;
+    const std::vector<CBspEntity>& aEnts = BspEntities();
+    for ( size_t i = 0; i < aEnts.size(); ++i )
+    {
+        const char* szClass = aEnts[i].Get( "classname" );
+        for ( int c = 0; c < sizeof(aSeedClasses) / sizeof(aSeedClasses[0]); ++c )
+            if ( strcmp( szClass, aSeedClasses[c] ) == 0 )
+            {
+                Vector v = aEnts[i].vOrigin;
+                v.z += fEye;
+                CWaypoints::AnalyzeAddVector( GroundEye( v ) );
+                ++iCount;
+            }
+    }
+
+    // Where button-operated teleporters lead: the spots 160 to 320 units around the destination that a player walks
+    // to from there, out of the deadly volumes (tls_lockdown's SGC gate room: closed by blast doors, the analysis
+    // never got in, and the gate's ramp is in its kawoosh volume; one spot beside the ramp led only to a corner).
+    const std::vector<CButtonTeleporter>& aTeleporters = ButtonTeleporters();
+    for ( size_t i = 0; i < aTeleporters.size(); ++i )
+    {
+        const Vector& vExit = aTeleporters[i].vExit;
+        for ( float fDist = 160.0f; fDist <= 320.0f; fDist += 80.0f )
+            for ( int a = 0; a < 8; ++a )
+            {
+                float fAngle = a * 3.14159265f / 4.0f;
+                Vector vOut = GroundEye( vExit + Vector( cos( fAngle ), sin( fAngle ), 0.0f ) * fDist ), vTo = vOut;
+                bool bCrouch = false;
+                if ( fabs( vOut.z - vExit.z ) > 160.0f || IsForbidden( vOut ) )
+                    continue;
+                TReach iReach = CUtil::GetReachableInfoFromTo( vExit, vTo, bCrouch, 0, 1e9f, false );
+                if ( iReach == EReachNotReachable || iReach == EReachFallDamage || bCrouch )
+                    continue;
+                CWaypoints::AnalyzeAddVector( vOut );
+                ++iCount;
+            }
+    }
+    return iCount;
+}
+
+
+std::string sgtls::PostProcessWaypoints()
+{
+    const std::vector<CBspEntity>& aEnts = BspEntities();
+    float fEye = CMod::GetVar( EModVarPlayerEye );
+
+    std::map<std::string, const CBspEntity*> aNamed;
+    for ( size_t i = 0; i < aEnts.size(); ++i )
+        if ( aEnts[i].Get( "targetname" )[0] )
+            aNamed[ aEnts[i].Get( "targetname" ) ] = &aEnts[i];
+
+    // Active teleporters (deadly ones, which send to a "killbox", are in ForbiddenBoxes()).
+    const std::vector<const CBspEntity*>& aKill = ForbiddenBoxes();
+    std::vector<const CBspEntity*> aLinks;
+    for ( size_t i = 0; i < aEnts.size(); ++i )
+    {
+        const CBspEntity& e = aEnts[i];
+        if ( e.bBrush && strcmp( e.Get( "classname" ), "trigger_teleport" ) == 0 && !IsKillTeleport( e ) &&
+             strcmp( e.Get( "StartDisabled" ), "1" ) != 0 && aNamed.count( e.Get( "target" ) ) )
+            aLinks.push_back( &e );
+    }
+
+    int iCreated = 0, iLinked = 0;
+    char szBuf[512];
+    std::string sResult;
+    // 1. Remove waypoints inside deadly volumes (eye or feet inside, with a hull margin), then paths that cross them.
+    std::vector<TWaypointId> aRemove;
+    for ( TWaypointId w = 0; w < CWaypoints::Size(); ++w )
+    {
+        Vector vEye = CWaypoints::Get( w ).vOrigin, vFeet = vEye;
+        vFeet.z -= fEye - 4.0f;
+        for ( size_t k = 0; k < aKill.size(); ++k )
+            if ( InsideDeadly( vEye, *aKill[k] ) || InsideDeadly( vFeet, *aKill[k] ) )
+            {
+                aRemove.push_back( w );
+                break;
+            }
+    }
+    for ( int i = (int)aRemove.size() - 1; i >= 0; --i )
+        CWaypoints::Remove( aRemove[i], false );
+
+    int iPathsRemoved = 0;
+    good::vector<TWaypointId> aTargets;
+    for ( TWaypointId w = 0; w < CWaypoints::Size(); ++w )
+    {
+        aTargets.clear();
+        CWaypoints::GetPathTargets( w, aTargets );
+        const Vector& a = CWaypoints::Get( w ).vOrigin;
+        for ( int t = 0; t < aTargets.size(); ++t )
+        {
+            const Vector& b = CWaypoints::Get( aTargets[t] ).vOrigin;
+            Vector aFeet = a, bFeet = b;
+            aFeet.z -= fEye - 4.0f;
+            bFeet.z -= fEye - 4.0f;
+            for ( size_t k = 0; k < aKill.size(); ++k )
+                if ( SegmentHitsDeadly( a, b, *aKill[k] ) || SegmentHitsDeadly( aFeet, bFeet, *aKill[k] ) )
+                {
+                    CWaypoints::RemovePath( w, aTargets[t] );
+                    ++iPathsRemoved;
+                    break;
+                }
+        }
+    }
+
+    // 1d. Fires burning for good (env_fire on from the start with infinite fuel, spawnflags 1 + 4): tls_lockdown's
+    // corridor east of the gate room had its only waypoints 12 to 66 units from three fires, bots burned there (13
+    // deaths in 8 minutes, 2026-10-28) while a player walks past them. Remove the waypoints and paths within reach
+    // (the SDK's damage radius is firesize / 2 at full heat, plus half a player and a little), then link the
+    // waypoints around a fire whose straight path keeps out of reach, if Botrix finds them reachable.
+    int iFireRemoved = 0, iFireBypass = 0;
+    {
+        struct CFireZone { Vector2D vCenter; float fMinZ, fMaxZ, fReach; };
+        std::vector<CFireZone> aFires;
+        for ( size_t i = 0; i < aEnts.size(); ++i )
+        {
+            const CBspEntity& e = aEnts[i];
+            if ( strcmp( e.Get( "classname" ), "env_fire" ) != 0 || ( atoi( e.Get( "spawnflags", "0" ) ) & 5 ) != 5 )
+                continue;
+            float fSize = atof( e.Get( "firesize", "64" ) );
+            CFireZone z = { e.vOrigin.AsVector2D(), e.vOrigin.z, e.vOrigin.z + fSize + fEye, fSize * 0.5f + 24.0f };
+            aFires.push_back( z );
+        }
+        // Shortest distance from the fires (at that height) to the segment a -> b, on the ground plane.
+        struct CFireDistance
+        {
+            static float Get( const std::vector<CFireZone>& aFires, const Vector& a, const Vector& b, float& fReach )
+            {
+                float fBest = 1e9f;
+                for ( size_t k = 0; k < aFires.size(); ++k )
+                {
+                    const CFireZone& z = aFires[k];
+                    if ( ( a.z < z.fMinZ || a.z > z.fMaxZ ) && ( b.z < z.fMinZ || b.z > z.fMaxZ ) )
+                        continue;
+                    Vector2D vA = a.AsVector2D(), vAB = b.AsVector2D() - vA;
+                    float fLengthSqr = vAB.LengthSqr();
+                    float f = fLengthSqr > 0.0f ? clamp( ( z.vCenter - vA ).Dot( vAB ) / fLengthSqr, 0.0f, 1.0f ) : 0.0f;
+                    float d = ( vA + vAB * f - z.vCenter ).Length() - z.fReach;
+                    if ( d < fBest )
+                    {
+                        fBest = d;
+                        fReach = z.fReach;
+                    }
+                }
+                return fBest; // < 0: within reach.
+            }
+        };
+        if ( aFires.size() )
+        {
+            float fReach;
+            for ( int w = CWaypoints::Size() - 1; w >= 0; --w )
+                if ( CFireDistance::Get( aFires, CWaypoints::Get( w ).vOrigin, CWaypoints::Get( w ).vOrigin, fReach ) < 0.0f )
+                {
+                    CWaypoints::Remove( w, false );
+                    ++iFireRemoved;
+                }
+            for ( TWaypointId w = 0; w < CWaypoints::Size(); ++w )
+            {
+                aTargets.clear();
+                CWaypoints::GetPathTargets( w, aTargets );
+                for ( int t = 0; t < aTargets.size(); ++t )
+                    if ( CFireDistance::Get( aFires, CWaypoints::Get( w ).vOrigin, CWaypoints::Get( aTargets[t] ).vOrigin, fReach ) < 0.0f )
+                    {
+                        CWaypoints::RemovePath( w, aTargets[t] );
+                        ++iPathsRemoved;
+                    }
+            }
+            std::vector<TWaypointId> aNear;
+            for ( TWaypointId w = 0; w < CWaypoints::Size(); ++w )
+                if ( CFireDistance::Get( aFires, CWaypoints::Get( w ).vOrigin, CWaypoints::Get( w ).vOrigin, fReach ) < 160.0f )
+                    aNear.push_back( w );
+            for ( size_t i = 0; i < aNear.size(); ++i )
+                for ( size_t j = i + 1; j < aNear.size(); ++j )
+                {
+                    TWaypointId a = aNear[i], b = aNear[j];
+                    const Vector& va = CWaypoints::Get( a ).vOrigin;
+                    const Vector& vb = CWaypoints::Get( b ).vOrigin;
+                    if ( va.DistToSqr( vb ) > 224.0f * 224.0f || CWaypoints::HasPath( a, b ) ||
+                         CFireDistance::Get( aFires, va, vb, fReach ) < 8.0f )
+                        continue;
+                    CWaypoints::CreatePathsWithAutoFlags( a, b, false, 240, false );
+                    if ( CWaypoints::HasPath( a, b ) )
+                        ++iFireBypass;
+                }
+        }
+    }
+
+    // 1c. StargateTC 2: too steep slopes. The analysis climbs displacement terrain in 18-unit stair steps, but a
+    // player slides down ground steeper than ~45 degrees (ground normal z < 0.7): ah_forest's DHD hill had paths up
+    // a 50-60 degree side, where bots stay stuck for minutes. Remove the uphill paths that cross 16 units (two
+    // samples in a row) of such ground, or that climb mostly on terrain (displacements) steeper than 40 degrees
+    // (normal z < 0.77): a 43-45 degree side is walkable on paper, bots slid down it below their waypoint. Every
+    // 8 units: 16-unit samples missed the 61 degree bands of ah_forest's DHD hill (2026-10-28, the user saw the
+    // artefact carriers stuck there instead of taking the stairs). Level paths across such a side (24 units in a
+    // row steeper than 45 degrees: the hill had paths along a 54 degree side) go too. Downhill paths stay: sliding
+    // down is fine.
+    // A removed path whose end the bot can't reach any other way is put back afterwards, least steep first: removing
+    // them all left ah_forest's plateaus reachable only downhill (370 waypoints); the artefact fell on one and every
+    // bot searched an impossible path to it until the watchdog killed it (120 kills in 7 minutes, 2026-10-28).
+    int iSteepRemoved = 0, iSteepRestored = 0;
+#ifdef BOTRIX_SGTC2
+    {
+        struct CSteepPath { TWaypointId a, b; TPathFlags iFlags; float fScore; };
+        std::vector<CSteepPath> aSteep;
+        const float fSample = 8.0f;
+        for ( TWaypointId w = 0; w < CWaypoints::Size(); ++w )
+        {
+            aTargets.clear();
+            CWaypoints::GetPathTargets( w, aTargets );
+            const Vector& a = CWaypoints::Get( w ).vOrigin;
+            for ( int t = 0; t < aTargets.size(); ++t )
+            {
+                const Vector& b = CWaypoints::Get( aTargets[t] ).vOrigin;
+                if ( b.z - a.z < -16.0f )
+                    continue;
+                bool bUphill = ( b.z - a.z >= 16.0f );
+                int iSteps = (int)( ( b - a ).Length2D() / fSample ) + 1, iSteepRow = 0, iGround = 0, iSteepTerrain = 0;
+                int iTooSteep = 0;
+                bool bSteep = false;
+                for ( int i = 0; i <= iSteps && !bSteep; ++i )
+                {
+                    Vector v = a + ( b - a ) * ( (float)i / iSteps );
+                    v.z += 32.0f;
+                    CUtil::GetGroundVec( v );
+                    const trace_t& tr = CUtil::TraceResult();
+                    if ( tr.startsolid || tr.fraction >= 1.0f )
+                    {
+                        iSteepRow = 0;
+                        continue;
+                    }
+                    ++iGround;
+                    if ( ( tr.dispFlags & DISPSURF_FLAG_SURFACE ) && tr.plane.normal.z < 0.77f )
+                        ++iSteepTerrain;
+                    iSteepRow = ( tr.plane.normal.z < 0.7f ) ? iSteepRow + 1 : 0;
+                    iTooSteep += ( tr.plane.normal.z < 0.7f ) ? 1 : 0;
+                    bSteep = ( iSteepRow >= ( bUphill ? 2 : 3 ) );
+                }
+                if ( !bSteep && bUphill && iGround > 0 && iSteepTerrain * 2 >= iGround )
+                    bSteep = true;
+                if ( bSteep )
+                {
+                    CWaypointPath* pPath = CWaypoints::GetPath( w, aTargets[t] );
+                    CSteepPath cPath = { w, aTargets[t], pPath ? pPath->iFlags : (TPathFlags)0,
+                                         ( iTooSteep * 2.0f + iSteepTerrain ) / ( iGround > 0 ? iGround : 1 ) };
+                    aSteep.push_back( cPath );
+                    CWaypoints::RemovePath( w, aTargets[t] );
+                    ++iSteepRemoved;
+                }
+            }
+        }
+
+        // Put back, least steep first, the removed paths whose end is no longer reachable from their start.
+        for ( size_t i = 1; i < aSteep.size(); ++i ) // Insertion sort by score: a few thousand paths at most.
+            for ( size_t j = i; j > 0 && aSteep[j].fScore < aSteep[j - 1].fScore; --j )
+                std::swap( aSteep[j], aSteep[j - 1] );
+        std::vector<int> aSeen( CWaypoints::Size(), -1 );
+        std::vector<TWaypointId> aStack;
+        for ( size_t k = 0; k < aSteep.size(); ++k )
+        {
+            const CSteepPath& c = aSteep[k];
+            bool bReached = false;
+            aStack.clear();
+            aStack.push_back( c.a );
+            aSeen[ c.a ] = (int)k;
+            while ( !aStack.empty() && !bReached )
+            {
+                TWaypointId u = aStack.back();
+                aStack.pop_back();
+                aTargets.clear();
+                CWaypoints::GetPathTargets( u, aTargets );
+                for ( int t = 0; t < aTargets.size(); ++t )
+                    if ( aSeen[ aTargets[t] ] != (int)k )
+                    {
+                        if ( aTargets[t] == c.b )
+                        {
+                            bReached = true;
+                            break;
+                        }
+                        aSeen[ aTargets[t] ] = (int)k;
+                        aStack.push_back( aTargets[t] );
+                    }
+            }
+            if ( !bReached )
+            {
+                CWaypoints::AddPath( c.a, c.b, CWaypoints::Get( c.a ).vOrigin.DistTo( CWaypoints::Get( c.b ).vOrigin ), c.iFlags );
+                ++iSteepRestored;
+            }
+        }
+        iSteepRemoved -= iSteepRestored;
+    }
+#endif
+
+    // 1b. Spawn islands: the analysis misses some exits (tls_lockdown: the Tau'ri spawn room's only exit is a window,
+    // a func_breakable_surf, over a storage room). For each small component holding a spawn, try Botrix's
+    // reachability test (walk / jump / fall), going through windows (bots shoot them, CBot_SGTLS::BreakGlass),
+    // towards the waypoints of other components within 260 units.
+    int iRepaired = 0;
+    {
+        int n = CWaypoints::Size();
+        std::vector<int> aComp( n, -1 ), aCompSize;
+        std::vector< std::vector<TWaypointId> > aUndirected( n );
+        for ( TWaypointId w = 0; w < n; ++w )
+        {
+            good::vector<TWaypointId> aOut;
+            CWaypoints::GetPathTargets( w, aOut );
+            for ( int t = 0; t < aOut.size(); ++t )
+            {
+                aUndirected[w].push_back( aOut[t] );
+                aUndirected[aOut[t]].push_back( w );
+            }
+        }
+        for ( TWaypointId w = 0; w < n; ++w )
+        {
+            if ( aComp[w] >= 0 )
+                continue;
+            int iComp = (int)aCompSize.size(), iSize = 0;
+            std::vector<TWaypointId> aStack( 1, w );
+            aComp[w] = iComp;
+            while ( !aStack.empty() )
+            {
+                TWaypointId u = aStack.back();
+                aStack.pop_back();
+                ++iSize;
+                for ( size_t k = 0; k < aUndirected[u].size(); ++k )
+                    if ( aComp[ aUndirected[u][k] ] < 0 )
+                    {
+                        aComp[ aUndirected[u][k] ] = iComp;
+                        aStack.push_back( aUndirected[u][k] );
+                    }
+            }
+            aCompSize.push_back( iSize );
+        }
+        // Also the small components holding an objective (tls_lockdown: the breaker room, whose doorway the 64-unit
+        // analysis missed because a prop is close to the line between two waypoints).
+        static const char* aRepairClasses[] = { "info_player_teamspawn", "info_tls_objective", "func_hold_button",
+                                                "trigger_tls_capture_area" };
+        std::vector<bool> aRepair( aCompSize.size(), false );
+        for ( size_t i = 0; i < aEnts.size(); ++i )
+        {
+            bool bKey = false;
+            for ( int c = 0; c < sizeof(aRepairClasses) / sizeof(aRepairClasses[0]); ++c )
+                bKey = bKey || strcmp( aEnts[i].Get( "classname" ), aRepairClasses[c] ) == 0;
+            if ( !bKey )
+                continue;
+            Vector v = aEnts[i].bBrush ? ( aEnts[i].vMins + aEnts[i].vMaxs ) * 0.5f : aEnts[i].vOrigin;
+            v.z += fEye;
+            TWaypointId w = CWaypoints::GetNearestWaypoint( v, NULL, false, 128.0f );
+            if ( CWaypoint::IsValid( w ) && aCompSize[ aComp[w] ] * 4 < n )
+                aRepair[ aComp[w] ] = true;
+        }
+        const float fRepairDistance = 260.0f;
+        // Through windows, and through the doors that the map opens (named ones): tls_lockdown's gate room is behind
+        // BlastDoorA1, which the bomb objective opens. A bot only heads there for an active objective, which the map
+        // enables when it opens the door.
+        CUtil::bPassGlass = true;
+        // Also the breakables that the map breaks itself (an output "<name>,Break"): tls_abydos's
+        // objective1closewall, broken when objective1_CapArea is captured, is the only way from the Goa'uld side to
+        // the next area.
+        std::set<std::string> aBrokenByMap;
+        for ( size_t i = 0; i < aEnts.size(); ++i )
+            for ( std::multimap<std::string, std::string>::const_iterator it = aEnts[i].aKeys.begin();
+                  it != aEnts[i].aKeys.end(); ++it )
+            {
+                size_t iComma = it->second.find( ',' );
+                if ( it->first.compare( 0, 2, "On" ) == 0 && iComma != std::string::npos &&
+                     it->second.compare( iComma, 7, ",Break," ) == 0 )
+                    aBrokenByMap.insert( it->second.substr( 0, iComma ) );
+            }
+        CUtil::aPassModels.clear();
+        for ( size_t i = 0; i < aEnts.size(); ++i )
+        {
+            const char* szClass = aEnts[i].Get( "classname" );
+            if ( aEnts[i].bBrush && aEnts[i].Get( "targetname" )[0] && aEnts[i].Get( "model" )[0] == '*' &&
+                 ( strcmp( szClass, "func_door" ) == 0 || strcmp( szClass, "func_door_rotating" ) == 0 ||
+                   strcmp( szClass, "func_movelinear" ) == 0 ||
+                   ( strcmp( szClass, "func_breakable" ) == 0 && aBrokenByMap.count( aEnts[i].Get( "targetname" ) ) ) ) )
+                CUtil::aPassModels.push_back( aEnts[i].Get( "model" ) );
+        }
+        std::vector<bool> aLinked( aCompSize.size(), false );
+        for ( TWaypointId a = 0; a < n; ++a )
+        {
+            if ( !aRepair[ aComp[a] ] )
+                continue;
+            const Vector va = CWaypoints::Get( a ).vOrigin;
+            for ( TWaypointId b = 0; b < n; ++b )
+                if ( aComp[b] != aComp[a] && va.DistToSqr( CWaypoints::Get( b ).vOrigin ) < fRepairDistance * fRepairDistance &&
+                     !CWaypoints::HasPath( a, b ) )
+                {
+                    CWaypoints::CreatePathsWithAutoFlags( a, b, false, (int)fRepairDistance + 10, false );
+                    // Higher than a crouched jump and not a jump: a way down only (tls_lockdown's SGC control room
+                    // window, 85 units above the gate room floor: bots went for it from below and never made it).
+                    for ( int k = 0; k < 2; ++k )
+                    {
+                        TWaypointId wFrom = k ? b : a, wTo = k ? a : b;
+                        CWaypointPath* pUp = CWaypoints::GetPath( wFrom, wTo );
+                        if ( pUp && !FLAG_SOME_SET( FPathJump, pUp->iFlags ) &&
+                             CWaypoints::Get( wTo ).vOrigin.z - CWaypoints::Get( wFrom ).vOrigin.z >
+                             CMod::GetVar( EModVarPlayerJumpHeightCrouched ) )
+                            CWaypoints::RemovePath( wFrom, wTo );
+                    }
+                    KeepPaths( a, b );
+                    if ( CWaypoints::HasPath( a, b ) )
+                    {
+                        ++iRepaired;
+                        aLinked[ aComp[a] ] = true;
+                    }
+                }
+        }
+
+        // Narrow doorways between two lines of the grid (tls_lockdown's breaker room: a gap between two props, half
+        // way between waypoints 64 units apart, that a player passes only going straight): for the repaired
+        // components still cut off, try close pairs a, b shifted sideways by the same amount: a -> a' (sideways),
+        // a' -> b' (through the gap), b' -> b.
+        for ( TWaypointId a = 0; a < n; ++a )
+        {
+            if ( !aRepair[ aComp[a] ] || aLinked[ aComp[a] ] )
+                continue;
+            const Vector va = CWaypoints::Get( a ).vOrigin;
+            for ( TWaypointId b = 0; b < n && !aLinked[ aComp[a] ]; ++b )
+            {
+                const Vector vb = CWaypoints::Get( b ).vOrigin;
+                if ( aComp[b] == aComp[a] || va.DistToSqr( vb ) > fRepairDistance * fRepairDistance ||
+                     vb.z - va.z > 64.0f || va.z - vb.z > 160.0f )
+                    continue;
+                Vector vSide( va.y - vb.y, vb.x - va.x, 0.0f );
+                vSide.NormalizeInPlace();
+                for ( int s = -7; s <= 7; ++s )
+                {
+                    if ( s == 0 )
+                    {
+                        // A step in the middle: a 128-unit grid on uneven ground has hops too long for the walk test
+                        // (tls_erebus, the Goa'uld first spawn).
+                        Vector vM = GroundEye( ( va + vb ) * 0.5f ), v1 = vM, v2 = vb;
+                        bool bCrouch = false;
+                        if ( CUtil::GetReachableInfoFromTo( va, v1, bCrouch, 0, 1e9f, false ) != EReachReachable || bCrouch ||
+                             CUtil::GetReachableInfoFromTo( vM, v2, bCrouch, 0, 1e9f, false ) != EReachReachable || bCrouch )
+                            continue;
+                        TWaypointId wM = CWaypoints::Add( vM );
+                        ++iCreated;
+                        CWaypoints::CreatePathsWithAutoFlags( a, wM, false, (int)fRepairDistance + 10, false );
+                        CWaypoints::CreatePathsWithAutoFlags( wM, b, false, (int)fRepairDistance + 10, false );
+                        KeepPaths( a, wM );
+                        KeepPaths( wM, b );
+                        ++iRepaired;
+                        aLinked[ aComp[a] ] = true;
+                        snprintf( szBuf, sizeof(szBuf), "  step: waypoint %d (%.0f %.0f %.0f) between %d and %d\n", wM,
+                                  vM.x, vM.y, vM.z, a, b );
+                        sResult += szBuf;
+                        break;
+                    }
+                    Vector vA = GroundEye( va + vSide * ( s * 8.0f ) ), vB = GroundEye( vb + vSide * ( s * 8.0f ) );
+                    Vector v1 = vA, v2 = vB, v3 = vb;
+                    bool bCrouch = false;
+                    if ( CUtil::GetReachableInfoFromTo( va, v1, bCrouch, 0, 1e9f, false ) != EReachReachable || bCrouch ||
+                         CUtil::GetReachableInfoFromTo( vA, v2, bCrouch, 0, 1e9f, false ) != EReachReachable || bCrouch ||
+                         CUtil::GetReachableInfoFromTo( vB, v3, bCrouch, 0, 1e9f, false ) != EReachReachable || bCrouch )
+                        continue;
+                    TWaypointId wA = CWaypoints::Add( vA ), wB = CWaypoints::Add( vB );
+                    iCreated += 2;
+                    CWaypoints::CreatePathsWithAutoFlags( a, wA, false, (int)fRepairDistance + 10, false );
+                    CWaypoints::CreatePathsWithAutoFlags( wA, wB, false, (int)fRepairDistance + 10, false );
+                    CWaypoints::CreatePathsWithAutoFlags( wB, b, false, (int)fRepairDistance + 10, false );
+                    KeepPaths( a, wA );
+                    KeepPaths( wA, wB );
+                    KeepPaths( wB, b );
+                    ++iRepaired;
+                    aLinked[ aComp[a] ] = true;
+                    snprintf( szBuf, sizeof(szBuf), "  doorway: waypoints %d (%.0f %.0f %.0f) -> %d (%.0f %.0f %.0f), "
+                              "between %d and %d\n", wA, vA.x, vA.y, vA.z, wB, vB.x, vB.y, vB.z, a, b );
+                    sResult += szBuf;
+                    break;
+                }
+            }
+        }
+
+        // Islands still cut off: a finer search from their waypoints, in 32-unit steps that the walk test passes
+        // (walking, climbing stairs, jumping or falling), until a waypoint of a bigger island is in reach; then
+        // waypoints along the way found. tls_erebus: the temple spawn's only way out is a narrow ramp, a 170-unit drop
+        // and a winding corridor, that the 96-unit grid missed.
+        for ( size_t c = 0; c < aCompSize.size(); ++c )
+        {
+            if ( !aRepair[c] || aLinked[c] )
+                continue;
+            const int iMaxNodes = 6000;
+            std::vector<Vector> aNodes;
+            std::vector<int> aPrev;
+            std::vector<TWaypointId> aStart;
+            std::set<long long> aSeen;
+            for ( TWaypointId w = 0; w < n; ++w )
+                if ( aComp[w] == (int)c )
+                {
+                    aNodes.push_back( CWaypoints::Get( w ).vOrigin );
+                    aPrev.push_back( -1 );
+                    aStart.push_back( w );
+                    aSeen.insert( CellKey( aNodes.back() ) );
+                }
+            int iFound = -1;
+            TWaypointId wTarget = EWaypointIdInvalid;
+            TPathFlags iTargetFlags = FPathNone;
+            for ( size_t i = 0; i < aNodes.size() && (int)aNodes.size() < iMaxNodes && iFound < 0; ++i )
+                for ( int d = 0; d < 8 && iFound < 0; ++d )
+                {
+                    float fAngle = d * 3.14159265f / 4.0f;
+                    Vector vNode = aNodes[i];
+                    Vector v = GroundEye( vNode + Vector( cos( fAngle ), sin( fAngle ), 0.0f ) * 32.0f );
+                    if ( vNode.z - v.z > 400.0f || v.z - vNode.z > 64.0f || aSeen.count( CellKey( v ) ) || IsForbidden( v ) )
+                        continue;
+                    Vector vTo = v;
+                    bool bCrouch = false;
+                    TReach iReach = CUtil::GetReachableInfoFromTo( vNode, vTo, bCrouch, 0, 1e9f, false );
+                    if ( iReach == EReachNotReachable || bCrouch )
+                        continue;
+                    aSeen.insert( CellKey( v ) );
+                    aNodes.push_back( v );
+                    aPrev.push_back( (int)i );
+                    TWaypointId wNear = CWaypoints::GetNearestWaypoint( v, NULL, false, 64.0f );
+                    if ( !CWaypoint::IsValid( wNear ) || wNear >= n || aCompSize[ aComp[wNear] ] <= aCompSize[c] )
+                        continue;
+                    vTo = CWaypoints::Get( wNear ).vOrigin;
+                    iReach = CUtil::GetReachableInfoFromTo( v, vTo, bCrouch, 0, 1e9f, false );
+                    if ( iReach == EReachNotReachable || bCrouch )
+                        continue;
+                    iFound = (int)aNodes.size() - 1;
+                    wTarget = wNear;
+                    iTargetFlags = ( iReach == EReachNeedJump ) ? FPathJump : ( iReach == EReachFallDamage ) ? FPathDamage : FPathNone;
+                }
+            if ( iFound < 0 )
+            {
+                snprintf( szBuf, sizeof(szBuf), "  island of %d waypoints: no way out found (%d spots)\n", aCompSize[c],
+                          (int)aNodes.size() );
+                sResult += szBuf;
+                continue;
+            }
+
+            // The way, from the island's waypoint to the spot next to the target.
+            std::vector<int> aWay;
+            for ( int k = iFound; k >= 0; k = aPrev[k] )
+                aWay.push_back( k );
+            std::reverse( aWay.begin(), aWay.end() );
+            TWaypointId wPrev = aStart[ aWay[0] ];
+            Vector vPrev = aNodes[ aWay[0] ];
+            int iAdded = 0;
+            for ( size_t i = 1; i < aWay.size(); )
+            {
+                // The farthest spot (5 steps at most) reached in a straight line: fewer waypoints.
+                size_t j = i;
+                for ( size_t k = i + 1; k < aWay.size() && k <= i + 4; ++k )
+                {
+                    Vector vTo = aNodes[ aWay[k] ];
+                    bool bCrouch = false;
+                    TReach iReach = CUtil::GetReachableInfoFromTo( vPrev, vTo, bCrouch, 0, 1e9f, false );
+                    if ( iReach == EReachNotReachable || bCrouch )
+                        break;
+                    j = k;
+                }
+                Vector vTo = aNodes[ aWay[j] ];
+                bool bCrouch = false;
+                TReach iReach = CUtil::GetReachableInfoFromTo( vPrev, vTo, bCrouch, 0, 1e9f, false );
+                TWaypointId w = CWaypoints::Add( aNodes[ aWay[j] ] );
+                ++iCreated;
+                ++iAdded;
+                CWaypoints::CreatePathsWithAutoFlags( wPrev, w, false, 1000, false );
+                if ( !CWaypoints::HasPath( wPrev, w ) )
+                    CWaypoints::AddPath( wPrev, w, vPrev.DistTo( aNodes[ aWay[j] ] ),
+                                         ( iReach == EReachNeedJump ) ? FPathJump : ( iReach == EReachFallDamage ) ? FPathDamage : FPathNone );
+                KeepPaths( wPrev, w );
+                wPrev = w;
+                vPrev = aNodes[ aWay[j] ];
+                i = j + 1;
+            }
+            CWaypoints::CreatePathsWithAutoFlags( wPrev, wTarget, false, 1000, false );
+            if ( !CWaypoints::HasPath( wPrev, wTarget ) )
+                CWaypoints::AddPath( wPrev, wTarget, vPrev.DistTo( CWaypoints::Get( wTarget ).vOrigin ), iTargetFlags );
+            KeepPaths( wPrev, wTarget );
+            ++iRepaired;
+            aLinked[c] = true;
+            snprintf( szBuf, sizeof(szBuf), "  island of %d waypoints: way out of %d steps (%d spots searched), %d "
+                      "waypoints added, to waypoint %d (%.0f %.0f %.0f)\n", aCompSize[c], (int)aWay.size() - 1,
+                      (int)aNodes.size(), iAdded, wTarget, CWaypoints::Get( wTarget ).vOrigin.x,
+                      CWaypoints::Get( wTarget ).vOrigin.y, CWaypoints::Get( wTarget ).vOrigin.z );
+            sResult += szBuf;
+        }
+
+        // Windows next to a spawn island, leading to another part of the map: the eye line from the room to the
+        // floor beyond can hit a ledge, so add a waypoint just past the window (tls_lockdown: a narrow ledge, then a
+        // drop into the storage room), a path to it from the nearest island waypoint, and its automatic paths onwards.
+        for ( size_t i = 0; i < aEnts.size(); ++i )
+        {
+            const CBspEntity& e = aEnts[i];
+            if ( !e.bBrush || strcmp( e.Get( "classname" ), "func_breakable_surf" ) != 0 )
+                continue;
+            Vector vSize = e.vMaxs - e.vMins, vCenter = ( e.vMins + e.vMaxs ) * 0.5f;
+            int iThin = ( vSize.x <= vSize.y && vSize.x <= vSize.z ) ? 0 : ( vSize.y <= vSize.z ? 1 : 2 );
+            if ( iThin == 2 || vSize.z < 72.0f )
+                continue; // Floor glass or too low for a player.
+            for ( int iSide = -1; iSide <= 1; iSide += 2 )
+            {
+                Vector vIn = vCenter, vOut = vCenter;
+                vIn[iThin] += iSide * 24.0f;
+                vOut[iThin] -= iSide * 24.0f;
+                vIn.z = vOut.z = e.vMins.z + 24.0f;
+                Vector vInEye = GroundEye( vIn ), vOutEye = GroundEye( vOut );
+                if ( fabs( vInEye.z - fEye - e.vMins.z ) > 24.0f || fabs( vOutEye.z - fEye - e.vMins.z ) > 24.0f )
+                    continue; // No floor at the window's bottom on both sides.
+                TWaypointId wIn = CWaypoints::GetNearestWaypoint( vInEye, NULL, false, 128.0f );
+                if ( !CWaypoint::IsValid( wIn ) || wIn >= n || !aRepair[ aComp[wIn] ] )
+                    continue;
+                // The other side must lead to another part of the map (not a window inside the island): waypoints of
+                // another component within 200 units, and none of the island on that side.
+                good::vector<TWaypointId> aAround;
+                CWaypoints::GetNearestWaypoints( aAround, vOutEye, false, 200.0f );
+                bool bOther = false, bSameBeyond = false;
+                for ( int k = 0; k < aAround.size(); ++k )
+                {
+                    if ( aAround[k] >= n )
+                        continue;
+                    float fSide = ( CWaypoints::Get( aAround[k] ).vOrigin[iThin] - vCenter[iThin] ) * iSide;
+                    if ( aComp[ aAround[k] ] != aComp[wIn] )
+                        bOther = true;
+                    else if ( fSide < 0.0f )
+                        bSameBeyond = true;
+                }
+                if ( !bOther || bSameBeyond )
+                    continue;
+                TWaypointId wOut = NearestOrNew( vOutEye, 16.0f, iCreated );
+                if ( CWaypoints::AddPath( wIn, wOut ) )
+                    ++iRepaired;
+                KeepPaths( wIn, wOut );
+                snprintf( szBuf, sizeof(szBuf), "  window (%.0f %.0f %.0f): spawn island waypoint %d -> %d (%.0f %.0f %.0f)\n",
+                          vCenter.x, vCenter.y, vCenter.z, wIn, wOut, vOutEye.x, vOutEye.y, vOutEye.z );
+                sResult += szBuf;
+            }
+        }
+        CUtil::bPassGlass = false;
+        CUtil::aPassModels.clear();
+    }
+
+    // 2. Link each active teleporter (after the cleanup: a link line can cross a killbox, e.g. gate 2 -> gate 1 exit).: waypoint inside the trigger -> waypoint at the destination, one way.
+    // Also the teleporters that a button turns on (CBot_SGTLS presses the button first): kept paths, the bots fail
+    // them while the teleporter is off.
+    const std::vector<CButtonTeleporter>& aButtonTeleporters = ButtonTeleporters();
+    for ( size_t i = 0; i < aLinks.size() + aButtonTeleporters.size(); ++i )
+    {
+        bool bButton = ( i >= aLinks.size() );
+        const CBspEntity& e = bButton ? *aButtonTeleporters[ i - aLinks.size() ].pTeleporter : *aLinks[i];
+        const CBspEntity& d = *aNamed[ e.Get( "target" ) ];
+        Vector vEntry, vExit;
+        LinkEnds( e, d, vEntry, vExit );
+
+        TWaypointId wEntry = NearestOrNew( vEntry, 24.0f, iCreated );
+        TWaypointId wExit = NearestOrNew( vExit, 64.0f, iCreated );
+        if ( CWaypoints::AddPath( wEntry, wExit, 50.0f ) ) // Teleporting is instant: cheap path.
+            ++iLinked;
+        CWaypointPath* pPath = CWaypoints::GetPath( wEntry, wExit );
+        if ( bButton && pPath )
+            FLAG_SET( FPathKeep, pPath->iFlags );
+        int iInto = ConnectLinkEnd( wEntry, true, wExit, iCreated ), iOut = ConnectLinkEnd( wExit, false, wEntry, iCreated );
+        char szConnected[64] = "";
+        if ( iInto || iOut )
+            snprintf( szConnected, sizeof(szConnected), ", connected: %d in, %d out", iInto, iOut );
+        snprintf( szBuf, sizeof(szBuf), "  link %s (%.0f %.0f %.0f) -> %s (%.0f %.0f %.0f): waypoints %d -> %d%s%s\n",
+                  e.Get( "targetname" ), vEntry.x, vEntry.y, vEntry.z, d.Get( "targetname" ), vExit.x, vExit.y, vExit.z,
+                  wEntry, wExit, bButton ? ", button-operated" : "", szConnected );
+        sResult += szBuf;
+    }
+
+    // 3. StargateTC 2: drop the islands without any spawn, stargate, DHD or objective. The analysis can leak under a
+    // displacement terrain (ah_forest: a 21000 waypoints grid below the map), and such islands only cost memory and
+    // the visibility table.
+    int iDropped = 0;
+#ifdef BOTRIX_SGTC2
+    {
+        static const char* aKeyClasses[] = { "info_player_tauri", "info_player_goa", "bfl_stargate", "bfl_dhdbutton",
+                                             "objective_trigger_filter", "bfl_objectivepoint_tauri",
+                                             "bfl_objectivepoint_goa" };
+        int n = CWaypoints::Size();
+        std::vector<int> aComp( n, -1 );
+        std::vector< std::vector<TWaypointId> > aUndirected( n );
+        for ( TWaypointId w = 0; w < n; ++w )
+        {
+            good::vector<TWaypointId> aOut;
+            CWaypoints::GetPathTargets( w, aOut );
+            for ( int t = 0; t < aOut.size(); ++t )
+            {
+                aUndirected[w].push_back( aOut[t] );
+                aUndirected[aOut[t]].push_back( w );
+            }
+        }
+        int iComps = 0;
+        for ( TWaypointId w = 0; w < n; ++w )
+        {
+            if ( aComp[w] >= 0 )
+                continue;
+            std::vector<TWaypointId> aStack( 1, w );
+            aComp[w] = iComps;
+            while ( !aStack.empty() )
+            {
+                TWaypointId u = aStack.back();
+                aStack.pop_back();
+                for ( size_t k = 0; k < aUndirected[u].size(); ++k )
+                    if ( aComp[ aUndirected[u][k] ] < 0 )
+                    {
+                        aComp[ aUndirected[u][k] ] = iComps;
+                        aStack.push_back( aUndirected[u][k] );
+                    }
+            }
+            ++iComps;
+        }
+        std::vector<bool> aKeep( iComps, false );
+        for ( size_t i = 0; i < aEnts.size(); ++i )
+            for ( int c = 0; c < sizeof(aKeyClasses) / sizeof(aKeyClasses[0]); ++c )
+                if ( strcmp( aEnts[i].Get( "classname" ), aKeyClasses[c] ) == 0 )
+                {
+                    Vector v = aEnts[i].bBrush ? ( aEnts[i].vMins + aEnts[i].vMaxs ) * 0.5f : aEnts[i].vOrigin;
+                    TWaypointId w = CWaypoints::GetNearestWaypoint( v + Vector( 0, 0, fEye ), NULL, false, 300.0f );
+                    if ( CWaypoint::IsValid( w ) )
+                        aKeep[ aComp[w] ] = true;
+                }
+        bool* aDrop = new bool[ n > 0 ? n : 1 ];
+        for ( TWaypointId w = 0; w < n; ++w )
+        {
+            aDrop[w] = !aKeep[ aComp[w] ];
+            iDropped += aDrop[w] ? 1 : 0;
+        }
+        if ( iDropped > 0 && iDropped < n )
+            CWaypoints::RemoveMany( aDrop );
+        else
+            iDropped = 0;
+        delete[] aDrop;
+    }
+#endif
+
+    snprintf( szBuf, sizeof(szBuf), "%d teleporters linked (%d waypoints created), %d deadly volumes: %d waypoints "
+              "and %d paths "
+             "removed, fires: %d waypoints removed and %d bypass paths, %d paths on too steep ground removed (%d put back: the only way up), %d paths out of spawn islands, %d waypoints in "
+             "islands without any spawn / gate / objective removed. Total %d waypoints.\n", iLinked, iCreated,
+             (int)aKill.size(), (int)aRemove.size(), iPathsRemoved, iFireRemoved, iFireBypass, iSteepRemoved, iSteepRestored, iRepaired, iDropped,
+             CWaypoints::Size() );
+    return sResult + szBuf;
+}
diff --git a/mods/sgtls/sgtls_map.h b/mods/sgtls/sgtls_map.h
new file mode 100644
index 0000000..263c4ca
--- /dev/null
+++ b/mods/sgtls/sgtls_map.h
@@ -0,0 +1,67 @@
+#ifndef __BOTRIX_SGTLS_MAP_H__
+#define __BOTRIX_SGTLS_MAP_H__
+
+// Map knowledge read from the BSP of the current sgtls map (its entity lump and brush models): spawns that
+// have no edict, stargates / rings (trigger_teleport) and their "killbox" triggers.
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include "vector.h" // public/ (episode1) or public/mathlib/ (Orange Box)
+
+namespace sgtls
+{
+    struct CBspEntity
+    {
+        std::multimap<std::string, std::string> aKeys;
+        Vector vOrigin;
+        bool bBrush;            ///< Has a brush model: vMins / vMaxs are its world bounds.
+        Vector vMins, vMaxs;
+
+        const char* Get( const char* szKey, const char* szDefault = "" ) const
+        {
+            std::multimap<std::string, std::string>::const_iterator it = aKeys.find( szKey );
+            return it == aKeys.end() ? szDefault : it->second.c_str();
+        }
+    };
+
+    /// Entities of the current map (read once per map).
+    const std::vector<CBspEntity>& BspEntities();
+
+    /// A teleporter that starts off and that a button turns on for good (tls_lockdown's gate 1: its DHD adds 1 to a
+    /// math_counter, whose OnHitMax enables the trigger_teleport).
+    struct CButtonTeleporter
+    {
+        const CBspEntity* pTeleporter;  ///< trigger_teleport.
+        const CBspEntity* pButton;      ///< func_button, the nearest one that turns it on.
+        int iPresses;                   ///< Presses needed (counter max - start value), 1 for a direct Enable.
+        float fKawoosh;                 ///< Seconds to wait once it is on: a deadly teleporter (stargate kawoosh) near its entry or exit.
+        Vector vEntry, vExit;           ///< Link positions (eye level): inside the trigger, at the destination.
+    };
+
+    /// Button-operated teleporters of the current map. Those that a button turns on only for a moment (tls_abydos's
+    /// rings: 0.04 s, 5 s after the press) aren't in the list.
+    const std::vector<CButtonTeleporter>& ButtonTeleporters();
+
+    /// Distance beyond which the map's fog hides everything (env_fog_controller fully opaque at fogend), 0 if none.
+    float FogSightDistance();
+
+    /// At map load: make the paths that pass within reach of a fire burning for good (env_fire) costly. Return the
+    /// count.
+    int AvoidFires();
+
+    /// True if a waypoint (eye level) would be in a deadly volume: killbox teleporter, enabled trigger_hurt.
+    /// Installed as CWaypoints::pfnAnalyzeForbidden.
+    bool IsForbidden( const Vector& vEye );
+
+    /// Add the spawn / objective origins as analysis seeds. Return the count.
+    int AddAnalyzeSeeds();
+
+    /// After the analysis: link active and button-operated stargates / teleporters to their destination with one-way
+    /// paths, and remove the waypoints and paths that go through a deadly teleporter (killbox). Return a summary for
+    /// the console.
+    std::string PostProcessWaypoints();
+}
+
+#endif // __BOTRIX_SGTLS_MAP_H__
