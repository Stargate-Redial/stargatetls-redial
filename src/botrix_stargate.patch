+void sgtls::Shutdown()
+{
+#ifndef BOTRIX_SOURCE_ENGINE_2006 // episode1's ICvar can't unregister a command.
+    for ( int i = 0; i < sizeof(aCommands) / sizeof(aCommands[0]); ++i )
+        CBotrixPlugin::pCVar->UnregisterConCommand( aCommands[i] );
+#endif
