+
+void sgtls::PassDoorsInAnalysis( bool bOn )
+{
+    CUtil::aPassModels.clear();
+    CUtil::aPassEdicts.clear();
+    CUtil::bPassModels = bOn;
+    const std::vector<CButtonDoor>& aDoors = ButtonDoors();
+    for ( size_t i = 0; bOn && i < aDoors.size(); ++i )
+        CUtil::aPassModels.push_back( aDoors[i].pDoor->Get( "model" ) );
+    // And what is parented to them (moves with them): tls_stargatecommandpost_b2's blast doors carry wheels and bars,
+    // unnamed func_door / func_door_rotating with parentname=doorhautmetal (60 on the map), that blocked the doorways.
+    std::set<std::string> aDoorNames;
+    for ( size_t i = 0; bOn && i < aDoors.size(); ++i )
+        if ( aDoors[i].pDoor->Get( "targetname" )[0] )
+            aDoorNames.insert( aDoors[i].pDoor->Get( "targetname" ) );
+    const std::vector<CBspEntity>& aParented = BspEntities();
+    for ( size_t i = 0; bOn && !aDoorNames.empty() && i < aParented.size(); ++i )
+        if ( aParented[i].bBrush && aDoorNames.count( aParented[i].Get( "parentname" ) ) )
+            CUtil::aPassModels.push_back( aParented[i].Get( "model" ) );
+    // Model doors (prop_door_rotating) that +use opens, not the locked ones (spawnflags 2048: nothing unlocks them on
+    // tls_outpost_17_b1_032, they are walls). Bots open them with +use when they bump into them (Botrix's door items,
+    // config.ini "prop_door_rotating = use"). tls_outpost_17_b1_032: the Tau'ri defenders stayed behind door_a11/a12.
+    const std::vector<CBspEntity>& aEnts = BspEntities();
+    IVEngineServer* pEngine = CBotrixPlugin::pEngineServer;
+    for ( size_t i = 0; bOn && i < aEnts.size(); ++i )
+    {
+        if ( strcmp( aEnts[i].Get( "classname" ), "prop_door_rotating" ) != 0 || ( atoi( aEnts[i].Get( "spawnflags" ) ) & 2048 ) )
+            continue;
+        for ( int e = 1; e < pEngine->GetEntityCount(); ++e )
+        {
+            edict_t* pEdict = pEngine->PEntityOfEntIndex( e );
+            if ( !pEdict || pEdict->IsFree() || !pEdict->GetCollideable() || !pEdict->GetClassName() ||
+                 strcmp( pEdict->GetClassName(), "prop_door_rotating" ) != 0 ||
+                 pEdict->GetCollideable()->GetCollisionOrigin().DistToSqr( aEnts[i].vOrigin ) > 16.0f )
+                continue;
+            CUtil::aPassEdicts.push_back( e );
+            break;
+        }
+    }
+}
