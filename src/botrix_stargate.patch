+
+int sgtls::CObjectives::GateToCross( TWaypointId wCurrent, TWaypointId wNext )
+{
+    Refresh();
+    const std::vector<sgtls::CButtonTeleporter>& aDefs = sgtls::ButtonTeleporters();
+    for ( size_t i = 0; i < m_aTeleporters.size() && i < aDefs.size(); ++i )
+    {
+        const sgtls::CButtonTeleporter& d = aDefs[i];
+        TWaypointId wEntry = m_aTeleporters[i].wEntry;
+        if ( d.bMomentary || d.iCrossAxis < 0 || ( d.fSafeDepth[0] <= 0.0f && d.fSafeDepth[1] <= 0.0f ) ||
+             !CWaypoint::IsValid( wEntry ) || ( wCurrent != wEntry && wNext != wEntry ) )
+            continue;
+        return TeleporterReady( (int)i ) ? (int)i : -1;
+    }
+    return -1;
+}
