+//----------------------------------------------------------------------------------------------------------------
+bool CBot_SGTLS::BreakGrate()
+{
+    // tls_stargate_atlantis_fixed: the air vents to the ZPM room are closed by grates (prop_physics, 100 kg, 15 health:
+    // they break). On a crouch path, a physics prop just ahead: knife it.
+    if ( !m_bNeedMove || m_pCurrentEnemy || !m_bUseNavigatorToMove || !CWaypoint::IsValid( iCurrentWaypoint ) ||
+         !CWaypoint::IsValid( iNextWaypoint ) || !CWeapons::IsValid( m_iMeleeWeapon ) )
+        return false;
+    CWaypointPath* pPath = CWaypoints::GetPath( iCurrentWaypoint, iNextWaypoint );
+    if ( !pPath || !FLAG_SOME_SET( FPathCrouch, pPath->iFlags ) )
+        return false;
+    Vector vDir = CWaypoints::Get( iNextWaypoint ).vOrigin - m_vHead;
+    vDir.z = 0.0f;
+    if ( vDir.NormalizeInPlace() < 1.0f )
+        return false;
+    int iSelf = CBotrixPlugin::pEngineServer->IndexOfEdict( m_pEdict );
+    CNotSelfFilter cFilter( iSelf );
+    const float aDown[3] = { 0.0f, 12.0f, 24.0f };
+    for ( int i = 0; i < 3; ++i )
+    {
+        Vector vStart = m_vHead;
+        vStart.z -= aDown[i];
+        Ray_t ray;
+        ray.Init( vStart, vStart + vDir * 64.0f );
+        trace_t tr;
+        CBotrixPlugin::pEngineTrace->TraceRay( ray, MASK_PLAYERSOLID, &cFilter, &tr );
+        if ( tr.fraction >= 1.0f || !tr.m_pEnt )
+            continue;
+        int iHit = reinterpret_cast<IHandleEntity*>( tr.m_pEnt )->GetRefEHandle().GetEntryIndex();
+        edict_t* pHit = CBotrixPlugin::pEngineServer->PEntityOfEntIndex( iHit );
+        if ( !pHit || pHit->IsFree() || strncmp( pHit->GetClassName(), "prop_physics", 12 ) != 0 )
+            continue;
+        // The Goa'uld hand device broke a grate; a bot's knife didn't (2026-11-10). So: a melee weapon other than the
+        // knife, else a gun that doesn't explode (zat, pistol, P90, G36, AWP: not the staff or the Kull, whose blast would
+        // hurt the bot this close), else the knife.
+        TWeaponId iMelee = -1, iGun = -1;
+        for ( int w = 0; w < (int)m_aWeapons.size(); ++w )
+        {
+            const CWeaponWithAmmo& cWeapon = m_aWeapons[w];
+            if ( !cWeapon.IsPresent() )
+                continue;
+            if ( cWeapon.IsMelee() && cWeapon.GetName() != "weapon_knife" )
+                iMelee = w;
+            else if ( cWeapon.IsRanged() && cWeapon.GetBaseWeapon()->fMinDistanceSqr[0] <= 0.0f &&
+                      ( cWeapon.Bullets( CWeapon::PRIMARY ) > 0 || cWeapon.ExtraBullets( CWeapon::PRIMARY ) > 0 ) )
+                iGun = w;
+        }
+        if ( iMelee < 0 )
+            iMelee = ( iGun >= 0 ) ? iGun : m_iMeleeWeapon;
+        if ( m_iWeapon != iMelee )
+        {
+            BLOG_I( "%s -> Breaking the %s in the way (%.0f %.0f %.0f) with %s.", GetName(), pHit->GetClassName(),
+                    tr.endpos.x, tr.endpos.y, tr.endpos.z, m_aWeapons[iMelee].GetName().c_str() );
+            ChangeWeapon( iMelee );
+        }
+        m_vLook = tr.endpos + vDir * 4.0f;
+        m_bNeedAim = true;
+        m_fEndAimTime = CBotrixPlugin::fTime + 0.2f;
+        if ( m_aWeapons[m_iWeapon].IsMelee() || m_aWeapons[m_iWeapon].CanUse() )
+            WeaponShoot(); // Melee: attack held, it swings again as soon as it can.
+        return true;
+    }
+    return false;
+}
+
+
+bool CBot_SGTLS::BreakGlass()
+{
+    if ( BreakGrate() )
+        return true;
+    // Not with blast weapons (staff, Kull: minimum range in config.ini): the splash would kill the bot.
+    if ( !m_bNeedMove || m_pCurrentEnemy || !CWeapons::IsValid( m_iWeapon ) ||
+         m_aWeapons[m_iWeapon].GetBaseWeapon()->fMinDistanceSqr[0] > 0.0f )
+    {
+        m_fGlassAimTime = 0.0f;
+        return false;
+    }
+
+    // Lines from the eye, the waist and the knees towards the next waypoint, 128 units at most: the first one that
+    // stops at a window gives the point to shoot (one hole at eye level isn't a way through).
+    const float aDown[3] = { 0.0f, 30.0f, 50.0f };
+    Vector vDir = m_vDestination - m_vHead;
+    vDir.z = 0.0f;
+    if ( vDir.NormalizeInPlace() < 1.0f )
+        return false;
+    int iSelf = CBotrixPlugin::pEngineServer->IndexOfEdict( m_pEdict );
+    CNotSelfFilter cFilter( iSelf );
+    for ( int i = 0; i < 3; ++i )
+    {
+        Vector vStart = m_vHead;
+        vStart.z -= aDown[i];
+        Ray_t ray;
+        ray.Init( vStart, vStart + vDir * 128.0f );
+        trace_t tr;
+        CBotrixPlugin::pEngineTrace->TraceRay( ray, MASK_PLAYERSOLID, &cFilter, &tr );
+        if ( tr.fraction >= 1.0f || !tr.m_pEnt )
+            continue;
+        // CBaseEntity derives from IHandleEntity alone (single inheritance): same address.
+        int iHit = reinterpret_cast<IHandleEntity*>( tr.m_pEnt )->GetRefEHandle().GetEntryIndex();
+        edict_t* pHit = CBotrixPlugin::pEngineServer->PEntityOfEntIndex( iHit );
+        if ( !pHit || pHit->IsFree() || strcmp( pHit->GetClassName(), "func_breakable_surf" ) != 0 )
+            continue;
+
+        if ( m_fGlassAimTime == 0.0f )
+        {
+            BLOG_I( "%s -> Shooting the window in the way (%.0f %.0f %.0f).", GetName(), tr.endpos.x, tr.endpos.y,
+                    tr.endpos.z );
+            m_fGlassAimTime = CBotrixPlugin::fTime + 0.3f;
+        }
+        m_vLook = tr.endpos + vDir * 4.0f;
+        m_bNeedAim = true;
+        m_fEndAimTime = CBotrixPlugin::fTime + 0.2f;
+        if ( CBotrixPlugin::fTime >= m_fGlassAimTime && m_aWeapons[m_iWeapon].CanUse() )
+            WeaponShoot();
+        return true;
+    }
+    m_fGlassAimTime = 0.0f;
+    return false;
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+bool CBot_SGTLS::ButtonInSight( edict_t* /*pButton*/, const Vector& vButton ) const
+{
+    // Walls and floors only (the world): props on the button (tls_lockdown's bomb device) and players standing on
+    // each other at the button don't stop +use. The button can sit in a desk: what the line hits right next to it
+    // doesn't count (the height test in Think keeps bots from pressing it through a floor).
+    Ray_t ray;
+    ray.Init( m_vHead, vButton );
+    trace_t tr;
+    CTraceFilterWorldOnly cFilter;
+    CBotrixPlugin::pEngineTrace->TraceRay( ray, MASK_PLAYERSOLID, &cFilter, &tr );
+    return tr.fraction >= 0.99f || tr.endpos.DistToSqr( vButton ) < 16.0f * 16.0f;
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+void CBot_SGTLS::Think()
+{
+    if ( sgtls::bHurtLog )
+        sgtls::CObjectives::DiagTeleporters();
+    m_bBreakingGlass = false;
+    Vector vButton;
+    edict_t* pButton = ( m_bAlive && !m_pCurrentEnemy ) ? sgtls::CObjectives::GetButtonToHold( GetTeam(), GetHead(), vButton )
+                                                       : NULL;
+    if ( pButton )
+    {
+        if ( !m_bHoldingButton )
+            BLOG_I( "%s -> Holding the objective button.", GetName() );
+        m_bHoldingButton = true;
+        // Walk straight to the button until in use range (80 units, horizontal), then stand still.
+        Vector vToButton = vButton - m_vHead;
+        if ( vToButton.Length2D() > 48.0f )
+        {
+            m_vDestination = Vector( vButton.x, vButton.y, m_vHead.z );
+            iNextWaypoint = EWaypointIdInvalid;
+            m_bUseNavigatorToMove = m_bDestinationChanged = false;
+            m_bNeedMove = true;
+        }
+        else
+            m_bNeedMove = false;
+        m_vLook = vButton;
+        m_bNeedAim = true;
+        m_fEndAimTime = CBotrixPlugin::fTime + 0.3f;
+        // No +use: the game took it for the nearest plain func_button. On tls_lockdown the Tau'ri holding the iris
+        // control pressed BlastButtonC3L next to it at each new attempt, which closed the blast door between the gate
+        // and the iris booth on the Goa'uld coming through (2026-11-04).
+        // +use from a bot doesn't reach the hold button anyway: call its Use() every frame in use range (80 units, at
+        // eye level, nothing in between: not through a floor), as the game does for a player holding +use.
+        if ( vToButton.Length2D() < 72.0f && fabs( vToButton.z ) < 64.0f && ButtonInSight( pButton, vButton ) )
+            sgtls::UseEntity( pButton, m_pEdict );
+        return;
+    }
+    if ( m_bHoldingButton )
+    {
+        m_bHoldingButton = false;
+        m_iCurrentTask = EBotTaskInvalid;
+        m_bNeedTaskCheck = true; // Objective done or enemy: back to the normal tasks.
+    }
+    // The active objectives changed: a bot on its way to a spot of the stage that is over picks a new destination.
+    // On tls_lockdown the Goa'uld that respawned for the breaker kept walking its 7000-unit way up after it fell,
+    // then all the way back down to the iris (2026-11-04).
+    if ( m_iStageSeen != sgtls::CObjectives::StageChanges() )
+    {
+        m_iStageSeen = sgtls::CObjectives::StageChanges();
+        if ( sgtls::bStageRepick && m_bAlive && m_iCurrentTask == EBotTaskFindEnemy )
+        {
+            m_iGuardWaypoint = EWaypointIdInvalid;
+            m_fGuardEnd = 0.0f;
+            m_iCurrentTask = EBotTaskInvalid;
+            m_bNeedTaskCheck = true;
+        }
+    }
+    // Well below its current and next waypoints (tls_stargate_atlantis_fixed: bots slipped off the city stairs'
+    // landing at waypoint 2160 to the floor 100 units below; Botrix keeps a current waypoint up to 256 units away, the
+    // path went on up from there, and the watchdog killed them: 9 in 30 minutes): on from the nearest waypoint at the
+    // bot's level, to the same destination.
+    if ( m_bAlive && sgtls::Feature( sgtls::FeatFallen ) && m_bUseNavigatorToMove && !m_bLadderMove &&
+         CWaypoint::IsValid( iCurrentWaypoint ) && CBotrixPlugin::fTime > m_fFallenCheck )
+    {
+        m_fFallenCheck = CBotrixPlugin::fTime + 0.5f;
+        float fBelow = CWaypoints::Get( iCurrentWaypoint ).vOrigin.z - m_vHead.z;
+        bool bNextAbove = !CWaypoint::IsValid( iNextWaypoint ) ||
+                          CWaypoints::Get( iNextWaypoint ).vOrigin.z - m_vHead.z > 48.0f;
+        if ( fBelow > 48.0f && bNextAbove )
+        {
+            if ( ++m_iFallenChecks >= 3 )
+            {
+                m_iFallenChecks = 0;
+                TWaypointId w = CWaypoints::GetNearestWaypoint( m_vHead, NULL, true, 200.0f );
+                if ( CWaypoint::IsValid( w ) && w != iCurrentWaypoint &&
+                     fabs( CWaypoints::Get( w ).vOrigin.z - m_vHead.z ) < 40.0f )
+                {
+                    BLOG_I( "%s -> %.0f units below waypoint %d, going on from %d.", GetName(), fBelow,
+                            iCurrentWaypoint, w );
+                    iCurrentWaypoint = w;
+                    iNextWaypoint = EWaypointIdInvalid;
+                    m_bDestinationChanged = true; // Same destination, a new path from here.
+                    m_bMoveFailure = false;
+                }
+            }
+        }
+        else
+            m_iFallenChecks = 0;
+    }
+    // A closed gate's entry is never the current waypoint: its only way out is the gate. Near it in a fight, or
+    // arrived through the other gate right beside it, the bots took that way, into the plane: the killbox while the
+    // gate is dialed from the other side (tlsdm_glass_gate_final, 11 of 14 killbox trips after the timed crossings).
+    if ( m_bAlive && sgtls::Feature( sgtls::FeatClosedEntry ) && CWaypoint::IsValid( iCurrentWaypoint ) &&
+         CBotrixPlugin::fTime > m_fEntryFixTime + 0.5f && sgtls::CObjectives::GateEntryClosed( iCurrentWaypoint ) )
+    {
+        m_fEntryFixTime = CBotrixPlugin::fTime;
+        good::vector<TWaypointId> aNear;
+        CWaypoints::GetNearestWaypoints( aNear, m_vHead, true, 400.0f );
+        TWaypointId wBest = EWaypointIdInvalid;
+        float fBest = 1e9f;
+        for ( int i = 0; i < aNear.size(); ++i )
+        {
+            float fDist = m_vHead.DistToSqr( CWaypoints::Get( aNear[i] ).vOrigin );
+            if ( fDist < fBest && !sgtls::CObjectives::IsGateEntry( aNear[i] ) )
+            {
+                fBest = fDist;
+                wBest = aNear[i];
+            }
+        }
+        if ( CWaypoint::IsValid( wBest ) )
+        {
+            iCurrentWaypoint = wBest;
+            iNextWaypoint = EWaypointIdInvalid;
+            m_iCurrentTask = EBotTaskInvalid;
+            m_bNeedTaskCheck = true; // A new path from here.
+        }
+    }
+    // Out of a stargate's kill boxes first (tlsdm_glass_gate_final, tls_p4x-639: bots standing in front of a gate
+    // when it was dialed were sent to the killbox).
+    if ( m_bAlive && sgtls::Feature( sgtls::FeatKillBox ) && LeaveGateKillBox() )
+        return;
+    // A door first: also on the way to a teleporter's button (tls_stargate_atlantis's transporter booths have one).
+    if ( m_bAlive && !m_pCurrentEnemy && OpenDoor() )
+        return;
+    if ( m_bAlive && !m_pCurrentEnemy && OpenTeleporter() )
+        return;
+    if ( m_bAlive && !m_bSpawnOriginSet && CBotrixPlugin::fTime > m_fSpawnTime + 0.5f )
+    {
+        m_vSpawnOrigin = m_vHead;
+        m_bSpawnOriginSet = true;
+    }
+    if ( m_bAlive && !m_pCurrentEnemy && Regroup() )
+        return;
+    if ( m_bAlive && !m_pCurrentEnemy && Guard() )
+        return;
+    CBot_HL2DM::Think();
+    // A gate's entry only once it is open and its kawoosh over, even while fighting: its plane sends to the killbox
+    // when the gate is dialed from the other side (tls_p4x-639, tlsdm_glass_gate_final: bots died there in fights).
+    if ( m_bAlive && m_bNeedMove && m_bUseNavigatorToMove && CWaypoint::IsValid( iNextWaypoint ) &&
+         iNextWaypoint != iCurrentWaypoint && sgtls::Feature( sgtls::FeatClosedEntry ) &&
+         ( sgtls::CObjectives::GateEntryClosed( iNextWaypoint ) || sgtls::CObjectives::GateEntryClosed( iCurrentWaypoint ) ) )
+        m_bNeedMove = false;
+    if ( m_bNeedMove && ( sgtls::iFireCross == 1 || sgtls::iFireCross == 2 ) && sgtls::InFire( m_vHead ) )
+        m_bNeedSprint = true; // Through the fire as fast as possible.
+    // After the HL2DM think, which aims along the path: the window first.
+    m_bBreakingGlass = m_bAlive && BreakGlass();
+    JumpAtStep();
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+bool CBot_SGTLS::Regroup()
+{
+    // tls_erebus: at the first objective the Goa'uld respawn about 3000 units from it, the Tau'ri 10500; the attackers
+    // arrived one by one and were picked off (23 kills to 34 while dealing more damage, 2026-10-28). An attacker that
+    // spawned far from its spot (6000+ units) stops 2200-3200 units from it until 2 teammates are within 600 units,
+    // nobody is behind on the way, or 15 seconds have passed: once per life. It still fights what comes.
+    if ( !sgtls::bRegroup || m_bRegroupDone || !m_bSpawnOriginSet || !m_pSpot || !sgtls::CObjectives::IsAttacking( GetTeam(), m_pSpot ) )
+        return false;
+    float fDist = sgtls::CObjectives::DistanceToSpot( m_pSpot, m_vHead );
+    if ( sgtls::CObjectives::DistanceToSpot( m_pSpot, m_vSpawnOrigin ) < 6000.0f || fDist < 2200.0f || fDist > 3200.0f )
+    {
+        if ( m_fRegroupEnd > 0.0f ) // Pushed out of the ring while waiting: go.
+        {
+            m_fRegroupEnd = 0.0f;
+            m_bRegroupDone = true;
+        }
+        return false;
+    }
+    if ( m_fRegroupEnd == 0.0f )
+    {
+        // Not at a door or a teleporter: tls_omega_b1's attackers waited 15 s in front of a sliding door of the
+        // Daedalus, the door closed, and they were stuck there until the watchdog. Further on, in the same ring.
+        const std::vector<sgtls::CButtonDoor>& aDoors = sgtls::ButtonDoors();
+        for ( size_t i = 0; i < aDoors.size() && sgtls::Feature( sgtls::FeatRegroupDoors ); ++i )
+        {
+            const Vector& vMins = aDoors[i].pDoor->vMins;
+            const Vector& vMaxs = aDoors[i].pDoor->vMaxs;
+            Vector vNear( clamp( m_vHead.x, vMins.x, vMaxs.x ), clamp( m_vHead.y, vMins.y, vMaxs.y ), clamp( m_vHead.z, vMins.z, vMaxs.z ) );
+            if ( vNear.DistToSqr( m_vHead ) < 160.0f * 160.0f )
+                return false;
+        }
+        const std::vector<sgtls::CButtonTeleporter>& aTeleporters = sgtls::ButtonTeleporters();
+        for ( size_t i = 0; i < aTeleporters.size() && sgtls::Feature( sgtls::FeatRegroupDoors ); ++i )
+            if ( aTeleporters[i].vEntry.DistToSqr( m_vHead ) < 200.0f * 200.0f || aTeleporters[i].vExit.DistToSqr( m_vHead ) < 200.0f * 200.0f )
+                return false;
+        m_fRegroupEnd = CBotrixPlugin::fTime + 15.0f;
+        BLOG_I( "%s -> Waiting for teammates before attacking.", GetName() );
+    }
+    int iNear = 0, iComing = 0;
+    for ( TPlayerIndex i = 0; i < CPlayers::Size(); ++i )
+    {
+        CPlayer* pPlayer = CPlayers::Get( i );
+        if ( !pPlayer || pPlayer == this || !pPlayer->IsAlive() || pPlayer->GetTeam() != GetTeam() )
+            continue;
+        if ( pPlayer->GetHead().DistToSqr( m_vHead ) < 600.0f * 600.0f )
+            ++iNear;
+        else if ( sgtls::CObjectives::DistanceToSpot( m_pSpot, pPlayer->GetHead() ) > fDist )
+            ++iComing;
+    }
+    if ( iNear >= 2 || iComing == 0 || CBotrixPlugin::fTime > m_fRegroupEnd )
+    {
+        BLOG_I( "%s -> Attacking with %d teammates near (%d on the way).", GetName(), iNear, iComing );
+        m_fRegroupEnd = 0.0f;
+        m_bRegroupDone = true;
+        m_iCurrentTask = EBotTaskInvalid;
+        m_bNeedTaskCheck = true;
+        return false;
+    }
+    m_bNeedMove = false;
+    return true;
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+void CBot_SGTLS::JumpAtStep()
+{
+    // Botrix jumps a fixed time after leaving the waypoint (the path's action time). On tls_lockdown's 40-46 unit
+    // steps the bots jumped too early or too late and failed the same paths again and again (415 -> 414: 67 times,
+    // 2026-11-03). Jump when at the step: the next waypoint (eye level) is more than a stair step higher and within
+    // 72 units. Once a second at most.
+    if ( !m_bAlive || !m_bNeedMove || !m_bUseNavigatorToMove || CBotrixPlugin::fTime < m_fNextStepJump ||
+         !CWaypoint::IsValid( iCurrentWaypoint ) || !CWaypoint::IsValid( iNextWaypoint ) || iCurrentWaypoint == iNextWaypoint )
+        return;
+    CWaypointPath* pPath = CWaypoints::GetPath( iCurrentWaypoint, iNextWaypoint );
+    if ( !pPath || !FLAG_SOME_SET( FPathJump, pPath->iFlags ) )
+        return;
+    const Vector& vNext = CWaypoints::Get( iNextWaypoint ).vOrigin;
+    bool bBlocked = false;
+    if ( sgtls::Feature( sgtls::FeatBlockedJump ) && !m_pCurrentEnemy ) // Fighting bots stand still on purpose.
+    {
+        // The step can be far from the next waypoint (tls_stargate_atlantis_fixed: the base gate's platform edge is
+        // 37 units after waypoint 999, the gate's entry 300 units on; Botrix's single jump at the path's action time
+        // missed it and the bots stood against the edge until the watchdog): a bot that hasn't moved 8 units in
+        // 0.4 seconds on a jump path jumps.
+        if ( m_vBlockedPos.DistToSqr( m_vHead ) > 8.0f * 8.0f )
+        {
+            m_vBlockedPos = m_vHead;
+            m_fBlockedSince = CBotrixPlugin::fTime;
+        }
+        else if ( CBotrixPlugin::fTime > m_fBlockedSince + 0.4f )
+        {
+            bBlocked = true;
+            m_fBlockedSince = CBotrixPlugin::fTime;
+        }
+    }
+    if ( !bBlocked && ( vNext.z - m_vHead.z <= 18.0f ||
+                        ( vNext.AsVector2D() - m_vHead.AsVector2D() ).LengthSqr() > 72.0f * 72.0f ) )
+        return;
+    m_fNextStepJump = CBotrixPlugin::fTime + 1.0f;
+    m_bNeedJump = m_bNeedJumpDuck = true;
+    m_fStartActionTime = CBotrixPlugin::fTime;
+    m_fEndActionTime = CBotrixPlugin::fTime + 0.7f;
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+bool CBot_SGTLS::Guard()
+{
+    // tls_lockdown: the attackers hold a button 5-8 seconds. Defenders walked from guard spot to guard spot looking
+    // ahead, and saw the attacker at the button too late (the Tau'ri won every bots-only round, 2026-11-03). Now a
+    // defender that reached its guard spot stays 8-15 seconds watching the button. It still fights what comes.
+    if ( !CWaypoint::IsValid( m_iGuardWaypoint ) )
+        return false;
+    Vector vButton;
+    if ( !sgtls::CObjectives::IsButtonToGuard( GetTeam(), m_pSpot, vButton ) )
+    {
+        m_iGuardWaypoint = EWaypointIdInvalid; // Objective done, or the bot attacks now.
+        m_fGuardEnd = 0.0f;
+        return false;
+    }
+    if ( m_fGuardEnd == 0.0f )
+    {
+        if ( m_vHead.DistToSqr( CWaypoints::Get( m_iGuardWaypoint ).vOrigin ) > 48.0f * 48.0f )
+            return false; // Not there yet.
+        m_fGuardEnd = CBotrixPlugin::fTime + sgtls::GuardTime();
+    }
+    if ( CBotrixPlugin::fTime >= m_fGuardEnd )
+    {
+        m_iGuardWaypoint = EWaypointIdInvalid;
+        m_fGuardEnd = 0.0f;
+        m_iCurrentTask = EBotTaskInvalid;
+        m_bNeedTaskCheck = true; // Next guard spot.
+        return false;
+    }
+    m_bNeedMove = false;
+    m_vLook = m_vGuardLook;
+    m_bNeedAim = true;
+    m_fEndAimTime = CBotrixPlugin::fTime + 0.3f;
+    return true;
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+bool CBot_SGTLS::OpenTeleporter()
+{
+    // The teleporter the path is about to take, or the one the bot is opening (its path now leads to the button).
+    int iTeleporter = ( m_bNeedMove && m_bUseNavigatorToMove )
+                    ? sgtls::CObjectives::TeleporterOnPath( iCurrentWaypoint, iNextWaypoint, m_iAfterNextWaypoint ) : -1;
+    if ( iTeleporter >= 0 && iTeleporter == m_iTeleporterGaveUp && CBotrixPlugin::fTime < m_fTeleporterGaveUpEnd )
+        iTeleporter = -1;
+    if ( iTeleporter < 0 )
+        iTeleporter = m_iTeleporter;
+    if ( iTeleporter < 0 || iTeleporter >= (int)sgtls::ButtonTeleporters().size() )
+        return false;
+    if ( sgtls::ButtonTeleporters()[iTeleporter].bMomentary )
+        return UseTransporter( iTeleporter );
+
+    if ( sgtls::CObjectives::TeleporterReady( iTeleporter ) )
+    {
+        if ( m_iTeleporter >= 0 )
+        {
+            BLOG_I( "%s -> Teleporter on, going through.", GetName() );
+            m_iTeleporter = -1;
+            m_iCurrentTask = EBotTaskInvalid;
+            m_bNeedTaskCheck = true; // New path, through the teleporter.
+        }
+        return false;
+    }
+    if ( m_iTeleporter != iTeleporter )
+    {
+        BLOG_I( "%s -> Teleporter off on the way, pressing its button.", GetName() );
+        m_iTeleporter = iTeleporter;
+        m_fTeleporterStart = CBotrixPlugin::fTime;
+    }
+    else if ( CBotrixPlugin::fTime > m_fTeleporterStart + 60.0f )
+    {
+        BLOG_W( "%s -> Teleporter still off after 60 seconds.", GetName() );
+        m_fTeleporterStart = CBotrixPlugin::fTime;
+    }
+
+    Vector vButton;
+    TWaypointId wButton;
+    edict_t* pButton = sgtls::CObjectives::TeleporterButton( iTeleporter, m_vHead, vButton, wButton );
+    if ( !pButton )
+    {
+        m_iTeleporter = -1;
+        return false;
+    }
+    Vector vToButton = vButton - m_vHead;
+    // A fire burning near the button (tls_stargate_atlantis_fixed: a torch 46 units from the Goa'uld DHD; bots coming
+    // from the gate walked straight to the button, stopped beside the torch and waited there 16.5 s for the gate: 8 of
+    // the 13 world deaths in 30 minutes): by the waypoint next to the button out of the fire's reach, and pressed from
+    // where the bot is as soon as it can.
+    float fPressReach = sgtls::Feature( sgtls::FeatDhdReach ) ? 79.0f : 72.0f;
+    bool bFireNear = sgtls::Feature( sgtls::FeatFires ) && sgtls::FireNear( vButton, 160.0f );
+    bool bPressHere = bFireNear && vToButton.Length2D() < fPressReach - 8.0f && fabs( vToButton.z ) < 64.0f &&
+                      !sgtls::InFireBox( m_vHead, 4.0f ) && ButtonInSight( pButton, vButton );
+    if ( ( vToButton.Length2D() > 130.0f || ( bFireNear && !bPressHere ) ) && CWaypoint::IsValid( wButton ) &&
+         iCurrentWaypoint != wButton )
+    {
+        // To the waypoint next to the button. The stargate's kawoosh would kill a bot waiting in front of it.
+        if ( m_iDestinationWaypoint != wButton || !m_bUseNavigatorToMove || m_bMoveFailure )
+        {
+            m_iDestinationWaypoint = wButton;
+            m_bDestinationChanged = true;
+            m_bMoveFailure = false;
+        }
+        m_bUseNavigatorToMove = m_bNeedMove = true;
+        return true;
+    }
+    // Then straight to the button, and press it as long as the teleporter is off (the DHD: 8 presses). Once on, the
+    // bot stands still during the kawoosh.
+    if ( vToButton.Length2D() > 48.0f && !bPressHere )
+    {
+        m_vDestination = Vector( vButton.x, vButton.y, m_vHead.z );
+        iNextWaypoint = EWaypointIdInvalid;
+        m_bUseNavigatorToMove = m_bDestinationChanged = false;
+        m_bNeedMove = true;
+    }
+    else
+        m_bNeedMove = false;
+    m_vLook = vButton;
+    m_bNeedAim = true;
+    m_fEndAimTime = CBotrixPlugin::fTime + 0.3f;
+    // Within the game's +use reach (80 units, horizontal): tls_kheb_fix1's DHD model keeps bots 71-75 units from its
+    // button (they never pressed it at 72).
+    if ( vToButton.Length2D() < fPressReach && fabs( vToButton.z ) < 64.0f &&
+         ButtonInSight( pButton, vButton ) &&
+         sgtls::CObjectives::PressTeleporterButton( iTeleporter, m_pEdict ) )
+        BLOG_I( "%s -> Pressed the teleporter's button.", GetName() );
+    return true;
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+bool CBot_SGTLS::LeaveGateKillBox()
+{
+    // Going through a gate that is ready: its entry is the next waypoint, or the bot is on it.
+    for ( int k = 0; k < 2; ++k )
+    {
+        TWaypointId w = k ? iCurrentWaypoint : iNextWaypoint;
+        if ( m_bUseNavigatorToMove && CWaypoint::IsValid( w ) && sgtls::CObjectives::IsGateEntry( w ) &&
+             !sgtls::CObjectives::GateEntryClosed( w ) )
+            return false;
+    }
+    Vector vOut;
+    std::vector<Vector> aOpenGates;
+    if ( sgtls::Feature( sgtls::FeatOpenKawoosh ) )
+        sgtls::CObjectives::OpenGatePlaces( aOpenGates );
+    if ( !sgtls::InGateKillBox( m_vHead, vOut, aOpenGates ) )
+    {
+        if ( m_bLeavingKillBox )
+        {
+            m_bLeavingKillBox = false;
+            m_iCurrentTask = EBotTaskInvalid;
+            m_bNeedTaskCheck = true; // Back to the path, from out here.
+        }
+        return false;
+    }
+    if ( !m_bLeavingKillBox )
+        BLOG_I( "%s -> In a stargate's kill box, leaving it.", GetName() );
+    m_bLeavingKillBox = true;
+    m_vDestination = vOut;
+    iNextWaypoint = EWaypointIdInvalid;
+    m_bUseNavigatorToMove = m_bDestinationChanged = false;
+    m_bNeedMove = true;
+    return true;
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+void CBot_SGTLS::FinalMove()
+{
+    // tlsdm_glass_gate_final: 12 bots in 3 minutes went through a gate and arrived in the far gate's incoming plane.
+    if ( !m_bAlive || !m_pPlayerInfo )
+    {
+        m_iCrossGate = -1;
+        return;
+    }
+    Vector vOrigin = m_pPlayerInfo->GetAbsOrigin();
+    float fFwd0 = m_cCmd.forwardmove, fSide0 = m_cCmd.sidemove;
+    CrossGate( vOrigin );
+    Swim( vOrigin );
+    KeepOffPlanes( vOrigin );
+    KeepOffRings( vOrigin );
+    KeepOffLasers( vOrigin );
+    KeepOffFires();
+    CrossDoorway( vOrigin );
+    UsePropDoor();
+    if ( sgtls::bHurtLog && m_iTeleporter >= 0 && m_fTeleporterPressed > 0.0f && CBotrixPlugin::fTime > m_fMoveDiag )
+    {
+        m_fMoveDiag = CBotrixPlugin::fTime + 0.5f;
+        BLOG_I( "%s -> move +%.1f s: need %d nav %d enemy %d, dest %.0f %.0f, cmd %.0f %.0f -> %.0f %.0f, buttons 0x%x, yaw %.0f.",
+                GetName(), CBotrixPlugin::fTime - m_fTeleporterPressed, m_bNeedMove ? 1 : 0, m_bUseNavigatorToMove ? 1 : 0,
+                m_pCurrentEnemy ? 1 : 0, m_vDestination.x, m_vDestination.y, fFwd0, fSide0, m_cCmd.forwardmove,
+                m_cCmd.sidemove, m_cCmd.buttons, m_cCmd.viewangles.y );
+    }
+}
