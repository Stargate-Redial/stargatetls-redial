diff --git a/mods/sgtls/objectives_sgtls.cpp b/mods/sgtls/objectives_sgtls.cpp
new file mode 100644
index 0000000..4a66799
--- /dev/null
+++ b/mods/sgtls/objectives_sgtls.cpp
@@ -0,0 +1,456 @@
+#include <stdlib.h>
+#include <string.h>
+#include <string>
+#include <vector>
+
+#include "mod.h"
+#include "players.h"
+#include "server_plugin.h"
+#include "waypoint.h"
+#include "mods/sgtls/objectives_sgtls.h"
+#include "mods/sgtls/sgtls_map.h"
+#include "mods/sgtls/sgtls_util.h"
+
+#include "eiface.h"
+#include "edict.h"
+#include "iservernetworkable.h"
+#include "iserverunknown.h"
+#include "iserverentity.h"
+
+// memdbgon must be the last include file in a .cpp file!!!
+#include "tier0/memdbgon.h"
+
+
+namespace
+{
+    // A place bots fight for: a capture area (objective type 0) or a hold button (type 2).
+    struct CSpot
+    {
+        edict_t* pEdict;                   // trigger_tls_capture_area or func_hold_button.
+        edict_t* pObjective;               // info_tls_objective of the spot, can be NULL for a capture area.
+        bool bButton;
+        Vector vMins, vMaxs, vCenter;
+        std::vector<TWaypointId> aInside;  // Capture area: waypoints inside. Button: waypoints in use range.
+        std::vector<TWaypointId> aNear;    // Waypoints around: where defenders wait.
+    };
+
+    std::vector<CSpot> m_aSpots;
+    std::string m_sMap;
+    int m_iWaypoints = -1;
+
+    // Button-operated teleporters (sgtls::ButtonTeleporters, same order), with their entities and waypoints.
+    struct CTeleporter
+    {
+        edict_t* pTeleporter;              // trigger_teleport.
+        edict_t* pButton;                  // func_button.
+        TWaypointId wEntry, wExit;         // The link, invalid if the waypoints don't have it.
+        TWaypointId wButton;               // Waypoint next to the button.
+        float fOnSince;                    // When it was seen turning on, -1 while off.
+        float fNextPress;
+    };
+    std::vector<CTeleporter> m_aTeleporters;
+
+    // A disabled trigger has no FSOLID_TRIGGER (CBaseTrigger::Enable / Disable).
+    bool IsOn( CTeleporter& t )
+    {
+        ICollideable* pColl = ( t.pTeleporter && !t.pTeleporter->IsFree() ) ? t.pTeleporter->GetCollideable() : NULL;
+        bool bOn = pColl && ( pColl->GetSolidFlags() & FSOLID_TRIGGER );
+        if ( !bOn )
+            t.fOnSince = -1.0f;
+        else if ( t.fOnSince < 0.0f )
+            t.fOnSince = CBotrixPlugin::fTime;
+        return bOn;
+    }
+
+    const float fNearDistance = 1000.0f;
+    const float fButtonUseDistance = 90.0f; // From the eye to the button center: waypoints of the spot.
+    // From the eye to the nearest point of the button: start walking to it and holding +use. The game takes +use
+    // within 80 units (PLAYER_USE_RADIUS, horizontal distance); tls_lockdown's bomb buttons are long strips on a desk
+    // whose waypoints are ~82 units away.
+    const float fButtonApproachDistance = 130.0f;
+
+    int GetByte( edict_t* pEdict, const char* szProp )
+    {
+        int iOffset = sgtls::PropOffset( pEdict, szProp );
+        if ( iOffset < 0 || !pEdict->GetUnknown() )
+            return -1;
+        return *( (unsigned char*)pEdict->GetUnknown()->GetBaseEntity() + iOffset );
+    }
+
+    // Team that attacks the spot (2 Tau'ri, 3 Goa'uld), -1 if none.
+    int Attackers( const CSpot& c )
+    {
+        if ( c.bButton )
+            return c.pObjective && !c.pObjective->IsFree() ? sgtls::GetInt( c.pObjective, "m_iTeamFilter", -1 ) : -1;
+        if ( GetByte( c.pEdict, "m_bTeam2CanCap" ) == 1 )
+            return 2;
+        if ( GetByte( c.pEdict, "m_bTeam3CanCap" ) == 1 )
+            return 3;
+        return -1;
+    }
+
+    bool IsActive( const CSpot& c )
+    {
+        if ( c.pEdict->IsFree() )
+            return false;
+        int iAttackers = Attackers( c );
+        if ( iAttackers < 0 )
+            return false;
+        if ( !c.bButton && sgtls::GetInt( c.pEdict, "m_iNetOwnerTeam", 0 ) == iAttackers )
+            return false;
+        return !c.pObjective || c.pObjective->IsFree() || GetByte( c.pObjective, "m_bEnabled" ) == 1;
+    }
+
+    int Order( const CSpot& c )
+    {
+        return c.pObjective && !c.pObjective->IsFree() ? sgtls::GetInt( c.pObjective, "m_iOrder", 0 ) : 0;
+    }
+
+    Vector Origin( edict_t* pEdict )
+    {
+        ICollideable* pColl = pEdict->GetCollideable();
+        return pColl ? pColl->GetCollisionOrigin() : Vector( 0, 0, 0 );
+    }
+
+    void Bounds( edict_t* pEdict, CSpot& c )
+    {
+        ICollideable* pColl = pEdict->GetCollideable();
+        c.vMins = pColl->GetCollisionOrigin() + pColl->OBBMins();
+        c.vMaxs = pColl->GetCollisionOrigin() + pColl->OBBMaxs();
+        c.vCenter = ( c.vMins + c.vMaxs ) * 0.5f;
+    }
+
+    // Spots whose objective is enabled (or capture areas without objective), weighted: the lowest order twice.
+    void ActiveSpots( std::vector<int>& aWeighted )
+    {
+        std::vector<int> aActive;
+        int iMinOrder = 1 << 30;
+        for ( size_t a = 0; a < m_aSpots.size(); ++a )
+            if ( IsActive( m_aSpots[a] ) )
+            {
+                aActive.push_back( (int)a );
+                if ( Order( m_aSpots[a] ) < iMinOrder )
+                    iMinOrder = Order( m_aSpots[a] );
+            }
+        for ( size_t i = 0; i < aActive.size(); ++i )
+        {
+            aWeighted.push_back( aActive[i] );
+            if ( Order( m_aSpots[aActive[i]] ) == iMinOrder )
+                aWeighted.push_back( aActive[i] );
+        }
+    }
+}
+
+
+void sgtls::CObjectives::Refresh()
+{
+    // Rebuild on map / waypoints change, and every 20 seconds: a round restart can recreate the entities.
+    static float fNextRefresh = 0.0f;
+    if ( m_sMap == CBotrixPlugin::instance->sMapName.c_str() && m_iWaypoints == CWaypoints::Size() &&
+         CBotrixPlugin::fTime < fNextRefresh && CBotrixPlugin::fTime > fNextRefresh - 30.0f )
+        return;
+    fNextRefresh = CBotrixPlugin::fTime + 20.0f;
+    bool bSameMap = ( m_sMap == CBotrixPlugin::instance->sMapName.c_str() );
+    m_sMap = CBotrixPlugin::instance->sMapName.c_str();
+    m_iWaypoints = CWaypoints::Size();
+    m_aSpots.clear();
+
+    IVEngineServer* pEngine = CBotrixPlugin::pEngineServer;
+    std::vector<edict_t*> aObjectives, aButtons;
+    std::map<std::string, edict_t*> aBrushes; // Teleporters and buttons by brush model ("*39").
+    for ( int i = 1; i < pEngine->GetEntityCount(); ++i )
+    {
+        edict_t* pEdict = pEngine->PEntityOfEntIndex( i );
+        if ( !pEdict || pEdict->IsFree() || !pEdict->GetUnknown() )
+            continue;
+        const char* szClass = sgtls::ServerClassName( pEdict );
+        const char* szName = pEdict->GetClassName();
+        if ( szName && pEdict->GetIServerEntity() &&
+             ( strcmp( szName, "trigger_teleport" ) == 0 || strcmp( szName, "func_button" ) == 0 ) )
+            aBrushes[ STRING( pEdict->GetIServerEntity()->GetModelName() ) ] = pEdict;
+        if ( strcmp( szClass, "CGameObjective" ) == 0 )
+            aObjectives.push_back( pEdict );
+        else if ( szName && strcmp( szName, "func_hold_button" ) == 0 )
+            aButtons.push_back( pEdict );
+        else if ( strcmp( szClass, "CDHCaptureArea" ) == 0 )
+        {
+            CSpot c;
+            c.pEdict = pEdict;
+            c.pObjective = NULL;
+            c.bButton = false;
+            Bounds( pEdict, c );
+            m_aSpots.push_back( c );
+        }
+    }
+
+    // Capture areas: the objective inside or nearest (within 1024).
+    for ( size_t a = 0; a < m_aSpots.size(); ++a )
+    {
+        float fBest = 1024.0f * 1024.0f;
+        for ( size_t o = 0; o < aObjectives.size(); ++o )
+        {
+            float fDist = Origin( aObjectives[o] ).DistToSqr( m_aSpots[a].vCenter );
+            if ( fDist < fBest )
+            {
+                fBest = fDist;
+                m_aSpots[a].pObjective = aObjectives[o];
+            }
+        }
+    }
+
+    // Hold-button objectives (type 2): every func_hold_button within 128 units of the objective.
+    for ( size_t o = 0; o < aObjectives.size(); ++o )
+    {
+        if ( sgtls::GetInt( aObjectives[o], "m_iObjectiveType", 0 ) != 2 )
+            continue;
+        Vector vObjective = Origin( aObjectives[o] );
+        for ( size_t b = 0; b < aButtons.size(); ++b )
+        {
+            CSpot c;
+            c.pEdict = aButtons[b];
+            c.pObjective = aObjectives[o];
+            c.bButton = true;
+            Bounds( aButtons[b], c );
+            if ( c.vCenter.DistToSqr( vObjective ) < 128.0f * 128.0f )
+                m_aSpots.push_back( c );
+        }
+    }
+
+    float fEye = CMod::GetVar( EModVarPlayerEye );
+    for ( size_t a = 0; a < m_aSpots.size(); ++a )
+    {
+        CSpot& c = m_aSpots[a];
+        for ( TWaypointId w = 0; w < CWaypoints::Size(); ++w )
+        {
+            const Vector& v = CWaypoints::Get( w ).vOrigin; // Eye level.
+            bool bInside = c.bButton
+                ? v.DistToSqr( c.vCenter ) < fButtonUseDistance * fButtonUseDistance
+                : ( v.x >= c.vMins.x - 16 && v.x <= c.vMaxs.x + 16 && v.y >= c.vMins.y - 16 && v.y <= c.vMaxs.y + 16 &&
+                    v.z - fEye >= c.vMins.z - 24 && v.z - fEye <= c.vMaxs.z );
+            if ( bInside )
+                c.aInside.push_back( w );
+            else if ( v.DistToSqr( c.vCenter ) < fNearDistance * fNearDistance )
+                c.aNear.push_back( w );
+        }
+        if ( c.aInside.empty() )
+        {
+            // Smaller than the waypoint grid: use the nearest waypoint.
+            TWaypointId w = CWaypoints::GetNearestWaypoint( c.vCenter, NULL, false, 600.0f );
+            if ( CWaypoint::IsValid( w ) )
+                c.aInside.push_back( w );
+        }
+    }
+
+    // Button-operated teleporters: their entities (a round restart can recreate them) and waypoints. The on / off
+    // timing stays.
+    const std::vector<sgtls::CButtonTeleporter>& aDefs = sgtls::ButtonTeleporters();
+    if ( !bSameMap || m_aTeleporters.size() != aDefs.size() )
+    {
+        m_aTeleporters.resize( aDefs.size() );
+        for ( size_t i = 0; i < aDefs.size(); ++i )
+            m_aTeleporters[i].fOnSince = m_aTeleporters[i].fNextPress = -1.0f;
+    }
+    for ( size_t i = 0; i < aDefs.size(); ++i )
+    {
+        const sgtls::CButtonTeleporter& d = aDefs[i];
+        CTeleporter& t = m_aTeleporters[i];
+        std::map<std::string, edict_t*>::const_iterator it = aBrushes.find( d.pTeleporter->Get( "model" ) );
+        t.pTeleporter = ( it == aBrushes.end() ) ? NULL : it->second;
+        it = aBrushes.find( d.pButton->Get( "model" ) );
+        t.pButton = ( it == aBrushes.end() ) ? NULL : it->second;
+        t.wEntry = CWaypoints::GetNearestWaypoint( d.vEntry, NULL, false, 32.0f );
+        t.wExit = CWaypoints::GetNearestWaypoint( d.vExit, NULL, false, 80.0f );
+        if ( !CWaypoint::IsValid( t.wEntry ) || !CWaypoint::IsValid( t.wExit ) || !CWaypoints::HasPath( t.wEntry, t.wExit ) )
+            t.wEntry = t.wExit = EWaypointIdInvalid;
+        Vector vButton = ( d.pButton->vMins + d.pButton->vMaxs ) * 0.5f;
+        t.wButton = CWaypoints::GetNearestWaypoint( vButton, NULL, false, 256.0f );
+    }
+}
+
+
+int sgtls::CObjectives::TeleporterOnPath( TWaypointId iCurrent, TWaypointId iNext )
+{
+    Refresh();
+    for ( size_t i = 0; i < m_aTeleporters.size(); ++i )
+    {
+        const CTeleporter& t = m_aTeleporters[i];
+        if ( CWaypoint::IsValid( t.wEntry ) && t.pTeleporter && t.pButton &&
+             ( ( iNext == t.wEntry && iCurrent != t.wEntry ) || ( iCurrent == t.wEntry && iNext == t.wExit ) ) )
+            return (int)i;
+    }
+    return -1;
+}
+
+
+bool sgtls::CObjectives::TeleporterReady( int iTeleporter )
+{
+    if ( iTeleporter < 0 || iTeleporter >= (int)m_aTeleporters.size() )
+        return false;
+    CTeleporter& t = m_aTeleporters[iTeleporter];
+    return IsOn( t ) && CBotrixPlugin::fTime >= t.fOnSince + sgtls::ButtonTeleporters()[iTeleporter].fKawoosh;
+}
+
+
+edict_t* sgtls::CObjectives::TeleporterButton( int iTeleporter, const Vector& vEye, Vector& vButton, TWaypointId& wButton )
+{
+    if ( iTeleporter < 0 || iTeleporter >= (int)m_aTeleporters.size() )
+        return NULL;
+    const CTeleporter& t = m_aTeleporters[iTeleporter];
+    if ( !t.pButton || t.pButton->IsFree() )
+        return NULL;
+    ICollideable* pColl = t.pButton->GetCollideable();
+    Vector vMins = pColl->GetCollisionOrigin() + pColl->OBBMins(), vMaxs = pColl->GetCollisionOrigin() + pColl->OBBMaxs();
+    for ( int i = 0; i < 3; ++i )
+    {
+        float fMargin = ( vMaxs[i] - vMins[i] ) * 0.5f;
+        if ( fMargin > 4.0f )
+            fMargin = 4.0f;
+        vButton[i] = clamp( vEye[i], vMins[i] + fMargin, vMaxs[i] - fMargin );
+    }
+    wButton = t.wButton;
+    return t.pButton;
+}
+
+
+bool sgtls::CObjectives::PressTeleporterButton( int iTeleporter, edict_t* pActivator )
+{
+    if ( iTeleporter < 0 || iTeleporter >= (int)m_aTeleporters.size() )
+        return false;
+    CTeleporter& t = m_aTeleporters[iTeleporter];
+    if ( IsOn( t ) || CBotrixPlugin::fTime < t.fNextPress || !t.pButton || t.pButton->IsFree() )
+        return false;
+    t.fNextPress = CBotrixPlugin::fTime + 0.5f;
+    return sgtls::UseEntity( t.pButton, pActivator );
+}
+
+
+TWaypointId sgtls::CObjectives::PickWaypoint( TTeam iTeam, edict_t*& pSpot )
+{
+    Refresh();
+    std::vector<int> aWeighted;
+    ActiveSpots( aWeighted );
+    if ( aWeighted.empty() )
+    {
+        pSpot = NULL;
+        return EWaypointIdInvalid;
+    }
+
+    // An attacker keeps its spot while it is active: a capture needs the attackers to stay inside, and a new random
+    // active spot at each arrival sent the bots back and forth between two areas 1000 units apart (tls_abydos).
+    int iSpot = -1;
+    for ( size_t i = 0; i < aWeighted.size() && pSpot; ++i )
+        if ( m_aSpots[ aWeighted[i] ].pEdict == pSpot && Attackers( m_aSpots[ aWeighted[i] ] ) == iTeam )
+            iSpot = aWeighted[i];
+    if ( iSpot < 0 )
+    {
+        // Defenders go first where the attackers are: 3 more chances per attacker inside a spot.
+        std::vector<int> aChoice = aWeighted;
+        for ( size_t i = 0; i < aWeighted.size(); ++i )
+        {
+            const CSpot& c = m_aSpots[ aWeighted[i] ];
+            int iAttackers = Attackers( c );
+            if ( iAttackers == iTeam || ( i > 0 && aWeighted[i] == aWeighted[i - 1] ) )
+                continue;
+            for ( int p = 0; p < CPlayers::Size(); ++p )
+            {
+                CPlayer* pPlayer = CPlayers::Get( p );
+                if ( !pPlayer || !pPlayer->IsAlive() || pPlayer->GetTeam() != iAttackers )
+                    continue;
+                const Vector& v = pPlayer->GetHead();
+                if ( v.x >= c.vMins.x - 64 && v.x <= c.vMaxs.x + 64 && v.y >= c.vMins.y - 64 && v.y <= c.vMaxs.y + 64 &&
+                     v.z >= c.vMins.z - 32 && v.z <= c.vMaxs.z + 96 )
+                    aChoice.insert( aChoice.end(), 3, aWeighted[i] );
+            }
+        }
+        iSpot = aChoice[ rand() % aChoice.size() ];
+    }
+    const CSpot& c = m_aSpots[iSpot];
+    pSpot = c.pEdict;
+
+    // Attackers go into the area / to the button. Defenders stand in it half of the time (to block the capture)
+    // and around it otherwise.
+    bool bAttacker = ( Attackers( c ) == iTeam );
+    const std::vector<TWaypointId>& aChoice = ( bAttacker || c.aNear.empty() || ( rand() & 1 ) ) ? c.aInside : c.aNear;
+    if ( aChoice.empty() )
+        return EWaypointIdInvalid;
+    return aChoice[ rand() % aChoice.size() ];
+}
+
+
+bool sgtls::CObjectives::IsAttacking( TTeam iTeam, edict_t* pSpot )
+{
+    Refresh();
+    for ( size_t a = 0; a < m_aSpots.size() && pSpot; ++a )
+        if ( m_aSpots[a].pEdict == pSpot )
+            return IsActive( m_aSpots[a] ) && Attackers( m_aSpots[a] ) == iTeam;
+    return false;
+}
+
+
+float sgtls::CObjectives::DistanceToSpot( edict_t* pSpot, const Vector& v )
+{
+    Refresh();
+    for ( size_t a = 0; a < m_aSpots.size() && pSpot; ++a )
+        if ( m_aSpots[a].pEdict == pSpot )
+        {
+            Vector vNearest;
+            for ( int i = 0; i < 3; ++i )
+                vNearest[i] = clamp( v[i], m_aSpots[a].vMins[i], m_aSpots[a].vMaxs[i] );
+            return v.DistTo( vNearest );
+        }
+    return 1e9f;
+}
+
+
+edict_t* sgtls::CObjectives::GetButtonToHold( TTeam iTeam, const Vector& vEye, Vector& vButton )
+{
+    Refresh();
+    for ( size_t a = 0; a < m_aSpots.size(); ++a )
+    {
+        const CSpot& c = m_aSpots[a];
+        if ( !c.bButton || !IsActive( c ) || Attackers( c ) != iTeam )
+            continue;
+        // Nearest point of the button, 4 units inside (a +use trace along an edge misses it).
+        Vector vNearest;
+        for ( int i = 0; i < 3; ++i )
+        {
+            float fMargin = ( c.vMaxs[i] - c.vMins[i] ) * 0.5f;
+            if ( fMargin > 4.0f )
+                fMargin = 4.0f;
+            vNearest[i] = clamp( vEye[i], c.vMins[i] + fMargin, c.vMaxs[i] - fMargin );
+        }
+        if ( vEye.DistToSqr( vNearest ) < fButtonApproachDistance * fButtonApproachDistance )
+        {
+            vButton = vNearest;
+            return c.pEdict;
+        }
+    }
+    return NULL;
+}
+
+
+void sgtls::CObjectives::Print()
+{
+    Refresh();
+    for ( size_t a = 0; a < m_aSpots.size(); ++a )
+    {
+        const CSpot& c = m_aSpots[a];
+        Msg( "%s %d: center %.0f %.0f %.0f, attackers %d, owner %d, objective %s order %d enabled %d -> %s, "
+             "%d waypoints inside, %d near\n", c.bButton ? "button" : "area", (int)a, c.vCenter.x, c.vCenter.y,
+             c.vCenter.z, Attackers( c ), c.bButton ? -1 : sgtls::GetInt( c.pEdict, "m_iNetOwnerTeam", 0 ),
+             c.pObjective ? "yes" : "no", Order( c ), c.pObjective ? GetByte( c.pObjective, "m_bEnabled" ) : -1,
+             IsActive( c ) ? "ACTIVE" : "inactive", (int)c.aInside.size(), (int)c.aNear.size() );
+    }
+    const std::vector<sgtls::CButtonTeleporter>& aDefs = sgtls::ButtonTeleporters();
+    for ( size_t i = 0; i < m_aTeleporters.size() && i < aDefs.size(); ++i )
+    {
+        CTeleporter& t = m_aTeleporters[i];
+        bool bOn = IsOn( t );
+        Msg( "teleporter %d: %s (%s, edict %d), button %s (%s, edict %d) x%d, kawoosh wait %.0f s, link %d -> %d, "
+             "button waypoint %d: %s\n", (int)i, aDefs[i].pTeleporter->Get( "targetname" ), aDefs[i].pTeleporter->Get( "model" ),
+             t.pTeleporter ? CBotrixPlugin::pEngineServer->IndexOfEdict( t.pTeleporter ) : -1,
+             aDefs[i].pButton->Get( "targetname" ), aDefs[i].pButton->Get( "model" ),
+             t.pButton ? CBotrixPlugin::pEngineServer->IndexOfEdict( t.pButton ) : -1, aDefs[i].iPresses,
+             aDefs[i].fKawoosh, t.wEntry, t.wExit, t.wButton, bOn ? "ON" : "off" );
+    }
+}
diff --git a/mods/sgtls/objectives_sgtls.h b/mods/sgtls/objectives_sgtls.h
new file mode 100644
index 0000000..9a84eef
--- /dev/null
+++ b/mods/sgtls/objectives_sgtls.h
@@ -0,0 +1,57 @@
+#ifndef __BOTRIX_OBJECTIVES_SGTLS_H__
+#define __BOTRIX_OBJECTIVES_SGTLS_H__
+
+// Stargate: The Last Stand objectives, read from the game entities:
+// - trigger_tls_capture_area (CDHCaptureArea): m_bTeam2CanCap / m_bTeam3CanCap, m_iNetOwnerTeam.
+// - info_tls_objective (CGameObjective): m_bEnabled, m_iOrder. Each one sits in a capture area.
+// The attackers are the team that can capture; the defenders are the other one.
+
+#include "types.h"
+#include "vector.h" // public/ (episode1) or public/mathlib/ (Orange Box)
+
+struct edict_t;
+
+namespace sgtls
+{
+    class CObjectives
+    {
+    public:
+        /// Rebuild the area list if the map or the waypoints changed. Cheap otherwise.
+        static void Refresh();
+
+        /// Waypoint where a bot of iTeam should go now (attack or defend an active area),
+        /// EWaypointIdInvalid if the map has no active area. pSpot is the bot's spot, kept between calls: an
+        /// attacker stays on it while it is active.
+        static TWaypointId PickWaypoint( TTeam iTeam, edict_t*& pSpot );
+
+        /// True if pSpot is an active spot that iTeam attacks.
+        static bool IsAttacking( TTeam iTeam, edict_t* pSpot );
+
+        /// Distance from v to the spot (0 inside its box), a big number for an unknown spot.
+        static float DistanceToSpot( edict_t* pSpot, const Vector& v );
+
+        /// Button of an active hold-button objective that iTeam attacks, near vEye (130 units), NULL if none.
+        /// vButton receives its nearest point.
+        static edict_t* GetButtonToHold( TTeam iTeam, const Vector& vEye, Vector& vButton );
+
+        /// Button-operated teleporter (sgtls::ButtonTeleporters) whose link a bot is about to take: iNext is its entry
+        /// waypoint, or iCurrent its entry and iNext its exit. -1 if none.
+        static int TeleporterOnPath( TWaypointId iCurrent, TWaypointId iNext );
+
+        /// True once the teleporter has been on long enough to walk in (a stargate: after its kawoosh).
+        static bool TeleporterReady( int iTeleporter );
+
+        /// Button of the teleporter, NULL if not found. vButton receives its nearest point to vEye (4 units inside),
+        /// wButton the waypoint next to it.
+        static edict_t* TeleporterButton( int iTeleporter, const Vector& vEye, Vector& vButton, TWaypointId& wButton );
+
+        /// Press the teleporter's button for pActivator, unless the teleporter is on or the button was pressed less
+        /// than 0.5 s ago (by any bot: it ignores presses while it comes back). True if pressed.
+        static bool PressTeleporterButton( int iTeleporter, edict_t* pActivator );
+
+        /// Print the areas and their state (sgtls_objectives command).
+        static void Print();
+    };
+}
+
+#endif // __BOTRIX_OBJECTIVES_SGTLS_H__
diff --git a/mods/sgtls/sgtls_hooks.cpp b/mods/sgtls/sgtls_hooks.cpp
new file mode 100644
index 0000000..99a2384
--- /dev/null
+++ b/mods/sgtls/sgtls_hooks.cpp
@@ -0,0 +1,183 @@
+// Crash guards for Stargate: The Last Stand's server.dll (closed source, image base 0x10000000).
+//
+// CTLSPlayer::EntSelectSpawnPoint (vtable slot 0x550, server.dll 0x10244870) asks the player's team for a spawn
+// point. The "unassigned" team has none on some maps (tls_erebus), so it returns NULL, and the caller
+// (0x10131db0) dereferences it: crash when a bot connects (bots spawn before choosing a team). The hook falls back
+// to what the function does for spectators: the first info_player_teamspawn.
+#ifdef _WIN32
+
+#include <string.h>
+
+#include "tier0/dbg.h"
+
+extern "C" __declspec(dllimport) void* __stdcall GetModuleHandleA( const char* szModule );
+extern "C" __declspec(dllimport) int __stdcall VirtualProtect( void* pAddress, unsigned long iSize, unsigned long iNew,
+                                                               unsigned long* pOld );
+
+namespace
+{
+    const unsigned int iImageBase = 0x10000000;
+    const unsigned int iPlayerVtable = 0x1039398c;      // CTLSPlayer vtable.
+    const unsigned int iSlotSelectSpawn = 0x550;
+    const unsigned int iSelectSpawnFn = 0x10244870;     // Expected content of the slot (checks the binary).
+    const unsigned int iFindByClassnameFn = 0x10100ff0; // CGlobalEntityList::FindEntityByClassname (thiscall).
+    const unsigned int iEntityList = 0x10440d28;        // gEntList.
+
+    char* m_pBase = NULL;
+    void** m_pSlot = NULL;
+    void* m_pOriginal = NULL;
+
+    // thiscall emulated with fastcall: ecx = this, edx unused.
+    typedef void* ( __fastcall *TSelectSpawn )( void* pThis, void* pEdx );
+    typedef void* ( __fastcall *TFindByClassname )( void* pThis, void* pEdx, void* pStart, const char* szName );
+
+    void* FindByClassname( const char* szClassname )
+    {
+        TFindByClassname pFind = (TFindByClassname)( m_pBase + ( iFindByClassnameFn - iImageBase ) );
+        return pFind( m_pBase + ( iEntityList - iImageBase ), NULL, NULL, szClassname );
+    }
+
+    void* __fastcall SelectSpawnHook( void* pThis, void* pEdx )
+    {
+        void* pSpawn = ( (TSelectSpawn)m_pOriginal )( pThis, pEdx );
+        if ( !pSpawn )
+        {
+            // During a round restart the spawn points don't exist yet: last resort, the world (always there).
+            pSpawn = FindByClassname( "info_player_teamspawn" );
+            if ( !pSpawn )
+                pSpawn = FindByClassname( "worldspawn" );
+            Msg( "[Botrix] sgtls: no spawn point for a player, fallback %p.\n", pSpawn );
+        }
+        return pSpawn;
+    }
+
+    bool WriteSlot( void* pValue )
+    {
+        unsigned long iOld = 0;
+        if ( !VirtualProtect( m_pSlot, sizeof(void*), 0x04 /* PAGE_READWRITE */, &iOld ) )
+            return false;
+        *m_pSlot = pValue;
+        VirtualProtect( m_pSlot, sizeof(void*), iOld, &iOld );
+        return true;
+    }
+}
+
+namespace sgtls
+{
+    void InstallHooks()
+    {
+        m_pBase = (char*)GetModuleHandleA( "server.dll" );
+        if ( !m_pBase || m_pOriginal )
+            return;
+        m_pSlot = (void**)( m_pBase + ( iPlayerVtable - iImageBase ) + iSlotSelectSpawn );
+        if ( *m_pSlot != m_pBase + ( iSelectSpawnFn - iImageBase ) )
+        {
+            Msg( "[Botrix] sgtls: unknown server.dll, spawn point guard not installed.\n" );
+            return;
+        }
+        m_pOriginal = *m_pSlot;
+        if ( WriteSlot( (void*)SelectSpawnHook ) )
+            Msg( "[Botrix] sgtls: spawn point guard installed.\n" );
+        else
+            m_pOriginal = NULL;
+    }
+
+    void RemoveHooks()
+    {
+        if ( m_pOriginal && WriteSlot( m_pOriginal ) )
+            m_pOriginal = NULL;
+    }
+
+    bool HasSpawnPoints()
+    {
+        return !m_pOriginal || FindByClassname( "info_player_teamspawn" ) != NULL; // Unknown binary: don't block.
+    }
+}
+
+#elif defined(__linux__)
+
+// Linux: the same guard in server_i486.so, found by name (linux_server.cpp). GCC's thiscall is cdecl with this
+// first.
+
+#include "tier0/dbg.h"
+#include "mods/sgtls/sgtls_util.h"
+
+namespace
+{
+    void** m_pSlot = NULL;
+    void* m_pOriginal = NULL;
+    void* m_pEntityList = NULL;
+
+    typedef void* ( *TSelectSpawn )( void* pThis );
+    typedef void* ( *TFindByClassname )( void* pThis, void* pStart, const char* szName );
+    TFindByClassname m_pfnFindByClassname = NULL;
+
+    void* FindByClassname( const char* szClassname )
+    {
+        return m_pfnFindByClassname( m_pEntityList, NULL, szClassname );
+    }
+
+    void* SelectSpawnHook( void* pThis )
+    {
+        void* pSpawn = ( (TSelectSpawn)m_pOriginal )( pThis );
+        if ( !pSpawn )
+        {
+            // During a round restart the spawn points don't exist yet: last resort, the world (always there).
+            pSpawn = FindByClassname( "info_player_teamspawn" );
+            if ( !pSpawn )
+                pSpawn = FindByClassname( "worldspawn" );
+            Msg( "[Botrix] sgtls: no spawn point for a player, fallback %p.\n", pSpawn );
+        }
+        return pSpawn;
+    }
+}
+
+namespace sgtls
+{
+    void InstallHooks()
+    {
+        if ( m_pOriginal )
+            return;
+        // The vtable symbol starts with offset-to-top and the typeinfo: the slots follow.
+        void** pVtable = (void**)ServerSymbol( "_ZTV10CTLSPlayer" );
+        void* pSelectSpawn = ServerSymbol( "_ZN10CTLSPlayer19EntSelectSpawnPointEv" );
+        m_pfnFindByClassname =
+            (TFindByClassname)ServerSymbol( "_ZN17CGlobalEntityList21FindEntityByClassnameEP11CBaseEntityPKc" );
+        m_pEntityList = ServerSymbol( "gEntList" );
+        int iSlot = ( pVtable && pSelectSpawn ) ? VtableSlot( pVtable + 2, pSelectSpawn ) : -1;
+        if ( iSlot < 0 || !m_pfnFindByClassname || !m_pEntityList )
+        {
+            Msg( "[Botrix] sgtls: unknown server .so, spawn point guard not installed.\n" );
+            return;
+        }
+        m_pSlot = pVtable + 2 + iSlot;
+        m_pOriginal = *m_pSlot;
+        void* pHook = (void*)SelectSpawnHook;
+        if ( WriteCode( m_pSlot, &pHook, sizeof(pHook) ) )
+            Msg( "[Botrix] sgtls: spawn point guard installed (vtable slot %d).\n", iSlot );
+        else
+            m_pOriginal = NULL;
+    }
+
+    void RemoveHooks()
+    {
+        if ( m_pOriginal && WriteCode( m_pSlot, &m_pOriginal, sizeof(m_pOriginal) ) )
+            m_pOriginal = NULL;
+    }
+
+    bool HasSpawnPoints()
+    {
+        return !m_pOriginal || FindByClassname( "info_player_teamspawn" ) != NULL; // Unknown binary: don't block.
+    }
+}
+
+#else
+
+namespace sgtls
+{
+    void InstallHooks() {}
+    void RemoveHooks() {}
+    bool HasSpawnPoints() { return true; }
+}
+
+#endif
