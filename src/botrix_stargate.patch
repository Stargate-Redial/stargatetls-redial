+
+const std::vector<sgtls::CButtonTeleporter>& sgtls::ButtonTeleporters()
+{
+    const std::vector<CBspEntity>& aEnts = BspEntities();
+    if ( m_sButtonTeleportersMap == m_sEntitiesMap )
+        return m_aButtonTeleporters;
+    m_sButtonTeleportersMap = m_sEntitiesMap;
+    m_aButtonTeleporters.clear();
+#ifdef BOTRIX_SGTC2
+    return m_aButtonTeleporters; // StargateTC 2's stargates are bfl_ entities (stargates_sgtc2.cpp).
+#endif
+
+    std::map<std::string, const CBspEntity*> aNamed;
+    TByName aByName;
+    for ( size_t i = 0; i < aEnts.size(); ++i )
+        if ( aEnts[i].Get( "targetname" )[0] )
+        {
+            if ( !aNamed.count( aEnts[i].Get( "targetname" ) ) )
+                aNamed[ aEnts[i].Get( "targetname" ) ] = &aEnts[i];
+            aByName.insert( std::make_pair( std::string( aEnts[i].Get( "targetname" ) ), &aEnts[i] ) );
+        }
+    for ( size_t i = 0; i < aEnts.size(); ++i )
+    {
+        const CBspEntity& e = aEnts[i];
+        std::string sName = e.Get( "targetname" );
+        if ( !e.bBrush || strcmp( e.Get( "classname" ), "trigger_teleport" ) != 0 || IsKillTeleport( e ) ||
+             strcmp( e.Get( "StartDisabled" ), "1" ) != 0 || sName.empty() || !aNamed.count( e.Get( "target" ) ) )
+            continue;
+        Vector vCenter = ( e.vMins + e.vMaxs ) * 0.5f;
+
+        // Buttons that enable it, directly or through the map's logic (relays, branches, a math_counter: each press
+        // adds to it, OnHitMax enables). Kept: a button that turns it on for good or for 10 seconds or more (a gate
+        // that closes after a minute), and one inside the teleporter (a transporter booth: on for a moment, some
+        // seconds after the press, the bot waits inside). Not: the other momentary ones (tls_abydos's rings: the
+        // button is outside, locked most of the time, and a bot must stand in the ring at the right moment).
+        const CBspEntity* pBest = NULL;
+        CChainResult cBest = { -1.0f, -1.0f, 0 };
+        float fBestDistance = 1500.0f;
+        std::vector< std::pair<float, const CBspEntity*> > aCandidates; // Not momentary ones, within 3000 units.
+        for ( size_t b = 0; b < aEnts.size(); ++b )
+        {
+            const CBspEntity& cButton = aEnts[b];
+            if ( !cButton.bBrush || strcmp( cButton.Get( "classname" ), "func_button" ) != 0 )
+                continue;
+            CChainResult r = { -1.0f, -1.0f, 0 };
+            FollowChain( aByName, cButton, "OnPressed", NULL, 0.0f, 1, 0, sName, r );
+            if ( r.fEnable < 0.0f || r.iPresses <= 0 )
+                continue;
+            bool bMomentary = r.fDisable >= r.fEnable && r.fDisable < r.fEnable + 10.0f;
+            if ( r.fDisable >= 0.0f && r.fDisable < r.fEnable )
+                continue; // Turned off first: a toggle.
+            Vector vButton = ( cButton.vMins + cButton.vMaxs ) * 0.5f;
+            // A momentary one: a transporter booth (its button inside), or rings (the button beside the platform,
+            // time enough to walk in: tls_sandfort_beta3, tls_omega_b1, kheb... 13 of the new maps).
+            if ( bMomentary && ( r.iPresses != 1 || DistanceToBox( vButton, e.vMins, e.vMaxs ) > 400.0f ||
+                                 ( DistanceToBox( vButton, e.vMins, e.vMaxs ) > 32.0f && r.fEnable < 2.0f ) ) )
+                continue;
+            float fDistance = vButton.DistTo( vCenter );
+            if ( !bMomentary && fDistance < 3000.0f )
+                aCandidates.push_back( std::make_pair( fDistance, &cButton ) );
+            if ( fDistance < fBestDistance )
+            {
+                pBest = &cButton;
+                cBest = r;
+                fBestDistance = fDistance;
+            }
+        }
+        if ( !pBest )
+            continue;
+
+        CButtonTeleporter t;
+        t.pTeleporter = &e;
+        t.pButton = pBest;
+        t.iPresses = cBest.iPresses;
+        t.fDelay = cBest.fEnable;
+        t.bMomentary = cBest.fDisable >= 0.0f && cBest.fDisable < cBest.fEnable + 10.0f;
+        t.bRing = t.bMomentary && DistanceToBox( ( pBest->vMins + pBest->vMaxs ) * 0.5f, e.vMins, e.vMaxs ) > 32.0f;
+        std::sort( aCandidates.begin(), aCandidates.end() );
+        for ( size_t c = 0; c < aCandidates.size() && !t.bMomentary; ++c )
+            t.aButtons.push_back( aCandidates[c].second );
+        // The rings' holding room: the destination is inside another teleporter (on a tenth of a second later), which
+        // sends on.
+        t.pDestination = aNamed[ e.Get( "target" ) ];
+        float fArrival = cBest.fEnable; // When the traveller gets to t.pDestination.
+        for ( int iHop = 0; iHop < 3 && t.bRing; ++iHop )
+        {
+            const CBspEntity* pNext = NULL;
+            float fNextArrival = 0.0f;
+            for ( size_t k = 0; k < aEnts.size() && !pNext; ++k )
+            {
+                const CBspEntity& h = aEnts[k];
+                if ( &h == &e || !h.bBrush || strcmp( h.Get( "classname" ), "trigger_teleport" ) != 0 || IsKillTeleport( h ) ||
+                     !Inside( t.pDestination->vOrigin, h.vMins - Vector( 8, 8, 40 ), h.vMaxs + Vector( 8, 8, 8 ) ) ||
+                     !aNamed.count( h.Get( "target" ) ) )
+                    continue;
+                // Turned on by the same press once the traveller is there (the other ring's platform is on from
+                // 5.30 to 5.34 s, the holding room sends there at 5.35 s: not a hop, the swap).
+                CChainResult rHop = { -1.0f, -1.0f, 0 };
+                FollowChain( aByName, *pBest, "OnPressed", NULL, 0.0f, 1, 0, h.Get( "targetname" ), rHop );
+                if ( rHop.fEnable > fArrival )
+                {
+                    pNext = aNamed[ h.Get( "target" ) ];
+                    fNextArrival = rHop.fEnable;
+                }
+            }
+            if ( !pNext )
+                break;
+            t.pDestination = pNext;
+            fArrival = fNextArrival;
+        }
+        // The rings' moving parts at both stations (they run together): func_trains starting (or first stopping)
+        // within 150 units of the platform's axis or of the destination. tls_stargate_beta1: the other way's
+        // teleporter isn't usable, its station was watched by nothing, and arriving bots were crushed there.
+        // Also func_doors (tls_hatak: each ring set is one door rising around the platform, forceclosed: a bot
+        // standing on the ring was lifted into the ceiling and stopped it 3 to 13 s, the teleporter came on 7 to 17 s
+        // after the press instead of 4.4, the presser had left).
+        for ( int iStation = 0; iStation < 2 && t.bRing; ++iStation )
+        {
+            Vector vRingCenter = iStation ? t.pDestination->vOrigin : ( e.vMins + e.vMaxs ) * 0.5f;
+            for ( size_t k = 0; k < aEnts.size(); ++k )
+            {
+                const CBspEntity& r = aEnts[k];
+                if ( !r.bBrush || ( strcmp( r.Get( "classname" ), "func_train" ) != 0 &&
+                                    strcmp( r.Get( "classname" ), "func_door" ) != 0 ) ||
+                     std::find( t.aRingParts.begin(), t.aRingParts.end(), &r ) != t.aRingParts.end() )
+                    continue;
+                Vector vAt = ( r.vMins + r.vMaxs ) * 0.5f;
+                if ( aNamed.count( r.Get( "target" ) ) && ( vAt - vRingCenter ).Length2D() > 150.0f )
+                    vAt = aNamed[ r.Get( "target" ) ]->vOrigin;
+                if ( ( vAt - vRingCenter ).Length2D() <= 150.0f && fabs( vAt.z - vRingCenter.z ) < 300.0f )
+                    t.aRingParts.push_back( &r );
+            }
+        }
+        LinkEnds( e, *t.pDestination, t.vEntry, t.vExit );
+        CrossingDepth( t, e, aNamed );
+        for ( int iSide = 0; iSide < 2; ++iSide )
+            if ( t.fSafeDepth[iSide] > 0.0f )
+                LogGateDepth( e.Get( "targetname" ), iSide, t.iCrossAxis, t.fSafeDepth[iSide] - 0.4f );
+        // tls_lockdown: the kawoosh kills in front of both gates from 1.7 to 3.1 seconds after the dialing.
+        t.fKawoosh = 0.0f;
+        const std::vector<const CBspEntity*>& aKill = ForbiddenBoxes();
+        for ( size_t k = 0; k < aKill.size(); ++k )
+            if ( DistanceToBox( t.vEntry, aKill[k]->vMins, aKill[k]->vMaxs ) < 300.0f ||
+                 DistanceToBox( t.vExit, aKill[k]->vMins, aKill[k]->vMaxs ) < 300.0f )
+                t.fKawoosh = 4.0f;
+        m_aButtonTeleporters.push_back( t );
+    }
+    return m_aButtonTeleporters;
+}
