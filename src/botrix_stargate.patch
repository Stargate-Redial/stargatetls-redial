+bool sgtls::CObjectives::RingsActive( int iTeleporter )
+{
+    if ( iTeleporter < 0 || iTeleporter >= (int)m_aTeleporters.size() )
+        return false;
+    CTeleporter& t = m_aTeleporters[iTeleporter];
+    float fNow = CBotrixPlugin::fTime;
+    if ( t.fRingsChecked == fNow || t.aRingParts.empty() )
+        return t.bRingsActive && !t.aRingParts.empty();
+    t.fRingsChecked = fNow;
+    size_t n = t.aRingParts.size();
+    if ( t.aPartState.size() != n )
+    {
+        t.aPartState.assign( n, 0 );
+        t.aPartLast.assign( n, Vector( 0.0f, 0.0f, 0.0f ) );
+        t.aPartHome = t.aPartLast;
+        t.aPartMoved.assign( n, -100.0f );
+        t.aPartStill.assign( n, fNow );
+    }
+    bool bActive = false;
+    for ( size_t r = 0; r < n; ++r )
+    {
+        edict_t* p = t.aRingParts[r];
+        if ( !p || p->IsFree() || !p->GetCollideable() )
+            continue;
+        Vector v = p->GetCollideable()->GetCollisionOrigin();
+        if ( t.aPartState[r] == 0 )
+        {
+            t.aPartState[r] = 1;
+            t.aPartLast[r] = v;
+            t.aPartStill[r] = fNow;
+        }
+        else if ( v.DistToSqr( t.aPartLast[r] ) > 0.01f )
+        {
+            t.aPartLast[r] = v;
+            t.aPartMoved[r] = t.aPartStill[r] = fNow;
+        }
+        else if ( fNow - t.aPartStill[r] > 10.0f )
+        {
+            t.aPartHome[r] = v; // The floor halves wait 6.5 s open, the rings' whole run takes 8: not a rest.
+            t.aPartState[r] = 2;
+        }
+        if ( fNow - t.aPartMoved[r] < 0.5f || ( t.aPartState[r] == 2 && v.DistToSqr( t.aPartHome[r] ) > 4.0f ) )
+            bActive = true;
+    }
+    t.bRingsActive = bActive;
+    return bActive;
+}
