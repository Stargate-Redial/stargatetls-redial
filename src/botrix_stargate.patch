+void sgtls::ApplyMapCfgFeatures( const char* szPath )
+{
+    FILE* f = fopen( szPath, "rb" );
+    if ( !f )
+        return;
+    char szLine[256], szName[64];
+    int iOn;
+    bool bAny = false;
+    while ( fgets( szLine, sizeof(szLine), f ) )
+        if ( sscanf( szLine, SGTLS_PREFIX "_feature %63s %d", szName, &iOn ) == 2 )
+            bAny |= SetFeature( szName, iOn != 0 );
+    fclose( f );
+    if ( bAny )
+        Msg( "[Botrix] Map-pack behaviours set by the map cfg at load: 0x%x.\n", iFeatures );
+}
+bool sgtls::bCaptureDiag = false;
+
+void sgtls::LogCapture( CPlayer* pCapper, const char* szEvent )
+{
+    const Vector& vCap = pCapper->GetHead();
+    int iAlive = 0, iNear = 0, iSee = 0, iOnHim = 0, iOther = 0, iEscort = 0;
+    std::string sList;
+    CTraceFilterWorldOnly cFilter;
+    for ( TPlayerIndex i = 0; i < CPlayers::Size(); ++i )
+    {
+        CPlayer* p = CPlayers::Get( i );
+        if ( !p || p == pCapper || !p->IsAlive() || p->GetTeam() < 2 )
+            continue;
+        float fDist = p->GetHead().DistTo( vCap );
+        if ( p->GetTeam() == pCapper->GetTeam() )
+        {
+            if ( fDist < 800.0f )
+                ++iEscort;
+            continue;
+        }
+        ++iAlive;
+        if ( fDist > 1500.0f )
+            continue;
+        ++iNear;
+        Ray_t ray;
+        ray.Init( p->GetHead(), vCap );
+        trace_t tr;
+        CBotrixPlugin::pEngineTrace->TraceRay( ray, MASK_PLAYERSOLID, &cFilter, &tr );
+        bool bSee = tr.fraction >= 0.99f;
+        CPlayer* pEnemy = p->IsBot() ? ( (CBot*)p )->GetCurrentEnemy() : NULL;
+        bool bEnemy = true, bVis = bSee, bCone = bSee;
+        if ( p->IsBot() )
+            ( (CBot*)p )->DiagSight( pCapper, bEnemy, bVis, bCone );
+        iSee += bSee;
+        if ( pEnemy == pCapper )
+            ++iOnHim;
+        else if ( pEnemy )
+            ++iOther;
+        // A line through the world only, but the bots' own sight blocked: by what (entity class / model, how far).
+        char szBlock[96] = "";
+        if ( bSee && !bVis )
+        {
+            Vector vEar;
+            CUtil::EntityHead( pCapper->GetEdict(), vEar );
+            CTraceFilterWithFlags& cBots = CUtil::GetTraceFilter( EVisibilityBots );
+            CUtil::TraceLine( p->GetHead(), vEar, cBots.iTraceFlags, &cBots );
+            const trace_t& t = CUtil::TraceResult();
+            const char* szHit = "world";
+            const char* szModel = "";
+            if ( t.m_pEnt )
+            {
+                int iHit = reinterpret_cast<IHandleEntity*>( t.m_pEnt )->GetRefEHandle().GetEntryIndex();
+                edict_t* pHit = CBotrixPlugin::pEngineServer->PEntityOfEntIndex( iHit );
+                if ( pHit && !pHit->IsFree() )
+                {
+                    szHit = pHit->GetClassName();
+                    szModel = pHit->GetIServerEntity() ? STRING( pHit->GetIServerEntity()->GetModelName() ) : "";
+                }
+                else if ( iHit > 0 )
+                    szHit = "static prop";
+            }
+            snprintf( szBlock, sizeof( szBlock ), " blocked by %s %s at %.0f", szHit, szModel, t.fraction * p->GetHead().DistTo( vEar ) );
+        }
+        char sz[256];
+        snprintf( sz, sizeof( sz ), " [%s %.0f @%.0f,%.0f,%.0f%s%s%s%s%s%s]", p->GetName(), fDist, p->GetHead().x, p->GetHead().y, p->GetHead().z, bSee ? " sees" : "", bVis ? " vis" : "",
+                  bCone ? " cone" : "", bEnemy ? "" : " notenemy", pEnemy == pCapper ? " on him" : pEnemy ? " busy" : "", szBlock );
+        sList += sz;
+    }
+    char szLine[2048];
+    snprintf( szLine, sizeof( szLine ), "%s: capture diag %s by %s hp %d at %.0f %.0f %.0f: defenders alive %d, within 1500 %d, "
+              "line of sight %d, targeting him %d, fighting another %d; attackers within 800: %d;%s",
+              CBotrixPlugin::instance->sMapName.c_str(), szEvent, pCapper->GetName(), pCapper->IsAlive() ? pCapper->GetHealth() : 0,
+              vCap.x, vCap.y, vCap.z, iAlive, iNear, iSee, iOnHim, iOther, iEscort, sList.c_str() );
+    AuditLog( szLine );
+}
