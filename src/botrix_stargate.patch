+#include "tier0/memdbgon.h"
+
+
+#ifdef _WIN32
+// Not including windows.h: it clashes with the SDK headers.
+extern "C" __declspec(dllimport) void* __stdcall GetModuleHandleA( const char* szModule );
+extern "C" __declspec(dllimport) int __stdcall VirtualProtect( void* pAddress, unsigned long iSize, unsigned long iNew,
+                                                               unsigned long* pOld );
+#endif
+
+IServerGameDLL* sgtls::pServerGameDll = NULL;
+
+#ifdef BOTRIX_SOURCE_ENGINE_2006
+// episode1 commands get their arguments from the engine: same interface as the Orange Box CCommand.
+class CCommand
+{
+public:
+    int ArgC() const { return CBotrixPlugin::pEngineServer->Cmd_Argc(); }
+    const char* Arg( int i ) const { return CBotrixPlugin::pEngineServer->Cmd_Argv( i ); }
+    const char* ArgS() const { return CBotrixPlugin::pEngineServer->Cmd_Args(); }
+};
+#define SGTLS_COMMAND_CALLBACK( fn ) fn##_NoArgs
+#define SGTLS_DECLARE_NOARGS( fn ) void fn##_NoArgs() { CCommand args; fn( args ); }
+
+namespace
+{
+    // Every ConCommand of this DLL (ours and Botrix's "botrix") goes through here once OneTimeInit is called.
+    class CPluginConVarAccessor: public IConCommandBaseAccessor
+    {
+    public:
+        virtual bool RegisterConCommandBase( ConCommandBase* pCommand )
+        {
+            pCommand->AddFlags( FCVAR_PLUGIN );
+            pCommand->SetNext( NULL ); // Unlink from the plugin-only list, the engine links it in its own.
+            CBotrixPlugin::pCVar->RegisterConCommandBase( pCommand );
+            return true;
+        }
+    };
+    CPluginConVarAccessor cConVarAccessor;
+}
+#else
+#define SGTLS_COMMAND_CALLBACK( fn ) fn
+#define SGTLS_DECLARE_NOARGS( fn )
+#endif
+
+// Debug commands are named <prefix>_dump etc.
+#if defined(BOTRIX_SGTC2)
+    #define SGTLS_PREFIX "sgtc2"
+#else
+    #define SGTLS_PREFIX "sgtls"
+#endif
+
+namespace
+{
+    std::map<std::string, int> m_cOffsets; // "ServerClass/prop" -> offset (-1 = missing).
+
+    int FindInTable( SendTable* pTable, const char* szProp, int iBase )
+    {
+        for ( int i = 0; i < pTable->GetNumProps(); ++i )
+        {
+            SendProp* pProp = pTable->GetProp( i );
+            if ( pProp->GetType() == DPT_DataTable )
+            {
+                if ( strcmp( pProp->GetName(), szProp ) == 0 )
+                    return iBase + pProp->GetOffset();
+                int iFound = FindInTable( pProp->GetDataTable(), szProp, iBase + pProp->GetOffset() );
+                if ( iFound >= 0 )
+                    return iFound;
+            }
+            else if ( strcmp( pProp->GetName(), szProp ) == 0 )
+                return iBase + pProp->GetOffset();
+        }
+        return -1;
+    }
+
+    void PrintTable( SendTable* pTable, int iBase, int iDepth )
+    {
+        static const char* aTypes[] = { "int", "float", "vector", "string", "array", "table" }; // Orange Box order.
+        for ( int i = 0; i < pTable->GetNumProps(); ++i )
+        {
+            SendProp* pProp = pTable->GetProp( i );
+            int iType = pProp->GetType();
+            Msg( "%*s%-40s %-8s off %d\n", iDepth * 2, "", pProp->GetName(),
+                 (iType >= 0 && iType < 6) ? aTypes[iType] : "?", iBase + pProp->GetOffset() );
+            if ( iType == DPT_DataTable && pProp->GetDataTable() && iDepth < 6 )
+                PrintTable( pProp->GetDataTable(), iBase + pProp->GetOffset(), iDepth + 1 );
+        }
+    }
+
+    char* EntityBase( edict_t* pEdict )
+    {
+        if ( !pEdict || pEdict->IsFree() || !pEdict->GetUnknown() )
+            return NULL;
+        return (char*)pEdict->GetUnknown()->GetBaseEntity();
+    }
+
+    // sgtls_props <ServerClass> : list the network properties of a server class with their offsets.
+    void PropsCommand( const CCommand& args )
+    {
+        if ( !sgtls::pServerGameDll )
+            return;
+        for ( ServerClass* pClass = sgtls::pServerGameDll->GetAllServerClasses(); pClass; pClass = pClass->m_pNext )
+        {
+            if ( args.ArgC() < 2 )
+                Msg( "%s (%s)\n", pClass->GetName(), pClass->m_pTable->GetName() );
+            else if ( strcmp( pClass->GetName(), args.Arg( 1 ) ) == 0 )
+            {
+                Msg( "%s (%s):\n", pClass->GetName(), pClass->m_pTable->GetName() );
+                PrintTable( pClass->m_pTable, 0, 1 );
+            }
+        }
+    }
+
+    // sgtls_dump : players (team, class, health, weapon...) and non-player entities of interesting classes.
+    void DumpCommand( const CCommand& args )
+    {
+        IVEngineServer* pEngine = CBotrixPlugin::pEngineServer;
+        // GetPlayerInfo() doesn't check that the entity is a player: only look at player slots.
+        int iMaxClients = CBotrixPlugin::pPlayerInfoManager->GetGlobalVars()->maxClients;
+        for ( int i = 1; i <= iMaxClients; ++i )
+        {
+            edict_t* pEdict = pEngine->PEntityOfEntIndex( i );
+            if ( !EntityBase( pEdict ) )
+                continue;
+            IPlayerInfo* pInfo = CBotrixPlugin::pPlayerInfoManager->GetPlayerInfo( pEdict );
+            if ( !pInfo || !pInfo->IsConnected() )
+                continue;
+            Vector v = pInfo->GetAbsOrigin();
+            CPlayer* pPlayer = CPlayers::Get( pEdict );
+            if ( pPlayer && pPlayer->IsBot() )
+            {
+                char szState[768];
+                ( (const CBot_HL2DM*)pPlayer )->DebugState( szState, sizeof( szState ) );
+                Msg( "    %s\n", szState );
+            }
+            IServerEntity* pPlayerEntity = pEdict->GetIServerEntity();
+            Msg( "#%d %-16s team %d (net %d) classcur %d live %d hp %d ar %d %s%s obsmode %d wpn %s pos %.0f %.0f %.0f model %s\n",
+                 i, pInfo->GetName(), pInfo->GetTeamIndex(), sgtls::GetInt( pEdict, "m_iTeamNum" ),
+                 sgtls::GetInt( pEdict, "m_iClassIDCurrent" ), sgtls::GetInt( pEdict, "m_iLiveClassID" ),
+                 pInfo->GetHealth(), pInfo->GetArmorValue(), pInfo->IsDead() ? "DEAD" : "alive",
+                 pInfo->IsObserver() ? " OBSERVER" : "", sgtls::GetInt( pEdict, "m_iObserverMode" ),
+                 pInfo->GetWeaponName() ? pInfo->GetWeaponName() : "-", v.x, v.y, v.z,
+                 pPlayerEntity ? STRING( pPlayerEntity->GetModelName() ) : "-" );
+            int iWeapons = sgtls::PropOffset( pEdict, "m_hMyWeapons" );
+            if ( iWeapons >= 0 )
+            {
+                Msg( "    weapons:" );
+                const int* aHandles = (const int*)( EntityBase( pEdict ) + iWeapons );
+                int iAmmo = sgtls::PropOffset( pEdict, "m_iAmmo" );
+                for ( int w = 0; w < 48; ++w )
+                {
+                    if ( aHandles[w] == -1 )
+                        continue;
+                    edict_t* pWeapon = pEngine->PEntityOfEntIndex( aHandles[w] & 0xFFF );
+                    if ( !EntityBase( pWeapon ) )
+                    {
+                        Msg( " ?" );
+                        continue;
+                    }
+                    // Clip / reserve ammo of its primary ammo type.
+                    int iType = sgtls::GetInt( pWeapon, "m_iPrimaryAmmoType", -1 );
+                    int iReserve = ( iAmmo >= 0 && iType >= 0 && iType < 32 ) ? *(const int*)( EntityBase( pEdict ) + iAmmo + 4 * iType ) : -1;
+                    Msg( " %s(%d/%d)", pWeapon->GetClassName(), sgtls::GetInt( pWeapon, "m_iClip1", -1 ), iReserve );
+                }
+                Msg( "\n" );
+            }
+        }
+        const char* szFilter = args.ArgC() > 1 ? args.Arg( 1 ) : NULL;
+        if ( !szFilter )
+            return;
+        for ( int i = 1; i < pEngine->GetEntityCount(); ++i )
+        {
+            edict_t* pEdict = pEngine->PEntityOfEntIndex( i );
+            if ( !EntityBase( pEdict ) )
+                continue;
+            const char* szClass = sgtls::ServerClassName( pEdict );
+            const char* szName = pEdict->GetClassName();
+            if ( !strstr( szClass, szFilter ) && !(szName && strstr( szName, szFilter )) )
+                continue;
+            ICollideable* pColl = pEdict->GetCollideable();
+            Vector v( 0, 0, 0 ), vSize( 0, 0, 0 );
+            if ( pColl )
+            {
+                v = pColl->GetCollisionOrigin() + ( pColl->OBBMins() + pColl->OBBMaxs() ) * 0.5f;
+                vSize = pColl->OBBMaxs() - pColl->OBBMins();
+            }
+            IServerEntity* pServerEntity = pEdict->GetIServerEntity();
+            Msg( "ent %d %s (%s) center %.0f %.0f %.0f size %.0f %.0f %.0f team %d model %s", i,
+                 szName ? szName : "?", szClass, v.x, v.y, v.z, vSize.x, vSize.y, vSize.z,
+                 sgtls::GetInt( pEdict, "m_iTeamNum" ), pServerEntity ? STRING( pServerEntity->GetModelName() ) : "" );
+            static const char* aExtra[] = { "m_bEnabled", "m_iTeamFilter", "m_iOrder", "m_iObjectiveType",
+                                            "m_bAttacked", "m_bTeam2CanCap", "m_bTeam3CanCap", "m_iNetOwnerTeam" };
+            for ( int j = 0; j < sizeof(aExtra) / sizeof(aExtra[0]); ++j )
+            {
+                int iOffset = sgtls::PropOffset( pEdict, aExtra[j] );
+                if ( iOffset >= 0 )
+                {
+                    // Booleans are 1 byte: don't read the neighbours.
+                    int iValue = ( aExtra[j][2] == 'b' ) ? *( EntityBase( pEdict ) + iOffset )
+                                                         : sgtls::GetInt( pEdict, aExtra[j] );
+                    Msg( " %s %d", aExtra[j] + 2, iValue );
+                }
+            }
+            if ( sgtls::PropOffset( pEdict, "m_fNetCurrentPoints" ) >= 0 )
+                Msg( " points %.1f/%.1f", sgtls::GetFloat( pEdict, "m_fNetCurrentPoints" ),
+                     sgtls::GetFloat( pEdict, "m_fPointsForCap" ) );
+            Msg( "\n" );
+        }
+    }
+
+    // Address inside sgtls server.dll (static VA, image base 0x10000000) -> address in this process.
+    char* ServerVA( unsigned int iVA )
+    {
+#ifdef _WIN32
+        static char* pBase = (char*)GetModuleHandleA( "server.dll" );
+        return pBase ? pBase + ( iVA - 0x10000000 ) : NULL;
+#else
+        return NULL; // Addresses of the Windows server.dll: sgtls_equipids does nothing elsewhere.
+#endif
+    }
+
+    const char* PrintableAt( const char* p )
+    {
+        for ( int i = 0; i < 40; ++i )
+            if ( p[i] == 0 )
+                return i > 2 ? p : NULL;
+            else if ( p[i] < 32 || p[i] > 126 )
+                return NULL;
+        return NULL;
+    }
+
+    // sgtls_equipids : dump the equipment ids used by "setequipcode" (bit b = item id b+1), from the tables
+    // read by the code validation function (server.dll 0x10244e80).
+    void EquipIdsCommand( const CCommand& args )
+    {
+        if ( !ServerVA( 0x10000000 ) )
+            return;
+        int iCount = *(int*)ServerVA( 0x10481f80 );
+        char** aWeapons = (char**)ServerVA( 0x10481ec0 );
+        Msg( "%d weapon infos\n", iCount );
+        for ( int i = 0; i < iCount && i < 48; ++i )
+        {
+            char* p = aWeapons[i];
+            if ( !p )
+                continue;
+            const char* szName = PrintableAt( p + 6 );
+            Msg( "  weapon id %d weight %d %s\n", *(int*)( p + 0xb7c ), *(int*)( p + 0xb80 ), szName ? szName : "?" );
+        }
+        char* pGameRules = *(char**)ServerVA( 0x1045627c );
+        char* pEquip = pGameRules ? *(char**)( pGameRules + 0x294 ) : NULL;
+        if ( pEquip )
+        {
+            int iEquip = *(int*)( pEquip + 0xd0 );
+            Msg( "%d equipments\n", iEquip );
+            for ( int i = 0; i < iEquip && i < 50; ++i )
+            {
+                char* p = ( (char**)( pEquip + 8 ) )[i];
+                if ( !p )
+                    continue;
+                const char* szName = NULL;
+                for ( int o = 4; o < 0x40 && !szName; ++o )
+                    szName = PrintableAt( p + o );
+                Msg( "  equip id %d weight %d %s\n", *(int*)p, *(int*)( p + 0x5fc ), szName ? szName : "?" );
+            }
+        }
+        char** aClasses = (char**)ServerVA( 0x1047cbe0 );
+        for ( int i = 0; i < 16; ++i )
+            if ( aClasses[i] )
+                Msg( "  class index %d mask 0x%08x\n", i, *(int*)( aClasses[i] + 0xd48 ) );
+        int iMaxClients = CBotrixPlugin::pPlayerInfoManager->GetGlobalVars()->maxClients;
+        for ( int i = 1; i <= iMaxClients; ++i )
+        {
+            char* pPlayer = EntityBase( CBotrixPlugin::pEngineServer->PEntityOfEntIndex( i ) );
+            if ( pPlayer )
+                Msg( "  player %d class index %d max weight? %d\n", i, *(int*)( pPlayer + 0x1008 ),
+                     *(int*)( pPlayer + 0x744 ) );
+        }
+    }
+
+    // sgtls_wpgen <distance> [per frame] : delete the waypoints and run the automatic map analysis.
+    // ("botrix waypoint clear/save" need a logged-in player, these work from the server console / rcon.)
+    void WpGenCommand( const CCommand& args )
+    {
+        if ( CWaypoints::IsAnalyzing() )
+        {
+            // Botrix analyzes maps without waypoints at load time: start again from scratch.
+            CWaypoints::StopAnalyzing();
+            Msg( "Stopped the analysis in progress.\n" );
+        }
+        if ( args.ArgC() > 1 )
+            CWaypoint::iAnalyzeDistance = atoi( args.Arg( 1 ) );
+        if ( args.ArgC() > 2 )
+            CWaypoint::fAnalyzeWaypointsPerFrame = (float)atof( args.Arg( 2 ) );
+        CWaypoints::Clear();
+        CItems::MapUnloaded();
+        CItems::MapLoaded( false );
+        CWaypoints::AnalyzeClear( CWaypoints::EAnalyzeWaypointsAdd );
+        int iSeeds = sgtls::AddAnalyzeSeeds();
+        Msg( "Analyzing with distance %d, %.1f waypoints per frame, %d seeds from the BSP.\n",
+             CWaypoint::iAnalyzeDistance, CWaypoint::fAnalyzeWaypointsPerFrame, iSeeds );
+        CWaypoints::Analyze( NULL, false );
+    }
+
+    // <prefix>_wpgrow [per frame] : analyze from the current waypoints and the BSP seeds, without clearing them
+    // (tls_lockdown: the SGC gate room, closed by blast doors, had no waypoints).
+    void WpGrowCommand( const CCommand& args )
+    {
+        if ( CWaypoints::IsAnalyzing() )
+        {
+            Msg( "Still analyzing.\n" );
+            return;
+        }
+        if ( args.ArgC() > 1 )
+            CWaypoint::fAnalyzeWaypointsPerFrame = (float)atof( args.Arg( 1 ) );
+        CWaypoints::AnalyzeClear( CWaypoints::EAnalyzeWaypointsAdd );
+        int iSeeds = sgtls::AddAnalyzeSeeds();
+        Msg( "Analyzing from %d waypoints and %d seeds from the BSP, distance %d.\n", CWaypoints::Size(), iSeeds,
+             CWaypoint::iAnalyzeDistance );
+        CWaypoints::Analyze( NULL, false );
+    }
+
+    // sgtls_wpsave : link the stargates / remove killbox paths, then save the waypoints (with the visibility table).
+    void WpSaveCommand( const CCommand& args )
+    {
+        if ( CWaypoints::IsAnalyzing() )
+        {
+            Msg( "Still analyzing.\n" );
+            return;
+        }
+        Msg( "%s", sgtls::PostProcessWaypoints().c_str() );
+        bool bResult = CWaypoints::Save();
+        Msg( bResult ? "%d waypoints saved.\n" : "Error, could not save %d waypoints.\n", CWaypoints::Size() );
+        CItems::MapUnloaded();
+        CItems::MapLoaded( true );
+    }
+
+    // sgtls_reach x y z x y z [glass] : Botrix's reachability test between two eye positions, with the ground below
+    // each; "glass": through windows, as the spawn island repair does.
+    // sgtls_slope <waypoint> <waypoint>: the ground every 8 units along a path (height, slope, displacement or not).
+    void SlopeCommand( const CCommand& args )
+    {
+        if ( args.ArgC() < 3 )
+            return;
+        TWaypointId iFrom = atoi( args.Arg( 1 ) ), iTo = atoi( args.Arg( 2 ) );
+        if ( !CWaypoints::IsValid( iFrom ) || !CWaypoints::IsValid( iTo ) )
+            return;
+        const Vector& a = CWaypoints::Get( iFrom ).vOrigin;
+        const Vector& b = CWaypoints::Get( iTo ).vOrigin;
+        int iSteps = (int)( ( b - a ).Length2D() / 8.0f ) + 1;
+        Msg( "%d (%.0f %.0f %.0f) -> %d (%.0f %.0f %.0f), path %s\n", iFrom, a.x, a.y, a.z, iTo, b.x, b.y, b.z,
+             CWaypoints::HasPath( iFrom, iTo ) ? "yes" : "no" );
+        for ( int i = 0; i <= iSteps; ++i )
+        {
+            Vector v = a + ( b - a ) * ( (float)i / iSteps );
+            v.z += 32.0f;
+            CUtil::GetGroundVec( v );
+            const trace_t& tr = CUtil::TraceResult();
+            Msg( "  %2d ground %.0f normal z %.2f (%.0f deg)%s%s\n", i, v.z, tr.plane.normal.z,
+                 acosf( clamp( tr.plane.normal.z, -1.0f, 1.0f ) ) * 57.2958f, tr.startsolid ? " startsolid" : "",
+                 ( tr.dispFlags & DISPSURF_FLAG_SURFACE ) ? " disp" : "" );
+        }
+    }
+
+    void ReachCommand( const CCommand& args )
+    {
+        if ( args.ArgC() < 7 )
+            return;
+        CUtil::bPassGlass = ( args.ArgC() > 7 && strcmp( args.Arg( 7 ), "glass" ) == 0 );
+        Vector a( atof( args.Arg( 1 ) ), atof( args.Arg( 2 ) ), atof( args.Arg( 3 ) ) );
+        Vector b( atof( args.Arg( 4 ) ), atof( args.Arg( 5 ) ), atof( args.Arg( 6 ) ) );
+        Vector ga = CUtil::GetHullGroundVec( a );
+        Vector gb = CUtil::GetHullGroundVec( b );
+        bool bVisible = CUtil::IsVisible( a, b, EVisibilityWaypoints );
+        bool bCrouch = false;
+        Vector b2 = b;
+        TReach iReach = CUtil::GetReachableInfoFromTo( a, b2, bCrouch, 0, 1e9f, false );
+        CUtil::bPassGlass = false;
+        Msg( "ground a %.0f, ground b %.0f, visible %d, reach %d (0 no, 1 yes, 2 stairs, 3 jump, 4 fall damage), crouch %d\n",
+             ga.z, gb.z, bVisible, iReach, bCrouch );
+        // Contents just above the ground (water 0x20, slime 0x10, solid 0x1, player clip 0x10000...).
+        Msg( "contents above the ground: a 0x%x, b 0x%x\n",
+             CBotrixPlugin::pEngineTrace->GetPointContents( ga + Vector( 0, 0, 8 ) ),
+             CBotrixPlugin::pEngineTrace->GetPointContents( gb + Vector( 0, 0, 8 ) ) );
+        // What stops a player-sized line a -> b: the world alone, then everything.
+        Ray_t ray;
+        ray.Init( a, b );
+        trace_t tr;
+        CTraceFilterWorldOnly cWorld;
+        CBotrixPlugin::pEngineTrace->TraceRay( ray, MASK_PLAYERSOLID, &cWorld, &tr );
+        Msg( "world only: fraction %.2f, end %.0f %.0f %.0f\n", tr.fraction, tr.endpos.x, tr.endpos.y, tr.endpos.z );
+        CTraceFilterHitAll cAll;
+        CBotrixPlugin::pEngineTrace->TraceRay( ray, MASK_PLAYERSOLID, &cAll, &tr );
+        // CBaseEntity derives from IHandleEntity alone (single inheritance): same address.
+        int iHit = tr.m_pEnt ? reinterpret_cast<IHandleEntity*>( tr.m_pEnt )->GetRefEHandle().GetEntryIndex() : -1;
+        edict_t* pHit = iHit >= 0 ? CBotrixPlugin::pEngineServer->PEntityOfEntIndex( iHit ) : NULL;
+        Msg( "everything: fraction %.2f, end %.0f %.0f %.0f, hit %s %d\n", tr.fraction, tr.endpos.x, tr.endpos.y,
+             tr.endpos.z, pHit ? pHit->GetClassName() : "-", iHit );
+    }
