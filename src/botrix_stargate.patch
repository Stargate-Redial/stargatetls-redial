+//----------------------------------------------------------------------------------------------------------------
+void CBot_SGTLS::CrossGate( const Vector& vOrigin )
+{
+    if ( !sgtls::Feature( sgtls::FeatGateCross ) )
+    {
+        m_iCrossGate = -1;
+        return;
+    }
+    if ( m_iCrossGate >= 0 && vOrigin.DistToSqr( m_vCrossLast ) > 300.0f * 300.0f )
+    {
+        BLOG_I( "%s -> Through gate %d: %.2f units before the plane, step %.2f, expected depth %.2f (safe %.2f), "
+                "%d coasts, %d back-offs, arrived at (%.0f %.0f %.0f).", GetName(), m_iCrossGate, m_fCrossDist,
+                m_fCrossStep, m_fCrossExpected, m_fCrossSafe, m_iCrossCoasts, m_iCrossBackOffs,
+                vOrigin.x, vOrigin.y, vOrigin.z );
+        m_iCrossGate = -1;
+        return;
+    }
+    int iGate = sgtls::CObjectives::GateToCross( iCurrentWaypoint, iNextWaypoint );
+    if ( iGate < 0 )
+    {
+        m_iCrossGate = -1;
+        return;
+    }
+    const sgtls::CButtonTeleporter& d = sgtls::ButtonTeleporters()[iGate];
+    const Vector& vMins = d.pTeleporter->vMins;
+    const Vector& vMaxs = d.pTeleporter->vMaxs;
+    int a = d.iCrossAxis, o = 1 - a;
+    int iSide = ( vOrigin[a] > ( vMins[a] + vMaxs[a] ) * 0.5f ) ? 1 : 0;
+    float fSign = iSide ? 1.0f : -1.0f;
+    float fSafe = d.fSafeDepth[iSide];
+    float fDist = fSign * ( vOrigin[a] - ( iSide ? vMaxs[a] : vMins[a] ) ) - 16.0f; // From the hull to the plane.
+    float fLat = vOrigin[o] - ( vMins[o] + vMaxs[o] ) * 0.5f;
+    // Hull wholly in front of the plane, and clear of the ring's bottom (the opening is round, the trigger square).
+    float fLatFree = ( vMaxs[o] - vMins[o] ) * 0.5f - 20.0f;
+    if ( fLatFree > 40.0f )
+        fLatFree = 40.0f;
+    if ( fSafe <= 0.0f || fSafe > 8.0f || fDist > 300.0f || fDist < -2.0f || fabs( fLat ) > fLatFree + 300.0f ||
+         vOrigin.z > vMaxs.z || vOrigin.z + 72.0f < vMins.z )
+    {
+        m_iCrossGate = -1;
+        return;
+    }
+    if ( m_iCrossGate != iGate )
+    {
+        m_iCrossGate = iGate;
+        m_fCrossStep = m_fCrossPrevStep = m_fCrossExpected = 0.0f;
+        m_iCrossFull = m_iCrossCoasts = m_iCrossBackOffs = 0;
+        m_bCrossBackOff = false;
+    }
+    else
+    {
+        float fStep = m_fCrossDist - fDist;
+        if ( fabs( fStep ) < 0.01f )
+        {
+            m_vCrossLast = vOrigin; // No tick since the last frame.
+            return;
+        }
+        m_fCrossPrevStep = m_fCrossStep;
+        m_fCrossStep = fStep;
+    }
+    m_vCrossLast = vOrigin;
+    m_fCrossDist = fDist;
+    m_fCrossSafe = fSafe;
+
+    // Where to: straight at the plane once in line with it (in the last 64 units), else toward the line.
+    bool bAligned = fabs( fLat ) <= fLatFree;
+    if ( m_bCrossBackOff && fDist > 120.0f )
+        m_bCrossBackOff = false;
+    if ( !bAligned && fDist < 48.0f && !m_bCrossBackOff )
+    {
+        m_bCrossBackOff = true; // Beside the plane: a corner would be touched.
+        ++m_iCrossBackOffs;
+    }
+    bool bSteady = m_iCrossFull >= 2 && m_fCrossStep > 0.5f && fabs( m_fCrossStep - m_fCrossPrevStep ) < 0.05f;
+    bool bCoast = false;
+    if ( !m_bCrossBackOff && bAligned && bSteady && m_fCrossStep > fSafe + 0.3f )
+    {
+        m_fCrossExpected = ceilf( fDist / m_fCrossStep ) * m_fCrossStep - fDist;
+        if ( m_fCrossExpected < fSafe )
+        {
+            if ( fDist > 40.0f )
+                bCoast = true; // Lose a little ground: the touch comes at another point of the step.
+            else
+            {
+                m_bCrossBackOff = true; // Too close to fix it.
+                ++m_iCrossBackOffs;
+            }
+        }
+    }
+    else if ( !m_bCrossBackOff && bAligned && fDist < 12.0f && m_iCrossFull < 2 )
+    {
+        m_bCrossBackOff = true; // Standing right in front: from a standstill the first steps are too short.
+        ++m_iCrossBackOffs;
+    }
+    Vector vDir( 0.0f, 0.0f, 0.0f );
+    if ( m_bCrossBackOff )
+    {
+        vDir[a] = fSign;
+        vDir[o] = ( fabs( fLat ) > fLatFree * 0.5f ) ? ( fLat > 0.0f ? -1.0f : 1.0f ) : 0.0f;
+    }
+    else
+    {
+        vDir[a] = -fSign;
+        if ( !bAligned || fDist > 64.0f )
+            vDir[o] = clamp( -fLat / ( fDist > 24.0f ? fDist : 24.0f ), -1.5f, 1.5f );
+    }
+    // Far from the plane the path's jump and duck stay: tls_stargate_atlantis_fixed's base gate stands on a platform
+    // 39 units up, its paths jump, and the bots walked into the platform's side until the watchdog (9 in 30 minutes).
+    int iKeepButtons = ( fDist > 64.0f ) ? ( m_cCmd.buttons & ( IN_JUMP | IN_DUCK ) ) : 0;
+    FLAG_CLEAR( IN_DUCK | IN_JUMP | IN_SPEED | IN_FORWARD | IN_BACK | IN_MOVELEFT | IN_MOVERIGHT, m_cCmd.buttons );
+    m_cCmd.buttons |= iKeepButtons;
+    if ( bCoast )
+    {
+        ++m_iCrossCoasts;
+        m_iCrossFull = 0;
+        m_cCmd.forwardmove = m_cCmd.sidemove = 0.0f;
+        return;
+    }
+    m_iCrossFull = m_bCrossBackOff ? 0 : m_iCrossFull + 1;
+    float fYaw = atan2f( vDir.y, vDir.x ) * 180.0f / 3.14159265f - m_cCmd.viewangles.y;
+    fYaw *= 3.14159265f / 180.0f;
+    m_cCmd.forwardmove = 1000.0f * cosf( fYaw ); // The game caps it at the player's speed.
+    m_cCmd.sidemove = -1000.0f * sinf( fYaw );
+}
+
