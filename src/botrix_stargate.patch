+const std::vector<const sgtls::CBspEntity*>& sgtls::TeleportPlanes()
+{
+    const std::vector<CBspEntity>& aEnts = BspEntities();
+    if ( m_sTeleportPlanesMap == m_sEntitiesMap )
+        return m_aTeleportPlanes;
+    m_sTeleportPlanesMap = m_sEntitiesMap;
+    m_aTeleportPlanes.clear();
+    m_aFlatTeleportPlanes.clear();
+    for ( size_t i = 0; i < aEnts.size(); ++i )
+    {
+        const CBspEntity& e = aEnts[i];
+        Vector vSize = e.vMaxs - e.vMins;
+        if ( e.bBrush && strcmp( e.Get( "classname" ), "trigger_teleport" ) == 0 && vSize.z <= 16.0f &&
+             vSize.x >= 48.0f && vSize.y >= 48.0f && ( IsKillTeleport( e ) || strcmp( e.Get( "StartDisabled" ), "1" ) == 0 ) )
+            m_aFlatTeleportPlanes.push_back( &e );
+        if ( e.bBrush && strcmp( e.Get( "classname" ), "trigger_teleport" ) == 0 && ( vSize.x <= 16.0f || vSize.y <= 16.0f ) &&
+             vSize.x >= 1.0f && vSize.y >= 1.0f && vSize.z >= 48.0f && ( vSize.x >= 48.0f || vSize.y >= 48.0f ) &&
+             ( IsKillTeleport( e ) || strcmp( e.Get( "StartDisabled" ), "1" ) == 0 ) ) // Not the ones always on: links.
+            m_aTeleportPlanes.push_back( &e );
+    }
+    return m_aTeleportPlanes;
+}
