+            if ( !cButton.bBrush || strcmp( cButton.Get( "classname" ), "func_button" ) != 0 )
+                continue;
+            int iPresses = 0;
+            bool bTurnsOff = false;
+            for ( std::multimap<std::string, std::string>::const_iterator it = cButton.aKeys.begin();
+                  it != cButton.aKeys.end(); ++it )
+            {
+                if ( it->first != "OnPressed" || !ParseOutput( it->second, sTarget, sInput, sParam ) )
+                    continue;
+                if ( sTarget == sName )
+                {
+                    if ( sInput == "Enable" )
+                        iPresses = 1;
+                    else if ( sInput == "Disable" || sInput == "Toggle" )
+                        bTurnsOff = true;
+                    continue;
+                }
+                if ( sInput != "Add" )
+                    continue;
+                // Several counters can share a name (tls_lockdown: one per chevron light, max 1 to 8).
+                for ( size_t c = 0; c < aEnts.size(); ++c )
+                {
+                    const CBspEntity& cCounter = aEnts[c];
+                    if ( strcmp( cCounter.Get( "classname" ), "math_counter" ) != 0 || sTarget != cCounter.Get( "targetname" ) )
+                        continue;
+                    for ( std::multimap<std::string, std::string>::const_iterator ot = cCounter.aKeys.begin();
+                          ot != cCounter.aKeys.end(); ++ot )
+                        if ( ot->first == "OnHitMax" && ParseOutput( ot->second, sCounterTarget, sCounterInput, sCounterParam ) &&
+                             sCounterTarget == sName && sCounterInput == "Enable" )
+                        {
+                            float fAdd = (float)atof( sParam.c_str() );
+                            float fNeeded = (float)( atof( cCounter.Get( "max", "0" ) ) - atof( cCounter.Get( "startvalue", "0" ) ) );
+                            iPresses = ( fAdd > 0.0f && fNeeded > 0.0f ) ? (int)ceil( fNeeded / fAdd ) : 0;
+                        }
+                }
+            }
+            float fDistance = ( ( cButton.vMins + cButton.vMaxs ) * 0.5f ).DistTo( vCenter );
+            if ( iPresses > 0 && !bTurnsOff && fDistance < fBestDistance )
+            {
+                pBest = &cButton;
+                iBestPresses = iPresses;
+                fBestDistance = fDistance;
+            }
+        }
+        if ( !pBest )
+            continue;
+
+        CButtonTeleporter t;
+        t.pTeleporter = &e;
+        t.pButton = pBest;
+        t.iPresses = iBestPresses;
+        LinkEnds( e, *aNamed[ e.Get( "target" ) ], t.vEntry, t.vExit );
+        // tls_lockdown: the kawoosh kills in front of both gates from 1.7 to 3.1 seconds after the dialing.
+        t.fKawoosh = 0.0f;
+        const std::vector<const CBspEntity*>& aKill = ForbiddenBoxes();
+        for ( size_t k = 0; k < aKill.size(); ++k )
+            if ( DistanceToBox( t.vEntry, aKill[k]->vMins, aKill[k]->vMaxs ) < 300.0f ||
+                 DistanceToBox( t.vExit, aKill[k]->vMins, aKill[k]->vMaxs ) < 300.0f )
+                t.fKawoosh = 4.0f;
+        m_aButtonTeleporters.push_back( t );
+    }
+    return m_aButtonTeleporters;
+}
