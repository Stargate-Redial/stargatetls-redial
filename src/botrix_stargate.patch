+#if defined(BOTRIX_SGTC2) && defined(_WIN32)
+bool sgtls::UseEntity( edict_t* pEdict, edict_t* pActivator )
+{
+    // CBaseEntity::Use( pActivator, pCaller, useType, value ) is slot 87 of the StargateTC 2 server.dll vtables
+    // (thiscall, ret 0x10). Only for CBFL_DHDBUTTON, recognized by its vtable (server.dll 0x224f70bc, image base
+    // 0x22000000): its network class is CPhysicsProp.
+    static char* pServerBase = (char*)GetModuleHandleA( "server.dll" );
+    char* pEntity = EntityBase( pEdict );
+    char* pPlayer = EntityBase( pActivator );
+    if ( !pEntity || !pPlayer || !pServerBase || *(char**)pEntity != pServerBase + ( 0x224f70bc - 0x22000000 ) )
+        return false;
+    typedef void ( __fastcall *TUse )( void* pThis, void* pEdx, void* pActivator, void* pCaller, int iUseType,
+                                       float fValue );
+    TUse pfnUse = (TUse)( (*(void***)pEntity)[87] );
+    pfnUse( pEntity, NULL, pPlayer, pPlayer, 3 /* USE_TOGGLE */, 0.0f );
+    return true;
+}
+#elif defined(BOTRIX_SGTLS) && defined(_WIN32)
+bool sgtls::UseEntity( edict_t* pEdict, edict_t* pActivator )
+{
+    // Bots holding +use don't reach the objective buttons (func_hold_button = CButtonHold: its last use time,
+    // +0x458, stays 0), so the bot calls CBaseEntity::Use( pActivator, pCaller, useType, value ) itself, as the
+    // game does for a player holding +use (USE_TOGGLE). Slot 89 of the sgtls server.dll vtables, thiscall, ret 0x10;
+    // its first bytes are checked: mov eax, [ecx + 0xc8] (m_pfnUse); test eax, eax. Also for func_button
+    // (tls_lockdown's DHD, which opens gate 1).
+    char* pEntity = EntityBase( pEdict );
+    char* pPlayer = EntityBase( pActivator );
+    if ( !pEntity || !pPlayer || ( strcmp( pEdict->GetClassName(), "func_hold_button" ) != 0 &&
+                                   strcmp( pEdict->GetClassName(), "func_button" ) != 0 ) )
+        return false;
+    static const unsigned char aUseStart[] = { 0x8B, 0x81, 0xC8, 0x00, 0x00, 0x00, 0x85, 0xC0 };
+    unsigned char* pfn = (unsigned char*)( (*(void***)pEntity)[89] );
+    if ( memcmp( pfn, aUseStart, sizeof(aUseStart) ) != 0 )
+        return false;
+    typedef void ( __fastcall *TUse )( void* pThis, void* pEdx, void* pActivator, void* pCaller, int iUseType,
+                                       float fValue );
+    ( (TUse)pfn )( pEntity, NULL, pPlayer, pPlayer, 3 /* USE_TOGGLE */, 0.0f );
+    return true;
+}
+#elif defined(BOTRIX_SGTLS) && defined(__linux__)
+bool sgtls::UseEntity( edict_t* pEdict, edict_t* pActivator )
+{
+    // Linux: the same call, CBaseEntity::Use found by name. The entity's vtable must hold it (not overridden).
+    char* pEntity = EntityBase( pEdict );
+    char* pPlayer = EntityBase( pActivator );
+    if ( !pEntity || !pPlayer || ( strcmp( pEdict->GetClassName(), "func_hold_button" ) != 0 &&
+                                   strcmp( pEdict->GetClassName(), "func_button" ) != 0 ) )
+        return false;
+    static void* pfnBaseUse = ServerSymbol( "_ZN11CBaseEntity3UseEPS_S0_8USE_TYPEf" );
+    if ( !pfnBaseUse || VtableSlot( *(void***)pEntity, pfnBaseUse ) < 0 )
+        return false;
+    typedef void ( *TUse )( void* pThis, void* pActivator, void* pCaller, int iUseType, float fValue );
+    ( (TUse)pfnBaseUse )( pEntity, pPlayer, pPlayer, 3 /* USE_TOGGLE */, 0.0f );
+    return true;
+}
+#elif defined(BOTRIX_SGTC2) && defined(__linux__)
+bool sgtls::UseEntity( edict_t* pEdict, edict_t* pActivator )
+{
+    // Linux: the same call, CBFL_DHDBUTTON recognized by its vtable symbol (objects point after offset-to-top and
+    // the typeinfo), its Use found by name.
+    char* pEntity = EntityBase( pEdict );
+    char* pPlayer = EntityBase( pActivator );
+    static void** pVtable = (void**)ServerSymbol( "_ZTV14CBFL_DHDBUTTON" );
+    static void* pfnUse = ServerSymbol( "_ZN14CBFL_DHDBUTTON3UseEP11CBaseEntityS1_8USE_TYPEf" );
+    if ( !pEntity || !pPlayer || !pVtable || !pfnUse || *(void***)pEntity != pVtable + 2 )
+        return false;
+    typedef void ( *TUse )( void* pThis, void* pActivator, void* pCaller, int iUseType, float fValue );
+    ( (TUse)pfnUse )( pEntity, pPlayer, pPlayer, 3 /* USE_TOGGLE */, 0.0f );
+    return true;
+}
+#endif
