+//----------------------------------------------------------------------------------------------------------------
+bool CBot_SGTLS::CheckJoin()
+{
+    TTeam iTeam = m_pPlayerInfo->GetTeamIndex();
+    int iFirst = FirstClassOfTeam( iTeam );
+    int iClassId = GetClassId( m_pEdict );
+    bool bClassOk = ( iFirst > 0 ) && ( iClassId >= iFirst ) && ( iClassId < iFirst + 4 );
+
+    if ( bClassOk && iClassId != m_iClassId )
+    {
+        // The server gave us another class than the one we asked for: equip for that one.
+        m_iClassId = iClassId;
+        m_bEquipSent = false;
+    }
+
+    if ( bClassOk && m_bEquipSent )
+    {
+        // If the bot stays in the world without its class (spawned before choosing it), kill it so that it
+        // respawns properly.
+        if ( m_bAlive && sgtls::GetInt( m_pEdict, "m_iLiveClassID", -1 ) == -1 &&
+             CBotrixPlugin::fTime > m_fEquipTime + 6.0f && CBotrixPlugin::fTime > m_fNextKill )
+        {
+            BLOG_I( "%s -> Not spawned with its class, respawning.", GetName() );
+            ConsoleCommand( "kill" );
+            m_fNextKill = CBotrixPlugin::fTime + 15.0f;
+        }
+        // Spawned with the knife only: the game refused the loadout on this map. Only a new class takes a new
+        // loadout: another class, another loadout, and a respawn.
+        else if ( m_bAlive && !m_bLoadoutChecked && CBotrixPlugin::fTime > m_fSpawnTime + 2.0f &&
+                  CBotrixPlugin::fTime > m_fNextKill )
+        {
+            m_bLoadoutChecked = true;
+            if ( HasOnlyKnife( m_pEdict ) )
+            {
+                Refuse( m_iEquipCode );
+                int iRefused = m_iEquipCode;
+                m_iClassId = ChooseClass( iTeam, m_iClassId );
+                m_iEquipCode = ChooseLoadout( m_iClassId );
+                m_iEquipClass = m_iClassId;
+                BLOG_I( "%s -> Spawned with the knife only: loadout %d refused on this map, class %d with loadout %d.",
+                        GetName(), iRefused, m_iClassId, m_iEquipCode );
+                char szCmd[32];
+                sprintf( szCmd, "joinclass %d", m_iClassId );
+                ConsoleCommand( szCmd );
+                sprintf( szCmd, "setequipcode %d", m_iEquipCode );
+                ConsoleCommand( szCmd );
+                ConsoleCommand( "kill" );
+                m_fNextKill = CBotrixPlugin::fTime + 15.0f;
+            }
+        }
+        // A Kull Warrior over the cap (<prefix>_kullmax): the map's cfg runs 3 s after the level load, often after
+        // the bots chose their class. Another class from the next life, chosen while dead.
+        else if ( !m_bAlive && iClassId == 7 && sgtls::iKullMax >= 0 && CBotrixPlugin::fTime >= m_fNextJoinCommand &&
+                  CountPlayers( iTeam, 7, m_pEdict ) >= sgtls::iKullMax )
+        {
+            m_fNextJoinCommand = CBotrixPlugin::fTime + 2.0f;
+            m_iClassId = ChooseClass( iTeam, 7 );
+            m_iEquipCode = ChooseLoadout( m_iClassId );
+            m_iEquipClass = m_iClassId;
+            BLOG_I( "%s -> Kull Warriors over the cap (%d): class %d from the next life.", GetName(), sgtls::iKullMax,
+                    m_iClassId );
+            char szCmd[32];
+            sprintf( szCmd, "joinclass %d", m_iClassId );
+            ConsoleCommand( szCmd );
+            sprintf( szCmd, "setequipcode %d", m_iEquipCode );
+            ConsoleCommand( szCmd );
+        }
+        return false;
+    }
+
+    if ( CBotrixPlugin::fTime < m_fNextJoinCommand )
+        return true;
+    m_fNextJoinCommand = CBotrixPlugin::fTime + 0.5f;
+
+    char szCmd[32];
+    if ( iFirst < 0 )
+    {
+        sprintf( szCmd, "jointeam %d", ChooseTeam() );
+        m_bEquipSent = false;
+    }
+    else if ( !bClassOk )
+    {
+        // No class yet, or the server reset it (team change). The equipment goes in the same frame: a bot that
+        // spawned between the two commands (0.5 s apart) played its first life with the knife only.
+        m_iClassId = ChooseClass( iTeam );
+        sprintf( szCmd, "joinclass %d", m_iClassId );
+        ConsoleCommand( szCmd );
+        m_iEquipCode = ChooseLoadout( m_iClassId );
+        m_iEquipClass = m_iClassId;
+        sprintf( szCmd, "setequipcode %d", m_iEquipCode );
+        m_bEquipSent = false;
+    }
+    else
+    {
+        // The same code again once the class is set (taken if the first one came too early, ignored otherwise): a
+        // new random one made some bots spawn with the knife only (tls_erebus).
+        if ( m_iEquipClass != m_iClassId )
+        {
+            m_iEquipCode = ChooseLoadout( m_iClassId );
+            m_iEquipClass = m_iClassId;
+        }
+        sprintf( szCmd, "setequipcode %d", m_iEquipCode );
+        m_bEquipSent = true;
+        m_fEquipTime = CBotrixPlugin::fTime;
+    }
+    ConsoleCommand( szCmd );
+    return !m_bEquipSent;
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+void CBot_SGTLS::PreThink()
+{
+    // Waypoint-less bots don't think (CBot::PreThink returns early): join the game first.
+    if ( CheckJoin() )
+    {
+        m_cCmd.forwardmove = m_cCmd.sidemove = m_cCmd.upmove = 0;
+        m_cCmd.buttons = 0;
+        m_cCmd.impulse = 0;
+        m_pController->RunPlayerMove( &m_cCmd );
+        return;
+    }
+    CBot_HL2DM::PreThink();
+    // Teleported (a jump of 1000+ units since the last think): where from, doing what (killbox deaths, 2026-11-10).
+    // Here: CBot::PreThink skips Think for a bot away from the waypoints (in a killbox).
+    // (Logged even if the bot died there: a killbox kills at once.)
+    if ( m_vLastHead.LengthSqr() > 1.0f && m_vLastHead.DistToSqr( m_vHead ) > 1000.0f * 1000.0f )
+    {
+        BLOG_I( "%s -> Teleported from (%.0f %.0f %.0f) to (%.0f %.0f %.0f), waypoints %d -> %d, teleporter %d, "
+                "leaving a kill box %d, enemy %d, alive %d.", GetName(), m_vLastHead.x, m_vLastHead.y, m_vLastHead.z,
+                m_vHead.x, m_vHead.y, m_vHead.z, m_iLastCurrent, m_iLastNext, m_iTeleporter, m_bLeavingKillBox ? 1 : 0,
+                m_pCurrentEnemy != NULL ? 1 : 0, m_bAlive ? 1 : 0 );
+        m_vLastHead.Init();
+        if ( m_bAlive && sgtls::Feature( sgtls::FeatTeleported ) )
+            AfterTeleport();
+    }
+    if ( m_bAlive && CBotrixPlugin::fTime > m_fSpawnTime + 1.0f )
+    {
+        m_vLastHead = m_vHead;
+        m_iLastCurrent = iCurrentWaypoint;
+        m_iLastNext = iNextWaypoint;
+    }
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+TWaypointId CBot_SGTLS::GetRoamDestination()
+{
+    // Arrived at its guard spot (a new destination is asked for on arrival): wait there first (Guard).
+    if ( CWaypoint::IsValid( m_iGuardWaypoint ) && m_fGuardEnd == 0.0f &&
+         m_vHead.DistToSqr( CWaypoints::Get( m_iGuardWaypoint ).vOrigin ) < 64.0f * 64.0f )
+        m_fGuardEnd = CBotrixPlugin::fTime + sgtls::GuardTime();
+    TWaypointId iDestination = sgtls::CObjectives::PickWaypoint( GetTeam(), m_pSpot );
+    if ( m_fGuardEnd == 0.0f )
+    {
+        // A guard spot, not the button itself (a defender standing there goes on at once).
+        Vector vLook;
+        m_iGuardWaypoint = ( CWaypoint::IsValid( iDestination ) &&
+                             sgtls::CObjectives::GuardSpotLook( GetTeam(), m_pSpot, iDestination, vLook ) )
+                         ? iDestination : EWaypointIdInvalid;
+        if ( CWaypoint::IsValid( m_iGuardWaypoint ) )
+            m_vGuardLook = vLook;
+    }
+    if ( !sgtls::Feature( sgtls::FeatReachDest ) || !CWaypoint::IsValid( iCurrentWaypoint ) )
+    {
+        if ( CWaypoint::IsValid( iDestination ) && iDestination != iCurrentWaypoint )
+            return iDestination;
+        return CBot_HL2DM::GetRoamDestination();
+    }
+    // Only where the bot can go. A destination it can't reach makes A* search the whole graph before it fails (200
+    // frames on 8000 waypoints), three times, then a new task often as unreachable: bots stood on their spawn until
+    // the watchdog (tls_hatak's Goa'uld spawn before its rings had a link, tls_continuum_v1: 61 in 8 minutes).
+    UpdateReach();
+    if ( CWaypoint::IsValid( iDestination ) && iDestination != iCurrentWaypoint && m_aReach[iDestination] )
+        return iDestination;
+    if ( m_iGuardWaypoint == iDestination )
+        m_iGuardWaypoint = EWaypointIdInvalid;
+    for ( int iTry = 0; iTry < 8; ++iTry )
+    {
+        TWaypointId w = CBot_HL2DM::GetRoamDestination();
+        if ( CWaypoint::IsValid( w ) && w != iCurrentWaypoint && m_aReach[w] )
+            return w;
+    }
+    // A random one among those it can reach.
+    int iCount = 0;
+    for ( size_t i = 0; i < m_aReach.size(); ++i )
+        iCount += m_aReach[i] ? 1 : 0;
+    if ( iCount > 1 )
+    {
+        int iPick = rand() % iCount;
+        for ( size_t i = 0; i < m_aReach.size(); ++i )
+            if ( m_aReach[i] && iPick-- == 0 && (TWaypointId)i != iCurrentWaypoint )
+                return (TWaypointId)i;
+    }
+    return CBot_HL2DM::GetRoamDestination();
+}
+
+
+void CBot_SGTLS::UpdateReach()
+{
+    int n = CWaypoints::Size();
+    if ( m_iReachSource == iCurrentWaypoint && (int)m_aReach.size() == n && CBotrixPlugin::fTime < m_fReachTime + 10.0f )
+        return;
+    m_iReachSource = iCurrentWaypoint;
+    m_fReachTime = CBotrixPlugin::fTime;
+    m_aReach.assign( n, 0 );
+    if ( !CWaypoint::IsValid( iCurrentWaypoint ) )
+        return;
+    std::vector<TWaypointId> aQueue;
+    aQueue.reserve( n );
+    aQueue.push_back( iCurrentWaypoint );
+    m_aReach[iCurrentWaypoint] = 1;
+    good::vector<TWaypointId> aOut;
+    for ( size_t i = 0; i < aQueue.size(); ++i )
+    {
+        aOut.clear();
+        CWaypoints::GetPathTargets( aQueue[i], aOut );
+        for ( int k = 0; k < aOut.size(); ++k )
+            if ( aOut[k] >= 0 && aOut[k] < n && !m_aReach[ aOut[k] ] )
+            {
+                m_aReach[ aOut[k] ] = 1;
+                aQueue.push_back( aOut[k] );
+            }
+    }
+}
