+float sgtls::FogSightDistance()
+{
+    const std::vector<CBspEntity>& aEnts = BspEntities();
+    for ( size_t i = 0; i < aEnts.size(); ++i )
+    {
+        const CBspEntity& e = aEnts[i];
+        // A max density below 1 (tls_abydos: 0.5) leaves players visible through the fog at any distance.
+        if ( strcmp( e.Get( "classname" ), "env_fog_controller" ) == 0 && strcmp( e.Get( "fogenable" ), "1" ) == 0 &&
+             atof( e.Get( "fogmaxdensity", "1" ) ) >= 0.95f && atof( e.Get( "fogend" ) ) > 0.0f )
+            return (float)atof( e.Get( "fogend" ) );
+    }
+    return 0.0f;
+}
