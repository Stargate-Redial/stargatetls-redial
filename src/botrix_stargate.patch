+int sgtls::GetInt( edict_t* pEdict, const char* szProp, int iDefault )
+{
+    int iOffset = PropOffset( pEdict, szProp );
+    char* pBase = EntityBase( pEdict );
+    return ( iOffset < 0 || !pBase ) ? iDefault : *(int*)( pBase + iOffset );
+}
+
+float sgtls::GetFloat( edict_t* pEdict, const char* szProp, float fDefault )
+{
+    int iOffset = PropOffset( pEdict, szProp );
+    char* pBase = EntityBase( pEdict );
+    return ( iOffset < 0 || !pBase ) ? fDefault : *(float*)( pBase + iOffset );
+}
