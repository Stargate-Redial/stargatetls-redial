+    int FindInTable( SendTable* pTable, const char* szProp, int iBase )
+    {
+        for ( int i = 0; i < pTable->GetNumProps(); ++i )
+        {
+            SendProp* pProp = pTable->GetProp( i );
+            if ( pProp->GetType() == DPT_DataTable )
+            {
+                if ( strcmp( pProp->GetName(), szProp ) == 0 )
+                    return iBase + pProp->GetOffset();
+                int iFound = FindInTable( pProp->GetDataTable(), szProp, iBase + pProp->GetOffset() );
+                if ( iFound >= 0 )
+                    return iFound;
+            }
+            else if ( strcmp( pProp->GetName(), szProp ) == 0 )
+                return iBase + pProp->GetOffset();
+        }
+        return -1;
+    }
+
+    void PrintTable( SendTable* pTable, int iBase, int iDepth )
+    {
+        static const char* aTypes[] = { "int", "float", "vector", "string", "array", "table" }; // Orange Box order.
+        for ( int i = 0; i < pTable->GetNumProps(); ++i )
+        {
+            SendProp* pProp = pTable->GetProp( i );
+            int iType = pProp->GetType();
+            Msg( "%*s%-40s %-8s off %d\n", iDepth * 2, "", pProp->GetName(),
+                 (iType >= 0 && iType < 6) ? aTypes[iType] : "?", iBase + pProp->GetOffset() );
+            if ( iType == DPT_DataTable && pProp->GetDataTable() && iDepth < 6 )
+                PrintTable( pProp->GetDataTable(), iBase + pProp->GetOffset(), iDepth + 1 );
+        }
+    }
+
+    char* EntityBase( edict_t* pEdict )
+    {
+        if ( !pEdict || pEdict->IsFree() || !pEdict->GetUnknown() )
+            return NULL;
+        return (char*)pEdict->GetUnknown()->GetBaseEntity();
+    }
