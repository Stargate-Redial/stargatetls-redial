+void sgtls::CObjectives::OpenGatePlaces( std::vector<Vector>& aPlaces )
+{
+    aPlaces.clear();
+    Refresh();
+    const std::vector<sgtls::CButtonTeleporter>& aDefs = sgtls::ButtonTeleporters();
+    for ( size_t i = 0; i < m_aTeleporters.size() && i < aDefs.size(); ++i )
+        if ( !aDefs[i].bMomentary && TeleporterReady( (int)i ) )
+        {
+            aPlaces.push_back( ( aDefs[i].pTeleporter->vMins + aDefs[i].pTeleporter->vMaxs ) * 0.5f );
+            aPlaces.push_back( aDefs[i].vExit );
+        }
+}
