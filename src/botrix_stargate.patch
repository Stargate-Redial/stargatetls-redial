+void sgtls::Init( CreateInterfaceFn pGameServerFactory )
+{
+    pServerGameDll = (IServerGameDLL*)pGameServerFactory( INTERFACEVERSION_SERVERGAMEDLL, NULL );
+    if ( !pServerGameDll )
+        Warning( "[Botrix] sgtls: no %s interface.\n", INTERFACEVERSION_SERVERGAMEDLL );
+
+#ifdef BOTRIX_SOURCE_ENGINE_2006
+    ConCommandBaseMgr::OneTimeInit( &cConVarAccessor );
+#else
+    for ( int i = 0; i < sizeof(aCommands) / sizeof(aCommands[0]); ++i )
+        CBotrixPlugin::pCVar->RegisterConCommand( aCommands[i] );
+#endif
+#ifdef BOTRIX_SGTLS
+    InstallHooks(); // Addresses of the sgtls server.dll.
+#elif defined(BOTRIX_SGTC2)
+    sgtc2::InstallHooks();
+#endif
+    DisableSdkBotThink();
+    // Analysis: skip deadly volumes. Save: big outdoor maps have too many waypoints for the N*N visibility table.
+    CWaypoints::pfnAnalyzeForbidden = sgtls::IsForbidden;
+    CWaypoints::iMaxWaypointsForVisibility = 12000;
+}
+
+void sgtls::Shutdown()
+{
+#ifndef BOTRIX_SOURCE_ENGINE_2006 // episode1's ICvar can't unregister a command.
+    for ( int i = 0; i < sizeof(aCommands) / sizeof(aCommands[0]); ++i )
+        CBotrixPlugin::pCVar->UnregisterConCommand( aCommands[i] );
+#endif
+#ifdef BOTRIX_SGTLS
+    RemoveHooks();
+#elif defined(BOTRIX_SGTC2)
+    sgtc2::RemoveHooks();
+#endif
+    EnableSdkBotThink();
+}
