+void sgtls::RestoreMapSettings()
+{
+    iKullMax = -1;
+    fGuardMin = 8.0f;
+    fGuardMax = 15.0f;
+    iGuardInside = 4;
+    fDefenderReach = 0.0f;
+#ifdef BOTRIX_SGTC2
+    sgtc2::fObjectiveRoam = 0.0f;
+    sgtc2::iChase = 0;
+#endif
+    iAreaInside = 50;
+    bStageRepick = true;
+    bOpenDoors = false;
+    iFeatures = FeatAll;
+    for ( std::map<int, CSavedWeapon>::const_iterator it = aSavedWeapons.begin(); it != aSavedWeapons.end(); ++it )
+    {
+        if ( !CWeapons::IsValid( it->first ) )
+            continue;
+        CWeapon* w = const_cast<CWeapon*>( CWeapons::Get( it->first )->GetBaseWeapon() );
+        w->fShotTime[0] = it->second.fShotTime;
+        w->fMinDistanceSqr[0] = it->second.fMinDistanceSqr;
+        w->fMaxDistanceSqr[0] = it->second.fMaxDistanceSqr;
+        w->iType = it->second.iType;
+    }
+    aSavedWeapons.clear();
+}
