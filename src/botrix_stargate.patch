+    // Output value "<target>,<input>,<parameter>,<delay>,<times>".
+    bool ParseOutput( const std::string& sValue, std::string& sTarget, std::string& sInput, std::string& sParam )
+    {
+        size_t a = sValue.find( ',' );
+        size_t b = ( a == std::string::npos ) ? a : sValue.find( ',', a + 1 );
+        size_t c = ( b == std::string::npos ) ? b : sValue.find( ',', b + 1 );
+        if ( c == std::string::npos )
+            return false;
+        sTarget = sValue.substr( 0, a );
