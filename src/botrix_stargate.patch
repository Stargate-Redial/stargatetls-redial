+void sgtls::NeutralizeSdkBots()
+{
+    static const char* aNeutral[][2] = { { "bot_attack", "0" }, { "bot_flipout", "0" }, { "bot_crouch", "0" },
+                                         { "bot_mimic", "0" }, { "bot_zombie", "0" }, { "bot_forcefireweapon", "" } };
