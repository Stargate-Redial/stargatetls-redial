+namespace
+{
+    // Everything but players blocks. Static props block or not (to tell them from the world and entities).
+    class CAuditFilter: public ITraceFilter
+    {
+    public:
+        CAuditFilter( TraceType_t iType, bool bProps ): m_iType( iType ), m_bProps( bProps ) {}
+        virtual TraceType_t GetTraceType() const { return m_iType; }
+        virtual bool ShouldHitEntity( IHandleEntity* pEntity, int )
+        {
+            if ( CBotrixPlugin::pStaticPropMgr && CBotrixPlugin::pStaticPropMgr->IsStaticProp( pEntity ) )
+                return m_bProps;
+            int iIndex = pEntity->GetRefEHandle().GetEntryIndex();
+            if ( iIndex == 0 )
+                return true;
+            if ( iIndex <= CPlayers::Size() )
+                return false;
+            // Projectiles in flight, weapons and items don't hide a player.
+            edict_t* pEdict = CBotrixPlugin::pEngineServer->PEntityOfEntIndex( iIndex );
+            return !pEdict || pEdict->IsFree() || !CUtil::IsSeeThrough( pEdict );
+        }
+    private:
+        TraceType_t m_iType;
+        bool m_bProps;
+    };
+
+    struct TAudit { int iShots, iHidden, iWorld, iEntity, iProp, iLogged, iEngagements, iEarly, iEngagementsLogged; } cAudit;
+    const CPlayer* aLastEnemy[AUDIT_MAX_PLAYERS];
+    float aLastShot[AUDIT_MAX_PLAYERS];
+    std::map<std::string, int> cPresses; // Attack presses by reason.
+    std::map<std::string, std::pair<int, int> > cDamage; // Damage and hits by attacker team and weapon.
+
+    // Units of the ray missing before vTo (0 = clear), and the trace.
+    float Blocked( const Vector& vFrom, const Vector& vTo, TraceType_t iType, bool bProps, trace_t& tr )
+    {
+        CAuditFilter cFilter( iType, bProps );
+        Ray_t ray;
+        ray.Init( vFrom, vTo );
+        memset( &tr, 0, sizeof( tr ) );
+        CBotrixPlugin::pEngineTrace->TraceRay( ray, MASK_SHOT, &cFilter, &tr );
+        return ( 1.0f - tr.fraction ) * vFrom.DistTo( vTo );
+    }
+
+    void VisAuditCommand( const CCommand& args )
+    {
+        if ( args.ArgC() > 1 )
+        {
+            if ( strcmp( args.Arg( 1 ), "fix" ) == 0 && args.ArgC() > 2 )
+                CUtil::bStrictBotVisibility = atoi( args.Arg( 2 ) ) != 0;
+            else if ( strcmp( args.Arg( 1 ), "sdkbots" ) == 0 && args.ArgC() > 2 ) // A/B tests of Bot_RunAll.
+            {
+                if ( atoi( args.Arg( 2 ) ) )
+                    sgtls::EnableSdkBotThink();
+                else
+                    sgtls::DisableSdkBotThink();
+            }
+            else
+            {
+                sgtls::bVisAudit = atoi( args.Arg( 1 ) ) != 0;
+                memset( &cAudit, 0, sizeof( cAudit ) );
+                memset( aLastEnemy, 0, sizeof( aLastEnemy ) );
+                cPresses.clear();
+                cDamage.clear();
+            }
+        }
+        // Parsed by the test scripts: keep the format.
+        Msg( "visaudit %s, fix %d: shots %d, hidden %d (world %d, entity %d, static prop %d), engagements %d, early %d\n",
+             sgtls::bVisAudit ? "on" : "off", CUtil::bStrictBotVisibility, cAudit.iShots, cAudit.iHidden,
+             cAudit.iWorld, cAudit.iEntity, cAudit.iProp, cAudit.iEngagements, cAudit.iEarly );
+        for ( std::map<std::string, int>::const_iterator it = cPresses.begin(); it != cPresses.end(); ++it )
+            Msg( "visaudit press %s: %d\n", it->first.c_str(), it->second );
+        for ( std::map<std::string, std::pair<int, int> >::const_iterator it = cDamage.begin(); it != cDamage.end(); ++it )
+            Msg( "visaudit damage %s: %d in %d hits\n", it->first.c_str(), it->second.first, it->second.second );
+        int iBreakPaths = 0;
+        for ( TWaypointId i = 0; i < CWaypoints::Size(); ++i )
+        {
+            CWaypoints::WaypointNode& cNode = CWaypoints::GetNode( i );
+            for ( CWaypoints::WaypointArcIt it = cNode.neighbours.begin(); it != cNode.neighbours.end(); ++it )
+                if ( FLAG_SOME_SET( FPathBreak, it->edge.iFlags ) )
+                    ++iBreakPaths;
+        }
+        Msg( "visaudit break paths: %d\n", iBreakPaths );
+    }
+}
