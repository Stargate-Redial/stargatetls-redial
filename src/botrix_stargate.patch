+//----------------------------------------------------------------------------------------------------------------
+bool CBot::IsShotAllowed( const CWeaponWithAmmo& cWeapon, int iSecondary )
+{
+    // Parabolic weapons aim above the target.
+    if ( !CUtil::bStrictBotVisibility || cWeapon.GetBaseWeapon()->iParabolicDistance0[iSecondary] ||
+         cWeapon.GetBaseWeapon()->iParabolicDistance45[iSecondary] )
+        return true;
+    return strcmp( ShotCheck(), "on target" ) == 0;
+}
