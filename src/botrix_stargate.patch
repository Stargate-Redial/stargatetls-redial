+    // <prefix>_feature [name] [0|1] : the map-pack behaviours, per map (all on, the default at the next map).
+    const char* aFeatureNames[] = { "gatecross", "planes", "closedentry", "ringguard", "swim", "lasers", "fires",
+                                    "doorpair", "doordest", "regroupdoors", "propdoors", "openkawoosh", "killbox",
