+//----------------------------------------------------------------------------------------------------------------
+void CBot_SGTC2::PreThink()
+{
+    // Waypoint-less bots don't think (CBot::PreThink returns early): join the game first.
+    if ( CheckJoin() )
+    {
+        m_cCmd.forwardmove = m_cCmd.sidemove = m_cCmd.upmove = 0;
+        m_cCmd.buttons = 0;
+        m_cCmd.impulse = 0;
+        m_pController->RunPlayerMove( &m_cCmd );
+#ifdef BOTRIX_SOURCE_ENGINE_2006
+        m_pController->PostClientMessagesSent();
+#endif
+        return;
+    }
+    CBot_HL2DM::PreThink();
+}
