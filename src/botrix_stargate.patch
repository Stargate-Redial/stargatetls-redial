+
+bool sgtls::CObjectives::PressTeleporterButton( int iTeleporter, edict_t* pActivator )
+{
+    if ( iTeleporter < 0 || iTeleporter >= (int)m_aTeleporters.size() )
+        return false;
+    CTeleporter& t = m_aTeleporters[iTeleporter];
+    if ( IsOn( t ) || CBotrixPlugin::fTime < t.fNextPress || !t.pButton || t.pButton->IsFree() )
+        return false;
+    // A transporter booth's button: not again while its press is pending (each press sends the occupants of
+    // several booths around).
+    const sgtls::CButtonTeleporter& def = sgtls::ButtonTeleporters()[iTeleporter];
+    t.fNextPress = CBotrixPlugin::fTime + ( def.bMomentary ? def.fDelay + 1.5f : 0.5f );
+    if ( sgtls::bHurtLog )
+        Msg( "[Botrix] Teleporter %d: button pressed at %.2f.\n", iTeleporter, CBotrixPlugin::fTime );
+    return sgtls::UseEntity( t.pButton, pActivator );
+}
