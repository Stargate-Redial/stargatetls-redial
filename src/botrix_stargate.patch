+int sgtls::CObjectives::ReadyGate( TWaypointId wCurrent, TWaypointId wNext )
+{
+    Refresh();
+    const std::vector<sgtls::CButtonTeleporter>& aDefs = sgtls::ButtonTeleporters();
+    for ( size_t i = 0; i < m_aTeleporters.size() && i < aDefs.size(); ++i )
+    {
+        TWaypointId wEntry = m_aTeleporters[i].wEntry;
+        if ( !aDefs[i].bMomentary && CWaypoint::IsValid( wEntry ) && ( wCurrent == wEntry || wNext == wEntry ) &&
+             TeleporterReady( (int)i ) )
+            return (int)i;
+    }
