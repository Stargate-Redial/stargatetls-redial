+void sgtls::CObjectives::LogStage()
+{
+    static float fNext = 0.0f;
+    static std::string sLast, sLastMap;
+    if ( CBotrixPlugin::fTime < fNext && CBotrixPlugin::fTime > fNext - 10.0f )
+        return;
+    fNext = CBotrixPlugin::fTime + 1.0f;
+    Refresh();
+    std::set<int> aOrders;
+    for ( size_t a = 0; a < m_aSpots.size(); ++a )
+        if ( m_aSpots[a].pObjective && IsActive( m_aSpots[a] ) )
+            aOrders.insert( Order( m_aSpots[a] ) );
+    std::string sNow;
+    for ( std::set<int>::const_iterator it = aOrders.begin(); it != aOrders.end(); ++it )
+    {
+        char sz[16];
+        snprintf( sz, sizeof( sz ), sNow.empty() ? "%d" : ",%d", *it );
+        sNow += sz;
+    }
+    const char* szMap = CBotrixPlugin::instance->sMapName.c_str();
+    if ( sNow == sLast && sLastMap == szMap )
+        return;
+    sLast = sNow;
+    sLastMap = szMap;
+    ++m_iStageChanges;
+    Msg( "[Botrix] %s: active objectives now: %s (t=%.0f).\n", szMap, sNow.empty() ? "none" : sNow.c_str(), CBotrixPlugin::fTime );
+}
