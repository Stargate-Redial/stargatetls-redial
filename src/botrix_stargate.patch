+
+int sgtls::PropOffset( edict_t* pEdict, const char* szProp )
+{
+    if ( !pEdict || pEdict->IsFree() || !pEdict->GetNetworkable() )
+        return -1;
+    ServerClass* pClass = pEdict->GetNetworkable()->GetServerClass();
+    if ( !pClass )
+        return -1;
+    std::string sKey = std::string( pClass->GetName() ) + "/" + szProp;
+    std::map<std::string, int>::const_iterator it = m_cOffsets.find( sKey );
+    if ( it != m_cOffsets.end() )
+        return it->second;
+    int iOffset = FindInTable( pClass->m_pTable, szProp, 0 );
+    m_cOffsets[sKey] = iOffset;
+    return iOffset;
+}
+
+bool sgtls::HasWeapon( edict_t* pEdict )
+{
+    int iWeapons = PropOffset( pEdict, "m_hMyWeapons" );
+    char* pBase = EntityBase( pEdict );
+    if ( iWeapons < 0 || !pBase )
+        return true; // Can't tell: as before.
+    const int* aHandles = (const int*)( pBase + iWeapons );
+    for ( int w = 0; w < 48; ++w )
+        if ( aHandles[w] != -1 && EntityBase( CBotrixPlugin::pEngineServer->PEntityOfEntIndex( aHandles[w] & 0xFFF ) ) )
+            return true;
+    return false;
+}
