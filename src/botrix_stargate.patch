+//----------------------------------------------------------------------------------------------------------------
+#if defined(BOTRIX_SGTLS) || defined(BOTRIX_SGTC2)
+float CBot::RecoilControl() const
+{
+    // How much of the recoil a bot pulls back, by intelligence (fool .. pro), times <prefix>_recoil (A/B tests).
+    // Only with automatic weapons (more than 4 shots a second), as a player pulls down during a burst: the punch of
+    // a single shot is gone before the next one, and the one from being hit isn't for the shooter to cancel (with
+    // every weapon, the staff's hits went up and the AWP's down on tls_erebus).
+    if ( !CWeapons::IsValid(m_iWeapon) || m_aWeapons[m_iWeapon].GetBaseWeapon()->fShotTime[0] >= 0.25f )
+        return 0.0f;
+    static const float aControl[] = { 0.4f, 0.55f, 0.7f, 0.85f, 1.0f };
+    int i = m_iIntelligence < 0 ? 0 : ( m_iIntelligence > 4 ? 4 : m_iIntelligence );
+    return aControl[i] * sgtls::fRecoilControl;
+}
+#endif
