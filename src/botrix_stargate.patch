+
+bool sgtls::InGateKillBox( const Vector& vEye, Vector& vOut, const std::vector<Vector>& aOpenGates )
+{
+    const std::vector<const CBspEntity*>& aBoxes = ForbiddenBoxes();
+    float fEye = CMod::GetVar( EModVarPlayerEye );
+    Vector vGrow( 16.0f, 16.0f, 0.0f );
+    Vector vFeet( vEye.x, vEye.y, vEye.z - fEye + 8.0f );
+    bool bIn = false;
+    std::vector<bool> aInside( aBoxes.size(), false );
+    for ( size_t i = 0; i < aBoxes.size(); ++i )
+    {
+        aInside[i] = strcmp( aBoxes[i]->Get( "classname" ), "trigger_teleport" ) == 0 &&
+                     ( Inside( vEye, aBoxes[i]->vMins - vGrow, aBoxes[i]->vMaxs + vGrow ) ||
+                       Inside( vFeet, aBoxes[i]->vMins - vGrow, aBoxes[i]->vMaxs + vGrow ) );
+        if ( aInside[i] && strstr( aBoxes[i]->Get( "targetname" ), "kawoosh" ) )
+        {
+            Vector vCenter = ( aBoxes[i]->vMins + aBoxes[i]->vMaxs ) * 0.5f;
+            for ( size_t g = 0; g < aOpenGates.size() && aInside[i]; ++g )
+                if ( vCenter.DistToSqr( aOpenGates[g] ) < 400.0f * 400.0f )
+                    aInside[i] = false;
+        }
+        bIn |= aInside[i];
+    }
+    if ( !bIn )
+        return false;
+    good::vector<TWaypointId> aNear;
+    CWaypoints::GetNearestWaypoints( aNear, vEye, true, 600.0f ); // Seen from here: walked to straight.
+    float fBest = 1e9f;
+    for ( int i = 0; i < aNear.size(); ++i )
+    {
+        const Vector& v = CWaypoints::Get( aNear[i] ).vOrigin;
+        // Out of every kill box, and not through another one on the way: just behind a gate's plane is close, but
+        // the plane sends to the killbox while the gate is dialed from the other side (tlsdm_glass_gate_final: bots
+        // that came through one gate walked back across the other's plane).
+        bool bOut = true;
+        for ( size_t b = 0; b < aBoxes.size() && bOut; ++b )
+            bOut = strcmp( aBoxes[b]->Get( "classname" ), "trigger_teleport" ) != 0 ||
+                   ( !Inside( v, aBoxes[b]->vMins - vGrow * 2.0f, aBoxes[b]->vMaxs + vGrow * 2.0f ) &&
+                     ( aInside[b] || !SegmentHitsBox( vFeet, Vector( v.x, v.y, vFeet.z ), aBoxes[b]->vMins - vGrow,
+                                                      aBoxes[b]->vMaxs + vGrow ) ) );
+        // Nor past a gate's plane, its travel teleporter included: touched by the corner, not deep enough, it sends
+        // to the far gate's incoming plane (sgtls::CButtonTeleporter::fSafeDepth).
+        const std::vector<sgtls::CBspEntity>& aEnts = sgtls::BspEntities();
+        Vector vPlaneGrow( 24.0f, 24.0f, 0.0f );
+        for ( size_t b = 0; b < aEnts.size() && bOut; ++b )
+        {
+            const sgtls::CBspEntity& p = aEnts[b];
+            if ( !p.bBrush || strcmp( p.Get( "classname" ), "trigger_teleport" ) != 0 ||
+                 ( p.vMaxs.x - p.vMins.x > 16.0f && p.vMaxs.y - p.vMins.y > 16.0f ) )
+                continue;
+            Vector vFrom( vEye.x, vEye.y, ( p.vMins.z + p.vMaxs.z ) * 0.5f ), vTo( v.x, v.y, vFrom.z );
+            bOut = Inside( vFrom, p.vMins - vPlaneGrow, p.vMaxs + vPlaneGrow ) ||
+                   !SegmentHitsBox( vFrom, vTo, p.vMins - vPlaneGrow, p.vMaxs + vPlaneGrow );
+        }
+        if ( bOut && v.DistToSqr( vEye ) < fBest )
+        {
+            fBest = v.DistToSqr( vEye );
+            vOut = v;
+        }
+    }
+    return fBest < 1e9f;
+}
