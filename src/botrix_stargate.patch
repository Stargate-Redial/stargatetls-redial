+    for ( size_t i = 0; i < m_aTeleporters.size() && i < aDefs.size(); ++i )
+        if ( m_aTeleporters[i].wEntry == w && !aDefs[i].bMomentary && !TeleporterReady( (int)i ) )
+            return true;
+    return false;
+}
