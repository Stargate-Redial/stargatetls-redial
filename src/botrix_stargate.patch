+QAngle sgtls::PunchAngle( edict_t* pEdict )
+{
+    int iOffset = PropOffset( pEdict, "m_vecPunchAngle" );
+    const char* pBase = EntityBase( pEdict );
+    if ( iOffset < 0 || !pBase )
+        return QAngle( 0, 0, 0 );
+    const float* f = (const float*)( pBase + iOffset );
+    return QAngle( f[0], f[1], f[2] );
+}
+
+const char* sgtls::DistanceBucket( float fDistance )
+{
+    return fDistance < 500.0f ? " <500" : fDistance < 1000.0f ? " 500-1000" : fDistance < 1500.0f ? " 1000-1500" :
+           fDistance < 2000.0f ? " 1500-2000" : " 2000+";
+}
+
+void sgtls::AuditDamage( CPlayer* pAttacker, CPlayer* pVictim, const char* szWeapon, int iDamage )
+{
+    if ( !bVisAudit || pAttacker->GetTeam() == pVictim->GetTeam() )
+        return;
+    if ( !szWeapon || !szWeapon[0] )
+    {
+        IPlayerInfo* pInfo = CBotrixPlugin::pPlayerInfoManager->GetPlayerInfo( pAttacker->GetEdict() );
+        szWeapon = ( pInfo && pInfo->GetWeaponName() ) ? pInfo->GetWeaponName() : "?";
+    }
+    char szKey[96];
+    snprintf( szKey, sizeof( szKey ), "team %d %s%s%s", pAttacker->GetTeam(), szWeapon,
+              DistanceBucket( pAttacker->GetHead().DistTo( pVictim->GetHead() ) ), pAttacker->IsBot() ? "" : " (human)" );
+    std::pair<int, int>& cSum = cDamage[szKey];
+    cSum.first += iDamage;
+    cSum.second += 1;
+}
+
+void sgtls::AuditPress( CPlayer* pShooter, const char* szReason )
+{
+    int& iCount = cPresses[szReason];
+    ++iCount;
+    // Log the first presses of each kind (more for the unusual ones), every 1000th after that.
+    bool bCommon = strcmp( szReason, "enemy" ) == 0 || strstr( szReason, "on target" ) != NULL;
+    if ( pShooter && ( iCount <= ( bCommon ? 3 : 20 ) || iCount % 1000 == 0 ) )
+    {
+        char szText[256];
+        snprintf( szText, sizeof( szText ), "visaudit: %s fires (%s, #%d) at %.0f %.0f %.0f, %.1f s after spawning.",
+                  pShooter->GetName(), szReason, iCount, pShooter->GetHead().x, pShooter->GetHead().y,
+                  pShooter->GetHead().z, CBotrixPlugin::fTime - pShooter->GetSpawnTime() );
+        AuditLog( szText );
+    }
+}
+
+void sgtls::AuditShot( CPlayer* pShooter, CPlayer* pEnemy )
+{
+    if ( !pShooter || !pEnemy )
+        return;
+    ++cAudit.iShots;
+    const Vector& vEye = pShooter->GetHead();
+    Vector vCenter;
+    pEnemy->GetCenter( vCenter );
+    trace_t tr;
+    bool bSeen = Blocked( vEye, pEnemy->GetHead(), TRACE_EVERYTHING, true, tr ) <= 8.0f ||
+                 Blocked( vEye, vCenter, TRACE_EVERYTHING, true, tr ) <= 8.0f;
+
+    // A new engagement (other enemy, or no shot for 2 s). Firing a few seconds after spawning means seeing an
+    // enemy across the map, from the spawn room.
+    int iShooter = pShooter->GetIndex();
+    if ( iShooter >= 0 && iShooter < AUDIT_MAX_PLAYERS )
+    {
+        if ( aLastEnemy[iShooter] != pEnemy || CBotrixPlugin::fTime > aLastShot[iShooter] + 2.0f )
+        {
+            float fAlive = CBotrixPlugin::fTime - pShooter->GetSpawnTime();
+            ++cAudit.iEngagements;
+            if ( fAlive < 10.0f )
+                ++cAudit.iEarly;
+            if ( cAudit.iEngagementsLogged < 80 )
+            {
+                ++cAudit.iEngagementsLogged;
+                char szText[256];
+                IPlayerInfo* pInfo = pEnemy->GetPlayerInfo();
+                snprintf( szText, sizeof( szText ), "visaudit: %s engages %s, %.1f s after spawning, distance %.0f, %s, enemy hp %d%s wpn %s.",
+                          pShooter->GetName(), pEnemy->GetName(), fAlive, vEye.DistTo( pEnemy->GetHead() ),
+                          bSeen ? "visible" : "HIDDEN", pInfo ? pInfo->GetHealth() : -1,
+                          pInfo && pInfo->IsObserver() ? " OBSERVER" : "",
+                          pInfo && pInfo->GetWeaponName() ? pInfo->GetWeaponName() : "-" );
+                AuditLog( szText );
+            }
+        }
+        aLastEnemy[iShooter] = pEnemy;
+        aLastShot[iShooter] = CBotrixPlugin::fTime;
+    }
+    if ( bSeen )
+        return;
+
+    // Hidden: what is in the way of the head?
+    ++cAudit.iHidden;
+    Blocked( vEye, pEnemy->GetHead(), TRACE_EVERYTHING, true, tr );
+    Vector vHit = tr.endpos;
+    const char* szWhat = "static prop";
+    const char* szClass = "";
+    trace_t tr2;
+    if ( Blocked( vEye, pEnemy->GetHead(), TRACE_WORLD_ONLY, true, tr2 ) > 8.0f )
+    {
+        szWhat = "world";
+        ++cAudit.iWorld;
+    }
+    else if ( Blocked( vEye, pEnemy->GetHead(), TRACE_EVERYTHING_FILTER_PROPS, false, tr2 ) > 8.0f )
+    {
+        szWhat = "entity";
+        ++cAudit.iEntity;
+        if ( tr2.m_pEnt )
+        {
+            int iIndex = ( (IHandleEntity*)tr2.m_pEnt )->GetRefEHandle().GetEntryIndex();
+            edict_t* pEdict = CBotrixPlugin::pEngineServer->PEntityOfEntIndex( iIndex );
+            if ( pEdict && !pEdict->IsFree() )
+                szClass = pEdict->GetClassName();
+        }
+    }
+    else
+        ++cAudit.iProp;
+
+    if ( cAudit.iLogged < 60 )
+    {
+        ++cAudit.iLogged;
+        char szText[384];
+        // What the bot's own visibility test says right now (it ran earlier in the frame, or frames ago).
+        bool bBotSees = CUtil::IsVisible( vEye, pEnemy->GetEdict() );
+        snprintf( szText, sizeof( szText ), "visaudit: %s fires at %s through %s %s, distance %.0f, obstacle %.0f from the shooter, eye %.0f %.0f %.0f, enemy %.0f %.0f %.0f, bot test now %s.",
+                  pShooter->GetName(), pEnemy->GetName(), szWhat, szClass, vEye.DistTo( pEnemy->GetHead() ),
+                  vEye.DistTo( vHit ), vEye.x, vEye.y, vEye.z, pEnemy->GetHead().x, pEnemy->GetHead().y,
+                  pEnemy->GetHead().z, bBotSees ? "visible" : "hidden" );
+        AuditLog( szText );
+    }
+}
