+void CBot::FilterAttack()
+{
+    // Every attack press goes through here (new shots, rifle-type weapons held during their shot time, no-weapon
+    // shots): no firing at a wall, beside the enemy while turning, or at an enemy gone out of sight.
+    const CWeaponWithAmmo* pWeapon = CWeapons::IsValid(m_iWeapon) ? &m_aWeapons[m_iWeapon] : NULL;
+    if ( pWeapon && ( pWeapon->IsMelee() || pWeapon->IsGrenade() || pWeapon->IsPhysics() ||
+                      pWeapon->GetBaseWeapon()->iParabolicDistance0[0] || pWeapon->GetBaseWeapon()->iParabolicDistance45[0] ) )
+    {
+#if defined(BOTRIX_SGTLS) || defined(BOTRIX_SGTC2)
+        if ( sgtls::bVisAudit )
+        {
+            char szReason[64];
+            snprintf( szReason, sizeof(szReason), "unfiltered: %s %s", pWeapon->IsMelee() ? "melee" : "throw",
+                      pWeapon->GetName().c_str() );
+            sgtls::AuditPress( this, szReason );
+        }
+#endif
+        return; // Swings, throws, arcs.
+    }
+
+    int iButtons = IN_ATTACK;
+    if ( !pWeapon || !pWeapon->IsSniper() )
+        iButtons |= IN_ATTACK2; // A sniper's secondary is its zoom.
+    if ( !FLAG_SOME_SET(iButtons, m_cCmd.buttons) )
+        return;
+
+    const char* szShot = !m_pCurrentEnemy ? "no enemy" : m_bEnemyOffSight ? "enemy out of sight" : ShotCheck();
+    bool bHold = CUtil::bStrictBotVisibility && strcmp( szShot, "on target" ) != 0;
+#if defined(BOTRIX_SGTLS) || defined(BOTRIX_SGTC2)
+    if ( sgtls::bVisAudit )
+    {
+        char szReason[128];
+        snprintf( szReason, sizeof(szReason), "%s: %s (%s)%s", bHold ? "final, held" : "final, fired", szShot,
+                  pWeapon ? pWeapon->GetName().c_str() : "no weapon",
+                  m_pCurrentEnemy ? sgtls::DistanceBucket( sqrt( m_fDistanceSqrToEnemy ) ) : "" );
+        sgtls::AuditPress( this, szReason );
+    }
+#endif
+    if ( bHold )
+        FLAG_CLEAR( iButtons, m_cCmd.buttons );
+}
