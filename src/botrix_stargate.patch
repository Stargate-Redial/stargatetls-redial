+
+namespace
+{
+    // Deadly volumes: teleporters to a killbox (back of a stargate, kawoosh) and enabled trigger_hurt (out of
+    // bounds zones). Rebuilt with the BSP entities.
+    std::vector<const sgtls::CBspEntity*> m_aForbidden;
+    std::string m_sForbiddenMap;
+
+    bool IsKillTeleport( const sgtls::CBspEntity& e )
+    {
+        std::string sTarget = e.Get( "target" ), sName = e.Get( "targetname" );
+        return sTarget.find( "killbox" ) != std::string::npos || sName.find( "kill" ) != std::string::npos ||
+               sName.find( "backtele" ) != std::string::npos;
+    }
+
+    // A trigger whose filter is a filter_activator_team: it only acts on one team (tls_hapschets_temple's spawn
+    // protection hurts the enemies in each spawn room; counted as deadly, it left the spawns without waypoints).
+    bool TeamFiltered( const sgtls::CBspEntity& e )
+    {
+        const char* szFilter = e.Get( "filtername" );
+        if ( !szFilter[0] )
+            return false;
+        const std::vector<sgtls::CBspEntity>& aEnts = sgtls::BspEntities();
+        for ( size_t i = 0; i < aEnts.size(); ++i )
+            if ( strcmp( aEnts[i].Get( "targetname" ), szFilter ) == 0 &&
+                 strcmp( aEnts[i].Get( "classname" ), "filter_activator_team" ) == 0 )
+                return true;
+        return false;
+    }
+
+    const std::vector<const sgtls::CBspEntity*>& ForbiddenBoxes()
+    {
+        const std::vector<sgtls::CBspEntity>& aEnts = sgtls::BspEntities();
+        if ( m_sForbiddenMap == m_sEntitiesMap )
+            return m_aForbidden;
+        m_sForbiddenMap = m_sEntitiesMap;
+        m_aForbidden.clear();
+        for ( size_t i = 0; i < aEnts.size(); ++i )
+        {
+            const sgtls::CBspEntity& e = aEnts[i];
+            if ( !e.bBrush )
+                continue;
+            const char* szClass = e.Get( "classname" );
+            if ( strcmp( szClass, "trigger_teleport" ) == 0 && IsKillTeleport( e ) )
+                m_aForbidden.push_back( &e );
+            else if ( strcmp( szClass, "trigger_hurt" ) == 0 && strcmp( e.Get( "StartDisabled" ), "1" ) != 0 &&
+                      atof( e.Get( "damage", "0" ) ) >= 5.0f && !TeamFiltered( e ) )
+                m_aForbidden.push_back( &e );
+        }
+        // A strong push for good (trigger_push on from the start, 200+ units/s) whose stream ends in one of them within
+        // 256 units: tls_hapschets_temple_06e's river (speed 400, 4800 units long) sweeps into a pit (damage 1000);
+        // 13 bots in 10 minutes walked into it and died there.
+        size_t iDeadly = m_aForbidden.size();
+        for ( size_t i = 0; i < aEnts.size(); ++i )
+        {
+            const sgtls::CBspEntity& e = aEnts[i];
+            if ( !e.bBrush || strcmp( e.Get( "classname" ), "trigger_push" ) != 0 || strcmp( e.Get( "StartDisabled" ), "1" ) == 0 ||
+                 atof( e.Get( "speed", "0" ) ) < 200.0f || TeamFiltered( e ) )
+                continue;
+            float fPitch = 0.0f, fYaw = 0.0f, fRoll = 0.0f;
+            sscanf( e.Get( "pushdir", "0 0 0" ), "%f %f %f", &fPitch, &fYaw, &fRoll );
+            Vector vDir( cosf( fYaw * 3.14159265f / 180.0f ), sinf( fYaw * 3.14159265f / 180.0f ), 0.0f );
+            Vector vMins = e.vMins, vMaxs = e.vMaxs;
+            for ( int a = 0; a < 2; ++a )
+            {
+                if ( vDir[a] > 0.5f )
+                    vMaxs[a] += 256.0f;
+                else if ( vDir[a] < -0.5f )
+                    vMins[a] -= 256.0f;
+            }
+            bool bIntoDeath = false;
+            for ( size_t k = 0; k < iDeadly && !bIntoDeath; ++k )
+            {
+                const sgtls::CBspEntity& d = *m_aForbidden[k];
+                bIntoDeath = ( strcmp( d.Get( "classname" ), "trigger_teleport" ) == 0 || atof( d.Get( "damage", "0" ) ) >= 100.0f ) &&
+                             vMins.x < d.vMaxs.x && vMaxs.x > d.vMins.x && vMins.y < d.vMaxs.y && vMaxs.y > d.vMins.y &&
+                             vMins.z < d.vMaxs.z + 64.0f && vMaxs.z > d.vMins.z;
+            }
+            if ( bIntoDeath )
+                m_aForbidden.push_back( &e );
+        }
+        return m_aForbidden;
+    }
+
+    // Half a player's hull plus a little: a bot following a waypoint along the edge of a deadly volume touches it.
+    const float fDeadlyMargin = 24.0f;
+
+    bool InsideDeadly( const Vector& v, const sgtls::CBspEntity& e )
+    {
+        Vector vGrow( fDeadlyMargin, fDeadlyMargin, 0.0f );
+        return Inside( v, e.vMins - vGrow, e.vMaxs + vGrow );
+    }
+
+    bool SegmentHitsDeadly( const Vector& a, const Vector& b, const sgtls::CBspEntity& e )
+    {
+        Vector vGrow( fDeadlyMargin, fDeadlyMargin, 0.0f );
+        return SegmentHitsBox( a, b, e.vMins - vGrow, e.vMaxs + vGrow );
+    }
+
+    // Ends of a teleporter link, eye level: inside the trigger (on the ground if there is ground near its bottom),
+    // and on the ground at the destination.
+    void LinkEnds( const sgtls::CBspEntity& e, const sgtls::CBspEntity& d, Vector& vEntry, Vector& vExit )
+    {
+        float fEye = CMod::GetVar( EModVarPlayerEye );
+        vEntry.Init( ( e.vMins.x + e.vMaxs.x ) * 0.5f, ( e.vMins.y + e.vMaxs.y ) * 0.5f, e.vMins.z + fEye );
+        Vector vGround = GroundEye( vEntry );
+        if ( fabs( vGround.z - vEntry.z ) < 96.0f )
+            vEntry = vGround;
+        vExit = d.vOrigin;
+        vExit.z += fEye;
+        vExit = GroundEye( vExit );
+    }
+
+    // sgtls::CButtonTeleporter::fSafeDepth: where a traveller arrives (the landmark offset) for each depth of the first
+    // touch, and whether its hull is then in a kill teleporter there (not a kawoosh: over before the gate takes
+    // travellers).
+    void CrossingDepth( sgtls::CButtonTeleporter& t, const sgtls::CBspEntity& e,
+                        const std::map<std::string, const sgtls::CBspEntity*>& aNamed )
+    {
+        t.iCrossAxis = -1;
+        t.fSafeDepth[0] = t.fSafeDepth[1] = 0.0f;
+        Vector vSize = e.vMaxs - e.vMins;
+        int a = ( vSize.x < vSize.y ) ? 0 : 1, o = 1 - a;
+        if ( vSize[a] > 16.0f || vSize[o] < 48.0f || vSize.z < 64.0f )
+            return;
+        t.iCrossAxis = a;
+        std::map<std::string, const sgtls::CBspEntity*>::const_iterator itMark = aNamed.find( e.Get( "landmark" ) );
+        std::map<std::string, const sgtls::CBspEntity*>::const_iterator itDest = aNamed.find( e.Get( "target" ) );
+        if ( !e.Get( "landmark" )[0] || itMark == aNamed.end() || itDest == aNamed.end() )
+            return;
+        Vector vShift = itDest->second->vOrigin - itMark->second->vOrigin; // Arrival = position + vShift.
+        const float fHalf = 16.0f; // Player hull, half width.
+        const std::vector<const sgtls::CBspEntity*>& aKill = ForbiddenBoxes();
+        for ( int iSide = 0; iSide < 2; ++iSide )
+        {
+            float fSign = iSide ? 1.0f : -1.0f;
+            float fFace = iSide ? e.vMaxs[a] : e.vMins[a];
+            for ( int iDepth = 1; iDepth < 120; ++iDepth )
+            {
+                float fArrive = fFace + fSign * ( fHalf - iDepth * 0.1f ) + vShift[a];
+                bool bKilled = false;
+                for ( size_t k = 0; k < aKill.size() && !bKilled; ++k )
+                {
+                    const sgtls::CBspEntity& K = *aKill[k];
+                    if ( strcmp( K.Get( "classname" ), "trigger_teleport" ) != 0 || strstr( K.Get( "targetname" ), "kawoosh" ) )
+                        continue;
+                    if ( e.vMaxs[o] + vShift[o] + fHalf <= K.vMins[o] || e.vMins[o] + vShift[o] - fHalf >= K.vMaxs[o] ||
+                         e.vMaxs.z + vShift.z <= K.vMins.z || e.vMins.z + vShift.z >= K.vMaxs.z )
+                        continue;
+                    bKilled = fArrive + fHalf > K.vMins[a] && fArrive - fHalf < K.vMaxs[a];
+                }
+                if ( bKilled )
+                    t.fSafeDepth[iSide] = iDepth * 0.1f + 0.4f;
+            }
+        }
+    }
+
+    // Output value "<target>,<input>,<parameter>,<delay>,<times>".
+    bool ParseOutput( const std::string& sValue, std::string& sTarget, std::string& sInput, std::string& sParam )
+    {
+        size_t a = sValue.find( ',' );
+        size_t b = ( a == std::string::npos ) ? a : sValue.find( ',', a + 1 );
+        size_t c = ( b == std::string::npos ) ? b : sValue.find( ',', b + 1 );
+        if ( c == std::string::npos )
+            return false;
+        sTarget = sValue.substr( 0, a );
+        sInput = sValue.substr( a + 1, b - a - 1 );
+        sParam = sValue.substr( b + 1, c - b - 1 );
+        return true;
+    }
+
+    float DistanceToBox( const Vector& v, const Vector& vMins, const Vector& vMaxs )
+    {
+        Vector vNearest;
+        for ( int i = 0; i < 3; ++i )
+            vNearest[i] = clamp( v[i], vMins[i], vMaxs[i] );
+        return v.DistTo( vNearest );
+    }
+
+    // Delay of an output value (its 4th field), 0 if none.
+    float OutputDelay( const std::string& sValue )
+    {
+        size_t a = sValue.find( ',' );
+        size_t b = ( a == std::string::npos ) ? a : sValue.find( ',', a + 1 );
+        size_t c = ( b == std::string::npos ) ? b : sValue.find( ',', b + 1 );
+        return ( c == std::string::npos ) ? 0.0f : (float)atof( sValue.c_str() + c + 1 );
+    }
+
+    // What pressing a button does to a teleporter, through the map's logic: when it turns on and off (seconds after
+    // the press, -1 = never), and the presses needed (a math_counter on the way).
+    struct CChainResult
+    {
+        float fEnable, fDisable;
+        int iPresses;
+    };
+
+    typedef std::multimap<std::string, const sgtls::CBspEntity*> TByName;
+
+    // Seconds a func_door takes to open (the engine's travel: the size along its move direction, minus 2, minus lip).
+    float DoorTravelTime( const sgtls::CBspEntity& d )
+    {
+        float p = 0.0f, y = 0.0f, r = 0.0f;
+        sscanf( d.Get( "movedir", "0 0 0" ), "%f %f %f", &p, &y, &r );
+        p *= 3.14159265f / 180.0f;
+        y *= 3.14159265f / 180.0f;
+        Vector vDir( cosf( p ) * cosf( y ), cosf( p ) * sinf( y ), -sinf( p ) );
+        Vector vSize = d.vMaxs - d.vMins;
+        float fDist = fabs( vDir.x * ( vSize.x - 2.0f ) ) + fabs( vDir.y * ( vSize.y - 2.0f ) ) +
+                      fabs( vDir.z * ( vSize.z - 2.0f ) ) - (float)atof( d.Get( "lip", "0" ) );
+        float fSpeed = (float)atof( d.Get( "speed", "100" ) );
+        return ( fDist > 0.0f && fSpeed > 0.0f ) ? fDist / fSpeed : 0.0f;
+    }
+
+    // Follow the outputs of e named szOutput1 / szOutput2 that fire fDelay seconds after the press, through
+    // logic_relay (Trigger), logic_branch (Test: either result), math_counter (Add: OnHitMax after enough presses).
+    // tls_stargate_atlantis: the Goa'uld DHD triggers a chain of chevron relays, then a branch (the city's shield)
+    // enables the gate 3.5 seconds later; a relay disables it 60 seconds after.
+    void FollowChain( const TByName& aByName, const sgtls::CBspEntity& e, const char* szOutput1, const char* szOutput2,
+                      float fDelay, int iPresses, int iDepth, const std::string& sTele, CChainResult& r )
+    {
+        if ( iDepth > 24 )
+            return;
+        std::string sTarget, sInput, sParam;
+        for ( std::multimap<std::string, std::string>::const_iterator it = e.aKeys.begin(); it != e.aKeys.end(); ++it )
+        {
+            if ( ( it->first != szOutput1 && ( !szOutput2 || it->first != szOutput2 ) ) ||
+                 !ParseOutput( it->second, sTarget, sInput, sParam ) )
+                continue;
+            float fAt = fDelay + OutputDelay( it->second );
+            if ( sTarget == sTele )
+            {
+                if ( sInput == "Enable" && ( r.fEnable < 0.0f || fAt < r.fEnable ) )
+                {
+                    r.fEnable = fAt;
+                    r.iPresses = iPresses;
+                }
+                else if ( ( sInput == "Disable" || sInput == "Toggle" ) && ( r.fDisable < 0.0f || fAt < r.fDisable ) )
+                    r.fDisable = fAt;
+                continue;
+            }
+            std::pair<TByName::const_iterator, TByName::const_iterator> range = aByName.equal_range( sTarget );
+            for ( TByName::const_iterator t = range.first; t != range.second; ++t )
+            {
+                const sgtls::CBspEntity& cNext = *t->second;
+                const char* szClass = cNext.Get( "classname" );
+                if ( strcmp( szClass, "logic_relay" ) == 0 && sInput == "Trigger" )
+                    FollowChain( aByName, cNext, "OnTrigger", NULL, fAt, iPresses, iDepth + 1, sTele, r );
+                else if ( strcmp( szClass, "logic_branch" ) == 0 && ( sInput == "Test" || sInput == "SetValueTest" ) )
+                    FollowChain( aByName, cNext, "OnFalse", "OnTrue", fAt, iPresses, iDepth + 1, sTele, r );
+                else if ( strcmp( szClass, "func_door" ) == 0 && ( sInput == "Open" || sInput == "Toggle" ) )
+                {
+                    // tls_hatak's rings: the panel opens a func_door (the rings rising), whose OnFullyOpen enables
+                    // the teleporter.
+                    FollowChain( aByName, cNext, "OnOpen", NULL, fAt, iPresses, iDepth + 1, sTele, r );
+                    FollowChain( aByName, cNext, "OnFullyOpen", NULL, fAt + DoorTravelTime( cNext ), iPresses,
+                                 iDepth + 1, sTele, r );
+                }
+                else if ( strcmp( szClass, "math_counter" ) == 0 && sInput == "Add" )
+                {
+                    // Several counters can share a name (tls_lockdown: one per chevron light, max 1 to 8).
+                    float fAdd = (float)atof( sParam.c_str() );
+                    float fNeeded = (float)( atof( cNext.Get( "max", "0" ) ) - atof( cNext.Get( "startvalue", "0" ) ) );
+                    if ( fAdd > 0.0f && fNeeded > 0.0f )
+                        FollowChain( aByName, cNext, "OnHitMax", NULL, fAt, iPresses * (int)ceil( fNeeded / fAdd ),
+                                     iDepth + 1, sTele, r );
+                }
+            }
+        }
+    }
+
+    std::vector<sgtls::CButtonTeleporter> m_aButtonTeleporters;
+    std::string m_sButtonTeleportersMap;
+}
