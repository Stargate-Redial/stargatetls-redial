+
+TWaypointId sgtls::CObjectives::PickWaypoint( TTeam iTeam, edict_t*& pSpot )
+{
+    Refresh();
+    std::vector<int> aWeighted;
+    ActiveSpots( aWeighted );
+    if ( aWeighted.empty() )
+    {
+        pSpot = NULL;
+        return EWaypointIdInvalid;
+    }
+
+    // An attacker keeps its spot while it is active: a capture needs the attackers to stay inside, and a new random
+    // active spot at each arrival sent the bots back and forth between two areas 1000 units apart (tls_abydos).
+    int iSpot = -1;
+    for ( size_t i = 0; i < aWeighted.size() && pSpot; ++i )
+        if ( m_aSpots[ aWeighted[i] ].pEdict == pSpot && Attackers( m_aSpots[ aWeighted[i] ] ) == iTeam )
+            iSpot = aWeighted[i];
+    if ( iSpot < 0 )
+    {
+        // Defenders go first where the attackers are: 3 more chances per attacker inside a spot.
+        std::vector<int> aChoice = aWeighted;
+        for ( size_t i = 0; i < aWeighted.size(); ++i )
+        {
+            const CSpot& c = m_aSpots[ aWeighted[i] ];
+            int iAttackers = Attackers( c );
+            if ( iAttackers == iTeam || ( i > 0 && aWeighted[i] == aWeighted[i - 1] ) )
+                continue;
+            for ( int p = 0; p < CPlayers::Size(); ++p )
+            {
+                CPlayer* pPlayer = CPlayers::Get( p );
+                if ( !pPlayer || !pPlayer->IsAlive() || pPlayer->GetTeam() != iAttackers )
+                    continue;
+                const Vector& v = pPlayer->GetHead();
+                if ( v.x >= c.vMins.x - 64 && v.x <= c.vMaxs.x + 64 && v.y >= c.vMins.y - 64 && v.y <= c.vMaxs.y + 64 &&
+                     v.z >= c.vMins.z - 32 && v.z <= c.vMaxs.z + 96 )
+                    aChoice.insert( aChoice.end(), 3, aWeighted[i] );
+            }
+        }
+        iSpot = aChoice[ rand() % aChoice.size() ];
+    }
+    const CSpot& c = m_aSpots[iSpot];
+    pSpot = c.pEdict;
+
+    // Attackers go into the area / to the button. Defenders stand in an area half of the time (to block the
+    // capture) and around it otherwise; at a button, which they can't block, at a guard spot 3 times in 4 (<prefix>_defend).
+    bool bAttacker = ( Attackers( c ) == iTeam );
+    bool bInside = bAttacker || c.aNear.empty() || ( c.bButton ? ( sgtls::iGuardInside > 0 && ( rand() % sgtls::iGuardInside ) == 0 ) : ( rand() % 100 ) < sgtls::iAreaInside );
+    // A defender of a button watches the place under threat from a guard spot that sees it, or stands on that place
+    // (not on another one: tls_lockdown's guards at the north side of the bomb desk were blind to the Tau'ri holding
+    // it from the south, 2026-11-04).
+    if ( !bAttacker && c.bButton )
+    {
+        int iPlace = PlaceToWatch( c, Attackers( c ) );
+        if ( iPlace >= 0 )
+            return ( bInside && MainPart()[ c.aInside[iPlace] ] ) ? c.aInside[iPlace]
+                                                                : c.aWatch[iPlace][ rand() % c.aWatch[iPlace].size() ];
+    }
+    const std::vector<TWaypointId>& aChoice = bInside ? c.aInside : c.aNear;
+    if ( aChoice.empty() )
+        return EWaypointIdInvalid;
+    // Buttons: only places a bot can come back from, when there are some: two of the three places of tls_lockdown's
+    // alternate iris control are in a pocket with no way in from the rest of the map, and the Tau'ri sent there
+    // never arrived (1 attempt in 40 on that control, 2026-11-04).
+    if ( c.bButton )
+    {
+        const std::vector<char>& aMain = MainPart();
+        int iReachable = 0;
+        for ( size_t i = 0; i < aChoice.size(); ++i )
+            iReachable += aMain[ aChoice[i] ];
+        if ( iReachable > 0 && iReachable < (int)aChoice.size() )
+        {
+            int k = rand() % iReachable;
+            for ( size_t i = 0; i < aChoice.size(); ++i )
+                if ( aMain[ aChoice[i] ] && k-- == 0 )
+                    return aChoice[i];
+        }
+    }
+    return aChoice[ rand() % aChoice.size() ];
+}
+
+
+bool sgtls::CObjectives::IsAttacking( TTeam iTeam, edict_t* pSpot )
+{
+    Refresh();
+    for ( size_t a = 0; a < m_aSpots.size() && pSpot; ++a )
+        if ( m_aSpots[a].pEdict == pSpot )
+            return IsActive( m_aSpots[a] ) && Attackers( m_aSpots[a] ) == iTeam;
+    return false;
+}
+
+
+bool sgtls::CObjectives::IsDefending( TTeam iTeam, edict_t* pSpot )
+{
+    Refresh();
+    for ( size_t a = 0; a < m_aSpots.size() && pSpot; ++a )
+        if ( m_aSpots[a].pEdict == pSpot )
+            return IsActive( m_aSpots[a] ) && Attackers( m_aSpots[a] ) != iTeam;
+    return false;
+}
+
+
+bool sgtls::CObjectives::IsButtonToGuard( TTeam iTeam, edict_t* pSpot, Vector& vButton )
+{
+    Refresh();
+    for ( size_t a = 0; a < m_aSpots.size() && pSpot; ++a )
+        if ( m_aSpots[a].pEdict == pSpot )
+        {
+            const CSpot& c = m_aSpots[a];
+            if ( !c.bButton || !IsActive( c ) || Attackers( c ) == iTeam )
+                return false;
+            vButton = c.vCenter;
+            return true;
+        }
+    return false;
+}
+
+
+bool sgtls::CObjectives::GuardSpotLook( TTeam iTeam, edict_t* pSpot, TWaypointId w, Vector& vLook )
+{
+    Refresh();
+    for ( size_t a = 0; a < m_aSpots.size() && pSpot; ++a )
+    {
+        const CSpot& c = m_aSpots[a];
+        if ( c.pEdict != pSpot )
+            continue;
+        if ( !c.bButton || !IsActive( c ) || Attackers( c ) == iTeam ||
+             std::find( c.aInside.begin(), c.aInside.end(), w ) != c.aInside.end() )
+            return false;
+        if ( std::find( c.aNear.begin(), c.aNear.end(), w ) == c.aNear.end() )
+            return false;
+        vLook = c.vCenter; // Old rule (walls only): the button.
+        int iThreat = PlaceToWatch( c, Attackers( c ) );
+        int iSeen = -1;
+        for ( size_t i = 0; i < c.aWatch.size(); ++i )
+            if ( std::find( c.aWatch[i].begin(), c.aWatch[i].end(), w ) != c.aWatch[i].end() &&
+                 ( iSeen < 0 || (int)i == iThreat ) )
+                iSeen = (int)i;
+        if ( iSeen >= 0 )
+            vLook = CWaypoints::Get( c.aInside[iSeen] ).vOrigin;
+        return true;
+    }
+    return false;
+}
+
+
+void sgtls::CObjectives::NoteCapture( const Vector& vEye )
+{
+    Refresh();
+    float fBest = 200.0f * 200.0f;
+    const CSpot* pBest = NULL;
+    for ( size_t a = 0; a < m_aSpots.size(); ++a )
+        if ( m_aSpots[a].bButton && IsActive( m_aSpots[a] ) && m_aSpots[a].vCenter.DistToSqr( vEye ) < fBest )
+        {
+            fBest = m_aSpots[a].vCenter.DistToSqr( vEye );
+            pBest = &m_aSpots[a];
+        }
+    if ( !pBest || pBest->aInside.empty() )
+        return;
+    int iPlace = 0;
+    for ( size_t i = 1; i < pBest->aInside.size(); ++i )
+        if ( CWaypoints::Get( pBest->aInside[i] ).vOrigin.DistToSqr( vEye ) <
+             CWaypoints::Get( pBest->aInside[iPlace] ).vOrigin.DistToSqr( vEye ) )
+            iPlace = (int)i;
+    m_aLastPlace[ ButtonKey( *pBest ) ] = iPlace;
+}
+
+
+float sgtls::CObjectives::DistanceToSpot( edict_t* pSpot, const Vector& v )
+{
+    Refresh();
+    for ( size_t a = 0; a < m_aSpots.size() && pSpot; ++a )
+        if ( m_aSpots[a].pEdict == pSpot )
+        {
+            Vector vNearest;
+            for ( int i = 0; i < 3; ++i )
+                vNearest[i] = clamp( v[i], m_aSpots[a].vMins[i], m_aSpots[a].vMaxs[i] );
+            return v.DistTo( vNearest );
+        }
+    return 1e9f;
+}
+
+
+edict_t* sgtls::CObjectives::GetButtonToHold( TTeam iTeam, const Vector& vEye, Vector& vButton )
+{
+    Refresh();
+    for ( size_t a = 0; a < m_aSpots.size(); ++a )
+    {
+        const CSpot& c = m_aSpots[a];
+        if ( !c.bButton || !IsActive( c ) || Attackers( c ) != iTeam )
+            continue;
+        // Nearest point of the button, 4 units inside (a +use trace along an edge misses it).
+        Vector vNearest;
+        for ( int i = 0; i < 3; ++i )
+        {
+            float fMargin = ( c.vMaxs[i] - c.vMins[i] ) * 0.5f;
+            if ( fMargin > 4.0f )
+                fMargin = 4.0f;
+            vNearest[i] = clamp( vEye[i], c.vMins[i] + fMargin, c.vMaxs[i] - fMargin );
+        }
+        if ( vEye.DistToSqr( vNearest ) < fButtonApproachDistance * fButtonApproachDistance )
+        {
+            vButton = vNearest;
+            return c.pEdict;
+        }
+    }
+    return NULL;
+}
