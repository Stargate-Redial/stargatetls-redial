+    // sgtls_wpsave : link the stargates / remove killbox paths, then save the waypoints (with the visibility table).
+    void WpSaveCommand( const CCommand& args )
+    {
+        if ( CWaypoints::IsAnalyzing() )
+        {
+            Msg( "Still analyzing.\n" );
+            return;
+        }
+        Msg( "%s", sgtls::PostProcessWaypoints().c_str() );
+        sgtls::PassDoorsInAnalysis( false ); // The next traces stop at doors again.
+        bool bResult = CWaypoints::Save();
+        Msg( bResult ? "%d waypoints saved.\n" : "Error, could not save %d waypoints.\n", CWaypoints::Size() );
+        CItems::MapUnloaded();
+        CItems::MapLoaded( true );
+    }
+
+    // sgtls_reach x y z x y z [glass] : Botrix's reachability test between two eye positions, with the ground below
+    // each; "glass": through windows, as the spawn island repair does.
+    // sgtls_slope <waypoint> <waypoint>: the ground every 8 units along a path (height, slope, displacement or not).
+    void SlopeCommand( const CCommand& args )
+    {
+        if ( args.ArgC() < 3 )
+            return;
+        TWaypointId iFrom = atoi( args.Arg( 1 ) ), iTo = atoi( args.Arg( 2 ) );
+        if ( !CWaypoints::IsValid( iFrom ) || !CWaypoints::IsValid( iTo ) )
+            return;
+        const Vector& a = CWaypoints::Get( iFrom ).vOrigin;
+        const Vector& b = CWaypoints::Get( iTo ).vOrigin;
+        int iSteps = (int)( ( b - a ).Length2D() / 8.0f ) + 1;
+        Msg( "%d (%.0f %.0f %.0f) -> %d (%.0f %.0f %.0f), path %s\n", iFrom, a.x, a.y, a.z, iTo, b.x, b.y, b.z,
+             CWaypoints::HasPath( iFrom, iTo ) ? "yes" : "no" );
+        for ( int i = 0; i <= iSteps; ++i )
+        {
+            Vector v = a + ( b - a ) * ( (float)i / iSteps );
+            v.z += 32.0f;
+            Vector vGround = CUtil::GetGroundVec( v ); // GetGroundVec returns the trace end, v is unchanged.
+            const trace_t& tr = CUtil::TraceResult();
+            Msg( "  %2d ground %.0f normal z %.2f (%.0f deg)%s%s\n", i, vGround.z, tr.plane.normal.z,
+                 acosf( clamp( tr.plane.normal.z, -1.0f, 1.0f ) ) * 57.2958f, tr.startsolid ? " startsolid" : "",
+                 ( tr.dispFlags & DISPSURF_FLAG_SURFACE ) ? " disp" : "" );
+        }
+    }
+
+    // sgtls_slopescan <xmin> <ymin> <xmax> <ymax> [degrees [hull|line [steep rise]]]: the paths starting in the box that a walking player can't
+    // climb. Ground every 8 units along the path (traced down from 32 units above the path, as sgtls_slope). A path is
+    // listed when the ground rises by more than a step (18 units) over consecutive samples steeper than the limit
+    // (46 by default: Source players slide on ground steeper than 45.6 degrees, normal z < 0.7), or rises by more than
+    // a step between two samples without the path's jump flag (a ledge). One line per path:
+    // "from to climb steepest steep-rise ledge flags rise-on-displacement ledge-on-displacement" (steep-rise: the
+    // longest rise over consecutive steep samples; the last two: 1 when that rise / ledge is on terrain).
+    void SlopeScanCommand( const CCommand& args )
+    {
+        if ( args.ArgC() < 5 )
+            return;
+        float x0 = atof( args.Arg( 1 ) ), y0 = atof( args.Arg( 2 ) ), x1 = atof( args.Arg( 3 ) ), y1 = atof( args.Arg( 4 ) );
+        float fLimit = ( args.ArgC() > 5 ) ? atof( args.Arg( 5 ) ) : 46.0f;
+        bool bHull = ( args.ArgC() <= 6 ) || strcmp( args.Arg( 6 ), "line" ) != 0;
+        // The steep rise listed: 18 (a step) by default. The game refuses a step that lands on steep ground
+        // (StepMove), so shorter steep parts can block too: a lower value lists them.
+        float fSteepRise = ( args.ArgC() > 7 ) ? atof( args.Arg( 7 ) ) : 18.0f;
+        const float fStep = 18.0f;
+        int iPaths = 0, iListed = 0;
+        for ( TWaypointId w = 0; w < CWaypoints::Size(); ++w )
+        {
+            const Vector& a = CWaypoints::Get( w ).vOrigin;
+            if ( a.x < x0 || a.x > x1 || a.y < y0 || a.y > y1 )
+                continue;
+            CWaypoints::WaypointNode& cNode = CWaypoints::GetNode( w );
+            for ( CWaypoints::WaypointArcIt it = cNode.neighbours.begin(); it != cNode.neighbours.end(); ++it )
+            {
+                const Vector& b = CWaypoints::Get( it->target ).vOrigin;
+                ++iPaths;
+                int iSteps = (int)( ( b - a ).Length2D() / 8.0f ) + 1;
+                float fPrev = 0.0f, fMax = 0.0f, fRise = 0.0f, fRun = 0.0f, fLedge = 0.0f;
+                bool bRunDisp = false, bRiseDisp = false, bLedgeDisp = false;
+                for ( int i = 0; i <= iSteps; ++i )
+                {
+                    Vector v = a + ( b - a ) * ( (float)i / iSteps );
+                    v.z += 32.0f;
+                    // The player's hull, as the game's movement finds the ground (CategorizePosition: a hull trace,
+                    // ground if the normal z >= 0.7): small steep bumps under a wide hull don't count.
+                    float fGround = bHull ? CUtil::GetHullGroundVec( v ).z : CUtil::GetGroundVec( v ).z;
+                    const trace_t& tr = CUtil::TraceResult();
+                    float fDeg = acosf( clamp( tr.plane.normal.z, -1.0f, 1.0f ) ) * 57.2958f;
+                    bool bDisp = ( tr.dispFlags & DISPSURF_FLAG_SURFACE ) != 0;
+                    float fUp = fGround - fPrev;
+                    if ( i > 0 && fUp > 0.5f && fDeg > fLimit )
+                    {
+                        fRun += fUp;
+                        bRunDisp |= bDisp;
+                        if ( fRun > fRise )
+                        {
+                            fRise = fRun;
+                            bRiseDisp = bRunDisp;
+                        }
+                        if ( fDeg > fMax )
+                            fMax = fDeg;
+                    }
+                    else
+                    {
+                        fRun = 0.0f;
+                        bRunDisp = false;
+                        if ( i > 0 && fUp > fLedge )
+                        {
+                            fLedge = fUp;
+                            bLedgeDisp = bDisp;
+                        }
+                    }
+                    fPrev = fGround;
+                }
+                bool bJump = FLAG_SOME_SET( FPathJump, it->edge.iFlags );
+                if ( fRise > fSteepRise || ( !bJump && fLedge > fStep ) )
+                {
+                    ++iListed;
+                    Msg( "%d %d %.0f %.0f %.0f %.0f %d %d %d\n", w, it->target, b.z - a.z, fMax, fRise, fLedge,
+                         (int)it->edge.iFlags, bRiseDisp ? 1 : 0, bLedgeDisp ? 1 : 0 );
+                }
+            }
+        }
+        Msg( "%d paths from the box, %d can't be walked up (steeper than %.0f degrees or a ledge).\n", iPaths,
+             iListed, fLimit );
+    }
+
+    // <prefix>_wpcheck : the plain paths (no flag, nearly level) that a player's hull can't walk because an entity that
+    // doesn't move stands in the way (a model's collision: tls_sandfort_beta3's tents, 350 units wide, the Tau'ri spawn
+    // inside one; the analysis let them through and bots walked into the walls until the watchdog). Listed as
+    // "wpcheck <from> <to> <class> <model>": the waypoints file is not changed.
+    class CWpCheckFilter: public CTraceFilter
+    {
+    public:
+        virtual bool ShouldHitEntity( IHandleEntity* pHandle, int /*contentsMask*/ )
+        {
+            if ( CBotrixPlugin::pStaticPropMgr && CBotrixPlugin::pStaticPropMgr->IsStaticProp( pHandle ) )
+                return true;
+            int index = pHandle->GetRefEHandle().GetEntryIndex();
+            if ( index == 0 || index >= MAX_EDICTS )
+                return false; // The world: steps and slopes are the analysis' business.
+            edict_t* pEdict = CBotrixPlugin::pEngineServer->PEntityOfEntIndex( index );
+            if ( !pEdict || pEdict->IsFree() || index < 1 + CPlayers::Size() )
+                return false;
+            const char* szClass = pEdict->GetClassName();
+            if ( !szClass )
+                return false;
+            // What moves, opens or breaks is not a wall.
+            return strcmp( szClass, "prop_dynamic" ) == 0 || strcmp( szClass, "prop_dynamic_override" ) == 0 ||
+                   strcmp( szClass, "func_brush" ) == 0 || strcmp( szClass, "func_wall" ) == 0 ||
+                   strcmp( szClass, "func_illusionary" ) == 0;
+        }
+        virtual TraceType_t GetTraceType() const { return TRACE_EVERYTHING; }
+    };
+
+    void WpCheckCommand( const CCommand& /*args*/ )
+    {
+        float fEye = CMod::GetVar( EModVarPlayerEye );
+        float fHalf = CMod::GetVar( EModVarPlayerWidth ) * 0.5f - 1.0f;
+        int iTested = 0, iBlocked = 0;
+        for ( TWaypointId i = 0; i < CWaypoints::Size(); ++i )
+        {
+            CWaypoints::WaypointNode& cNode = CWaypoints::GetNode( i );
+            for ( CWaypoints::WaypointArcIt it = cNode.neighbours.begin(); it != cNode.neighbours.end(); ++it )
+            {
+                if ( it->edge.iFlags != FPathNone )
+                    continue;
+                const Vector& a = cNode.vertex.vOrigin;
+                const Vector& b = CWaypoints::Get( it->target ).vOrigin;
+                if ( fabs( a.z - b.z ) > 24.0f )
+                    continue;
+                ++iTested;
+                // Feet 20 units up (steps), up to a crouched player's top.
+                Vector fa( a.x, a.y, a.z - fEye + 20.0f ), fb( b.x, b.y, b.z - fEye + 20.0f );
+                Ray_t ray;
+                ray.Init( fa, fb, Vector( -fHalf, -fHalf, 0.0f ), Vector( fHalf, fHalf, 24.0f ) );
+                trace_t tr;
+                CWpCheckFilter cFilter;
+                CBotrixPlugin::pEngineTrace->TraceRay( ray, MASK_PLAYERSOLID, &cFilter, &tr );
+                if ( tr.fraction >= 1.0f && !tr.startsolid )
+                    continue;
+                ++iBlocked;
+                const char* szClass = "static prop";
+                const char* szModel = "";
+                if ( tr.m_pEnt && !( CBotrixPlugin::pStaticPropMgr &&
+                                     CBotrixPlugin::pStaticPropMgr->IsStaticProp( reinterpret_cast<IHandleEntity*>( tr.m_pEnt ) ) ) )
+                {
+                    int iHit = reinterpret_cast<IHandleEntity*>( tr.m_pEnt )->GetRefEHandle().GetEntryIndex();
+                    edict_t* pHit = CBotrixPlugin::pEngineServer->PEntityOfEntIndex( iHit );
+                    if ( pHit && !pHit->IsFree() )
+                    {
+                        szClass = pHit->GetClassName();
+                        szModel = pHit->GetIServerEntity() ? STRING( pHit->GetIServerEntity()->GetModelName() ) : "";
+                    }
+                }
+                Msg( "wpcheck %d %d %s %s\n", i, it->target, szClass, szModel );
+            }
+        }
+        Msg( "wpcheck: %d plain paths tested, %d blocked by an entity that doesn't move\n", iTested, iBlocked );
+    }
+
+    void ReachCommand( const CCommand& args )
+    {
+        if ( args.ArgC() < 7 )
+            return;
+        bool bGround = false;
+        CUtil::bPassGlass = false;
+        for ( int i = 7; i < args.ArgC(); ++i )
+        {
+            if ( strcmp( args.Arg( i ), "glass" ) == 0 )
+                CUtil::bPassGlass = true;
+            else if ( strcmp( args.Arg( i ), "ground" ) == 0 )
+                bGround = true;
+            else if ( strcmp( args.Arg( i ), "doors" ) == 0 )
+                sgtls::PassDoorsInAnalysis( true ); // As the analysis with sgtls_wpgen ... doors.
+        }
+        Vector a( atof( args.Arg( 1 ) ), atof( args.Arg( 2 ) ), atof( args.Arg( 3 ) ) );
+        Vector b( atof( args.Arg( 4 ) ), atof( args.Arg( 5 ) ), atof( args.Arg( 6 ) ) );
+        if ( bGround )
+        {
+            float fEye = CMod::GetVar( EModVarPlayerEye );
+            a = CUtil::GetHullGroundVec( a ) + Vector( 0, 0, fEye );
+            b = CUtil::GetHullGroundVec( b ) + Vector( 0, 0, fEye );
+            Msg( "a %.2f %.2f %.2f, b %.2f %.2f %.2f%s\n", a.x, a.y, a.z, b.x, b.y, b.z,
+                 CUtil::bPassModels ? " (doors passable)" : "" );
+        }
+        Vector ga = CUtil::GetHullGroundVec( a );
+        Vector gb = CUtil::GetHullGroundVec( b );
+        bool bVisible = CUtil::IsVisible( a, b, EVisibilityWaypoints );
+        bool bCrouch = false;
+        Vector b2 = b;
+        TReach iReach = CUtil::GetReachableInfoFromTo( a, b2, bCrouch, 0, 1e9f, false );
+        CUtil::bPassGlass = false;
+        if ( !CWaypoints::IsAnalyzing() )
+            sgtls::PassDoorsInAnalysis( false );
+        Msg( "ground a %.0f, ground b %.0f, visible %d, reach %d (0 no, 1 yes, 2 stairs, 3 jump, 4 fall damage), crouch %d\n",
+             ga.z, gb.z, bVisible, iReach, bCrouch );
+        // Contents just above the ground (water 0x20, slime 0x10, solid 0x1, player clip 0x10000...).
+        Msg( "contents above the ground: a 0x%x, b 0x%x\n",
+             CBotrixPlugin::pEngineTrace->GetPointContents( ga + Vector( 0, 0, 8 ) ),
+             CBotrixPlugin::pEngineTrace->GetPointContents( gb + Vector( 0, 0, 8 ) ) );
+        // What stops a player-sized line a -> b: the world alone, then everything.
+        Ray_t ray;
+        ray.Init( a, b );
+        trace_t tr;
+        CTraceFilterWorldOnly cWorld;
+        CBotrixPlugin::pEngineTrace->TraceRay( ray, MASK_PLAYERSOLID, &cWorld, &tr );
+        Msg( "world only: fraction %.2f, end %.0f %.0f %.0f\n", tr.fraction, tr.endpos.x, tr.endpos.y, tr.endpos.z );
+        CTraceFilterHitAll cAll;
+        CBotrixPlugin::pEngineTrace->TraceRay( ray, MASK_PLAYERSOLID, &cAll, &tr );
+        // CBaseEntity derives from IHandleEntity alone (single inheritance): same address.
+        int iHit = tr.m_pEnt ? reinterpret_cast<IHandleEntity*>( tr.m_pEnt )->GetRefEHandle().GetEntryIndex() : -1;
+        edict_t* pHit = iHit >= 0 ? CBotrixPlugin::pEngineServer->PEntityOfEntIndex( iHit ) : NULL;
+        Msg( "everything: fraction %.2f, end %.0f %.0f %.0f, hit %s %d\n", tr.fraction, tr.endpos.x, tr.endpos.y,
+             tr.endpos.z, pHit ? pHit->GetClassName() : "-", iHit );
+    }
+
+    // <prefix>_wpnear x y z [radius] : the waypoints near a point (eye level) with their paths (also during an analysis).
+    void WpNearCommand( const CCommand& args )
+    {
+        if ( args.ArgC() < 4 )
+            return;
+        Vector v( atof( args.Arg( 1 ) ), atof( args.Arg( 2 ) ), atof( args.Arg( 3 ) ) );
+        float fRadius = args.ArgC() > 4 ? (float)atof( args.Arg( 4 ) ) : 96.0f;
+        int iShown = 0;
+        for ( TWaypointId w = 0; w < CWaypoints::Size() && iShown < 24; ++w )
+        {
+            const Vector& vw = CWaypoints::Get( w ).vOrigin;
+            if ( vw.DistToSqr( v ) > fRadius * fRadius )
+                continue;
+            ++iShown;
+            std::string sPaths;
+            char szBuf[32];
+            for ( TWaypointId t = 0; t < CWaypoints::Size(); ++t )
+                if ( t != w && CWaypoints::HasPath( w, t ) && CWaypoints::Get( t ).vOrigin.DistToSqr( vw ) < 400.0f * 400.0f )
+                {
+                    snprintf( szBuf, sizeof(szBuf), " %d", (int)t );
+                    sPaths += szBuf;
+                }
+            Msg( "%d (%.1f %.1f %.1f) flags 0x%x ->%s\n", (int)w, vw.x, vw.y, vw.z, CWaypoints::Get( w ).iFlags,
+                 sPaths.c_str() );
+        }
+        Msg( "%d waypoints within %.0f%s\n", iShown, fRadius, CWaypoints::IsAnalyzing() ? " (analyzing)" : "" );
+    }
