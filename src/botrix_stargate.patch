diff --git a/mods/sgtc2/stargates_sgtc2.cpp b/mods/sgtc2/stargates_sgtc2.cpp
new file mode 100644
index 0000000..71dee60
--- /dev/null
+++ b/mods/sgtc2/stargates_sgtc2.cpp
@@ -0,0 +1,1055 @@
+#ifdef BOTRIX_SGTC2
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include "mod.h"
+#include "players.h"
+#include "server_plugin.h"
+#include "waypoint.h"
+#include "mods/sgtc2/stargates_sgtc2.h"
+#include "mods/sgtc2/bot_sgtc2.h"
+#include "mods/sgtls/sgtls_map.h"
+#include "mods/sgtls/sgtls_util.h"
+
+#include "eiface.h"
+#include "edict.h"
+#include "iservernetworkable.h"
+#include "iserverunknown.h"
+#include "tier1/strtools.h"
+
+// memdbgon must be the last include file in a .cpp file!!!
+#include "tier0/memdbgon.h"
+
+
+#ifdef _WIN32
+// Not including windows.h: it clashes with the SDK headers.
+extern "C" __declspec(dllimport) void* __stdcall GetModuleHandleA( const char* szModule );
+#endif
+
+namespace
+{
+    // CBFLStargate fields in the StargateTC 2 server.dll (image base 0x22000000), found by disassembly. Only read
+    // from entities that have this vtable.
+#ifdef _WIN32
+    const unsigned int iGateVtable = 0x224f693c;
+    const int iGateChevrons = 0x474;           // 7 string_t: the locked symbols, "" when not locked.
+    const int iGateActive = 0x491;             // bool: wormhole established (incoming or outgoing).
+    const int iGateOutgoing = 0x4a0;           // bool: this gate dialed the wormhole.
+    const int iGateDestination = 0x4b8;        // CBFLStargate*: the gate it dialed.
+#else
+    // The same fields in server_i486.so, 0x14 further: GCC's member function pointers (m_pfnThink...) take 8 bytes.
+    // Checked in OutGoing / InComing / SetGateActive / DialOut / AddChevron.
+    const int iGateChevrons = 0x488;
+    const int iGateActive = 0x4a5;
+    const int iGateOutgoing = 0x4b4;
+    const int iGateDestination = 0x4cc;
+#endif
+
+    // DHD button n (1..38) sends the symbol szSymbols[n-1]. The 7th chevron must be the point of origin.
+    const char* szSymbols = "123456789qwertyuiopasdfghjklzxcvbnm,.[";
+    const char cPointOfOrigin = 'h';
+
+    const float fKawooshTime = 4.0f;           // A gate that opened less than this ago kills what is in front of it.
+    const float fDhdDistance = 130.0f;         // Max horizontal distance from the eyes to the DHD to press buttons.
+    const float fEnterDistance = 400.0f;       // Walk straight into an open gate from this distance in front of it.
+    // Walk straight into an objective trigger / the artefact from these distances (off the waypoint grid). Farther,
+    // the navigation brings the bot closer: a straight line can be blocked.
+    const float fWalkIntoGoalDistance = 200.0f;
+    const float fWalkIntoArtefactDistance = 80.0f;
+    const float fPressInterval = 0.4f;
+    const float fNearDistance = 900.0f;
+    const float fChaseInterval = 3.0f;         // Choose again the destination of bots that follow the artefact.
+
+    struct CGate
+    {
+        std::string sName;                     // Address.
+        Vector vOrigin, vForward;              // The open side faces vForward.
+        edict_t* pEdict;
+        TWaypointId iFront;                    // Waypoint in front of the gate.
+        int iIsland;
+        std::vector<TWaypointId> aNear;
+        bool bActive;                          // Last seen state.
+        float fActiveTime;                     // When bActive changed.
+    };
+
+    struct CDhd
+    {
+        std::string sGate;
+        int iGate;                             // Gate it dials from (index in m_aGates), -1 if missing.
+        Vector vOrigin;
+        edict_t* aButtons[39];                 // [0] center button, [1..38] symbol buttons.
+        TWaypointId iWaypoint;
+        int iIsland;
+        std::vector<TWaypointId> aNear;
+    };
+
+    // objective_trigger_filter (objective mode: the team that touches it wins), or bfl_objectivepoint_* (capture
+    // the artefact: where a team brings it).
+    struct CGoal
+    {
+        int iTeam;
+        bool bPoint;                           // bfl_objectivepoint_*.
+        Vector vMins, vMaxs, vCenter;
+        std::vector<TWaypointId> aInside, aNear;
+        int iIsland;
+    };
+
+    // Gate travel from an island to another one.
+    struct CRoute
+    {
+        int iDhd, iSource, iDestination;
+    };
+
+    std::vector<CGate> m_aGates;
+    std::vector<CDhd> m_aDhds;
+    std::vector<CGoal> m_aGoals;
+    std::vector<int> m_aIsland;                // Island (connected component) of each waypoint.
+    std::vector<bool> m_aExits;                // Islands with a spawn point or a DHD.
+    TAreaId m_aTurretArea[2] = { EAreaIdInvalid, EAreaIdInvalid }; // Waypoints under the turrets of team 2 / 3.
+    sgtc2::TGameMode m_iMode = sgtc2::EModeNone;
+    std::string m_sMap;
+    int m_iWaypoints = -1;
+    float m_fNextEntities = 0.0f;
+    float m_fLastUpdate = -1.0f;
+    int m_iStamp = 0;
+    // Objective mode, <prefix>_chase: defenders going through the stargate after attackers that reached the
+    // objective's island (they may dial), and whether attackers are there (checked every second).
+    std::vector<edict_t*> m_aChasers;
+    bool m_bAttackersOnGoal = false;
+    float m_fNextGoalCheck = 0.0f;
+    int m_iChaseStamp = 0;                     // Every fChaseInterval while the artefact is carried.
+
+    edict_t* m_pDialer = NULL;                 // Bot that dials, one at a time.
+    float m_fDialerTime = 0.0f;
+    float m_fNextPress = 0.0f;
+
+    edict_t* m_pArtefact = NULL;               // weapon_artfact (capture the artefact mode).
+    edict_t* m_pCarrier = NULL;                // Player that carries it, NULL when on the ground.
+    float m_fNextArtefact = 0.0f;
+    float m_fNextChase = 0.0f;
+
+
+    int Island( TWaypointId w )
+    {
+        return ( w >= 0 && w < (int)m_aIsland.size() ) ? m_aIsland[w] : -1;
+    }
+
+    TWaypointId Random( const std::vector<TWaypointId>& aWaypoints )
+    {
+        return aWaypoints.empty() ? EWaypointIdInvalid : aWaypoints[ rand() % aWaypoints.size() ];
+    }
+
+    // A random waypoint of an island (a few tries), EWaypointIdInvalid if none found.
+    // A random waypoint of the island; with pNear, within fRadius of it.
+    TWaypointId RandomOnIsland( int iIsland, const Vector* pNear = NULL, float fRadius = 0.0f )
+    {
+        for ( int i = 0; i < ( pNear ? 256 : 32 ) && !m_aIsland.empty(); ++i )
+        {
+            TWaypointId w = rand() % (int)m_aIsland.size();
+            if ( m_aIsland[w] == iIsland &&
+                 ( !pNear || CWaypoints::Get( w ).vOrigin.DistToSqr( *pNear ) < fRadius * fRadius ) )
+                return w;
+        }
+        return EWaypointIdInvalid;
+    }
+
+    // Another bot is dialing (it pressed a button less than 2 seconds ago).
+    bool OtherDialer( edict_t* pBot )
+    {
+        return m_pDialer && m_pDialer != pBot && CBotrixPlugin::fTime - m_fDialerTime < 2.0f;
+    }
+
+    int ButtonOf( char cSymbol )
+    {
+        const char* p = strchr( szSymbols, cSymbol );
+        return ( p && cSymbol ) ? (int)( p - szSymbols ) + 1 : -1;
+    }
+
+    bool CanDial( const CGate& g )
+    {
+        if ( g.sName.size() != 6 )
+            return false;
+        for ( size_t i = 0; i < g.sName.size(); ++i )
+            if ( ButtonOf( g.sName[i] ) < 0 )
+                return false;
+        return true;
+    }
+
+    char* GateBase( const CGate& g )
+    {
+#ifdef _WIN32
+        static char* pServer = (char*)GetModuleHandleA( "server.dll" );
+        if ( !pServer || !g.pEdict || g.pEdict->IsFree() || !g.pEdict->GetUnknown() )
+            return NULL;
+        char* p = (char*)g.pEdict->GetUnknown()->GetBaseEntity();
+        return ( p && *(char**)p == pServer + ( iGateVtable - 0x22000000 ) ) ? p : NULL;
+#else
+        // The vtable symbol starts with offset-to-top and the typeinfo: objects point after them.
+        static void** pVtable = (void**)sgtls::ServerSymbol( "_ZTV12CBFLStargate" );
+        if ( !pVtable || !g.pEdict || g.pEdict->IsFree() || !g.pEdict->GetUnknown() )
+            return NULL;
+        char* p = (char*)g.pEdict->GetUnknown()->GetBaseEntity();
+        return ( p && *(void***)p == pVtable + 2 ) ? p : NULL;
+#endif
+    }
+
+    bool IsActive( const CGate& g )
+    {
+        char* p = GateBase( g );
+        return p && p[iGateActive];
+    }
+
+    bool IsOpenTo( const CGate& g, const CGate& d )
+    {
+        char* p = GateBase( g );
+        char* q = GateBase( d );
+        return p && q && p[iGateActive] && p[iGateOutgoing] && *(char**)( p + iGateDestination ) == q;
+    }
+
+    // Symbols locked on a gate that is being dialed. Return their count.
+    int Chevrons( const CGate& g, char aSymbols[7] )
+    {
+        char* p = GateBase( g );
+        int n = 0;
+        while ( p && n < 7 )
+        {
+            const char* sz = *(const char**)( p + iGateChevrons + n * 4 );
+            if ( !sz || !*sz )
+                break;
+            aSymbols[n++] = sz[0];
+        }
+        return n;
+    }
+
+    // Waypoints within fDistance of v on the island iIsland.
+    void NearWaypoints( const Vector& v, float fDistance, int iIsland, std::vector<TWaypointId>& aResult )
+    {
+        for ( TWaypointId w = 0; w < CWaypoints::Size(); ++w )
+            if ( m_aIsland[w] == iIsland && CWaypoints::Get( w ).vOrigin.DistToSqr( v ) < fDistance * fDistance )
+                aResult.push_back( w );
+    }
+
+    void BuildIslands()
+    {
+        int n = CWaypoints::Size();
+        std::vector< std::vector<TWaypointId> > aLinks( n );
+        for ( TWaypointId w = 0; w < n; ++w )
+        {
+            CWaypoints::WaypointNode& cNode = CWaypoints::GetNode( w );
+            for ( int i = 0; i < (int)cNode.neighbours.size(); ++i )
+            {
+                TWaypointId t = cNode.neighbours[i].target;
+                aLinks[w].push_back( t );
+                aLinks[t].push_back( w );
+            }
+        }
+        m_aIsland.assign( n, -1 );
+        std::vector<TWaypointId> aStack;
+        int iIsland = 0;
+        for ( TWaypointId s = 0; s < n; ++s )
+        {
+            if ( m_aIsland[s] >= 0 )
+                continue;
+            m_aIsland[s] = iIsland;
+            aStack.push_back( s );
+            while ( !aStack.empty() )
+            {
+                TWaypointId w = aStack.back();
+                aStack.pop_back();
+                for ( size_t i = 0; i < aLinks[w].size(); ++i )
+                    if ( m_aIsland[ aLinks[w][i] ] < 0 )
+                    {
+                        m_aIsland[ aLinks[w][i] ] = iIsland;
+                        aStack.push_back( aLinks[w][i] );
+                    }
+            }
+            ++iIsland;
+        }
+    }
+
+    void AddGoal( const sgtls::CBspEntity& e, int iTeam, bool bPoint )
+    {
+        float fEye = CMod::GetVar( EModVarPlayerEye );
+        CGoal c;
+        c.iTeam = iTeam;
+        c.bPoint = bPoint;
+        c.vMins = e.bBrush ? e.vMins : e.vOrigin - Vector( 32, 32, 32 );
+        c.vMaxs = e.bBrush ? e.vMaxs : e.vOrigin + Vector( 32, 32, 32 );
+        c.vCenter = ( c.vMins + c.vMaxs ) * 0.5f;
+        for ( TWaypointId w = 0; w < CWaypoints::Size(); ++w )
+        {
+            const Vector& v = CWaypoints::Get( w ).vOrigin; // Eye level.
+            if ( v.x >= c.vMins.x - 16 && v.x <= c.vMaxs.x + 16 && v.y >= c.vMins.y - 16 && v.y <= c.vMaxs.y + 16 &&
+                 v.z - fEye >= c.vMins.z - 24 && v.z - fEye <= c.vMaxs.z )
+                c.aInside.push_back( w );
+        }
+        if ( c.aInside.empty() )
+        {
+            // Smaller than the waypoint grid: the nearest waypoint, then GetAction() walks into it.
+            TWaypointId w = CWaypoints::GetNearestWaypoint( c.vCenter, NULL, false, 600.0f );
+            if ( CWaypoint::IsValid( w ) )
+                c.aInside.push_back( w );
+        }
+        c.iIsland = c.aInside.empty() ? -1 : Island( c.aInside[0] );
+        if ( c.iIsland >= 0 )
+            NearWaypoints( c.vCenter, fNearDistance, c.iIsland, c.aNear );
+        m_aGoals.push_back( c );
+    }
+
+    // Map knowledge from the BSP and the waypoints.
+    void Rebuild()
+    {
+        m_aGates.clear();
+        m_aDhds.clear();
+        m_aGoals.clear();
+        m_aExits.clear();
+        m_iMode = sgtc2::EModeNone;
+        m_pDialer = m_pArtefact = m_pCarrier = NULL;
+        BuildIslands();
+
+        float fEye = CMod::GetVar( EModVarPlayerEye );
+        const std::vector<sgtls::CBspEntity>& aEnts = sgtls::BspEntities();
+        for ( size_t i = 0; i < aEnts.size(); ++i )
+        {
+            const sgtls::CBspEntity& e = aEnts[i];
+            const char* szClass = e.Get( "classname" );
+            if ( strcmp( szClass, "sgtc2_gameplay" ) == 0 )
+                m_iMode = (sgtc2::TGameMode)atoi( e.Get( "mod", "-1" ) );
+            else if ( strcmp( szClass, "bfl_stargate" ) == 0 )
+            {
+                CGate g;
+                g.sName = e.Get( "targetname" );
+                g.vOrigin = e.vOrigin;
+                float fPitch = 0, fYaw = 0, fRoll = 0;
+                sscanf( e.Get( "angles", "0 0 0" ), "%f %f %f", &fPitch, &fYaw, &fRoll );
+                g.vForward = Vector( cosf( fYaw * 3.14159265f / 180.0f ), sinf( fYaw * 3.14159265f / 180.0f ), 0 );
+                g.pEdict = NULL;
+                // The ring is ~300 high around its origin: eyes of a player standing in front are ~40 below it.
+                g.iFront = CWaypoints::GetNearestWaypoint( g.vOrigin + g.vForward * 100.0f - Vector( 0, 0, 40 ), NULL,
+                                                           false, 250.0f );
+                g.iIsland = Island( g.iFront );
+                if ( g.iIsland >= 0 )
+                    NearWaypoints( CWaypoints::Get( g.iFront ).vOrigin, 500.0f, g.iIsland, g.aNear );
+                g.bActive = false;
+                g.fActiveTime = 0.0f;
+                m_aGates.push_back( g );
+            }
+            else if ( strcmp( szClass, "bfl_dhdbutton" ) == 0 && strstr( e.Get( "model" ), "dhd_active" ) )
+            {
+                CDhd d;
+                d.sGate = e.Get( "Gate" );
+                d.iGate = -1;
+                d.vOrigin = e.vOrigin;
+                memset( d.aButtons, 0, sizeof( d.aButtons ) );
+                d.iWaypoint = CWaypoints::GetNearestWaypoint( d.vOrigin + Vector( 0, 0, fEye ), NULL, false, 300.0f );
+                d.iIsland = Island( d.iWaypoint );
+                if ( d.iIsland >= 0 )
+                    NearWaypoints( d.vOrigin, fNearDistance, d.iIsland, d.aNear );
+                m_aDhds.push_back( d );
+            }
+            else if ( strcmp( szClass, "objective_trigger_filter" ) == 0 )
+                AddGoal( e, atoi( e.Get( "team", "0" ) ), false );
+            else if ( strcmp( szClass, "bfl_objectivepoint_tauri" ) == 0 )
+                AddGoal( e, 3, true );
+            else if ( strcmp( szClass, "bfl_objectivepoint_goa" ) == 0 )
+                AddGoal( e, 2, true );
+            else if ( strcmp( szClass, "info_player_tauri" ) == 0 || strcmp( szClass, "info_player_goa" ) == 0 )
+            {
+                int iIsland = Island( CWaypoints::GetNearestWaypoint( e.vOrigin + Vector( 0, 0, fEye ), NULL, false,
+                                                                      200.0f ) );
+                if ( iIsland >= 0 )
+                {
+                    if ( (int)m_aExits.size() <= iIsland )
+                        m_aExits.resize( iIsland + 1, false );
+                    m_aExits[iIsland] = true;
+                }
+            }
+        }
+        for ( size_t d = 0; d < m_aDhds.size(); ++d )
+        {
+            for ( size_t g = 0; g < m_aGates.size(); ++g )
+                if ( m_aGates[g].sName == m_aDhds[d].sGate )
+                    m_aDhds[d].iGate = (int)g;
+            int iIsland = m_aDhds[d].iIsland;
+            if ( iIsland >= 0 )
+            {
+                if ( (int)m_aExits.size() <= iIsland )
+                    m_aExits.resize( iIsland + 1, false );
+                m_aExits[iIsland] = true;
+            }
+        }
+
+        // Automatic turrets (npc_tac_fixed: invincible, they shoot the other team within "distance", ah_forest has
+        // one with a 1300 range at the Tau'ri spawn): the waypoints they see go in an area of their team, that the
+        // bots of the other team avoid.
+        m_aTurretArea[0] = m_aTurretArea[1] = EAreaIdInvalid;
+        for ( size_t i = 0; i < aEnts.size(); ++i )
+        {
+            const sgtls::CBspEntity& e = aEnts[i];
+            int iTeam = atoi( e.Get( "team", "0" ) );
+            if ( strcmp( e.Get( "classname" ), "npc_tac_fixed" ) != 0 || iTeam < 2 || iTeam > 3 )
+                continue;
+            TAreaId& iArea = m_aTurretArea[iTeam - 2];
+            if ( iArea == EAreaIdInvalid )
+            {
+                good::string sArea( iTeam == 2 ? "goauld turrets" : "tauri turrets" );
+                iArea = CWaypoints::GetAreaId( sArea );
+                if ( iArea == EAreaIdInvalid )
+                    iArea = CWaypoints::AddAreaName( sArea );
+            }
+            float fRange = (float)atof( e.Get( "distance", "1000" ) );
+            Vector vTurret = e.vOrigin + Vector( 0, 0, 40 );
+            for ( TWaypointId w = 0; w < CWaypoints::Size(); ++w )
+            {
+                CWaypoint& cWaypoint = CWaypoints::Get( w );
+                if ( cWaypoint.vOrigin.DistToSqr( vTurret ) < fRange * fRange &&
+                     CUtil::IsVisible( vTurret, cWaypoint.vOrigin, EVisibilityWorld, false ) )
+                    cWaypoint.iAreaId = iArea;
+            }
+        }
+    }
+
+    // Edicts of the gates and of the DHD buttons (round restarts recreate entities).
+    void FindEntities()
+    {
+        for ( size_t g = 0; g < m_aGates.size(); ++g )
+            m_aGates[g].pEdict = NULL;
+        for ( size_t d = 0; d < m_aDhds.size(); ++d )
+            memset( m_aDhds[d].aButtons, 0, sizeof( m_aDhds[d].aButtons ) );
+
+        IVEngineServer* pEngine = CBotrixPlugin::pEngineServer;
+        for ( int i = 1; i < pEngine->GetEntityCount(); ++i )
+        {
+            edict_t* pEdict = pEngine->PEntityOfEntIndex( i );
+            if ( !pEdict || pEdict->IsFree() || !pEdict->GetUnknown() || !pEdict->GetCollideable() )
+                continue;
+            const char* szName = pEdict->GetClassName();
+            if ( !szName )
+                continue;
+            Vector vOrigin = pEdict->GetCollideable()->GetCollisionOrigin();
+            if ( strcmp( szName, "bfl_stargate" ) == 0 )
+            {
+                for ( size_t g = 0; g < m_aGates.size(); ++g )
+                    if ( m_aGates[g].vOrigin.DistToSqr( vOrigin ) < 32.0f * 32.0f )
+                        m_aGates[g].pEdict = pEdict;
+            }
+            else if ( strcmp( szName, "bfl_dhdbutton" ) == 0 && pEdict->GetIServerEntity() )
+            {
+                // The button sends the number found in its model name (models/dhd/bouton_NN.mdl).
+                const char* szModel = STRING( pEdict->GetIServerEntity()->GetModelName() );
+                const char* szNumber = strstr( szModel, "bouton_" );
+                int iButton = strstr( szModel, "dhd_active" ) ? 0 : ( szNumber ? atoi( szNumber + 7 ) : -1 );
+                if ( iButton < 0 || iButton > 38 )
+                    continue;
+                for ( size_t d = 0; d < m_aDhds.size(); ++d )
+                    if ( m_aDhds[d].vOrigin.DistToSqr( vOrigin ) < 32.0f * 32.0f && !m_aDhds[d].aButtons[iButton] )
+                        m_aDhds[d].aButtons[iButton] = pEdict;
+            }
+        }
+    }
+
+    bool IsArtefact( edict_t* pEdict )
+    {
+        // The map says weapon_artfact, the entity is registered as weapon_Artfact.
+        return pEdict && !pEdict->IsFree() && pEdict->GetUnknown() && pEdict->GetCollideable() &&
+               pEdict->GetClassName() && Q_stricmp( pEdict->GetClassName(), "weapon_artfact" ) == 0;
+    }
+
+    // The artefact and its carrier (the owner of the weapon).
+    void UpdateArtefact()
+    {
+        IVEngineServer* pEngine = CBotrixPlugin::pEngineServer;
+        if ( !IsArtefact( m_pArtefact ) )
+        {
+            m_pArtefact = NULL;
+            for ( int i = 1; i < pEngine->GetEntityCount() && !m_pArtefact; ++i )
+                if ( IsArtefact( pEngine->PEntityOfEntIndex( i ) ) )
+                    m_pArtefact = pEngine->PEntityOfEntIndex( i );
+        }
+        edict_t* pCarrier = NULL;
+        if ( m_pArtefact )
+        {
+            int iHandle = sgtls::GetInt( m_pArtefact, "m_hOwner", -1 );
+            int iIndex = ( iHandle == -1 ) ? 0 : ( iHandle & 0xFFF );
+            if ( iIndex > 0 && iIndex <= CBotrixPlugin::pPlayerInfoManager->GetGlobalVars()->maxClients )
+            {
+                pCarrier = pEngine->PEntityOfEntIndex( iIndex );
+                if ( pCarrier && ( pCarrier->IsFree() || !pCarrier->GetCollideable() ) )
+                    pCarrier = NULL;
+            }
+        }
+        if ( pCarrier != m_pCarrier )
+        {
+            m_pCarrier = pCarrier;
+            ++m_iStamp;
+        }
+    }
+
+    void UpdateGates()
+    {
+        for ( size_t g = 0; g < m_aGates.size(); ++g )
+        {
+            bool bActive = IsActive( m_aGates[g] );
+            if ( bActive != m_aGates[g].bActive )
+            {
+                m_aGates[g].bActive = bActive;
+                m_aGates[g].fActiveTime = CBotrixPlugin::fTime;
+                ++m_iStamp;
+            }
+        }
+    }
+
+    // A DHD on island iFrom, dialing from a gate on iFrom to a gate on iTo.
+    bool FindRoute( int iFrom, int iTo, CRoute& r )
+    {
+        if ( iFrom < 0 || iTo < 0 || iFrom == iTo )
+            return false;
+        for ( size_t d = 0; d < m_aDhds.size(); ++d )
+        {
+            const CDhd& cDhd = m_aDhds[d];
+            if ( cDhd.iIsland != iFrom || cDhd.iGate < 0 || m_aGates[cDhd.iGate].iIsland != iFrom )
+                continue;
+            for ( size_t g = 0; g < m_aGates.size(); ++g )
+                if ( m_aGates[g].iIsland == iTo && (int)g != cDhd.iGate && CanDial( m_aGates[g] ) )
+                {
+                    r.iDhd = (int)d;
+                    r.iSource = cDhd.iGate;
+                    r.iDestination = (int)g;
+                    return true;
+                }
+        }
+        return false;
+    }
+
+    // Objective trigger of a team (the trigger it must touch), or of its enemies (bEnemy).
+    const CGoal* GoalOf( TTeam iTeam, bool bEnemy )
+    {
+        for ( size_t c = 0; c < m_aGoals.size(); ++c )
+            if ( !m_aGoals[c].bPoint && m_aGoals[c].iIsland >= 0 && m_aGoals[c].iTeam > 1 &&
+                 ( ( m_aGoals[c].iTeam == iTeam ) != bEnemy ) )
+                return &m_aGoals[c];
+        return NULL;
+    }
+
+    // Where a team brings the artefact.
+    const CGoal* HomeOf( TTeam iTeam )
+    {
+        for ( size_t c = 0; c < m_aGoals.size(); ++c )
+            if ( m_aGoals[c].bPoint && m_aGoals[c].iIsland >= 0 && m_aGoals[c].iTeam == iTeam )
+                return &m_aGoals[c];
+        return NULL;
+    }
+
+    bool KawooshOver( const CGate& g )
+    {
+        return g.bActive && CBotrixPlugin::fTime - g.fActiveTime > fKawooshTime;
+    }
+
+    // While a gate is about to open (6 chevrons locked) or opened less than fKawooshTime ago, its kawoosh kills
+    // what stands in front of it: models/stargate/kawoosh_kill.mdl, 0..254 units forward and +-88 sideways / up and
+    // down. If vHead (with the player's half width) is in that volume, vTarget receives a point out of it, sideways.
+    // ah_forest's DHD of pkx5j3 stands 94 units off the axis, 193 in front: the dialer must step aside.
+    bool EscapeKawoosh( const Vector& vHead, Vector& vTarget )
+    {
+        const float fLength = 254.0f + 32.0f, fHalfWidth = 88.0f + 24.0f;
+        for ( size_t g = 0; g < m_aGates.size(); ++g )
+        {
+            const CGate& c = m_aGates[g];
+            char aLocked[7];
+            bool bDanger = c.bActive ? !KawooshOver( c ) : ( Chevrons( c, aLocked ) >= 6 );
+            if ( !bDanger )
+                continue;
+            Vector vSide( -c.vForward.y, c.vForward.x, 0 );
+            Vector vFromGate = vHead - c.vOrigin;
+            float fAlong = vFromGate.x * c.vForward.x + vFromGate.y * c.vForward.y;
+            float fSide = vFromGate.x * vSide.x + vFromGate.y * vSide.y;
+            if ( fAlong < -16.0f || fAlong > fLength || fabs( fSide ) > fHalfWidth ||
+                 fabs( vFromGate.z ) > 88.0f + 72.0f )
+                continue;
+            float fOut = ( fSide >= 0.0f ? 1.0f : -1.0f ) * ( fHalfWidth + 48.0f );
+            vTarget = c.vOrigin + c.vForward * fAlong + vSide * fOut;
+            vTarget.z = vHead.z;
+            return true;
+        }
+        return false;
+    }
+
+    // Island a bot must reach with the stargates (and may dial for), -1 if none.
+    bool IsChaser( edict_t* pBot )
+    {
+        return std::find( m_aChasers.begin(), m_aChasers.end(), pBot ) != m_aChasers.end();
+    }
+
+    void SetChaser( edict_t* pBot, bool bChaser )
+    {
+        std::vector<edict_t*>::iterator it = std::find( m_aChasers.begin(), m_aChasers.end(), pBot );
+        if ( bChaser && it == m_aChasers.end() )
+            m_aChasers.push_back( pBot );
+        else if ( !bChaser && it != m_aChasers.end() )
+            m_aChasers.erase( it );
+    }
+
+    // A living player of team iTeam on island iIsland.
+    bool TeamOnIsland( int iTeam, int iIsland )
+    {
+        for ( int p = 0; p < CPlayers::Size(); ++p )
+        {
+            CPlayer* pPlayer = CPlayers::Get( p );
+            if ( pPlayer && pPlayer->IsAlive() && pPlayer->GetTeam() == iTeam && Island( pPlayer->iCurrentWaypoint ) == iIsland )
+                return true;
+        }
+        return false;
+    }
+
+    int TravelIsland( edict_t* pBot, TTeam iTeam )
+    {
+        if ( m_iMode == sgtc2::EModeObjective )
+        {
+            const CGoal* pGoal = GoalOf( iTeam, false );
+            if ( !pGoal && IsChaser( pBot ) )
+                pGoal = GoalOf( iTeam, true );
+            return pGoal ? pGoal->iIsland : -1;
+        }
+        if ( m_iMode == sgtc2::EModeArtefact && m_pCarrier == pBot )
+        {
+            const CGoal* pHome = HomeOf( iTeam );
+            return pHome ? pHome->iIsland : -1;
+        }
+        return -1;
+    }
+
+    // Walk straight into a box (trigger, artefact) that can be off the waypoint grid: when near and not inside.
+    bool WalkInto( const Vector& vHead, const Vector& vMins, const Vector& vMaxs, float fDistance, Vector& vTarget )
+    {
+        Vector vFeet = vHead - Vector( 0, 0, CMod::GetVar( EModVarPlayerEye ) );
+        bool bInside = vFeet.x >= vMins.x && vFeet.x <= vMaxs.x && vFeet.y >= vMins.y && vFeet.y <= vMaxs.y &&
+                       vHead.z >= vMins.z && vFeet.z <= vMaxs.z;
+        Vector vCenter = ( vMins + vMaxs ) * 0.5f;
+        Vector vTo = vCenter - vHead;
+        if ( bInside || vTo.Length2D() > fDistance || fabs( vTo.z ) > 200.0f )
+            return false;
+        vTarget = vCenter;
+        vTarget.z = vHead.z;
+        return true;
+    }
+
+    // Gate travel to island iTo: the DHD waypoint, or the gate once it is open (and the kawoosh over). While another
+    // bot dials or the gate is busy, around the DHD: all of them on the DHD waypoint blocked the way (obj_iced_pilak,
+    // where the Tau'ri DHD is at their spawn's exit).
+    TWaypointId TravelWaypoint( edict_t* pBot, int iHere, int iTo )
+    {
+        CRoute r;
+        if ( !FindRoute( iHere, iTo, r ) )
+            return EWaypointIdInvalid;
+        const CGate& cSource = m_aGates[r.iSource];
+        if ( IsOpenTo( cSource, m_aGates[r.iDestination] ) && KawooshOver( cSource ) )
+            return cSource.iFront;
+        if ( ( OtherDialer( pBot ) || IsActive( cSource ) ) && !m_aDhds[r.iDhd].aNear.empty() )
+            return Random( m_aDhds[r.iDhd].aNear );
+        return m_aDhds[r.iDhd].iWaypoint;
+    }
+
+    // Gate action to reach island iTo: walk into the gate open to it, else dial at the DHD (bDial) or wait there
+    // while the gate is busy. Bots that don't dial only go through when they chose to (iDestination is the gate).
+    sgtc2::TGateAction TravelAction( edict_t* pBot, int iHere, int iTo, const Vector& vHead, bool bDial,
+                                     TWaypointId iDestination, Vector& vTarget )
+    {
+        CRoute r;
+        if ( !FindRoute( iHere, iTo, r ) )
+            return sgtc2::EGateActionNone;
+        const CGate& cSource = m_aGates[r.iSource];
+        const CDhd& cDhd = m_aDhds[r.iDhd];
+
+        Vector vToDhd = cDhd.vOrigin - vHead;
+        bool bAtDhd = vToDhd.Length2D() <= fDhdDistance && fabs( vToDhd.z ) <= 150.0f;
+        if ( IsOpenTo( cSource, m_aGates[r.iDestination] ) )
+        {
+            // The dialer stays at the DHD during the kawoosh: wandering in front of the gate kills (ah_forest's DHD is
+            // 200 units from its gate).
+            if ( !KawooshOver( cSource ) )
+            {
+                if ( !bDial || !bAtDhd || m_pDialer != pBot )
+                    return sgtc2::EGateActionNone; // Only the dialer stands still at the DHD.
+                vTarget = cDhd.vOrigin + Vector( 0, 0, 30 );
+                return sgtc2::EGateActionWait;
+            }
+            if ( !bDial && iDestination != cSource.iFront )
+                return sgtc2::EGateActionNone;
+            Vector vFromGate = vHead - cSource.vOrigin;
+            float fAlong = vFromGate.x * cSource.vForward.x + vFromGate.y * cSource.vForward.y;
+            float fSide = -vFromGate.x * cSource.vForward.y + vFromGate.y * cSource.vForward.x;
+            // The straight line to 48 units behind the horizon crosses the gate plane at fSide * 48 / (fAlong + 48)
+            // from its center: it must cross inside the horizon (radius 120), not hit the ring. Else go to the front
+            // waypoint first.
+            if ( fAlong > 16.0f && vFromGate.Length2D() < fEnterDistance && fabs( vFromGate.z ) < 200.0f &&
+                 fabs( fSide ) * 48.0f / ( fAlong + 48.0f ) < 90.0f )
+            {
+                vTarget = cSource.vOrigin - cSource.vForward * 48.0f;
+                vTarget.z = vHead.z;
+                return sgtc2::EGateActionWalk;
+            }
+            return sgtc2::EGateActionNone;
+        }
+
+        // The others don't stand at the DHD while one dials, or while the gate is busy: they wait around it
+        // (TravelWaypoint).
+        if ( !bDial || !bAtDhd || OtherDialer( pBot ) || ( IsActive( cSource ) && m_pDialer != pBot ) )
+            return sgtc2::EGateActionNone;
+        vTarget = cDhd.vOrigin + Vector( 0, 0, 30 );
+        return IsActive( cSource ) ? sgtc2::EGateActionWait : sgtc2::EGateActionDial;
+    }
+}
+
+
+void sgtc2::CStargates::Refresh()
+{
+    if ( m_sMap != CBotrixPlugin::instance->sMapName.c_str() || m_iWaypoints != CWaypoints::Size() )
+    {
+        m_sMap = CBotrixPlugin::instance->sMapName.c_str();
+        m_iWaypoints = CWaypoints::Size();
+        Rebuild();
+        m_fNextEntities = m_fNextArtefact = 0.0f;
+    }
+    if ( CBotrixPlugin::fTime >= m_fNextEntities || CBotrixPlugin::fTime < m_fNextEntities - 10.0f )
+    {
+        m_fNextEntities = CBotrixPlugin::fTime + 5.0f;
+        FindEntities();
+    }
+    if ( m_iMode == EModeArtefact &&
+         ( CBotrixPlugin::fTime >= m_fNextArtefact || CBotrixPlugin::fTime < m_fNextArtefact - 2.0f ) )
+    {
+        m_fNextArtefact = CBotrixPlugin::fTime + 0.5f;
+        UpdateArtefact();
+    }
+    if ( CBotrixPlugin::fTime != m_fLastUpdate )
+    {
+        m_fLastUpdate = CBotrixPlugin::fTime;
+        UpdateGates();
+        // The carrier moves: bots that follow it choose their destination again from time to time.
+        if ( m_pCarrier && ( CBotrixPlugin::fTime >= m_fNextChase || CBotrixPlugin::fTime < m_fNextChase - 10.0f ) )
+        {
+            m_fNextChase = CBotrixPlugin::fTime + fChaseInterval;
+            ++m_iChaseStamp;
+        }
+    }
+}
+
+
+sgtc2::TGameMode sgtc2::CStargates::GameMode()
+{
+    Refresh();
+    return m_iMode;
+}
+
+
+int sgtc2::CStargates::StateStamp( bool bFollower )
+{
+    // Chasing: attackers arriving on the objective's island (or gone from it) make the defenders choose again.
+    if ( sgtc2::iChase > 0 && m_iMode == EModeObjective && CBotrixPlugin::fTime >= m_fNextGoalCheck )
+    {
+        m_fNextGoalCheck = CBotrixPlugin::fTime + 1.0f;
+        bool bOn = false;
+        for ( int t = 2; t <= 3 && !bOn; ++t )
+        {
+            const CGoal* pGoal = GoalOf( t, false );
+            bOn = pGoal && TeamOnIsland( t, pGoal->iIsland );
+        }
+        if ( bOn != m_bAttackersOnGoal )
+        {
+            m_bAttackersOnGoal = bOn;
+            ++m_iStamp;
+        }
+    }
+    return bFollower ? m_iStamp + ( m_iChaseStamp << 16 ) : m_iStamp;
+}
+
+
+TAreaId sgtc2::CStargates::TurretArea( TTeam iTeam )
+{
+    Refresh();
+    return ( iTeam == 2 || iTeam == 3 ) ? m_aTurretArea[iTeam - 2] : EAreaIdInvalid;
+}
+
+
+bool sgtc2::CStargates::IsCarrier( edict_t* pBot )
+{
+    Refresh();
+    return m_iMode == EModeArtefact && pBot && m_pCarrier == pBot;
+}
+
+
+bool sgtc2::CStargates::IsStranded( edict_t* pBot, TWaypointId iCurrent )
+{
+    // Only in capture the artefact: in objective maps the island behind the gate is where the attackers go and the
+    // defenders follow them.
+    Refresh();
+    int iIsland = Island( iCurrent );
+    if ( m_iMode != EModeArtefact || m_pCarrier == pBot || iIsland < 0 ||
+         ( iIsland < (int)m_aExits.size() && m_aExits[iIsland] ) )
+        return false;
+    // Still something to do here: the artefact lies on this island.
+    return !( IsArtefact( m_pArtefact ) && !m_pCarrier &&
+              Island( CWaypoints::GetNearestWaypoint( m_pArtefact->GetCollideable()->GetCollisionOrigin() +
+                                                      Vector( 0, 0, CMod::GetVar( EModVarPlayerEye ) ), NULL, false,
+                                                      400.0f ) ) == iIsland );
+}
+
+
+TWaypointId sgtc2::CStargates::PickWaypoint( edict_t* pBot, TTeam iTeam, TWaypointId iCurrent )
+{
+    Refresh();
+    int iHere = Island( iCurrent );
+    if ( iHere < 0 )
+        return EWaypointIdInvalid;
+
+    if ( m_iMode == EModeObjective )
+    {
+        // Attackers go to their objective, through the stargate when it is elsewhere.
+        const CGoal* pGoal = GoalOf( iTeam, false );
+        if ( pGoal )
+            return ( pGoal->iIsland == iHere ) ? Random( pGoal->aInside ) : TravelWaypoint( pBot, iHere, pGoal->iIsland );
+
+        // Defenders: around the objective, else around the DHD and the gate the attackers need. Half of them
+        // follow the attackers through the open gate. On the objective's island, half of them anywhere on the
+        // island: all of them at the objective camped the arrival gate (sg2_temple, user's test 2026-10-27).
+        pGoal = GoalOf( iTeam, true );
+        if ( !pGoal )
+            return EWaypointIdInvalid;
+        if ( pGoal->iIsland == iHere )
+        {
+            SetChaser( pBot, false );
+            int iRoll = rand() % 4;
+            // <prefix>_objroam (per map, 0 = the whole island): those roam within that distance of the objective.
+            TWaypointId w = ( iRoll < 2 ) ? RandomOnIsland( iHere, sgtc2::fObjectiveRoam > 0.0f ? &pGoal->vCenter : NULL,
+                                                            sgtc2::fObjectiveRoam ) : EWaypointIdInvalid;
+            return CWaypoint::IsValid( w ) ? w : Random( ( iRoll & 1 ) ? pGoal->aInside : pGoal->aNear );
+        }
+        CRoute r;
+        if ( !FindRoute( iHere, pGoal->iIsland, r ) )
+            return EWaypointIdInvalid;
+        // <prefix>_chase (per map, percent, 0 = off): attackers reached the objective's island, so a defender goes
+        // after them through the stargate, dialing it if needed. On sg2_temple no defender was on that island in
+        // any of the 58 rounds the Tau'ri won by reaching the objective (2026-11-04): only attackers used gates.
+        bool bChase = sgtc2::iChase > 0 && TeamOnIsland( pGoal->iTeam, pGoal->iIsland ) && ( rand() % 100 ) < sgtc2::iChase;
+        SetChaser( pBot, bChase );
+        if ( bChase )
+            return TravelWaypoint( pBot, iHere, pGoal->iIsland );
+        // 30% around the DHD, 20% around the gate, the others roam (hunt the attackers): 70% at the DHD and the
+        // gate camped there (sg2_temple, user's test 2026-10-27).
+        const CGate& cSource = m_aGates[r.iSource];
+        int iRoll = rand() % 10;
+        if ( IsOpenTo( cSource, m_aGates[r.iDestination] ) && KawooshOver( cSource ) && iRoll < 5 )
+            return cSource.iFront;
+        if ( iRoll < 3 )
+            return Random( m_aDhds[r.iDhd].aNear );
+        if ( iRoll < 5 )
+            return Random( cSource.aNear );
+        return EWaypointIdInvalid;
+    }
+
+    if ( m_iMode == EModeArtefact && IsArtefact( m_pArtefact ) )
+    {
+        // The carrier brings the artefact home, through the stargate.
+        if ( m_pCarrier == pBot )
+        {
+            const CGoal* pHome = HomeOf( iTeam );
+            if ( !pHome )
+                return EWaypointIdInvalid;
+            return ( pHome->iIsland == iHere ) ? Random( pHome->aInside ) : TravelWaypoint( pBot, iHere, pHome->iIsland );
+        }
+        // The others go to the artefact on the ground, chase the enemy carrier, or escort the team carrier (half
+        // of them).
+        TWaypointId w = EWaypointIdInvalid;
+        if ( m_pCarrier )
+        {
+            CPlayer* pCarrier = CPlayers::Get( m_pCarrier );
+            bool bTeamCarrier = pCarrier && pCarrier->GetTeam() == iTeam;
+            if ( pCarrier && ( !bTeamCarrier || ( rand() & 1 ) ) )
+                w = pCarrier->iCurrentWaypoint;
+        }
+        else
+            w = CWaypoints::GetNearestWaypoint( m_pArtefact->GetCollideable()->GetCollisionOrigin() +
+                                                Vector( 0, 0, CMod::GetVar( EModVarPlayerEye ) ), NULL, false, 400.0f );
+        return ( Island( w ) == iHere ) ? w : EWaypointIdInvalid;
+    }
+    return EWaypointIdInvalid;
+}
+
+
+sgtc2::TGateAction sgtc2::CStargates::GetAction( edict_t* pBot, TTeam iTeam, TWaypointId iCurrent, const Vector& vHead,
+                                                 TWaypointId iDestination, Vector& vTarget )
+{
+    Refresh();
+    int iHere = Island( iCurrent );
+    if ( iHere < 0 )
+        return EGateActionNone;
+
+    if ( EscapeKawoosh( vHead, vTarget ) )
+        return EGateActionWalk;
+
+    if ( m_iMode == EModeObjective )
+    {
+        const CGoal* pGoal = GoalOf( iTeam, false );
+        bool bAttacker = ( pGoal != NULL );
+        if ( !pGoal )
+            pGoal = GoalOf( iTeam, true );
+        if ( !pGoal )
+            return EGateActionNone;
+        if ( pGoal->iIsland == iHere )
+            return ( bAttacker && WalkInto( vHead, pGoal->vMins, pGoal->vMaxs, fWalkIntoGoalDistance, vTarget ) )
+                   ? EGateActionWalk : EGateActionNone;
+        return TravelAction( pBot, iHere, pGoal->iIsland, vHead, bAttacker || IsChaser( pBot ), iDestination, vTarget );
+    }
+
+    if ( m_iMode == EModeArtefact && IsArtefact( m_pArtefact ) )
+    {
+        if ( m_pCarrier == pBot )
+        {
+            const CGoal* pHome = HomeOf( iTeam );
+            if ( !pHome )
+                return EGateActionNone;
+            if ( pHome->iIsland == iHere )
+                return WalkInto( vHead, pHome->vMins, pHome->vMaxs, fWalkIntoGoalDistance, vTarget ) ? EGateActionWalk
+                                                                                                     : EGateActionNone;
+            return TravelAction( pBot, iHere, pHome->iIsland, vHead, true, iDestination, vTarget );
+        }
+        // Pick up the artefact on the ground.
+        if ( !m_pCarrier )
+        {
+            Vector vArtefact = m_pArtefact->GetCollideable()->GetCollisionOrigin();
+            if ( WalkInto( vHead, vArtefact - Vector( 8, 8, 8 ), vArtefact + Vector( 8, 8, 8 ),
+                           fWalkIntoArtefactDistance, vTarget ) &&
+                 Island( CWaypoints::GetNearestWaypoint( vArtefact + Vector( 0, 0, CMod::GetVar( EModVarPlayerEye ) ),
+                                                         NULL, false, 400.0f ) ) == iHere )
+                return EGateActionWalk;
+        }
+    }
+    return EGateActionNone;
+}
+
+
+void sgtc2::CStargates::Dial( edict_t* pBot, TTeam iTeam, TWaypointId iCurrent )
+{
+    Refresh();
+    CRoute r;
+    if ( !FindRoute( Island( iCurrent ), TravelIsland( pBot, iTeam ), r ) )
+        return;
+    if ( m_pDialer && m_pDialer != pBot && CBotrixPlugin::fTime - m_fDialerTime < 2.0f )
+        return; // Another bot is dialing.
+    m_pDialer = pBot;
+    m_fDialerTime = CBotrixPlugin::fTime;
+    if ( CBotrixPlugin::fTime < m_fNextPress && CBotrixPlugin::fTime > m_fNextPress - 5.0f )
+        return;
+    m_fNextPress = CBotrixPlugin::fTime + fPressInterval;
+
+    // The address, the point of origin, then the center button. Locked symbols that aren't ours (someone else
+    // dialed) are reset with the center button.
+    std::string sSequence = m_aGates[r.iDestination].sName + cPointOfOrigin;
+    char aLocked[7];
+    int n = Chevrons( m_aGates[r.iSource], aLocked );
+    bool bOurs = true;
+    for ( int i = 0; i < n; ++i )
+        bOurs = bOurs && ( aLocked[i] == sSequence[i] );
+    int iButton = ( bOurs && n < (int)sSequence.size() ) ? ButtonOf( sSequence[n] ) : 0;
+    edict_t* pButton = m_aDhds[r.iDhd].aButtons[iButton];
+    if ( !pButton || pButton->IsFree() || !sgtls::UseEntity( pButton, pBot ) )
+        m_fNextEntities = 0.0f; // Find the entities again.
+}
+
+
+void sgtc2::CStargates::LogRoundEnd( int iWinner )
+{
+    Refresh();
+    if ( m_iMode != EModeObjective )
+        return;
+    int iAttackers = -1;
+    const CGoal* pGoal = NULL;
+    for ( int t = 2; t <= 3 && !pGoal; ++t )
+        if ( ( pGoal = GoalOf( t, false ) ) != NULL )
+            iAttackers = t;
+    if ( !pGoal )
+        return;
+    std::string aList[2];
+    int aAlive[2] = { 0, 0 }, aOnIsland[2] = { 0, 0 };
+    for ( int p = 0; p < CPlayers::Size(); ++p )
+    {
+        CPlayer* pPlayer = CPlayers::Get( p );
+        if ( !pPlayer || !pPlayer->IsAlive() || pPlayer->GetTeam() < 2 )
+            continue;
+        int k = ( pPlayer->GetTeam() == iAttackers ) ? 0 : 1;
+        bool bOn = Island( pPlayer->iCurrentWaypoint ) == pGoal->iIsland;
+        ++aAlive[k];
+        aOnIsland[k] += bOn;
+        char sz[48];
+        snprintf( sz, sizeof( sz ), " %.0f%s", pPlayer->GetHead().DistTo( pGoal->vCenter ), bOn ? "" : "(off)" );
+        aList[k] += sz;
+    }
+    Msg( "[Botrix] %s: round end diag: winner %d; attackers (team %d) alive %d, on the objective's island %d:%s; "
+         "defenders alive %d, on the island %d:%s\n", CBotrixPlugin::instance->sMapName.c_str(), iWinner, iAttackers,
+         aAlive[0], aOnIsland[0], aList[0].c_str(), aAlive[1], aOnIsland[1], aList[1].c_str() );
+}
+
+
+void sgtc2::CStargates::Print()
+{
+    Refresh();
+    Msg( "mode %d, %d waypoints, %d islands\n", (int)m_iMode, CWaypoints::Size(),
+         m_aIsland.empty() ? 0 : 1 + *std::max_element( m_aIsland.begin(), m_aIsland.end() ) );
+    for ( size_t g = 0; g < m_aGates.size(); ++g )
+    {
+        const CGate& c = m_aGates[g];
+        char aLocked[8] = { 0 };
+        Chevrons( c, aLocked );
+        char* p = GateBase( c );
+        const char* szDestination = "-";
+        for ( size_t d = 0; d < m_aGates.size(); ++d )
+            if ( p && GateBase( m_aGates[d] ) && *(char**)( p + iGateDestination ) == GateBase( m_aGates[d] ) )
+                szDestination = m_aGates[d].sName.c_str();
+        Msg( "gate %s: edict %d, front waypoint %d, island %d, %d near; %s%s, last dialed %s, chevrons '%s', "
+             "changed %.0f s ago\n", c.sName.c_str(),
+             c.pEdict ? CBotrixPlugin::pEngineServer->IndexOfEdict( c.pEdict ) : -1,
+             c.iFront, c.iIsland, (int)c.aNear.size(), !p ? "NOT FOUND" : ( p[iGateActive] ? "ACTIVE" : "idle" ),
+             p && p[iGateOutgoing] ? " outgoing" : "", szDestination, aLocked, CBotrixPlugin::fTime - c.fActiveTime );
+    }
+    for ( size_t d = 0; d < m_aDhds.size(); ++d )
+    {
+        const CDhd& c = m_aDhds[d];
+        int iButtons = 0;
+        for ( int b = 0; b < 39; ++b )
+            iButtons += c.aButtons[b] ? 1 : 0;
+        Msg( "DHD of gate %s at %.0f %.0f %.0f: %d/39 buttons, waypoint %d, island %d, %d near\n", c.sGate.c_str(),
+             c.vOrigin.x, c.vOrigin.y, c.vOrigin.z, iButtons, c.iWaypoint, c.iIsland, (int)c.aNear.size() );
+    }
+    for ( size_t i = 0; i < m_aGoals.size(); ++i )
+    {
+        const CGoal& c = m_aGoals[i];
+        Msg( "%s of team %d at %.0f %.0f %.0f (size %.0f %.0f %.0f): %d waypoints inside, %d near, island %d\n",
+             c.bPoint ? "artefact point" : "objective", c.iTeam, c.vCenter.x, c.vCenter.y, c.vCenter.z,
+             c.vMaxs.x - c.vMins.x, c.vMaxs.y - c.vMins.y, c.vMaxs.z - c.vMins.z, (int)c.aInside.size(),
+             (int)c.aNear.size(), c.iIsland );
+    }
+    if ( m_iMode == EModeArtefact )
+    {
+        Vector v = IsArtefact( m_pArtefact ) ? m_pArtefact->GetCollideable()->GetCollisionOrigin() : Vector( 0, 0, 0 );
+        Msg( "artefact: edict %d at %.0f %.0f %.0f, carrier %d\n",
+             m_pArtefact ? CBotrixPlugin::pEngineServer->IndexOfEdict( m_pArtefact ) : -1, v.x, v.y, v.z,
+             m_pCarrier ? CBotrixPlugin::pEngineServer->IndexOfEdict( m_pCarrier ) : -1 );
+    }
+    for ( size_t c = 0; c < m_aGoals.size(); ++c )
+        for ( int iIsland = 0; iIsland < 8; ++iIsland )
+        {
+            CRoute r;
+            if ( FindRoute( iIsland, m_aGoals[c].iIsland, r ) )
+                Msg( "to the %s of team %d from island %d: DHD %d, dial %s from %s\n",
+                     m_aGoals[c].bPoint ? "artefact point" : "objective", m_aGoals[c].iTeam, iIsland, r.iDhd,
+                     m_aGates[r.iDestination].sName.c_str(), m_aGates[r.iSource].sName.c_str() );
+        }
+}
+
+#endif // BOTRIX_SGTC2
diff --git a/mods/sgtc2/stargates_sgtc2.h b/mods/sgtc2/stargates_sgtc2.h
new file mode 100644
index 0000000..bf78c63
--- /dev/null
+++ b/mods/sgtc2/stargates_sgtc2.h
@@ -0,0 +1,89 @@
+#ifndef __BOTRIX_STARGATES_SGTC2_H__
+#define __BOTRIX_STARGATES_SGTC2_H__
+
+// StargateTC 2 objectives and stargates, read from the BSP and the game entities.
+// - sgtc2_gameplay "mod": 0 team deathmatch, 1 capture the artefact, 2 objective, 3 markers.
+// - objective_trigger_filter (team key): the team that touches it wins the round. In objective maps it is on the
+//   other side of a stargate: its waypoints are an island that only the gate reaches.
+// - Capture the artefact: one weapon_artfact; a team scores by bringing it into its bfl_objectivepoint_*, in a base
+//   that only a stargate reaches.
+// - bfl_stargate: its targetname is its address. A DHD is 39 bfl_dhdbutton props around one origin, its "Gate" key
+//   is the gate it dials from. Dialing = the 6 symbols of the address, the point of origin "h", then the center
+//   button ("dhd_active"). The gate stays open ~30 seconds; the first seconds (kawoosh) are deadly in front of it.
+
+#include "types.h"
+#include "vector.h" // public/ (episode1) or public/mathlib/ (Orange Box)
+
+struct edict_t;
+
+namespace sgtc2
+{
+    enum TGameMode
+    {
+        EModeNone = -1,
+        EModeDeathmatch = 0,
+        EModeArtefact,
+        EModeObjective,
+        EModeMarkers,
+    };
+
+    /// What a bot should do about the stargates right now.
+    enum TGateAction
+    {
+        EGateActionNone = 0,                   ///< Nothing special: navigate (to CStargates::PickWaypoint()).
+        EGateActionDial,                       ///< At the DHD and the gate is idle: stand and call CStargates::Dial().
+        EGateActionWait,                       ///< At the DHD, the gate is busy (incoming, or someone else dials).
+        EGateActionWalk,                       ///< Walk straight to the target: into the open gate, or into the
+                                               ///< objective trigger (it can be off the waypoint grid).
+    };
+
+    class CStargates
+    {
+    public:
+        /// Rebuild on map / waypoints change, refresh the entities and the gate states. Cheap otherwise.
+        static void Refresh();
+
+        static TGameMode GameMode();
+
+        /// Waypoint where the bot pBot of iTeam at waypoint iCurrent should go now, EWaypointIdInvalid to roam as
+        /// usual.
+        static TWaypointId PickWaypoint( edict_t* pBot, TTeam iTeam, TWaypointId iCurrent );
+
+        /// Gate action for a bot going to waypoint iDestination. vTarget receives the point to look at (DHD) or to
+        /// walk to.
+        static TGateAction GetAction( edict_t* pBot, TTeam iTeam, TWaypointId iCurrent, const Vector& vHead,
+                                      TWaypointId iDestination, Vector& vTarget );
+
+        /// Press the next DHD button of the route of iTeam for the bot pBot (after GetAction() returned
+        /// EGateActionDial). One bot dials at a time, one button every 0.4 seconds.
+        static void Dial( edict_t* pBot, TTeam iTeam, TWaypointId iCurrent );
+
+        /// Changes when a gate opens or closes, or the artefact carrier changes: bots then choose their destination
+        /// again. For bFollower (bots that go after the carrier), also every few seconds while the artefact moves.
+        static int StateStamp( bool bFollower );
+
+        /// Capture the artefact: true if pBot carries the artefact.
+        static bool IsCarrier( edict_t* pBot );
+
+        /// Area of the waypoints that the automatic turrets (npc_tac_fixed) of iTeam see, EAreaIdInvalid if none: the
+        /// other team avoids it.
+        static TAreaId TurretArea( TTeam iTeam );
+
+        /// Capture the artefact: true when pBot is on an island without spawn point nor DHD (a base reached through a
+        /// stargate) and has nothing to do there (doesn't carry the artefact): it can only leave by respawning.
+        static bool IsStranded( edict_t* pBot, TWaypointId iCurrent );
+
+        /// Print the map knowledge and the gate states (sgtc2_objectives command).
+        static void Print();
+
+        /// Objective mode, at a round end (tests): each living player's distance to the attackers' objective and
+        /// whether it is on the objective's island.
+        static void LogRoundEnd( int iWinner );
+    };
+
+    /// Round end log in server.dll (hooks_sgtc2.cpp).
+    void InstallHooks();
+    void RemoveHooks();
+}
+
+#endif // __BOTRIX_STARGATES_SGTC2_H__
diff --git a/mods/sgtls/bot_sgtls.cpp b/mods/sgtls/bot_sgtls.cpp
new file mode 100644
index 0000000..2f4ceff
--- /dev/null
+++ b/mods/sgtls/bot_sgtls.cpp
@@ -0,0 +1,2033 @@
+#ifdef BOTRIX_SGTLS
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <set>
+#include <string>
+
+#include "clients.h"
+#include "players.h"
+
+#include "mods/sgtls/bot_sgtls.h"
+#include "mods/sgtls/objectives_sgtls.h"
+#include "mods/sgtls/sgtls_map.h"
+#include "mods/sgtls/sgtls_util.h"
+
+#include "iplayerinfo.h"
+#include "engine/IEngineTrace.h"
+#include "gametrace.h"
+
+
+namespace
+{
+    // Everything solid but the bot itself.
+    class CNotSelfFilter: public CTraceFilter
+    {
+    public:
+        CNotSelfFilter( int iSelf ): m_iSelf( iSelf ) {}
+        virtual bool ShouldHitEntity( IHandleEntity* pEntity, int /*contentsMask*/ )
+        {
+            return pEntity->GetRefEHandle().GetEntryIndex() != m_iSelf;
+        }
+        int m_iSelf;
+    };
+
+    // Equipment ids (sgtls_equipids). A loadout is the sum of (1 << (id - 1)).
+    enum
+    {
+        EG36 = 1, EP90 = 2, EP90D = 3, EAwp = 4, EPistol = 5, EStaff = 6, EKull = 7, EZat = 8, EHandDevice = 9,
+        EGrenade = 10, ESmoke = 11, EFlash = 12, EC4 = 13, ETac = 14, EGac = 15,
+        EArmorLight = 16, EArmorMedium = 17, EArmorHeavy = 18, EArmorEnergy = 19, ECloak = 20,
+    };
+
+    #define BIT(id) ( 1 << ((id) - 1) )
+
+    // Two loadouts per class id (1..8). Each one fits the class's MaxWeight and permitted equipment
+    // (checked by server.dll before it accepts the code).
+    const int aLoadouts[9][2] =
+    {
+        { 0, 0 },
+        // 1 Tau'ri Scout, 5 kg.
+        { BIT(EP90D) | BIT(EZat) | BIT(EArmorLight), BIT(EP90D) | BIT(EPistol) | BIT(EArmorLight) },
+        // 2 Tau'ri Assault, 8 kg.
+        { BIT(EP90) | BIT(EPistol) | BIT(EGrenade) | BIT(EArmorMedium),
+          BIT(EG36) | BIT(EPistol) | BIT(EGrenade) | BIT(EArmorLight) },
+        // 3 Tau'ri Support, 11 kg.
+        { BIT(EG36) | BIT(EPistol) | BIT(EGrenade) | BIT(EArmorMedium),
+          BIT(EAwp) | BIT(EPistol) | BIT(EGrenade) | BIT(EArmorMedium) },
+        // 4 Tau'ri Team Leader, 13 kg.
+        { BIT(EG36) | BIT(EZat) | BIT(EGrenade) | BIT(EArmorHeavy), BIT(EP90) | BIT(EZat) | BIT(EGrenade) | BIT(EArmorHeavy) },
+        // 5 Jaffa Scout, 5 kg.
+        { BIT(EStaff) | BIT(EZat) | BIT(EArmorLight), BIT(EStaff) | BIT(EHandDevice) | BIT(EArmorLight) },
+        // 6 Anubis Guard, 8 kg.
+        { BIT(EStaff) | BIT(ETac) | BIT(EHandDevice) | BIT(EArmorMedium), BIT(EStaff) | BIT(EGac) | BIT(ETac) | BIT(EArmorMedium) },
+        // 7 Kull Warrior, 10 kg.
+        { BIT(EKull) | BIT(ETac) | BIT(EArmorEnergy), BIT(EKull) | BIT(ETac) | BIT(EArmorEnergy) },
+        // 8 Goa'uld Team Leader, 13 kg.
+        { BIT(EZat) | BIT(ETac) | BIT(EArmorHeavy), BIT(EZat) | BIT(ETac) | BIT(EGac) | BIT(EArmorHeavy) },
+    };
+
+    // Chances (out of 100) of the 4 classes of a team; the 4th one is the Team Leader.
+    const int aClassChances[4] = { 25, 35, 30, 10 };
+
+    // Loadout of aLoadouts with the G36, -1 if both or none: Tau'ri Assault and Team Leader.
+    const int aG36[9] = { -1, -1, 1, -1, 0, -1, -1, -1, -1 };
+
+    // Loadouts the game refused on the current map: the bot spawned with the knife only. tls_erebus refuses every
+    // loadout with the G36 (abydos and lockdown take them): one refused G36 loadout rules out all of them.
+    std::string m_sRefusedMap;
+    std::set<int> m_aRefused;
+    bool m_bRefusedG36 = false;
+
+    bool IsRefused( int iCode )
+    {
+        if ( m_sRefusedMap != CBotrixPlugin::instance->sMapName.c_str() )
+            return false;
+        return m_aRefused.count( iCode ) || ( m_bRefusedG36 && ( iCode & BIT(EG36) ) );
+    }
+
+    void Refuse( int iCode )
+    {
+        if ( m_sRefusedMap != CBotrixPlugin::instance->sMapName.c_str() )
+        {
+            m_sRefusedMap = CBotrixPlugin::instance->sMapName.c_str();
+            m_aRefused.clear();
+            m_bRefusedG36 = false;
+        }
+        m_aRefused.insert( iCode );
+        m_bRefusedG36 = m_bRefusedG36 || ( iCode & BIT(EG36) );
+    }
+
+    // A loadout for the class: the G36 one 3 times out of 4. G36 bots hit far more than P90 ones, close (tls_lockdown:
+    // 86 hits to 35) and far (tls_abydos: 40 hits at 1000-1500 units, P90s none beyond ~1000). The game takes the
+    // code at the first spawn of a class only (sent later, it is ignored, or respawns the player at once).
+    int ChooseLoadout( int iClassId )
+    {
+        int iG36 = aG36[iClassId];
+        // tls_erebus's fights are at 1000-2000 units (the valley, the camp): there the Tau'ri died crossing the
+        // valley while 2 of their 5 bots had the P90, which hits nothing beyond ~1100 (2026-10-28). Always the G36.
+        bool bLongRange = strcmp( CBotrixPlugin::instance->sMapName.c_str(), "tls_erebus" ) == 0;
+        int i = ( iG36 >= 0 ) ? ( ( bLongRange || ( rand() % 4 ) ) ? iG36 : 1 - iG36 ) : ( rand() & 1 );
+        if ( IsRefused( aLoadouts[iClassId][i] ) && !IsRefused( aLoadouts[iClassId][1 - i] ) )
+            i = 1 - i;
+        // Without the G36 (tls_erebus), half of the Assaults take the AWP instead of the P90 (7.75 kg of 8): the map's
+        // fights are far, and the P90 hits nothing beyond ~1000 units.
+        const int iAssaultAwp = BIT(EAwp) | BIT(EPistol) | BIT(EArmorLight);
+        if ( iClassId == 2 && m_bRefusedG36 && m_sRefusedMap == CBotrixPlugin::instance->sMapName.c_str() &&
+             !IsRefused( iAssaultAwp ) && ( rand() & 1 ) )
+            return iAssaultAwp;
+        return aLoadouts[iClassId][i];
+    }
+
+    // The player holds no weapon but its knife.
+    bool HasOnlyKnife( edict_t* pEdict )
+    {
+        int iWeapons = sgtls::PropOffset( pEdict, "m_hMyWeapons" );
+        if ( iWeapons < 0 || !pEdict->GetUnknown() )
+            return false;
+        const int* aHandles = (const int*)( (const char*)pEdict->GetUnknown()->GetBaseEntity() + iWeapons );
+        for ( int w = 0; w < 48; ++w )
+        {
+            if ( aHandles[w] == -1 )
+                continue;
+            edict_t* pWeapon = CBotrixPlugin::pEngineServer->PEntityOfEntIndex( aHandles[w] & 0xFFF );
+            if ( pWeapon && !pWeapon->IsFree() && strcmp( pWeapon->GetClassName(), "weapon_knife" ) != 0 )
+                return false;
+        }
+        return true;
+    }
+
+    int GetClassId( edict_t* pEdict )
+    {
+        return sgtls::GetInt( pEdict, "m_iClassIDCurrent", -1 );
+    }
+
+    // Count players of a team, and those of a class id in that team (iClassId -1 = don't care).
+    int CountPlayers( TTeam iTeam, int iClassId, edict_t* pSkip )
+    {
+        int iCount = 0;
+        for ( int i = 0; i < CPlayers::Size(); ++i )
+        {
+            CPlayer* pPlayer = CPlayers::Get( i );
+            if ( !pPlayer || pPlayer->GetEdict() == pSkip || pPlayer->GetTeam() != iTeam )
+                continue;
+            if ( iClassId == -1 || GetClassId( pPlayer->GetEdict() ) == iClassId )
+                ++iCount;
+        }
+        return iCount;
+    }
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+CBot_SGTLS::CBot_SGTLS( edict_t* pEdict, TBotIntelligence iIntelligence, TTeam iTeam, int iClassId ):
+    CBot_HL2DM( pEdict, iIntelligence ), m_iWantedTeam( iTeam ), m_iWantedClassId( iClassId ), m_iClassId( -1 ),
+    m_iEquipCode( 0 ), m_iEquipClass( -1 ),
+    m_bEquipSent( false ), m_fNextJoinCommand( 0.0f ), m_fEquipTime( 0.0f ), m_fNextKill( 0.0f ), m_fSpawnTime( 0.0f ),
+    m_bLoadoutChecked( true )
+{
+    if ( m_iWantedTeam != ETeamTauri && m_iWantedTeam != ETeamGoauld )
+        m_iWantedTeam = -1;
+    // When stuck, Botrix shoots the object in the way: with staff / Kull blasts the splash kills the bot.
+    m_bDontBreakObjects = true;
+    m_bHoldingButton = false;
+    m_bSpawnOriginSet = m_bRegroupDone = false;
+    m_fRegroupEnd = 0.0f;
+    m_iGuardWaypoint = EWaypointIdInvalid;
+    m_fGuardEnd = 0.0f;
+    m_fNextStepJump = 0.0f;
+    m_vBlockedPos.Init();
+    m_fBlockedSince = 0.0f;
+    m_fFallenCheck = 0.0f;
+    m_iFallenChecks = 0;
+    m_iReachSource = EWaypointIdInvalid;
+    m_fReachTime = 0.0f;
+    m_iDoorPassed = -1;
+    m_fDoorPassedEnd = 0.0f;
