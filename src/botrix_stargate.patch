+        for ( ServerClass* pClass = sgtls::pServerGameDll->GetAllServerClasses(); pClass; pClass = pClass->m_pNext )
+        {
+            if ( args.ArgC() < 2 )
+                Msg( "%s (%s)\n", pClass->GetName(), pClass->m_pTable->GetName() );
+            else if ( strcmp( pClass->GetName(), args.Arg( 1 ) ) == 0 )
+            {
+                Msg( "%s (%s):\n", pClass->GetName(), pClass->m_pTable->GetName() );
+                PrintTable( pClass->m_pTable, 0, 1 );
+            }
+        }
