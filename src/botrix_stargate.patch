+const char* sgtls::ServerClassName( edict_t* pEdict )
+{
+    if ( !pEdict || pEdict->IsFree() || !pEdict->GetNetworkable() )
+        return "";
+    ServerClass* pClass = pEdict->GetNetworkable()->GetServerClass();
