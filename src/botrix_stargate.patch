+//----------------------------------------------------------------------------------------------------------------
+void CBot_SGTLS::AfterTeleport()
+{
+    // tls_hatak (2026-11-12): either ring panel sends both platforms at once, and the ship's rings go through a room in
+    // between. A bot on its way to the button was sent before pressing it: it kept its transporter, pressed the button
+    // at the other end and was sent back, again and again (one bot: 9 trips in 3 minutes); others kept their path from
+    // the other side. Waypoints near the arrival: the transporter is done, the path starts again from here. None near
+    // (the room in between): at the next jump.
+    TWaypointId w = CWaypoints::GetNearestWaypoint( m_vHead, NULL, false, 256.0f );
+    if ( !CWaypoint::IsValid( w ) )
+        return;
+    if ( m_iTeleporter >= 0 )
+    {
+        BLOG_I( "%s -> Transported%s.", GetName(), m_fTeleporterPressed > 0.0f ? "" : " (someone else's press)" );
+        m_iTeleporter = -1;
+        m_fTeleporterPressed = 0.0f;
+        iCurrentWaypoint = w;
+        m_iCurrentTask = EBotTaskInvalid;
+        m_bNeedTaskCheck = true;
+        return;
+    }
+    // Its path went through (a stargate's link): the next waypoint is here.
+    if ( CWaypoint::IsValid( iNextWaypoint ) &&
+         CWaypoints::Get( iNextWaypoint ).vOrigin.DistToSqr( m_vHead ) < 400.0f * 400.0f )
+        return;
+    BLOG_I( "%s -> Sent off its path: on from waypoint %d.", GetName(), w );
+    iCurrentWaypoint = w;
+    iNextWaypoint = EWaypointIdInvalid;
+    m_iCurrentTask = EBotTaskInvalid;
+    m_bNeedTaskCheck = true;
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+bool CBot_SGTLS::UseTransporter( int iTeleporter )
+{
+    // tls_stargate_atlantis_fixed: the Ancient transporters. A button inside the booth turns its teleporter on for a
+    // hundredth of a second, 4 seconds later: whoever stands inside then is sent to another booth.
+    const sgtls::CButtonTeleporter& def = sgtls::ButtonTeleporters()[iTeleporter];
+    if ( m_iTeleporter != iTeleporter )
+    {
+        BLOG_I( "%s -> %s on the way, pressing its button.", GetName(), def.bRing ? "Rings" : "Transporter" );
+        m_iTeleporter = iTeleporter;
+        m_fTeleporterStart = CBotrixPlugin::fTime;
+        m_fTeleporterPressed = 0.0f;
+    }
+    if ( m_fTeleporterPressed > 0.0f )
+    {
+        // Rings: pressed beside the platform, the bot walks in. Transported once far from the platform.
+        Vector vRing = ( def.pTeleporter->vMins + def.pTeleporter->vMaxs ) * 0.5f;
+        bool bTransported = def.bRing ? m_vHead.DistToSqr( vRing ) > 600.0f * 600.0f
+                                      : m_vHead.DistToSqr( m_vTeleporterPressPos ) > 200.0f * 200.0f;
+        if ( bTransported )
+        {
+            BLOG_I( "%s -> Transported.", GetName() );
+            m_iTeleporter = -1;
+            m_fTeleporterPressed = 0.0f;
+            // The path search starts from the current waypoint: the one here, not the booth left behind (from there
+            // the path would take the link again).
+            TWaypointId w = CWaypoints::GetNearestWaypoint( m_vHead );
+            if ( CWaypoint::IsValid( w ) )
+                iCurrentWaypoint = w;
+            m_iCurrentTask = EBotTaskInvalid;
+            m_bNeedTaskCheck = true; // New path from the other booth.
+            return false;
+        }
+        if ( sgtls::bHurtLog && CBotrixPlugin::fTime > m_fTeleporterDiag )
+        {
+            m_fTeleporterDiag = CBotrixPlugin::fTime + 0.5f;
+            Vector vRingMid = ( def.pTeleporter->vMins + def.pTeleporter->vMaxs ) * 0.5f;
+            BLOG_I( "%s -> transporter %d +%.1f s: at %.0f %.0f %.0f, %.0f from the middle (z %.0f), on %d.", GetName(), iTeleporter,
+                    CBotrixPlugin::fTime - m_fTeleporterPressed, m_vHead.x, m_vHead.y, m_vHead.z,
+                    ( m_vHead - vRingMid ).Length2D(), vRingMid.z, sgtls::CObjectives::TeleporterReady( iTeleporter ) ? 1 : 0 );
+        }
+        // Rings still moving after its own press (tls_hatak's ship rings, 2026-11-12: they stall part way, up to 13 s,
+        // and came on 7, 9.5 or 17.5 s after the press; the presser had gone back to the button): wait inside, up to
+        // 25 s ("ringguard").
+        bool bRingsMoving = def.bRing && sgtls::Feature( sgtls::FeatRingGuard ) &&
+                            CBotrixPlugin::fTime < m_fTeleporterPressed + 25.0f &&
+                            CBotrixPlugin::fTime > m_fTeleporterPressed + 1.0f &&
+                            sgtls::CObjectives::RingsActive( iTeleporter );
+        if ( CBotrixPlugin::fTime < m_fTeleporterPressed + def.fDelay + 2.0f || bRingsMoving )
+        {
+            m_bNeedMove = false; // Wait inside.
+            if ( def.bRing )
+            {
+                // Into the middle of the platform (the rings come down around it), and wait there.
+                Vector vTo = def.vEntry - m_vHead;
+                if ( vTo.Length2D() > 20.0f )
+                {
+                    m_vDestination = Vector( def.vEntry.x, def.vEntry.y, m_vHead.z );
+                    iNextWaypoint = EWaypointIdInvalid;
+                    m_bUseNavigatorToMove = m_bDestinationChanged = false;
+                    m_bNeedMove = true;
+                }
+            }
+            return true;
+        }
+        m_fTeleporterPressed = 0.0f; // Still here: press again.
+    }
+    if ( CBotrixPlugin::fTime > m_fTeleporterStart + 30.0f )
+    {
+        BLOG_W( "%s -> Not transported after 30 seconds, leaving that transporter for a minute.", GetName() );
+        m_iTeleporterGaveUp = iTeleporter;
+        m_fTeleporterGaveUpEnd = CBotrixPlugin::fTime + 60.0f;
+        m_iTeleporter = -1;
+        m_iCurrentTask = EBotTaskInvalid;
+        m_bNeedTaskCheck = true;
+        return false;
+    }
+
+    Vector vButton;
+    TWaypointId wButton;
+    edict_t* pButton = sgtls::CObjectives::TeleporterButton( iTeleporter, m_vHead, vButton, wButton );
+    if ( !pButton )
+    {
+        m_iTeleporter = -1;
+        return false;
+    }
+    Vector vToButton = vButton - m_vHead;
+    if ( vToButton.Length2D() > 130.0f && CWaypoint::IsValid( wButton ) && iCurrentWaypoint != wButton )
+    {
+        if ( m_iDestinationWaypoint != wButton || !m_bUseNavigatorToMove || m_bMoveFailure )
+        {
+            m_iDestinationWaypoint = wButton;
+            m_bDestinationChanged = true;
+            m_bMoveFailure = false;
+        }
+        m_bUseNavigatorToMove = m_bNeedMove = true;
+        return true;
+    }
+    if ( vToButton.Length2D() > 40.0f )
+    {
+        m_vDestination = Vector( vButton.x, vButton.y, m_vHead.z );
+        iNextWaypoint = EWaypointIdInvalid;
+        m_bUseNavigatorToMove = m_bDestinationChanged = false;
+        m_bNeedMove = true;
+    }
+    else
+        m_bNeedMove = false;
+    m_vLook = vButton;
+    m_bNeedAim = true;
+    m_fEndAimTime = CBotrixPlugin::fTime + 0.3f;
+    if ( sgtls::bHurtLog && CBotrixPlugin::fTime > m_fTeleporterDiag )
+    {
+        m_fTeleporterDiag = CBotrixPlugin::fTime + 2.0f;
+        BLOG_I( "%s -> transporter %d: at %.0f %.0f %.0f, button %.0f %.0f %.0f (%.0f away, dz %.0f), sight %d, move %d nav %d, current %d, button wp %d.",
+                GetName(), iTeleporter, m_vHead.x, m_vHead.y, m_vHead.z, vButton.x, vButton.y, vButton.z,
+                vToButton.Length2D(), vToButton.z, ButtonInSight( pButton, vButton ) ? 1 : 0, m_bNeedMove ? 1 : 0,
+                m_bUseNavigatorToMove ? 1 : 0, iCurrentWaypoint, wButton );
+    }
+    if ( vToButton.Length2D() < 72.0f && fabs( vToButton.z ) < 64.0f && ButtonInSight( pButton, vButton ) )
+    {
+        // Pressed now, or by someone else a moment ago (the button waits): wait inside either way.
+        if ( sgtls::CObjectives::PressTeleporterButton( iTeleporter, m_pEdict ) )
+            BLOG_I( "%s -> Pressed the transporter's button.", GetName() );
+        m_fTeleporterPressed = CBotrixPlugin::fTime;
+        m_vTeleporterPressPos = m_vHead;
+    }
+    return true;
+}
+
