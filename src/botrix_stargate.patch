+                ++iCount;
+        }
+        return iCount;
+    }
+
+    // The least played class of the team (random among equals), so that the packs are spread.
+    const char* BalancedClass( const char** aClasses, int iClasses, TTeam iTeam, edict_t* pSkip )
+    {
+        int iStart = rand() % iClasses, iBest = iStart, iBestCount = 1 << 30;
+        for ( int k = 0; k < iClasses; ++k )
+        {
+            int i = ( iStart + k ) % iClasses;
+            int iCount = CountClass( iTeam, aClasses[i], pSkip );
+            if ( iCount < iBestCount )
+            {
+                iBestCount = iCount;
+                iBest = i;
+            }
+        }
+        return aClasses[iBest];
+    }
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+TTeam CBot_SGTC2::TeamOfClass( const char* szClass )
+{
+    for ( int i = 0; i < sizeof(aGoauldClasses) / sizeof(aGoauldClasses[0]); ++i )
+        if ( strcmp( szClass, aGoauldClasses[i] ) == 0 )
+            return ETeamGoauld;
+    if ( strcmp( szClass, "anubis" ) == 0 )
+        return ETeamGoauld;
+    for ( int i = 0; i < sizeof(aTauriClasses) / sizeof(aTauriClasses[0]); ++i )
+        if ( strcmp( szClass, aTauriClasses[i] ) == 0 )
+            return ETeamTauri;
+    return -1;
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+CBot_SGTC2::CBot_SGTC2( edict_t* pEdict, TBotIntelligence iIntelligence, TTeam iTeam, const char* szClass ):
+    CBot_HL2DM( pEdict, iIntelligence ), m_iGateAction( sgtc2::EGateActionNone ), m_iGateStamp( -1 ),
+    m_fStrandedTime( 0.0f ), m_bCarrier( false ), m_iBaseIntelligence( -1 ), m_fWalkStart( 0.0f ), m_fWalkCheckDistance( 0.0f ),
+    m_fNoWalkUntil( 0.0f ), m_iWantedTeam( iTeam ), m_szWantedClass( szClass ), m_fNextJoinCommand( 0.0f ),
+    m_iJoinTries( 0 )
+{
+    if ( m_iWantedTeam != ETeamGoauld && m_iWantedTeam != ETeamTauri )
+        m_iWantedTeam = -1;
+    // Staff and Zat'arc shots explode: never shoot an obstacle in the way.
+    m_bDontBreakObjects = true;
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+TTeam CBot_SGTC2::ChooseTeam() const
+{
+    if ( m_iWantedTeam != -1 )
+        return m_iWantedTeam;
+    int iGoauld = CountPlayers( ETeamGoauld, m_pEdict );
+    int iTauri = CountPlayers( ETeamTauri, m_pEdict );
+    if ( iGoauld != iTauri )
+        return iGoauld < iTauri ? ETeamGoauld : ETeamTauri;
+    return ( rand() & 1 ) ? ETeamGoauld : ETeamTauri;
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+int sgtc2::iTauriSkillBonus = 0;
+float sgtc2::fObjectiveRoam = 0.0f;
+int sgtc2::iChase = 0;
+
+bool CBot_SGTC2::CheckJoin()
+{
+    TTeam iTeam = m_pPlayerInfo->GetTeamIndex();
+    if ( iTeam == ETeamGoauld || iTeam == ETeamTauri )
+    {
+        // Optional handicap for the bots' weapon imbalance (Tau'ri rifles vs staff blasts), 0 by default; follows
+        // the console value live.
+        if ( m_iBaseIntelligence < 0 )
+            m_iBaseIntelligence = m_iIntelligence;
+        int iWanted = m_iBaseIntelligence + ( iTeam == ETeamTauri ? sgtc2::iTauriSkillBonus : 0 );
+        iWanted = iWanted < EBotPro ? iWanted : EBotPro;
+        if ( iWanted != m_iIntelligence )
+        {
+            m_iIntelligence = (TBotIntelligence)iWanted;
+            BLOG_I( "%s -> Tau'ri skill bonus: intelligence %d.", GetName(), m_iIntelligence );
+        }
+        return false;
+    }
+
+    if ( CBotrixPlugin::fTime < m_fNextJoinCommand )
+        return true;
+    m_fNextJoinCommand = CBotrixPlugin::fTime + 1.0f;
+
+    // The wanted class first, then the least played class of the chosen team; random after a refusal (a class can
+    // be refused, it would be the least played again).
+    const char* szClass = m_szWantedClass;
+    if ( !szClass || m_iJoinTries > 0 )
+    {
+        TTeam iTeam = ChooseTeam();
+        const char** aClasses = ( iTeam == ETeamGoauld ) ? aGoauldClasses : aTauriClasses;
+        int iClasses = ( iTeam == ETeamGoauld ) ? sizeof(aGoauldClasses) / sizeof(aGoauldClasses[0])
+                                                : sizeof(aTauriClasses) / sizeof(aTauriClasses[0]);
+        szClass = ( m_iJoinTries <= 1 ) ? BalancedClass( aClasses, iClasses, iTeam, m_pEdict )
+                                        : aClasses[ rand() % iClasses ];
+    }
+    ++m_iJoinTries;
+
+    char szCmd[32];
+    sprintf( szCmd, "set_%s", szClass );
+    ConsoleCommand( szCmd );
+    return true;
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+void CBot_SGTC2::PreThink()
+{
+    // Waypoint-less bots don't think (CBot::PreThink returns early): join the game first.
+    if ( CheckJoin() )
+    {
+        m_cCmd.forwardmove = m_cCmd.sidemove = m_cCmd.upmove = 0;
+        m_cCmd.buttons = 0;
+        m_cCmd.impulse = 0;
+        m_pController->RunPlayerMove( &m_cCmd );
+#ifdef BOTRIX_SOURCE_ENGINE_2006
+        m_pController->PostClientMessagesSent();
+#endif
+        return;
+    }
+    CBot_HL2DM::PreThink();
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+TWaypointId CBot_SGTC2::GetRoamDestination()
+{
+    m_iGateStamp = sgtc2::CStargates::StateStamp( !m_bCarrier );
+    TWaypointId iDestination = sgtc2::CStargates::PickWaypoint( m_pEdict, GetTeam(), iCurrentWaypoint );
+    if ( CWaypoint::IsValid( iDestination ) && iDestination != iCurrentWaypoint )
+        return iDestination;
+    return CBot_HL2DM::GetRoamDestination();
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+void CBot_SGTC2::Think()
+{
+    // Capture the artefact: switching weapons drops the artefact. Its carrier keeps it in hands and doesn't fight,
+    // it runs home.
+    bool bCarrier = m_bAlive && sgtc2::CStargates::IsCarrier( m_pEdict );
+
+    // Paths avoid the waypoints that the enemy automatic turrets see.
+    TAreaId iAvoid = sgtc2::CStargates::TurretArea( GetTeam() == ETeamTauri ? ETeamGoauld : ETeamTauri );
+    // Not from inside that area: no path at all would start (the bot stood still under the turrets).
+    if ( iAvoid != EAreaIdInvalid && CWaypoint::IsValid( iCurrentWaypoint ) && CWaypoints::Get( iCurrentWaypoint ).iAreaId == iAvoid )
+        iAvoid = EAreaIdInvalid;
+    bool bAvoidChanged = ( iAvoid == EAreaIdInvalid ) ? ( m_aAvoidAreas.size() > 0 )
+                                                      : ( m_aAvoidAreas.size() != 1 || m_aAvoidAreas[0] != iAvoid );
+    if ( bAvoidChanged )
+    {
+        m_aAvoidAreas.clear();
+        if ( iAvoid != EAreaIdInvalid )
+            m_aAvoidAreas.push_back( iAvoid );
+    }
+    if ( bCarrier != m_bCarrier )
+    {
+        BLOG_I( "%s -> %s the artefact.", GetName(), bCarrier ? "Carrying" : "No longer carrying" );
+        SetCarrier( bCarrier );
+        m_iCurrentTask = EBotTaskInvalid;
+        m_bNeedTaskCheck = true;
+    }
+
+    if ( m_bAlive && !m_pCurrentEnemy )
+    {
+        Vector vTarget;
+        TWaypointId iDestination = m_bUseNavigatorToMove ? m_iDestinationWaypoint : EWaypointIdInvalid;
+        sgtc2::TGateAction iAction = sgtc2::CStargates::GetAction( m_pEdict, GetTeam(), iCurrentWaypoint, GetHead(),
+                                                                   iDestination, vTarget );
+
+        // A straight walk can be blocked (it only starts near the target, still): when it doesn't get 16 units
+        // closer in 3 seconds (the artefact carrier walks at 20-50 units per second), back to the waypoints for a
+        // while.
+        if ( iAction == sgtc2::EGateActionWalk && CBotrixPlugin::fTime < m_fNoWalkUntil )
+            iAction = sgtc2::EGateActionNone;
+        if ( iAction == sgtc2::EGateActionWalk )
+        {
+            float fDistance = GetHead().AsVector2D().DistTo( vTarget.AsVector2D() );
+            if ( m_iGateAction != sgtc2::EGateActionWalk )
+                m_fWalkCheckDistance = fDistance;
+            else if ( CBotrixPlugin::fTime > m_fWalkStart + 3.0f )
+            {
+                if ( fDistance > m_fWalkCheckDistance - 16.0f )
+                {
+                    BLOG_I( "%s -> Blocked walking straight, back to the waypoints.", GetName() );
+                    m_fNoWalkUntil = CBotrixPlugin::fTime + 8.0f;
+                    iAction = sgtc2::EGateActionNone;
+                }
+                m_fWalkStart = CBotrixPlugin::fTime;
+                m_fWalkCheckDistance = fDistance;
+            }
+        }
+
+        if ( iAction != sgtc2::EGateActionNone )
+        {
+            if ( iAction != m_iGateAction )
+            {
+                BLOG_I( "%s -> %s.", GetName(), iAction == sgtc2::EGateActionDial ? "Dialing the stargate" :
+                        ( iAction == sgtc2::EGateActionWait ? "Waiting at the DHD"
+                                                             : "Walking into the gate / objective" ) );
+                m_fWalkStart = CBotrixPlugin::fTime;
+            }
+            m_iGateAction = iAction;
+            m_vLook = vTarget;
+            m_bNeedAim = true;
+            m_fEndAimTime = CBotrixPlugin::fTime + 0.2f;
+            m_bUseNavigatorToMove = m_bDestinationChanged = false;
+            if ( iAction == sgtc2::EGateActionWalk )
+            {
+                iNextWaypoint = EWaypointIdInvalid;
+                m_vDestination = vTarget;
+                m_bNeedMove = true;
+            }
+            else
+            {
+                m_bNeedMove = false;
+                if ( iAction == sgtc2::EGateActionDial )
+                    sgtc2::CStargates::Dial( m_pEdict, GetTeam(), iCurrentWaypoint );
+            }
+            return;
+        }
+    }
+
+    // Stuck in a base without exit (capture the artefact, after bringing it): respawn.
+    if ( m_bAlive && sgtc2::CStargates::IsStranded( m_pEdict, iCurrentWaypoint ) )
+    {
+        if ( m_fStrandedTime == 0.0f )
+            m_fStrandedTime = CBotrixPlugin::fTime;
+        else if ( CBotrixPlugin::fTime - m_fStrandedTime > 10.0f )
+        {
+            BLOG_I( "%s -> Stranded in a base, respawning.", GetName() );
+            ConsoleCommand( "kill" );
+            m_fStrandedTime = 0.0f;
+        }
+    }
+    else
+        m_fStrandedTime = 0.0f;
+
+    // After a gate action (the bot went through, or met an enemy), or when a gate opened / closed: choose the
+    // destination again.
+    if ( m_iGateAction != sgtc2::EGateActionNone ||
+         ( m_iCurrentTask == EBotTaskFindEnemy && m_iGateStamp != sgtc2::CStargates::StateStamp( !m_bCarrier ) ) )
+    {
+        m_iGateAction = sgtc2::EGateActionNone;
+        m_iCurrentTask = EBotTaskInvalid;
+        m_bNeedTaskCheck = true;
+    }
+    CBot_HL2DM::Think();
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+void CBot_SGTC2::Respawned()
+{
+    SetCarrier( false ); // Before the respawn weapons are configured.
+    CBot_HL2DM::Respawned();
+    m_iGateAction = sgtc2::EGateActionNone;
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+void CBot_SGTC2::SetCarrier( bool bCarrier )
+{
+    m_bCarrier = bCarrier;
+    m_bFeatureWeaponCheck = !bCarrier;
+    m_bDontAttack = bCarrier;
+    if ( bCarrier )
+        EraseCurrentEnemy();
+    else
+        m_bNeedSetWeapon = true; // Back to the best weapon.
+}
+
+#endif // BOTRIX_SGTC2
diff --git a/mods/sgtc2/bot_sgtc2.h b/mods/sgtc2/bot_sgtc2.h
new file mode 100644
index 0000000..7070ff0
--- /dev/null
+++ b/mods/sgtc2/bot_sgtc2.h
@@ -0,0 +1,82 @@
+#ifdef BOTRIX_SGTC2
+
+#ifndef __BOTRIX_BOT_SGTC2_H__
+#define __BOTRIX_BOT_SGTC2_H__
+
+#include "mods/hl2dm/bot_hl2dm.h"
+
+namespace sgtc2
+{
+    /// Tau'ri bots get this many intelligence levels more (console: sgtc2_tauri_skill_bonus, 0 by default).
+    extern int iTauriSkillBonus;
+    /// Objective mode: the defenders roaming on the objective's island stay within this distance of the objective
+    /// (<prefix>_objroam, for the current map, 0 = anywhere on the island).
+    extern float fObjectiveRoam;
+    /// Objective mode: percent of the defenders off the objective's island that go after attackers there,
+    /// through the stargate (<prefix>_chase, for the current map, 0 = off).
+    extern int iChase;
+}
+
+
+//****************************************************************************************************************
+/// Bot for StargateTC 2. Fights like the HL2DM bot. Joins with "set_<class>", which picks the class (a fixed
+/// weapon pack) and its team: Goa'uld = team 2 (horus, jaffa, serpent, anubis), Tau'ri = team 3 (soldier,
+/// jackson, tealc, carter, oneill).
+//****************************************************************************************************************
+class CBot_SGTC2: public CBot_HL2DM
+{
+
+public:
+    enum
+    {
+        ETeamGoauld = 2,
+        ETeamTauri = 3,
+    };
+
+    /// iTeam: -1 to balance the teams. szClass: class name ("jaffa"...), NULL for a random one of the team.
+    CBot_SGTC2( edict_t* pEdict, TBotIntelligence iIntelligence, TTeam iTeam, const char* szClass );
+
+    virtual void PreThink();
+
+    virtual void Respawned();
+
+    /// The weight system slows the artefact carrier down to 20-50 units per second.
+    virtual float MinNonStuckSpeed() const { return m_bCarrier ? 8.0f : CBot_HL2DM::MinNonStuckSpeed(); }
+
+    /// Team of a class name, -1 if unknown.
+    static TTeam TeamOfClass( const char* szClass );
+
+protected:
+    /// Objective maps: go to the objective, or to the DHD / stargate that leads to it (see stargates_sgtc2.h).
+    virtual TWaypointId GetRoamDestination();
+
+    /// Dial the stargate at the DHD, walk into the open gate or the objective trigger (when no enemy), else the
+    /// HL2DM think.
+    virtual void Think();
+
+    int m_iGateAction;             ///< sgtc2::TGateAction Think() is doing, none = the HL2DM think.
+    int m_iGateStamp;              ///< CStargates::StateStamp() when the roam destination was chosen.
+    float m_fStrandedTime;         ///< Since when the bot is stranded in a base, 0 if not.
+    bool m_bCarrier;               ///< Carries the artefact: no weapon change (it would drop it), no fight.
+    int m_iBaseIntelligence;       ///< Intelligence before the team's bonus, -1 until a team is joined.
+    float m_fWalkStart;            ///< When the current gate action started (straight walk: last progress check).
+    float m_fWalkCheckDistance;    ///< Straight walk: distance to the target at the last progress check.
+    float m_fNoWalkUntil;          ///< No straight walk until then (the last one was blocked).
+
+    void SetCarrier( bool bCarrier );
+
+    /// Send "set_<class>" until the bot is in a team. Return true while it isn't.
+    bool CheckJoin();
+
+    TTeam ChooseTeam() const;
+
+    TTeam m_iWantedTeam;           ///< -1 = balance teams.
+    const char* m_szWantedClass;   ///< NULL = random.
+    float m_fNextJoinCommand;      ///< Don't flood the server with join commands.
+    int m_iJoinTries;
+
+};
+
+#endif // __BOTRIX_BOT_SGTC2_H__
+
+#endif // BOTRIX_SGTC2
diff --git a/mods/sgtc2/hooks_sgtc2.cpp b/mods/sgtc2/hooks_sgtc2.cpp
new file mode 100644
index 0000000..5cdd7d0
--- /dev/null
+++ b/mods/sgtc2/hooks_sgtc2.cpp
@@ -0,0 +1,229 @@
+// Round end log for StargateTC 2's server.dll (closed source, image base 0x22000000).
+//
+// The game rules function "team X wins the round" (0x22346bb0, thiscall, one argument: the team) shows the win
+// panels; the round restarts right after. Its callers tell why the round ended (see the table below). A 5-byte jump at
+// its start logs each call to the console.
+#if defined(BOTRIX_SGTC2) && defined(_WIN32)
+
+#include <string.h>
+
+#include "server_plugin.h"
+#include "mods/sgtc2/stargates_sgtc2.h"
+
+#include "tier0/dbg.h"
+
+extern "C" __declspec(dllimport) void* __stdcall GetModuleHandleA( const char* szModule );
+extern "C" __declspec(dllimport) int __stdcall VirtualProtect( void* pAddress, unsigned long iSize, unsigned long iNew,
+                                                               unsigned long* pOld );
+
+namespace
+{
+    const unsigned int iImageBase = 0x22000000;
+    const unsigned int iTeamWinFn = 0x22346bb0;
+    const unsigned char aPrologue[5] = { 0x83, 0xEC, 0x24, 0x53, 0x55 }; // sub esp, 24h; push ebx; push ebp
+
+    // Return addresses of the calls (server.dll VA) -> why the round ended.
+    struct CCaller
+    {
+        unsigned int iReturn;
+        const char* szReason;
+    };
+    const CCaller aCallers[] =
+    {
+        { 0x223475b4, "objective mode: time is up" },
+        { 0x22347644, "objective mode: all Tau'ri dead" },
+        { 0x2234768f, "objective mode: all Goa'uld dead" },
+        { 0x2234779d, "objective mode: time is up / team dead" },
+        { 0x22347801, "objective mode: team dead (respawn limit)" },
+        { 0x22347bb0, "artefact brought home" },
+        { 0x22347bed, "artefact brought home" },
+        { 0x22381d40, "other game mode" },
+        { 0x22381db0, "other game mode" },
+        { 0x223841da, "sgtc2_gameplay WinTauri input (objective reached)" },
+        { 0x22384249, "sgtc2_gameplay WinGoa input (objective reached)" },
+    };
+
+    char* m_pBase = NULL;
+    unsigned char* m_pPatch = NULL;
+    void* m_pContinue = NULL; // Right after the patched prologue.
+
+    void __cdecl OnTeamWin( unsigned int iReturn, int iTeam )
+    {
+        unsigned int iVA = iReturn - (unsigned int)m_pBase + iImageBase;
+        const char* szReason = "other";
+        for ( int i = 0; i < sizeof(aCallers) / sizeof(aCallers[0]); ++i )
+            if ( aCallers[i].iReturn == iVA )
+                szReason = aCallers[i].szReason;
+        Msg( "[Botrix] %s: round won by %s (team %d): %s (server.dll %08x).\n",
+             CBotrixPlugin::instance->sMapName.c_str(),
+             iTeam == 3 ? "the Tau'ri" : ( iTeam == 2 ? "the Goa'uld" : "?" ), iTeam, szReason, iVA );
+        sgtc2::CStargates::LogRoundEnd( iTeam );
+    }
+
+    __declspec(naked) void TeamWinHook()
+    {
+        __asm
+        {
+            pushad
+            push dword ptr [esp + 36]   // The team (first argument).
+            push dword ptr [esp + 36]   // The return address (moved by the previous push).
+            call OnTeamWin
+            add esp, 8
+            popad
+            sub esp, 0x24               // The patched prologue.
+            push ebx
+            push ebp
+            jmp dword ptr [m_pContinue]
+        }
+    }
+
+    bool Write( const unsigned char* aBytes )
+    {
+        unsigned long iOld = 0;
+        if ( !VirtualProtect( m_pPatch, 5, 0x40 /* PAGE_EXECUTE_READWRITE */, &iOld ) )
+            return false;
+        memcpy( m_pPatch, aBytes, 5 );
+        VirtualProtect( m_pPatch, 5, iOld, &iOld );
+        return true;
+    }
+}
+
+namespace sgtc2
+{
+    void InstallHooks()
+    {
+        m_pBase = (char*)GetModuleHandleA( "server.dll" );
+        if ( !m_pBase || m_pPatch )
+            return;
+        unsigned char* p = (unsigned char*)m_pBase + ( iTeamWinFn - iImageBase );
+        if ( memcmp( p, aPrologue, 5 ) != 0 )
+        {
+            Msg( "[Botrix] sgtc2: unknown server.dll, round end log not installed.\n" );
+            return;
+        }
+        m_pPatch = p;
+        m_pContinue = p + 5;
+        unsigned char aJump[5] = { 0xE9 };
+        int iRelative = (int)( (char*)TeamWinHook - (char*)( p + 5 ) );
+        memcpy( aJump + 1, &iRelative, 4 );
+        if ( !Write( aJump ) )
+            m_pPatch = NULL;
+    }
+
+    void RemoveHooks()
+    {
+        if ( m_pPatch && Write( aPrologue ) )
+            m_pPatch = NULL;
+    }
+}
+
+#elif defined(BOTRIX_SGTC2) && defined(__linux__)
+
+// Linux: the same function in server_i486.so is CHL2MPRules::WinScreen(int) (GCC: cdecl, this first). A 5-byte jump
+// at its start goes to WinScreenHook, which logs and calls the original through a trampoline: the 6 prologue bytes the
+// jump replaced, then a jump back. The callers are named by dladdr (the .so exports all its symbols).
+
+#include <dlfcn.h>
+#include <string.h>
+#include <sys/mman.h>
+
+#include "server_plugin.h"
+#include "mods/sgtc2/stargates_sgtc2.h"
+#include "mods/sgtls/sgtls_util.h"
+
+#include "tier0/dbg.h"
+
+namespace
+{
+    const unsigned char aPrologue[6] = { 0x55, 0x89, 0xE5, 0x57, 0x56, 0x53 }; // push ebp; mov ebp, esp; push edi..ebx
+
+    // Function of the call -> why the round ended.
+    struct CCaller
+    {
+        const char* szFunction;
+        const char* szReason;
+    };
+    const CCaller aCallers[] =
+    {
+        { "_ZN11CHL2MPRules5ThinkEv", "objective mode: time is up / team dead" },
+        { "_ZN11CHL2MPRules14CaptureArtfactEi", "artefact brought home" },
+        { "_ZN15CBFLGameControl13InputWinTauriER11inputdata_t", "other game mode" },
+        { "_ZN15CBFLGameControl11InputWinGoaER11inputdata_t", "other game mode" },
+        { "_ZN17LogicSGT2Gameplay13InputWinTauriER11inputdata_t", "sgtc2_gameplay WinTauri input (objective reached)" },
+        { "_ZN17LogicSGT2Gameplay11InputWinGoaER11inputdata_t", "sgtc2_gameplay WinGoa input (objective reached)" },
+    };
+
+    typedef void ( *TWinScreen )( void* pThis, int iTeam );
+    unsigned char* m_pPatch = NULL;
+    unsigned char* m_pTrampoline = NULL;
+
+    // Reached by a jump from the start of WinScreen: the return address is the caller's.
+    void WinScreenHook( void* pThis, int iTeam )
+    {
+        char* pReturn = (char*)__builtin_return_address( 0 );
+        Dl_info cInfo;
+        const char* szFunction = ( dladdr( pReturn, &cInfo ) && cInfo.dli_sname ) ? cInfo.dli_sname : "?";
+        const char* szReason = "other";
+        for ( int i = 0; i < sizeof(aCallers) / sizeof(aCallers[0]); ++i )
+            if ( strcmp( aCallers[i].szFunction, szFunction ) == 0 )
+                szReason = aCallers[i].szReason;
+        Msg( "[Botrix] %s: round won by %s (team %d): %s (%s+0x%x).\n",
+             CBotrixPlugin::instance->sMapName.c_str(),
+             iTeam == 3 ? "the Tau'ri" : ( iTeam == 2 ? "the Goa'uld" : "?" ), iTeam, szReason, szFunction,
+             cInfo.dli_saddr ? (unsigned int)( pReturn - (char*)cInfo.dli_saddr ) : 0 );
+        sgtc2::CStargates::LogRoundEnd( iTeam );
+        ( (TWinScreen)m_pTrampoline )( pThis, iTeam );
+    }
+
+    void Jump( unsigned char* pFrom, const void* pTo, unsigned char aJump[5] )
+    {
+        int iRelative = (int)( (const char*)pTo - (const char*)( pFrom + 5 ) );
+        aJump[0] = 0xE9;
+        memcpy( aJump + 1, &iRelative, 4 );
+    }
+}
+
+namespace sgtc2
+{
+    void InstallHooks()
+    {
+        if ( m_pPatch )
+            return;
+        unsigned char* p = (unsigned char*)sgtls::ServerSymbol( "_ZN11CHL2MPRules9WinScreenEi" );
+        if ( !p || memcmp( p, aPrologue, sizeof(aPrologue) ) != 0 )
+        {
+            Msg( "[Botrix] sgtc2: unknown server .so, round end log not installed.\n" );
+            return;
+        }
+        if ( !m_pTrampoline )
+        {
+            void* pPage = mmap( NULL, 64, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0 );
+            if ( pPage == MAP_FAILED )
+                return;
+            m_pTrampoline = (unsigned char*)pPage;
+            memcpy( m_pTrampoline, aPrologue, sizeof(aPrologue) );
+            Jump( m_pTrampoline + sizeof(aPrologue), p + sizeof(aPrologue), m_pTrampoline + sizeof(aPrologue) );
+        }
+        unsigned char aJump[5];
+        Jump( p, (void*)WinScreenHook, aJump );
+        if ( sgtls::WriteCode( p, aJump, sizeof(aJump) ) )
+            m_pPatch = p;
+    }
+
+    void RemoveHooks()
+    {
+        // The trampoline stays mapped: a round end may still be running through it.
+        if ( m_pPatch && sgtls::WriteCode( m_pPatch, aPrologue, 5 ) )
+            m_pPatch = NULL;
+    }
+}
+
+#elif defined(BOTRIX_SGTC2)
+
+namespace sgtc2
+{
+    void InstallHooks() {}
+    void RemoveHooks() {}
+}
+
+#endif
diff --git a/mods/sgtc2/mod_sgtc2.cpp b/mods/sgtc2/mod_sgtc2.cpp
new file mode 100644
index 0000000..350d204
--- /dev/null
+++ b/mods/sgtc2/mod_sgtc2.cpp
@@ -0,0 +1,51 @@
+#ifdef BOTRIX_SGTC2
+
+#include <string.h>
+
+#include <good/string_buffer.h>
+
+#include "mods/sgtc2/bot_sgtc2.h"
+#include "mods/sgtc2/mod_sgtc2.h"
+
+#include "iplayerinfo.h"
+
+
+extern char* szMainBuffer;
+extern int iMainBufferSize;
+
+
+//----------------------------------------------------------------------------------------------------------------
+// Optional parameter: the class ("jaffa", "oneill"...), e.g. "botrix bot add ... carter".
+CPlayer* CModSGTC2::AddBot( const char* szName, TBotIntelligence iIntelligence, TTeam iTeam,
+                            TClass /*iClass*/, int iParamsCount, const char **aParams )
+{
+    const char* szClass = NULL;
+    if ( iParamsCount > 1 || ( iParamsCount == 1 && CBot_SGTC2::TeamOfClass( aParams[0] ) < 0 ) )
+    {
+        good::string_buffer sb( szMainBuffer, iMainBufferSize, false );
+        sb << "Invalid parameter: " << aParams[0]
+           << " (class expected: horus jaffa serpent anubis soldier jackson tealc carter oneill).";
+        m_sLastError = sb;
+        return NULL;
+    }
+    if ( iParamsCount == 1 )
+    {
+        // Keep a pointer that outlives the command arguments.
+        static const char* aClasses[] = { "horus", "jaffa", "serpent", "anubis", "soldier", "jackson", "tealc",
+                                          "carter", "oneill" };
+        for ( int i = 0; i < sizeof(aClasses) / sizeof(aClasses[0]); ++i )
+            if ( strcmp( aParams[0], aClasses[i] ) == 0 )
+                szClass = aClasses[i];
+        iTeam = CBot_SGTC2::TeamOfClass( szClass );
+    }
+
+    edict_t* pEdict = CBotrixPlugin::pBotManager->CreateBot( szName );
+    if ( !pEdict )
+    {
+        m_sLastError = "Error, couldn't add bot (no map or server full?).";
+        return NULL;
+    }
+    return new CBot_SGTC2( pEdict, iIntelligence, iTeam, szClass );
+}
+
+#endif // BOTRIX_SGTC2
