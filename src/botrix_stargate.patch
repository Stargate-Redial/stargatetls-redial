+    // Neighbour of iWaypoint nearest to / farthest from v, if it is nearer / farther than iWaypoint itself.
+    TWaypointId NeighbourTowards( TWaypointId iWaypoint, const Vector& v, bool bNearer )
+    {
+        const CWaypoints::WaypointNode::arcs_t& aNeighbours = CWaypoints::GetNode( iWaypoint ).neighbours;
+        float fBest = CWaypoints::Get( iWaypoint ).vOrigin.DistToSqr( v );
+        TWaypointId iBest = EWaypointIdInvalid;
+        for ( int i = 0; i < aNeighbours.size(); ++i )
+        {
+            float fDist = CWaypoints::Get( aNeighbours[i].target ).vOrigin.DistToSqr( v );
+            if ( bNearer ? fDist < fBest : fDist > fBest )
+            {
+                fBest = fDist;
+                iBest = aNeighbours[i].target;
+            }
+        }
+        return iBest;
