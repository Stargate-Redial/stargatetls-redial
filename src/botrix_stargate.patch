+    // sgtls_dump : players (team, class, health, weapon...) and non-player entities of interesting classes.
+    void DumpCommand( const CCommand& args )
+    {
+        IVEngineServer* pEngine = CBotrixPlugin::pEngineServer;
+        // GetPlayerInfo() doesn't check that the entity is a player: only look at player slots.
+        int iMaxClients = CBotrixPlugin::pPlayerInfoManager->GetGlobalVars()->maxClients;
+        for ( int i = 1; i <= iMaxClients; ++i )
+        {
+            edict_t* pEdict = pEngine->PEntityOfEntIndex( i );
+            if ( !EntityBase( pEdict ) )
+                continue;
+            IPlayerInfo* pInfo = CBotrixPlugin::pPlayerInfoManager->GetPlayerInfo( pEdict );
+            if ( !pInfo || !pInfo->IsConnected() )
+                continue;
+            Vector v = pInfo->GetAbsOrigin();
+            CPlayer* pPlayer = CPlayers::Get( pEdict );
+            if ( pPlayer && pPlayer->IsBot() )
+            {
+                char szState[768];
+                ( (const CBot_HL2DM*)pPlayer )->DebugState( szState, sizeof( szState ) );
+                Msg( "    %s\n", szState );
+            }
+            IServerEntity* pPlayerEntity = pEdict->GetIServerEntity();
+            Msg( "#%d %-16s team %d (net %d) classcur %d live %d hp %d ar %d %s%s obsmode %d wpn %s pos %.0f %.0f %.0f model %s\n",
+                 i, pInfo->GetName(), pInfo->GetTeamIndex(), sgtls::GetInt( pEdict, "m_iTeamNum" ),
+                 sgtls::GetInt( pEdict, "m_iClassIDCurrent" ), sgtls::GetInt( pEdict, "m_iLiveClassID" ),
+                 pInfo->GetHealth(), pInfo->GetArmorValue(), pInfo->IsDead() ? "DEAD" : "alive",
+                 pInfo->IsObserver() ? " OBSERVER" : "", sgtls::GetInt( pEdict, "m_iObserverMode" ),
+                 pInfo->GetWeaponName() ? pInfo->GetWeaponName() : "-", v.x, v.y, v.z,
+                 pPlayerEntity ? STRING( pPlayerEntity->GetModelName() ) : "-" );
+            int iWeapons = sgtls::PropOffset( pEdict, "m_hMyWeapons" );
+            if ( iWeapons >= 0 )
+            {
+                Msg( "    weapons:" );
+                const int* aHandles = (const int*)( EntityBase( pEdict ) + iWeapons );
+                int iAmmo = sgtls::PropOffset( pEdict, "m_iAmmo" );
+                for ( int w = 0; w < 48; ++w )
+                {
+                    if ( aHandles[w] == -1 )
+                        continue;
+                    edict_t* pWeapon = pEngine->PEntityOfEntIndex( aHandles[w] & 0xFFF );
+                    if ( !EntityBase( pWeapon ) )
+                    {
+                        Msg( " ?" );
+                        continue;
+                    }
+                    // Clip / reserve ammo of its primary ammo type.
+                    int iType = sgtls::GetInt( pWeapon, "m_iPrimaryAmmoType", -1 );
+                    int iReserve = ( iAmmo >= 0 && iType >= 0 && iType < 32 ) ? *(const int*)( EntityBase( pEdict ) + iAmmo + 4 * iType ) : -1;
+                    Msg( " %s(%d/%d)", pWeapon->GetClassName(), sgtls::GetInt( pWeapon, "m_iClip1", -1 ), iReserve );
+                }
+                Msg( "\n" );
+            }
+        }
+        const char* szFilter = args.ArgC() > 1 ? args.Arg( 1 ) : NULL;
+        if ( !szFilter )
+            return;
+        for ( int i = 1; i < pEngine->GetEntityCount(); ++i )
+        {
+            edict_t* pEdict = pEngine->PEntityOfEntIndex( i );
+            if ( !EntityBase( pEdict ) )
+                continue;
+            const char* szClass = sgtls::ServerClassName( pEdict );
+            const char* szName = pEdict->GetClassName();
+            if ( !strstr( szClass, szFilter ) && !(szName && strstr( szName, szFilter )) )
+                continue;
+            ICollideable* pColl = pEdict->GetCollideable();
+            Vector v( 0, 0, 0 ), vSize( 0, 0, 0 );
+            if ( pColl )
+            {
+                v = pColl->GetCollisionOrigin() + ( pColl->OBBMins() + pColl->OBBMaxs() ) * 0.5f;
+                vSize = pColl->OBBMaxs() - pColl->OBBMins();
+            }
+            IServerEntity* pServerEntity = pEdict->GetIServerEntity();
+            Msg( "ent %d %s (%s) center %.0f %.0f %.0f size %.0f %.0f %.0f team %d model %s", i,
+                 szName ? szName : "?", szClass, v.x, v.y, v.z, vSize.x, vSize.y, vSize.z,
+                 sgtls::GetInt( pEdict, "m_iTeamNum" ), pServerEntity ? STRING( pServerEntity->GetModelName() ) : "" );
+            static const char* aExtra[] = { "m_bEnabled", "m_iTeamFilter", "m_iOrder", "m_iObjectiveType",
+                                            "m_bAttacked", "m_bTeam2CanCap", "m_bTeam3CanCap", "m_iNetOwnerTeam" };
+            for ( int j = 0; j < sizeof(aExtra) / sizeof(aExtra[0]); ++j )
+            {
+                int iOffset = sgtls::PropOffset( pEdict, aExtra[j] );
+                if ( iOffset >= 0 )
+                {
+                    // Booleans are 1 byte: don't read the neighbours.
+                    int iValue = ( aExtra[j][2] == 'b' ) ? *( EntityBase( pEdict ) + iOffset )
+                                                         : sgtls::GetInt( pEdict, aExtra[j] );
+                    Msg( " %s %d", aExtra[j] + 2, iValue );
+                }
+            }
+            if ( sgtls::PropOffset( pEdict, "m_fNetCurrentPoints" ) >= 0 )
+                Msg( " points %.1f/%.1f", sgtls::GetFloat( pEdict, "m_fNetCurrentPoints" ),
+                     sgtls::GetFloat( pEdict, "m_fPointsForCap" ) );
+            Msg( "\n" );
+        }
+    }
