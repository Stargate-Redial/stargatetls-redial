+
+void sgtls::CObjectives::Refresh()
+{
+    // Rebuild on map / waypoints change, and every 20 seconds: a round restart can recreate the entities. Not while
+    // the waypoints are being analyzed: their count changes every frame, and each bot asked for a rebuild every frame
+    // (a map without waypoints and 10 bots: the server stuck at 100 % CPU, 2026-11-10).
+    if ( CWaypoints::IsAnalyzing() && m_sMap == CBotrixPlugin::instance->sMapName.c_str() )
+        return;
+    static float fNextRefresh = 0.0f;
+    if ( m_sMap == CBotrixPlugin::instance->sMapName.c_str() && m_iWaypoints == CWaypoints::Size() &&
+         CBotrixPlugin::fTime < fNextRefresh && CBotrixPlugin::fTime > fNextRefresh - 30.0f )
+        return;
+    fNextRefresh = CBotrixPlugin::fTime + 20.0f;
+    bool bSameMap = ( m_sMap == CBotrixPlugin::instance->sMapName.c_str() );
+    m_sMap = CBotrixPlugin::instance->sMapName.c_str();
+    m_iWaypoints = CWaypoints::Size();
+    m_aSpots.clear();
+
+    IVEngineServer* pEngine = CBotrixPlugin::pEngineServer;
+    std::vector<edict_t*> aObjectives, aButtons;
+    std::map<std::string, edict_t*> aBrushes; // Teleporters and buttons by brush model ("*39").
+    for ( int i = 1; i < pEngine->GetEntityCount(); ++i )
+    {
+        edict_t* pEdict = pEngine->PEntityOfEntIndex( i );
+        if ( !pEdict || pEdict->IsFree() || !pEdict->GetUnknown() )
+            continue;
+        const char* szClass = sgtls::ServerClassName( pEdict );
+        const char* szName = pEdict->GetClassName();
+        if ( szName && pEdict->GetIServerEntity() &&
+             ( strcmp( szName, "trigger_teleport" ) == 0 || strcmp( szName, "func_button" ) == 0 ||
+               strcmp( szName, "func_door" ) == 0 || strcmp( szName, "func_door_rotating" ) == 0 ||
+               strcmp( szName, "func_train" ) == 0 ) )
+            aBrushes[ STRING( pEdict->GetIServerEntity()->GetModelName() ) ] = pEdict;
+        if ( strcmp( szClass, "CGameObjective" ) == 0 )
+            aObjectives.push_back( pEdict );
+        else if ( szName && strcmp( szName, "func_hold_button" ) == 0 )
+            aButtons.push_back( pEdict );
+        else if ( strcmp( szClass, "CDHCaptureArea" ) == 0 )
+        {
+            CSpot c;
+            c.pEdict = pEdict;
+            c.pObjective = NULL;
+            c.bButton = false;
+            Bounds( pEdict, c );
+            m_aSpots.push_back( c );
+        }
+    }
+
+    // Capture areas: the objective inside or nearest (within 1024).
+    for ( size_t a = 0; a < m_aSpots.size(); ++a )
+    {
+        float fBest = 1024.0f * 1024.0f;
+        for ( size_t o = 0; o < aObjectives.size(); ++o )
+        {
+            float fDist = Origin( aObjectives[o] ).DistToSqr( m_aSpots[a].vCenter );
+            if ( fDist < fBest )
+            {
+                fBest = fDist;
+                m_aSpots[a].pObjective = aObjectives[o];
+            }
+        }
+    }
+
+    // Hold-button objectives (type 2): every func_hold_button within 128 units of the objective.
+    for ( size_t o = 0; o < aObjectives.size(); ++o )
+    {
+        if ( sgtls::GetInt( aObjectives[o], "m_iObjectiveType", 0 ) != 2 )
+            continue;
+        Vector vObjective = Origin( aObjectives[o] );
+        for ( size_t b = 0; b < aButtons.size(); ++b )
+        {
+            CSpot c;
+            c.pEdict = aButtons[b];
+            c.pObjective = aObjectives[o];
+            c.bButton = true;
+            Bounds( aButtons[b], c );
+            if ( c.vCenter.DistToSqr( vObjective ) < 128.0f * 128.0f )
+                m_aSpots.push_back( c );
+        }
+    }
+
+    float fEye = CMod::GetVar( EModVarPlayerEye );
+    for ( size_t a = 0; a < m_aSpots.size(); ++a )
+    {
+        CSpot& c = m_aSpots[a];
+        for ( TWaypointId w = 0; w < CWaypoints::Size(); ++w )
+        {
+            const Vector& v = CWaypoints::Get( w ).vOrigin; // Eye level.
+            bool bInside = c.bButton
+                ? v.DistToSqr( c.vCenter ) < fButtonUseDistance * fButtonUseDistance
+                : ( v.x >= c.vMins.x - 16 && v.x <= c.vMaxs.x + 16 && v.y >= c.vMins.y - 16 && v.y <= c.vMaxs.y + 16 &&
+                    v.z - fEye >= c.vMins.z - 24 && v.z - fEye <= c.vMaxs.z );
+            if ( bInside )
+                c.aInside.push_back( w );
+            else if ( v.DistToSqr( c.vCenter ) < fNearDistance * fNearDistance )
+                c.aNear.push_back( w );
+        }
+        if ( c.aInside.empty() )
+        {
+            // Smaller than the waypoint grid: use the nearest waypoint.
+            TWaypointId w = CWaypoints::GetNearestWaypoint( c.vCenter, NULL, false, 600.0f );
+            if ( CWaypoint::IsValid( w ) )
+                c.aInside.push_back( w );
+        }
+        if ( c.bButton )
+            GuardSpots( c, bSameMap );
+    }
+
+    // Button-operated teleporters: their entities (a round restart can recreate them) and waypoints. The on / off
+    // timing stays.
+    const std::vector<sgtls::CButtonTeleporter>& aDefs = sgtls::ButtonTeleporters();
+    if ( !bSameMap || m_aTeleporters.size() != aDefs.size() )
+    {
+        m_aTeleporters.resize( aDefs.size() );
+        for ( size_t i = 0; i < aDefs.size(); ++i )
+        {
+            m_aTeleporters[i].fOnSince = m_aTeleporters[i].fNextPress = -1.0f;
+            m_aTeleporters[i].aPartState.clear();
+            m_aTeleporters[i].fRingsChecked = -1.0f;
+            m_aTeleporters[i].bRingsActive = false;
+            m_aTeleporters[i].iButtonChoice = -1;
+            m_aTeleporters[i].iChoiceWaypoints = -1;
+        }
+    }
+    for ( size_t i = 0; i < aDefs.size(); ++i )
+    {
+        const sgtls::CButtonTeleporter& d = aDefs[i];
+        CTeleporter& t = m_aTeleporters[i];
+        std::map<std::string, edict_t*>::const_iterator it = aBrushes.find( d.pTeleporter->Get( "model" ) );
+        t.pTeleporter = ( it == aBrushes.end() ) ? NULL : it->second;
+        it = aBrushes.find( d.pButton->Get( "model" ) );
+        t.pButton = ( it == aBrushes.end() ) ? NULL : it->second;
+        t.aRingParts.clear();
+        for ( size_t r = 0; r < d.aRingParts.size(); ++r )
+        {
+            it = aBrushes.find( d.aRingParts[r]->Get( "model" ) );
+            t.aRingParts.push_back( it == aBrushes.end() ? NULL : it->second );
+        }
+        t.wEntry = CWaypoints::GetNearestWaypoint( d.vEntry, NULL, false, 32.0f );
+        t.wExit = CWaypoints::GetNearestWaypoint( d.vExit, NULL, false, 80.0f );
+        // The link may end at another waypoint near the destination than the nearest one (tls_omega_b1: the link of
+        // ring 2 -> 1 was made to a waypoint 51 units from the platform's middle, the entry of ring 1 -> 2 was
+        // created there afterwards; the link was taken for missing and the bots waited on the platform for good).
+        if ( CWaypoint::IsValid( t.wEntry ) && CWaypoint::IsValid( t.wExit ) && !CWaypoints::HasPath( t.wEntry, t.wExit ) )
+        {
+            good::vector<TWaypointId> aOut;
+            CWaypoints::GetPathTargets( t.wEntry, aOut );
+            float fBest = 80.0f * 80.0f;
+            t.wExit = EWaypointIdInvalid;
+            for ( int k = 0; k < aOut.size(); ++k )
+            {
+                float fDist = CWaypoints::Get( aOut[k] ).vOrigin.DistToSqr( d.vExit );
+                if ( fDist < fBest )
+                {
+                    fBest = fDist;
+                    t.wExit = aOut[k];
+                }
+            }
+        }
+        if ( !CWaypoint::IsValid( t.wEntry ) || !CWaypoint::IsValid( t.wExit ) || !CWaypoints::HasPath( t.wEntry, t.wExit ) )
+            t.wEntry = t.wExit = EWaypointIdInvalid;
+        // The nearest button whose waypoint has a way to the teleporter's entry (checked again when the waypoints
+        // change).
+        if ( !d.bMomentary && d.aButtons.size() > 1 && CWaypoint::IsValid( t.wEntry ) &&
+             t.iChoiceWaypoints != CWaypoints::Size() )
+        {
+            t.iChoiceWaypoints = CWaypoints::Size();
+            t.iButtonChoice = -1;
+            for ( size_t b = 0; b < d.aButtons.size() && t.iButtonChoice < 0; ++b )
+            {
+                Vector vB = ( d.aButtons[b]->vMins + d.aButtons[b]->vMaxs ) * 0.5f;
+                TWaypointId wB = CWaypoints::GetNearestWaypoint( vB, NULL, false, 256.0f );
+                if ( CWaypoint::IsValid( wB ) && Reaches( wB, t.wEntry ) )
+                    t.iButtonChoice = (int)b;
+            }
+        }
+        const sgtls::CBspEntity* pButtonDef = d.pButton;
+        if ( t.iButtonChoice >= 0 && t.iButtonChoice < (int)d.aButtons.size() && !d.bMomentary )
+        {
+            pButtonDef = d.aButtons[ t.iButtonChoice ];
+            it = aBrushes.find( pButtonDef->Get( "model" ) );
+            t.pButton = ( it == aBrushes.end() ) ? NULL : it->second;
+        }
+        Vector vButton = ( pButtonDef->vMins + pButtonDef->vMaxs ) * 0.5f;
+        t.wButton = CWaypoints::GetNearestWaypoint( vButton, NULL, false, 256.0f );
+        // A transporter booth: its button is inside, on a wall (the nearest waypoint can be behind that wall).
+        if ( d.bMomentary && !d.bRing && CWaypoint::IsValid( t.wEntry ) )
+            t.wButton = t.wEntry;
+        // Out of the fires' reach (tls_stargate_atlantis_fixed: a torch burns 46 units from the Goa'uld DHD).
+        t.wButtonSafe = t.wButton;
+        if ( CWaypoint::IsValid( t.wButton ) && !d.bMomentary &&
+             sgtls::InFireBox( CWaypoints::Get( t.wButton ).vOrigin, 12.0f ) )
+        {
+            good::vector<TWaypointId> aNear;
+            CWaypoints::GetNearestWaypoints( aNear, vButton, false, 256.0f );
+            float fBest = 1e18f;
+            for ( int k = 0; k < aNear.size(); ++k )
+            {
+                const Vector& v = CWaypoints::Get( aNear[k] ).vOrigin;
+                float fDist = v.DistToSqr( vButton );
+                if ( fDist < fBest && !sgtls::InFireBox( v, 12.0f ) )
+                {
+                    fBest = fDist;
+                    t.wButtonSafe = aNear[k];
+                }
+            }
+        }
+    }
+
+    // Doors that bots open: their entities (a round restart can recreate them).
+    const std::vector<sgtls::CButtonDoor>& aDoorDefs = sgtls::ButtonDoors();
+    if ( !bSameMap || m_aDoors.size() != aDoorDefs.size() )
+    {
+        m_aDoors.clear();
+        m_aDoors.resize( aDoorDefs.size() );
+    }
+    for ( size_t i = 0; i < aDoorDefs.size(); ++i )
+    {
+        CDoor& d = m_aDoors[i];
+        std::map<std::string, edict_t*>::const_iterator it = aBrushes.find( aDoorDefs[i].pDoor->Get( "model" ) );
+        d.pDoor = ( it == aBrushes.end() ) ? NULL : it->second;
+        d.aButtons.clear();
+        for ( size_t b = 0; b < aDoorDefs[i].aButtons.size(); ++b )
+        {
+            it = aBrushes.find( aDoorDefs[i].aButtons[b]->Get( "model" ) );
+            if ( it != aBrushes.end() )
+                d.aButtons.push_back( it->second );
+        }
+    }
+}
