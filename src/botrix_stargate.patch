+int sgtls::CObjectives::TeleporterOnPath( TWaypointId iCurrent, TWaypointId iNext, TWaypointId iAfterNext )
+{
+    Refresh();
+    const std::vector<sgtls::CButtonTeleporter>& aDefs = sgtls::ButtonTeleporters();
+    for ( size_t i = 0; i < m_aTeleporters.size() && i < aDefs.size(); ++i )
+    {
+        const CTeleporter& t = m_aTeleporters[i];
+        if ( !CWaypoint::IsValid( t.wEntry ) || !t.pTeleporter || !t.pButton )
+            continue;
+        bool bTaken = ( iCurrent == t.wEntry && iNext == t.wExit ) ||
+                      ( iNext == t.wEntry && iCurrent != t.wEntry && ( !aDefs[i].bMomentary || iAfterNext == t.wExit ) );
+        if ( bTaken )
+            return (int)i;
+    }
+    return -1;
+}
