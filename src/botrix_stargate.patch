+
+edict_t* sgtls::CObjectives::TeleporterButton( int iTeleporter, const Vector& vEye, Vector& vButton, TWaypointId& wButton )
+{
+    if ( iTeleporter < 0 || iTeleporter >= (int)m_aTeleporters.size() )
+        return NULL;
+    const CTeleporter& t = m_aTeleporters[iTeleporter];
+    if ( !t.pButton || t.pButton->IsFree() )
+        return NULL;
+    ICollideable* pColl = t.pButton->GetCollideable();
+    Vector vMins = pColl->GetCollisionOrigin() + pColl->OBBMins(), vMaxs = pColl->GetCollisionOrigin() + pColl->OBBMaxs();
+    for ( int i = 0; i < 3; ++i )
+    {
+        float fMargin = ( vMaxs[i] - vMins[i] ) * 0.5f;
+        if ( fMargin > 4.0f )
+            fMargin = 4.0f;
+        vButton[i] = clamp( vEye[i], vMins[i] + fMargin, vMaxs[i] - fMargin );
+    }
+    wButton = ( sgtls::Feature( sgtls::FeatFires ) && CWaypoint::IsValid( t.wButtonSafe ) ) ? t.wButtonSafe : t.wButton;
+    return t.pButton;
+}
