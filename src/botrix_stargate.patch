+const std::vector<sgtls::CLaser>& sgtls::DamagingLasers()
+{
+    const std::vector<CBspEntity>& aEnts = BspEntities();
+    if ( m_sLasersMap == m_sEntitiesMap )
+        return m_aLasers;
+    m_sLasersMap = m_sEntitiesMap;
+    m_aLasers.clear();
+    m_aLaserEdicts.clear();
+    for ( size_t i = 0; i < aEnts.size(); ++i )
+    {
+        const CBspEntity& e = aEnts[i];
+        if ( strcmp( e.Get( "classname" ), "env_laser" ) != 0 || atof( e.Get( "damage", "0" ) ) <= 0.0f )
+            continue;
+        const char* szTarget = e.Get( "LaserTarget" );
+        for ( size_t t = 0; szTarget[0] && t < aEnts.size(); ++t )
+            if ( strcmp( aEnts[t].Get( "targetname" ), szTarget ) == 0 )
+            {
+                CLaser l = { &e, e.vOrigin, aEnts[t].vOrigin };
+                m_aLasers.push_back( l );
+                break;
+            }
+    }
+    m_aLaserEdicts.assign( m_aLasers.size(), (edict_t*)NULL );
+    return m_aLasers;
+}
