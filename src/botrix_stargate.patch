+#ifdef BOTRIX_SGTC2
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "clients.h"
+#include "players.h"
+
+#include "mods/sgtc2/bot_sgtc2.h"
+#include "mods/sgtc2/stargates_sgtc2.h"
+
+#include "iplayerinfo.h"
+#include "edict.h"
+#include "iserverunknown.h"
+
+
+namespace
+{
+    // Classes bots may pick, by team. "anubis" is left out: the server refused it to a bot.
+    const char* aGoauldClasses[] = { "horus", "jaffa", "serpent" };
+    const char* aTauriClasses[] = { "soldier", "jackson", "tealc", "carter", "oneill" };
+
+    int CountPlayers( TTeam iTeam, edict_t* pSkip )
+    {
+        int iCount = 0;
+        for ( int i = 0; i < CPlayers::Size(); ++i )
+        {
+            CPlayer* pPlayer = CPlayers::Get( i );
+            if ( pPlayer && pPlayer->GetEdict() != pSkip && pPlayer->GetTeam() == iTeam )
+                ++iCount;
+        }
+        return iCount;
+    }
+
+    // Players of a team playing a class, known by their model (models/players/<model>.mdl).
+    int CountClass( TTeam iTeam, const char* szClass, edict_t* pSkip )
+    {
+        const char* szModel = strcmp( szClass, "serpent" ) == 0 ? "snake" : szClass;
+        int iCount = 0;
+        for ( int i = 0; i < CPlayers::Size(); ++i )
+        {
+            CPlayer* pPlayer = CPlayers::Get( i );
+            if ( !pPlayer || pPlayer->GetEdict() == pSkip || pPlayer->GetTeam() != iTeam )
+                continue;
+            IServerEntity* pEntity = pPlayer->GetEdict()->GetIServerEntity();
+            const char* szPlayerModel = pEntity ? STRING( pEntity->GetModelName() ) : NULL;
+            if ( szPlayerModel && strstr( szPlayerModel, szModel ) )
+                ++iCount;
+        }
+        return iCount;
+    }
+
+    // The least played class of the team (random among equals), so that the packs are spread.
+    const char* BalancedClass( const char** aClasses, int iClasses, TTeam iTeam, edict_t* pSkip )
+    {
+        int iStart = rand() % iClasses, iBest = iStart, iBestCount = 1 << 30;
+        for ( int k = 0; k < iClasses; ++k )
+        {
+            int i = ( iStart + k ) % iClasses;
+            int iCount = CountClass( iTeam, aClasses[i], pSkip );
+            if ( iCount < iBestCount )
+            {
+                iBestCount = iCount;
+                iBest = i;
+            }
+        }
+        return aClasses[iBest];
+    }
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+TTeam CBot_SGTC2::TeamOfClass( const char* szClass )
+{
+    for ( int i = 0; i < sizeof(aGoauldClasses) / sizeof(aGoauldClasses[0]); ++i )
+        if ( strcmp( szClass, aGoauldClasses[i] ) == 0 )
+            return ETeamGoauld;
+    if ( strcmp( szClass, "anubis" ) == 0 )
+        return ETeamGoauld;
+    for ( int i = 0; i < sizeof(aTauriClasses) / sizeof(aTauriClasses[0]); ++i )
+        if ( strcmp( szClass, aTauriClasses[i] ) == 0 )
+            return ETeamTauri;
+    return -1;
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+CBot_SGTC2::CBot_SGTC2( edict_t* pEdict, TBotIntelligence iIntelligence, TTeam iTeam, const char* szClass ):
+    CBot_HL2DM( pEdict, iIntelligence ), m_iGateAction( sgtc2::EGateActionNone ), m_iGateStamp( -1 ),
+    m_fStrandedTime( 0.0f ), m_bCarrier( false ), m_iBaseIntelligence( -1 ), m_fWalkStart( 0.0f ), m_fWalkCheckDistance( 0.0f ),
+    m_fNoWalkUntil( 0.0f ), m_iWantedTeam( iTeam ), m_szWantedClass( szClass ), m_fNextJoinCommand( 0.0f ),
+    m_iJoinTries( 0 )
+{
+    if ( m_iWantedTeam != ETeamGoauld && m_iWantedTeam != ETeamTauri )
+        m_iWantedTeam = -1;
+    // Staff and Zat'arc shots explode: never shoot an obstacle in the way.
+    m_bDontBreakObjects = true;
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+TTeam CBot_SGTC2::ChooseTeam() const
+{
+    if ( m_iWantedTeam != -1 )
+        return m_iWantedTeam;
+    int iGoauld = CountPlayers( ETeamGoauld, m_pEdict );
+    int iTauri = CountPlayers( ETeamTauri, m_pEdict );
+    if ( iGoauld != iTauri )
+        return iGoauld < iTauri ? ETeamGoauld : ETeamTauri;
+    return ( rand() & 1 ) ? ETeamGoauld : ETeamTauri;
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+int sgtc2::iTauriSkillBonus = 0;
+
+bool CBot_SGTC2::CheckJoin()
+{
+    TTeam iTeam = m_pPlayerInfo->GetTeamIndex();
+    if ( iTeam == ETeamGoauld || iTeam == ETeamTauri )
+    {
+        // Optional handicap for the bots' weapon imbalance (Tau'ri rifles vs staff blasts), 0 by default; follows
+        // the console value live.
+        if ( m_iBaseIntelligence < 0 )
+            m_iBaseIntelligence = m_iIntelligence;
+        int iWanted = m_iBaseIntelligence + ( iTeam == ETeamTauri ? sgtc2::iTauriSkillBonus : 0 );
+        iWanted = iWanted < EBotPro ? iWanted : EBotPro;
+        if ( iWanted != m_iIntelligence )
+        {
+            m_iIntelligence = (TBotIntelligence)iWanted;
+            BLOG_I( "%s -> Tau'ri skill bonus: intelligence %d.", GetName(), m_iIntelligence );
+        }
+        return false;
+    }
+
+    if ( CBotrixPlugin::fTime < m_fNextJoinCommand )
+        return true;
+    m_fNextJoinCommand = CBotrixPlugin::fTime + 1.0f;
+
+    // The wanted class first, then the least played class of the chosen team; random after a refusal (a class can
+    // be refused, it would be the least played again).
+    const char* szClass = m_szWantedClass;
+    if ( !szClass || m_iJoinTries > 0 )
+    {
+        TTeam iTeam = ChooseTeam();
+        const char** aClasses = ( iTeam == ETeamGoauld ) ? aGoauldClasses : aTauriClasses;
+        int iClasses = ( iTeam == ETeamGoauld ) ? sizeof(aGoauldClasses) / sizeof(aGoauldClasses[0])
+                                                : sizeof(aTauriClasses) / sizeof(aTauriClasses[0]);
+        szClass = ( m_iJoinTries <= 1 ) ? BalancedClass( aClasses, iClasses, iTeam, m_pEdict )
+                                        : aClasses[ rand() % iClasses ];
+    }
+    ++m_iJoinTries;
+
+    char szCmd[32];
+    sprintf( szCmd, "set_%s", szClass );
+    ConsoleCommand( szCmd );
+    return true;
+}
+
