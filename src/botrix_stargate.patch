+    // Bot weapon settings of config.ini changed for the current map only, by weapon id: the values to put back.
+    struct CSavedWeapon
+    {
+        float fShotTime, fMinDistanceSqr, fMaxDistanceSqr;
+        TWeaponType iType;
+    };
+    std::map<int, CSavedWeapon> aSavedWeapons;
+
+    // <prefix>_mapweapon <weapon> [delay <ms>] [range <min> <max>] : the bots' use of a weapon (primary fire) on this
+    // map only, from cfg/botrix_<map>.cfg; config.ini's values come back at the next map. Without arguments: what is
+    // changed. The weapon itself doesn't change, for players.
+    void MapWeaponCommand( const CCommand& args )
+    {
+        if ( args.ArgC() < 2 )
+        {
+            for ( std::map<int, CSavedWeapon>::const_iterator it = aSavedWeapons.begin(); it != aSavedWeapons.end(); ++it )
+            {
+                const CWeapon* w = CWeapons::Get( it->first )->GetBaseWeapon();
+                Msg( "%s: delay %.0f ms, range %.0f %.0f (config.ini: %.0f ms, %.0f %.0f)\n", w->pWeaponClass->sClassName.c_str(),
+                     w->fShotTime[0] * 1000.0f, sqrtf( w->fMinDistanceSqr[0] ), sqrtf( w->fMaxDistanceSqr[0] ),
+                     it->second.fShotTime * 1000.0f, sqrtf( it->second.fMinDistanceSqr ), sqrtf( it->second.fMaxDistanceSqr ) );
+            }
+            return;
+        }
+        TWeaponId iId = CWeapons::GetIdFromWeaponName( args.Arg( 1 ) );
+        if ( !CWeapons::IsValid( iId ) )
+        {
+            Msg( "Unknown weapon: %s\n", args.Arg( 1 ) );
+            return;
+        }
+        CWeapon* w = const_cast<CWeapon*>( CWeapons::Get( iId )->GetBaseWeapon() );
+        CSavedWeapon cOld = { w->fShotTime[0], w->fMinDistanceSqr[0], w->fMaxDistanceSqr[0], w->iType };
+        for ( int i = 2; i < args.ArgC(); )
+        {
+            if ( strcmp( args.Arg( i ), "delay" ) == 0 && i + 1 < args.ArgC() )
+            {
+                w->fShotTime[0] = atoi( args.Arg( i + 1 ) ) / 1000.0f;
+                i += 2;
+            }
+            else if ( strcmp( args.Arg( i ), "range" ) == 0 && i + 2 < args.ArgC() )
+            {
+                int iMax = atoi( args.Arg( i + 2 ) );
+                w->fMinDistanceSqr[0] = SQR( (float)atoi( args.Arg( i + 1 ) ) );
+                w->fMaxDistanceSqr[0] = iMax ? SQR( (float)iMax ) : (float)CUtil::iMaxMapSizeSqr;
+                i += 3;
+            }
+            else if ( strcmp( args.Arg( i ), "type" ) == 0 && i + 1 < args.ArgC() &&
+                      ( strcmp( args.Arg( i + 1 ), "pistol" ) == 0 || strcmp( args.Arg( i + 1 ), "rifle" ) == 0 ) )
+            {
+                // "rifle": the bot holds the trigger for the delay and the game fires at its own rate; "pistol": one
+                // press per delay (StargateTC 2's sniper: its delay changed nothing as a rifle, 2026-11-04).
+                w->iType = strcmp( args.Arg( i + 1 ), "pistol" ) == 0 ? EWeaponPistol : EWeaponRifle;
+                i += 2;
+            }
+            else
+            {
+                Msg( "Usage: <weapon> [delay <ms>] [range <min> <max>] [type pistol|rifle]\n" );
+                return;
+            }
+        }
+        if ( !aSavedWeapons.count( iId ) )
+            aSavedWeapons[iId] = cOld;
+        Msg( "%s on this map: delay %.0f ms, range %.0f %.0f, %s\n", args.Arg( 1 ), w->fShotTime[0] * 1000.0f,
+             sqrtf( w->fMinDistanceSqr[0] ), sqrtf( w->fMaxDistanceSqr[0] ), w->iType == EWeaponPistol ? "pistol" : w->iType == EWeaponRifle ? "rifle" : "other type" );
+    }
+
+    // <prefix>_tp <entindex> <waypoint> : put a bot on a waypoint, to test the way from there (tls_erebus's temple).
+    void TpCommand( const CCommand& args )
+    {
+        if ( args.ArgC() < 3 )
+            return;
+        int iIndex = atoi( args.Arg( 1 ) );
+        TWaypointId w = atoi( args.Arg( 2 ) );
+        CPlayer* pPlayer = ( iIndex > 0 && iIndex <= CPlayers::Size() ) ? CPlayers::Get( iIndex - 1 ) : NULL;
+        IBotController* pController = pPlayer && pPlayer->IsBot() ? CBotrixPlugin::pBotManager->GetBotController( pPlayer->GetEdict() ) : NULL;
+        if ( !pController || !CWaypoints::IsValid( w ) )
+        {
+            Msg( "Usage: <bot entindex> <waypoint>\n" );
+            return;
+        }
+        Vector v = CWaypoints::Get( w ).vOrigin;
+        v.z -= CMod::GetVar( EModVarPlayerEye );
+        pController->SetAbsOrigin( v );
+        pPlayer->iCurrentWaypoint = EWaypointIdInvalid;
+        Msg( "%s put on waypoint %d.\n", pPlayer->GetName(), w );
+    }
+}
