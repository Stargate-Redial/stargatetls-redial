+bool sgtls::SetFeature( const char* szName, bool bOn )
+{
+    bool bFound = false;
+    for ( int i = 0; i < iFeatureCount; ++i )
+        if ( strcmp( szName, aFeatureNames[i] ) == 0 || strcmp( szName, "all" ) == 0 )
+        {
+            bFound = true;
+            if ( bOn )
+                iFeatures |= ( 1 << i );
+            else
+                iFeatures &= ~( 1 << i );
+        }
+    return bFound;
+}
