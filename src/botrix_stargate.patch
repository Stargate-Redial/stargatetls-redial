+// Outside the namespaces: BLOG declares the log buffer in the enclosing one.
+static void LogGateDepth( const char* szName, int iSide, int iAxis, float fDepth )
+{
+    BLOG_I( "Gate %s: from its %s%c side, a traveller whose hull touches the plane less than %.1f units deep arrives in "
+            "a kill teleporter; bots time their steps.", szName, iSide ? "+" : "-", iAxis ? 'y' : 'x', fDepth );
+}
