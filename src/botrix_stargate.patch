+
+void sgtls::CObjectives::Print()
+{
+    Refresh();
+    Msg( "game time %.1f s\n", CBotrixPlugin::fTime );
+    for ( size_t a = 0; a < m_aSpots.size(); ++a )
+    {
+        const CSpot& c = m_aSpots[a];
+        Msg( "%s %d: center %.0f %.0f %.0f, attackers %d, owner %d, objective %s order %d enabled %d -> %s, "
+             "%d waypoints inside, %d near\n", c.bButton ? "button" : "area", (int)a, c.vCenter.x, c.vCenter.y,
+             c.vCenter.z, Attackers( c ), c.bButton ? -1 : sgtls::GetInt( c.pEdict, "m_iNetOwnerTeam", 0 ),
+             c.pObjective ? "yes" : "no", Order( c ), c.pObjective ? GetByte( c.pObjective, "m_bEnabled" ) : -1,
+             IsActive( c ) ? "ACTIVE" : "inactive", (int)c.aInside.size(), (int)c.aNear.size() );
+    }
+    const std::vector<sgtls::CButtonTeleporter>& aDefs = sgtls::ButtonTeleporters();
+    for ( size_t i = 0; i < m_aTeleporters.size() && i < aDefs.size(); ++i )
+    {
+        CTeleporter& t = m_aTeleporters[i];
+        bool bOn = IsOn( t );
+        Msg( "teleporter %d: %s (%s, edict %d), button %s (%s, edict %d) x%d, on %.1f s after%s, kawoosh wait %.0f s, "
+             "link %d -> %d, button waypoint %d: %s\n", (int)i, aDefs[i].pTeleporter->Get( "targetname" ), aDefs[i].pTeleporter->Get( "model" ),
+             t.pTeleporter ? CBotrixPlugin::pEngineServer->IndexOfEdict( t.pTeleporter ) : -1,
+             aDefs[i].pButton->Get( "targetname" ), aDefs[i].pButton->Get( "model" ),
+             t.pButton ? CBotrixPlugin::pEngineServer->IndexOfEdict( t.pButton ) : -1, aDefs[i].iPresses,
+             aDefs[i].fDelay, aDefs[i].bMomentary ? " for a moment" : "", aDefs[i].fKawoosh, t.wEntry, t.wExit, t.wButton, bOn ? "ON" : "off" );
+        if ( aDefs[i].aButtons.size() > 1 )
+            Msg( "  %d buttons turn it on; used: %s\n", (int)aDefs[i].aButtons.size(),
+                 ( t.iButtonChoice >= 0 && t.iButtonChoice < (int)aDefs[i].aButtons.size() )
+                 ? aDefs[i].aButtons[ t.iButtonChoice ]->Get( "targetname" ) : "the nearest (none reaches the entry)" );
+    }
+    const std::vector<sgtls::CButtonDoor>& aDoorDefs = sgtls::ButtonDoors();
+    for ( size_t i = 0; i < m_aDoors.size() && i < aDoorDefs.size(); ++i )
+    {
+        const sgtls::CButtonDoor& def = aDoorDefs[i];
+        Vector vCenter = ( def.pDoor->vMins + def.pDoor->vMaxs ) * 0.5f;
+        // Open or closed: a line across it, 40 units each side along its thin axis, at eye level above its bottom.
+        Vector a = vCenter, b = vCenter;
+        a[def.iAxis] -= 40.0f;
+        b[def.iAxis] += 40.0f;
+        a.z = b.z = def.pDoor->vMins.z + CMod::GetVar( EModVarPlayerEye );
+        Msg( "door %d: %s %s (%s, edict %d) at %.0f %.0f %.0f, %d panels (%d found)%s%s, %s\n", (int)i,
+             def.pDoor->Get( "classname" ), def.pDoor->Get( "targetname" ), def.pDoor->Get( "model" ),
+             m_aDoors[i].pDoor ? CBotrixPlugin::pEngineServer->IndexOfEdict( m_aDoors[i].pDoor ) : -1,
+             vCenter.x, vCenter.y, vCenter.z, (int)def.aButtons.size(), (int)m_aDoors[i].aButtons.size(),
+             def.bUseOpens ? ", +use" : "", def.bTouchOpens ? ", touch" : "",
+             DoorBlocks( (int)i, a, b ) ? "closed" : "open" );
+    }
+}
diff --git a/mods/sgtls/objectives_sgtls.h b/mods/sgtls/objectives_sgtls.h
new file mode 100644
index 0000000..6233692
--- /dev/null
+++ b/mods/sgtls/objectives_sgtls.h
@@ -0,0 +1,120 @@
+#ifndef __BOTRIX_OBJECTIVES_SGTLS_H__
+#define __BOTRIX_OBJECTIVES_SGTLS_H__
+
+// Stargate: The Last Stand objectives, read from the game entities:
+// - trigger_tls_capture_area (CDHCaptureArea): m_bTeam2CanCap / m_bTeam3CanCap, m_iNetOwnerTeam.
+// - info_tls_objective (CGameObjective): m_bEnabled, m_iOrder. Each one sits in a capture area.
+// The attackers are the team that can capture; the defenders are the other one.
+
+#include "types.h"
+#include "vector.h" // public/ (episode1) or public/mathlib/ (Orange Box)
+
+struct edict_t;
+
+namespace sgtls
+{
+    class CObjectives
+    {
+    public:
+        /// Rebuild the area list if the map or the waypoints changed. Cheap otherwise.
+        static void Refresh();
+
+        /// Log the orders of the active objectives when they change (how far the attackers got, balance tests).
+        static void LogStage();
+
+        /// Times the active objectives changed (LogStage, checked every second): bots compare it to drop a destination
+        /// picked for a stage that is over.
+        static int StageChanges();
+
+        /// Waypoint where a bot of iTeam should go now (attack or defend an active area),
+        /// EWaypointIdInvalid if the map has no active area. pSpot is the bot's spot, kept between calls: an
+        /// attacker stays on it while it is active.
+        static TWaypointId PickWaypoint( TTeam iTeam, edict_t*& pSpot );
+
+        /// True if pSpot is an active spot that iTeam attacks.
+        static bool IsAttacking( TTeam iTeam, edict_t* pSpot );
+
+        /// True if pSpot is an active spot that iTeam defends.
+        static bool IsDefending( TTeam iTeam, edict_t* pSpot );
+
+        /// True if pSpot is the button of an active hold-button objective that iTeam defends. vButton receives its
+        /// center: what a defender at a guard spot watches.
+        static bool IsButtonToGuard( TTeam iTeam, edict_t* pSpot, Vector& vButton );
+
+        /// A player started holding a button from vEye (capture_start): its defenders will watch that place.
+        static void NoteCapture( const Vector& vEye );
+
+        /// True if w is a guard spot (not a place at the button) of pSpot, an active button that iTeam defends. vLook
+        /// receives the place to watch from there: the one under threat if w sees it, else one it sees.
+        static bool GuardSpotLook( TTeam iTeam, edict_t* pSpot, TWaypointId w, Vector& vLook );
+
+        /// Distance from v to the spot (0 inside its box), a big number for an unknown spot.
+        static float DistanceToSpot( edict_t* pSpot, const Vector& v );
+
+        /// Button of an active hold-button objective that iTeam attacks, near vEye (130 units), NULL if none.
+        /// vButton receives its nearest point.
+        static edict_t* GetButtonToHold( TTeam iTeam, const Vector& vEye, Vector& vButton );
+
+        /// Button-operated teleporter (sgtls::ButtonTeleporters) whose link a bot is about to take: iNext is its entry
+        /// waypoint, or iCurrent its entry and iNext its exit. A transporter booth (momentary), whose entry bots also
+        /// walk through: only when the path takes the link (iNext the entry and iAfterNext the exit). -1 if none.
+        static int TeleporterOnPath( TWaypointId iCurrent, TWaypointId iNext, TWaypointId iAfterNext );
+
+        /// True once the teleporter has been on long enough to walk in (a stargate: after its kawoosh).
+        static bool TeleporterReady( int iTeleporter );
+
+        /// True if w is the entry of a button-operated gate (not a transporter booth) that isn't ready: off, in its
+        /// kawoosh, or dialed from the other side (its plane then sends to the killbox).
+        static bool GateEntryClosed( TWaypointId w );
+
+        /// True if w is the entry of a button-operated gate (not a transporter booth).
+        static bool IsGateEntry( TWaypointId w );
+
+        /// The gate a bot walks into now: its entry is the current or next waypoint, it is ready, and it has a depth
+        /// to keep (sgtls::CButtonTeleporter::fSafeDepth). Index in sgtls::ButtonTeleporters(), -1 if none.
+        static int GateToCross( TWaypointId wCurrent, TWaypointId wNext );
+
+        /// A ready gate (not a booth) whose entry is the current or next waypoint, -1 if none.
+        static int ReadyGate( TWaypointId wCurrent, TWaypointId wNext );
+
+        /// Places (trigger center, destination) of the gates (not booths) that are on and past their kawoosh.
+        static void OpenGatePlaces( std::vector<Vector>& aPlaces );
+
+        /// Rings: their station is working (its floor open, its rings up or moving, at either end). They crush
+        /// (func_train, dmg 1000) whoever stands in their way: tls_sandfort_beta3, 24 bots in 3 minutes.
+        static bool RingsActive( int iTeleporter );
+
+        /// Button of the teleporter, NULL if not found. vButton receives its nearest point to vEye (4 units inside),
+        /// wButton the waypoint next to it.
+        static edict_t* TeleporterButton( int iTeleporter, const Vector& vEye, Vector& vButton, TWaypointId& wButton );
+
+        /// Press the teleporter's button for pActivator, unless the teleporter is on or the button was pressed less
+        /// than 0.5 s ago (by any bot: it ignores presses while it comes back). True if pressed.
+        static bool PressTeleporterButton( int iTeleporter, edict_t* pActivator );
+        /// Diagnostic (sgtls_hurtlog 1): log each teleporter turning on / off, with the time.
+        static void DiagTeleporters();
+
+        /// A door that bots open (sgtls::ButtonDoors), not opened by a touch, whose closed position is within fNear of
+        /// vFrom and that stands between vFrom and vTo (eye level) now. Its index, -1 if none.
+        static int ClosedDoorOnPath( const Vector& vFrom, const Vector& vTo, float fNear );
+
+        /// True if the door is between vFrom and vTo (eye level): closed, or not open enough to walk through.
+        static bool DoorBlocks( int iDoor, const Vector& vFrom, const Vector& vTo );
+
+        /// The door's world box as it is now (it moves while it opens): false if its entity is gone.
+        static bool DoorWorldBox( int iDoor, Vector& vMins, Vector& vMaxs );
+
+        /// What opens the door from vEye's side: its nearest panel (func_button) on that side, or the door itself if
+        /// +use opens it (bDoorItself). NULL if neither. vOpener receives its nearest point to vEye (4 units inside).
+        static edict_t* DoorOpener( int iDoor, const Vector& vEye, Vector& vOpener, bool& bDoorItself );
+
+        /// Press a panel of the door for pActivator, unless one was pressed for it less than a second ago (by any bot).
+        /// True if pressed.
+        static bool PressDoorButton( int iDoor, edict_t* pButton, edict_t* pActivator );
+
+        /// Print the areas and their state (sgtls_objectives command).
+        static void Print();
+    };
+}
+
+#endif // __BOTRIX_OBJECTIVES_SGTLS_H__
diff --git a/mods/sgtls/sgtls_hooks.cpp b/mods/sgtls/sgtls_hooks.cpp
new file mode 100644
index 0000000..19a7c94
--- /dev/null
+++ b/mods/sgtls/sgtls_hooks.cpp
@@ -0,0 +1,302 @@
+// Crash guards for Stargate: The Last Stand's server.dll (closed source, image base 0x10000000).
+//
+// CTLSPlayer::EntSelectSpawnPoint (vtable slot 0x550, server.dll 0x10244870) asks the player's team for a spawn
+// point. The "unassigned" team has none on some maps (tls_erebus), so it returns NULL, and the caller
+// (0x10131db0) dereferences it: crash when a bot connects (bots spawn before choosing a team). The hook falls back
+// to what the function does for spectators: the first info_player_teamspawn.
+// A second guard, in the same hook: CTeam::SpawnPlayer (server.dll 0x101feb60, server_i486.so 0x801040) loops for
+// ever when no spawn point of the team is valid (all disabled, or a player within 16 units of each) and its random
+// start index is 0: the server hangs (found by the "Waypoints" session on 2026-11-10, with gdb on a frozen
+// tls_stargate_beta1: 3 Goa'uld spawns, 6 bots joining; humans can hit it too). Before asking the team, the hook
+// checks its spawns with their own IsValid (vtable); if none is valid, it returns the first enabled one (players then
+// stand on each other) instead of calling the game.
+#ifdef _WIN32
+
+#include <string.h>
+
+#include "tier0/dbg.h"
+
+extern "C" __declspec(dllimport) void* __stdcall GetModuleHandleA( const char* szModule );
+extern "C" __declspec(dllimport) int __stdcall VirtualProtect( void* pAddress, unsigned long iSize, unsigned long iNew,
+                                                               unsigned long* pOld );
+
+namespace
+{
+    const unsigned int iImageBase = 0x10000000;
+    const unsigned int iPlayerVtable = 0x1039398c;      // CTLSPlayer vtable.
+    const unsigned int iSlotSelectSpawn = 0x550;
+    const unsigned int iSelectSpawnFn = 0x10244870;     // Expected content of the slot (checks the binary).
+    const unsigned int iFindByClassnameFn = 0x10100ff0; // CGlobalEntityList::FindEntityByClassname (thiscall).
+    const unsigned int iEntityList = 0x10440d28;        // gEntList.
+    const unsigned int iGetTeamFn = 0x100b0520;         // CBaseEntity::GetTeam (thiscall).
+    const unsigned int iGetTeamNumberFn = 0x100b05b0;   // CBaseEntity::GetTeamNumber (thiscall).
+    const unsigned int iTeams = 0x10469de0;             // g_Teams (CUtlVector<CTeam*>): elements, then the size at +0xc.
+    const int iTeamSpawns = 0x300, iTeamSpawnCount = 0x30c; // CTeam::m_aSpawnPoints (CUtlVector), its size.
+    const int iSpawnDisabled = 0x318;                   // CTeamSpawnPoint::m_bDisabled (compared as a dword).
+    const int iSlotIsValid = 0x2b4;                     // CTeamSpawnPoint::IsValid( CBasePlayer* ).
+
+    char* m_pBase = NULL;
+    void** m_pSlot = NULL;
+    void* m_pOriginal = NULL;
+
+    // thiscall emulated with fastcall: ecx = this, edx unused.
+    typedef void* ( __fastcall *TSelectSpawn )( void* pThis, void* pEdx );
+    typedef void* ( __fastcall *TFindByClassname )( void* pThis, void* pEdx, void* pStart, const char* szName );
+
+    void* FindByClassname( const char* szClassname )
+    {
+        TFindByClassname pFind = (TFindByClassname)( m_pBase + ( iFindByClassnameFn - iImageBase ) );
+        return pFind( m_pBase + ( iEntityList - iImageBase ), NULL, NULL, szClassname );
+    }
+
+    typedef void* ( __fastcall *TGetTeam )( void* pThis, void* pEdx );
+    typedef int ( __fastcall *TGetTeamNumber )( void* pThis, void* pEdx );
+    typedef bool ( __fastcall *TIsValid )( void* pThis, void* pEdx, void* pPlayer );
+
+    void* GlobalTeam( int i )
+    {
+        char* pTeams = m_pBase + ( iTeams - iImageBase );
+        if ( i < 0 || i >= *(int*)( pTeams + 0xc ) )
+            return NULL;
+        return ( *(void***)pTeams )[i];
+    }
+
+    // The team's first enabled spawn (else its first) if none of its spawns is valid for pPlayer, else NULL.
+    void* NoValidSpawn( void* pTeam, void* pPlayer )
+    {
+        if ( !pTeam )
+            return NULL;
+        int iCount = *(int*)( (char*)pTeam + iTeamSpawnCount );
+        void** aSpawns = *(void***)( (char*)pTeam + iTeamSpawns );
+        if ( iCount <= 0 || !aSpawns )
+            return NULL; // The game returns NULL itself, handled after the call.
+        void* pEnabled = NULL;
+        for ( int i = 0; i < iCount; ++i )
+        {
+            void* pSpawn = aSpawns[i];
+            if ( !pSpawn )
+                continue;
+            TIsValid pIsValid = (TIsValid)( *(void***)pSpawn )[ iSlotIsValid / 4 ];
+            if ( pIsValid( pSpawn, NULL, pPlayer ) )
+                return NULL;
+            if ( !pEnabled && *(int*)( (char*)pSpawn + iSpawnDisabled ) == 0 )
+                pEnabled = pSpawn;
+        }
+        return pEnabled ? pEnabled : aSpawns[0];
+    }
+
+    void* __fastcall SelectSpawnHook( void* pThis, void* pEdx )
+    {
+        int iTeam = ( (TGetTeamNumber)( m_pBase + ( iGetTeamNumberFn - iImageBase ) ) )( pThis, NULL );
+        void* pStuck = NULL;
+        if ( iTeam >= 2 )
+            pStuck = NoValidSpawn( ( (TGetTeam)( m_pBase + ( iGetTeamFn - iImageBase ) ) )( pThis, NULL ), pThis );
+        else if ( iTeam == 0 ) // The game picks team 2 or 3 at random for an unassigned player.
+        {
+            pStuck = NoValidSpawn( GlobalTeam( 2 ), pThis );
+            if ( !pStuck )
+                pStuck = NoValidSpawn( GlobalTeam( 3 ), pThis );
+        }
+        if ( pStuck )
+        {
+            Msg( "[Botrix] sgtls: no free spawn point for a player of team %d, put on an occupied one.\n", iTeam );
+            return pStuck;
+        }
+        void* pSpawn = ( (TSelectSpawn)m_pOriginal )( pThis, pEdx );
+        if ( !pSpawn )
+        {
+            // During a round restart the spawn points don't exist yet: last resort, the world (always there).
+            pSpawn = FindByClassname( "info_player_teamspawn" );
+            if ( !pSpawn )
+                pSpawn = FindByClassname( "worldspawn" );
+            Msg( "[Botrix] sgtls: no spawn point for a player, fallback %p.\n", pSpawn );
+        }
+        return pSpawn;
+    }
+
+    bool WriteSlot( void* pValue )
+    {
+        unsigned long iOld = 0;
+        if ( !VirtualProtect( m_pSlot, sizeof(void*), 0x04 /* PAGE_READWRITE */, &iOld ) )
+            return false;
+        *m_pSlot = pValue;
+        VirtualProtect( m_pSlot, sizeof(void*), iOld, &iOld );
+        return true;
+    }
+}
+
+namespace sgtls
+{
+    void InstallHooks()
+    {
+        m_pBase = (char*)GetModuleHandleA( "server.dll" );
+        if ( !m_pBase || m_pOriginal )
+            return;
+        m_pSlot = (void**)( m_pBase + ( iPlayerVtable - iImageBase ) + iSlotSelectSpawn );
+        if ( *m_pSlot != m_pBase + ( iSelectSpawnFn - iImageBase ) )
+        {
+            Msg( "[Botrix] sgtls: unknown server.dll, spawn point guard not installed.\n" );
+            return;
+        }
+        m_pOriginal = *m_pSlot;
+        if ( WriteSlot( (void*)SelectSpawnHook ) )
+            Msg( "[Botrix] sgtls: spawn point guard installed.\n" );
+        else
+            m_pOriginal = NULL;
+    }
+
+    void RemoveHooks()
+    {
+        if ( m_pOriginal && WriteSlot( m_pOriginal ) )
+            m_pOriginal = NULL;
+    }
+
+    bool HasSpawnPoints()
+    {
+        return !m_pOriginal || FindByClassname( "info_player_teamspawn" ) != NULL; // Unknown binary: don't block.
+    }
+}
+
+#elif defined(__linux__)
+
+// Linux: the same guard in server_i486.so, found by name (linux_server.cpp). GCC's thiscall is cdecl with this
+// first.
+
+#include "tier0/dbg.h"
+#include "mods/sgtls/sgtls_util.h"
+
+namespace
+{
+    void** m_pSlot = NULL;
+    void* m_pOriginal = NULL;
+    void* m_pEntityList = NULL;
+
+    typedef void* ( *TSelectSpawn )( void* pThis );
+    typedef void* ( *TFindByClassname )( void* pThis, void* pStart, const char* szName );
+    TFindByClassname m_pfnFindByClassname = NULL;
+    typedef void* ( *TGetTeam )( void* pThis );
+    typedef int ( *TGetTeamNumber )( void* pThis );
+    typedef void* ( *TGetGlobalTeam )( int iIndex );
+    typedef bool ( *TIsValid )( void* pThis, void* pPlayer );
+    TGetTeam m_pfnGetTeam = NULL;
+    TGetTeamNumber m_pfnGetTeamNumber = NULL;
+    TGetGlobalTeam m_pfnGetGlobalTeam = NULL;
+    const int iTeamSpawns = 0x314, iTeamSpawnCount = 0x320; // CTeam::m_aSpawnPoints (CUtlVector), its size.
+    const int iSpawnDisabled = 0x32c;                   // CTeamSpawnPoint::m_bDisabled (compared as a dword).
+    const int iSlotIsValid = 0x2b8;                     // CTeamSpawnPoint::IsValid( CBasePlayer* ).
+
+    // The team's first enabled spawn (else its first) if none of its spawns is valid for pPlayer, else NULL.
+    void* NoValidSpawn( void* pTeam, void* pPlayer )
+    {
+        if ( !pTeam )
+            return NULL;
+        int iCount = *(int*)( (char*)pTeam + iTeamSpawnCount );
+        void** aSpawns = *(void***)( (char*)pTeam + iTeamSpawns );
+        if ( iCount <= 0 || !aSpawns )
+            return NULL;
+        void* pEnabled = NULL;
+        for ( int i = 0; i < iCount; ++i )
+        {
+            void* pSpawn = aSpawns[i];
+            if ( !pSpawn )
+                continue;
+            TIsValid pIsValid = (TIsValid)( *(void***)pSpawn )[ iSlotIsValid / 4 ];
+            if ( pIsValid( pSpawn, pPlayer ) )
+                return NULL;
+            if ( !pEnabled && *(int*)( (char*)pSpawn + iSpawnDisabled ) == 0 )
+                pEnabled = pSpawn;
+        }
+        return pEnabled ? pEnabled : aSpawns[0];
+    }
+
+    void* FindByClassname( const char* szClassname )
+    {
+        return m_pfnFindByClassname( m_pEntityList, NULL, szClassname );
+    }
+
+    void* SelectSpawnHook( void* pThis )
+    {
+        if ( m_pfnGetTeam && m_pfnGetTeamNumber && m_pfnGetGlobalTeam )
+        {
+            int iTeam = m_pfnGetTeamNumber( pThis );
+            void* pStuck = NULL;
+            if ( iTeam >= 2 )
+                pStuck = NoValidSpawn( m_pfnGetTeam( pThis ), pThis );
+            else if ( iTeam == 0 ) // The game picks team 2 or 3 at random for an unassigned player.
+            {
+                pStuck = NoValidSpawn( m_pfnGetGlobalTeam( 2 ), pThis );
+                if ( !pStuck )
+                    pStuck = NoValidSpawn( m_pfnGetGlobalTeam( 3 ), pThis );
+            }
+            if ( pStuck )
+            {
+                Msg( "[Botrix] sgtls: no free spawn point for a player of team %d, put on an occupied one.\n", iTeam );
+                return pStuck;
+            }
+        }
+        void* pSpawn = ( (TSelectSpawn)m_pOriginal )( pThis );
+        if ( !pSpawn )
+        {
+            // During a round restart the spawn points don't exist yet: last resort, the world (always there).
+            pSpawn = FindByClassname( "info_player_teamspawn" );
+            if ( !pSpawn )
+                pSpawn = FindByClassname( "worldspawn" );
+            Msg( "[Botrix] sgtls: no spawn point for a player, fallback %p.\n", pSpawn );
+        }
+        return pSpawn;
+    }
+}
+
+namespace sgtls
+{
+    void InstallHooks()
+    {
+        if ( m_pOriginal )
+            return;
+        // The vtable symbol starts with offset-to-top and the typeinfo: the slots follow.
+        void** pVtable = (void**)ServerSymbol( "_ZTV10CTLSPlayer" );
+        void* pSelectSpawn = ServerSymbol( "_ZN10CTLSPlayer19EntSelectSpawnPointEv" );
+        m_pfnFindByClassname =
+            (TFindByClassname)ServerSymbol( "_ZN17CGlobalEntityList21FindEntityByClassnameEP11CBaseEntityPKc" );
+        m_pEntityList = ServerSymbol( "gEntList" );
+        // The free spawn check (CTeam::SpawnPlayer's endless loop): off if one is missing.
+        m_pfnGetTeam = (TGetTeam)ServerSymbol( "_ZNK11CBaseEntity7GetTeamEv" );
+        m_pfnGetTeamNumber = (TGetTeamNumber)ServerSymbol( "_ZNK11CBaseEntity13GetTeamNumberEv" );
+        m_pfnGetGlobalTeam = (TGetGlobalTeam)ServerSymbol( "_Z13GetGlobalTeami" );
+        int iSlot = ( pVtable && pSelectSpawn ) ? VtableSlot( pVtable + 2, pSelectSpawn ) : -1;
+        if ( iSlot < 0 || !m_pfnFindByClassname || !m_pEntityList )
+        {
+            Msg( "[Botrix] sgtls: unknown server .so, spawn point guard not installed.\n" );
+            return;
+        }
+        m_pSlot = pVtable + 2 + iSlot;
+        m_pOriginal = *m_pSlot;
+        void* pHook = (void*)SelectSpawnHook;
+        if ( WriteCode( m_pSlot, &pHook, sizeof(pHook) ) )
+            Msg( "[Botrix] sgtls: spawn point guard installed (vtable slot %d).\n", iSlot );
+        else
+            m_pOriginal = NULL;
+    }
+
+    void RemoveHooks()
+    {
+        if ( m_pOriginal && WriteCode( m_pSlot, &m_pOriginal, sizeof(m_pOriginal) ) )
+            m_pOriginal = NULL;
+    }
+
+    bool HasSpawnPoints()
+    {
+        return !m_pOriginal || FindByClassname( "info_player_teamspawn" ) != NULL; // Unknown binary: don't block.
+    }
+}
+
+#else
+
+namespace sgtls
+{
+    void InstallHooks() {}
+    void RemoveHooks() {}
+    bool HasSpawnPoints() { return true; }
+}
+
+#endif
diff --git a/mods/sgtls/sgtls_map.cpp b/mods/sgtls/sgtls_map.cpp
new file mode 100644
index 0000000..1c173f2
--- /dev/null
+++ b/mods/sgtls/sgtls_map.cpp
@@ -0,0 +1,2610 @@
+#include <ctype.h>
+#include <math.h>
+#ifndef _WIN32
+#include <dirent.h>
+#include <strings.h>
+#endif
+#include <stdio.h>
+#include <string.h>
+#include <algorithm>
+#include <set>
+#include <string>
+
+#include "mod.h"
+#include "server_plugin.h"
+#include "source_engine.h"
+#include "waypoint.h"
+#include "mods/sgtls/sgtls_map.h"
+#include "mods/sgtls/sgtls_util.h"
+
+#include "eiface.h"
+#include "engine/IEngineTrace.h"
+#include "IStaticPropMgr.h"
+#include "players.h"
+#include "gametrace.h"
+
+// memdbgon must be the last include file in a .cpp file!!!
+#include "tier0/memdbgon.h"
+
+
+namespace
+{
+    std::vector<sgtls::CBspEntity> m_aEntities;
+    std::string m_sEntitiesMap;
+
+    // Point inside a box.
+    bool Inside( const Vector& v, const Vector& vMins, const Vector& vMaxs )
+    {
+        return v.x >= vMins.x && v.x <= vMaxs.x && v.y >= vMins.y && v.y <= vMaxs.y && v.z >= vMins.z && v.z <= vMaxs.z;
+    }
+
+    // Segment / box intersection (slab test).
+    bool SegmentHitsBox( const Vector& a, const Vector& b, const Vector& vMins, const Vector& vMaxs )
+    {
+        float t0 = 0.0f, t1 = 1.0f;
+        for ( int i = 0; i < 3; ++i )
+        {
+            float d = b[i] - a[i];
+            if ( fabs( d ) < 1e-6f )
+            {
+                if ( a[i] < vMins[i] || a[i] > vMaxs[i] )
+                    return false;
+                continue;
+            }
+            float u0 = ( vMins[i] - a[i] ) / d, u1 = ( vMaxs[i] - a[i] ) / d;
+            if ( u0 > u1 )
+                std::swap( u0, u1 );
+            t0 = std::max( t0, u0 );
+            t1 = std::min( t1, u1 );
+            if ( t0 > t1 )
+                return false;
+        }
+        return true;
+    }
+
+    // Eye-level waypoint position on the ground below / around v (v at eye level).
+    Vector GroundEye( Vector v )
+    {
+        float fEye = CMod::GetVar( EModVarPlayerEye );
+        Vector vGround = CUtil::GetHullGroundVec( v );
+        vGround.z += fEye;
+        return vGround;
+    }
+
+    // Cell of a 32 x 32 x 48 grid, for the fine search of a way out of an island.
+    long long CellKey( const Vector& v )
+    {
+        long long x = (long long)floor( v.x / 32.0f ) + 1000000, y = (long long)floor( v.y / 32.0f ) + 1000000;
+        long long z = (long long)floor( v.z / 48.0f ) + 100000;
+        return ( x * 2000000 + y ) * 200000 + z;
+    }
+
+    // Mark the paths between two waypoints (both ways, if they exist) as links that bots must not delete.
+    void KeepPaths( TWaypointId a, TWaypointId b )
+    {
+        CWaypointPath* pPath = CWaypoints::GetPath( a, b );
+        if ( pPath )
+            FLAG_SET( FPathKeep, pPath->iFlags );
+        pPath = CWaypoints::GetPath( b, a );
+        if ( pPath )
+            FLAG_SET( FPathKeep, pPath->iFlags );
+    }
+
+    TWaypointId NearestOrNew( const Vector& v, float fMaxDistance, int& iCreated )
+    {
+        TWaypointId w = CWaypoints::GetNearestWaypoint( v, NULL, false, fMaxDistance );
+        if ( !CWaypoint::IsValid( w ) )
+        {
+            w = CWaypoints::Add( v );
+            CWaypoints::CreateAutoPaths( w, false, CWaypoint::iAnalyzeDistance * 1.9f, false );
+            ++iCreated;
+        }
+        return w;
+    }
+
+    // The nearest waypoint within fMaxDistance that isn't in (or within 20 units of) one of the boxes, else a new one
+    // at v with its automatic paths.
+    TWaypointId NearestOutside( const Vector& v, float fMaxDistance, const std::vector<const sgtls::CBspEntity*>& aBoxes,
+                                int& iCreated )
+    {
+        good::vector<TWaypointId> aNear;
+        CWaypoints::GetNearestWaypoints( aNear, v, false, fMaxDistance );
+        TWaypointId wBest = EWaypointIdInvalid;
+        float fBest = 1e9f;
+        for ( int i = 0; i < aNear.size(); ++i )
+        {
+            const Vector& vw = CWaypoints::Get( aNear[i] ).vOrigin;
+            bool bIn = false;
+            for ( size_t b = 0; b < aBoxes.size() && !bIn; ++b )
+            {
+                Vector vNearest;
+                for ( int k = 0; k < 3; ++k )
+                    vNearest[k] = clamp( vw[k], aBoxes[b]->vMins[k], aBoxes[b]->vMaxs[k] );
+                bIn = vw.DistTo( vNearest ) < 20.0f;
+            }
+            if ( !bIn && vw.DistTo( v ) < fBest )
+            {
+                fBest = vw.DistTo( v );
+                wBest = aNear[i];
+            }
+        }
+        if ( CWaypoint::IsValid( wBest ) )
+            return wBest;
+        TWaypointId w = CWaypoints::Add( v ); // Connected by ConnectLinkEnd (its automatic paths could go into a gate).
+        ++iCreated;
+        return w;
+    }
+
+    // Waypoints reached from w (following the paths), up to iMax.
+    int CountReached( TWaypointId w, int iMax )
+    {
+        std::set<TWaypointId> aSeen;
+        std::vector<TWaypointId> aStack( 1, w );
+        aSeen.insert( w );
+        good::vector<TWaypointId> aOut;
+        while ( !aStack.empty() && (int)aSeen.size() < iMax )
+        {
+            TWaypointId u = aStack.back();
+            aStack.pop_back();
+            aOut.clear();
+            CWaypoints::GetPathTargets( u, aOut );
+            for ( int i = 0; i < aOut.size(); ++i )
+                if ( aSeen.insert( aOut[i] ).second )
+                    aStack.push_back( aOut[i] );
+        }
+        return (int)aSeen.size();
+    }
+
+    // Waypoints from which w is reached (iMax at most), through the paths backwards.
+    int CountReachingInto( TWaypointId w, int iMax )
+    {
+        int n = CWaypoints::Size();
+        std::vector< std::vector<TWaypointId> > aInto( n );
+        good::vector<TWaypointId> aOut;
+        for ( TWaypointId u = 0; u < n; ++u )
+        {
+            aOut.clear();
+            CWaypoints::GetPathTargets( u, aOut );
+            for ( int i = 0; i < aOut.size(); ++i )
+                aInto[ aOut[i] ].push_back( u );
+        }
+        std::set<TWaypointId> aSeen;
+        std::vector<TWaypointId> aStack( 1, w );
+        aSeen.insert( w );
+        while ( !aStack.empty() && (int)aSeen.size() < iMax )
+        {
+            TWaypointId u = aStack.back();
+            aStack.pop_back();
+            for ( size_t i = 0; i < aInto[u].size(); ++i )
+                if ( aSeen.insert( aInto[u][i] ).second )
+                    aStack.push_back( aInto[u][i] );
+        }
+        return (int)aSeen.size();
+    }
+
+    // An end of a teleporter link without paths into it (entry, bInto) / out of it (exit): tls_lockdown's stargates
+    // stand at the top of a ramp inside their kawoosh volume, whose waypoints step 1 removed. Add kept one-way paths
+    // from / to the nearest waypoints that the walk test reaches, within 400 units, 3 at most. For an exit, one of them
+    // leads to the most waypoints (tls_lockdown's SGC gate: the nearest ones, beside the ramp, are dead ends). Return
+    // the count, -1 if already connected.
+    std::set<TWaypointId> m_aGateEntries; // Waypoints in a gate's plane: never a way through (PostProcessWaypoints 2).
+    std::set<TWaypointId> m_aLinkExits;   // Arrival waypoints: not a way into an entry (reached from the other side).
+    // A gate entry is walked into from the front only: behind the plane, a "backtele" sends to the killbox while the
+    // gate is open (tlsdm_glass_gate_final: bots connected from behind died there). Axis, plane, side of the front.
+    struct CGateFront
+    {
+        int iAxis;
+        float fPlane, fSign;
+    };
+    std::map<TWaypointId, CGateFront> m_aEntryFront;
+
+    int ConnectDirect( TWaypointId w, bool bInto, TWaypointId wOther )
+    {
+        const float fMax = 400.0f;
+        const Vector vEnd = CWaypoints::Get( w ).vOrigin;
+        good::vector<TWaypointId> aNear;
+        CWaypoints::GetNearestWaypoints( aNear, vEnd, false, fMax );
+        std::vector< std::pair<float, TWaypointId> > aSorted;
+        for ( int i = 0; i < aNear.size(); ++i )
+        {
+            if ( aNear[i] == w || aNear[i] == wOther || m_aGateEntries.count( aNear[i] ) ||
+                 ( bInto && m_aLinkExits.count( aNear[i] ) ) )
+                continue;
+            std::map<TWaypointId, CGateFront>::const_iterator itFront = bInto ? m_aEntryFront.find( w ) : m_aEntryFront.end();
+            if ( itFront != m_aEntryFront.end() &&
+                 ( CWaypoints::Get( aNear[i] ).vOrigin[ itFront->second.iAxis ] - itFront->second.fPlane ) * itFront->second.fSign < 8.0f )
+                continue; // Behind the gate.
+            if ( bInto ? CWaypoints::HasPath( aNear[i], w ) : CWaypoints::HasPath( w, aNear[i] ) )
+                return -1;
+            aSorted.push_back( std::make_pair( CWaypoints::Get( aNear[i] ).vOrigin.DistTo( vEnd ), aNear[i] ) );
+        }
+        std::sort( aSorted.begin(), aSorted.end() );
+
+        // The reachable ones (16 nearest at most), with their path flags.
+        std::vector< std::pair<TWaypointId, TPathFlags> > aReachable;
+        std::vector<float> aDistance;
+        for ( size_t i = 0; i < aSorted.size() && i < 32; ++i )
+        {
+            TWaypointId wFrom = bInto ? aSorted[i].second : w, wTo = bInto ? w : aSorted[i].second;
+            Vector vFrom = CWaypoints::Get( wFrom ).vOrigin, vTo = CWaypoints::Get( wTo ).vOrigin;
+            bool bCrouch = false;
+            TReach iReach = CUtil::GetReachableInfoFromTo( vFrom, vTo, bCrouch, 0, fMax * fMax, false );
+            if ( iReach == EReachNotReachable || bCrouch )
+                continue;
+            TPathFlags iFlags = ( iReach == EReachNeedJump ) ? FPathJump : ( iReach == EReachFallDamage ) ? FPathDamage : FPathNone;
+            FLAG_SET( FPathKeep, iFlags );
+            aReachable.push_back( std::make_pair( aSorted[i].second, iFlags ) );
+            aDistance.push_back( aSorted[i].first );
+        }
+        // An entry: one of them reached from the most waypoints (tls_stargate_atlantis's Goa'uld gate: the nearest
+        // ones are corners of its platform, the way up is in the kawoosh volume).
+        int iBest = -1, iBestReached = 0;
+        for ( size_t i = 0; i < aReachable.size(); ++i )
+        {
+            int iReached = bInto ? CountReachingInto( aReachable[i].first, 400 ) : CountReached( aReachable[i].first, 400 );
+            if ( iReached > iBestReached )
+            {
+                iBest = (int)i;
+                iBestReached = iReached;
+            }
+        }
+        int iCount = 0;
+        for ( int i = -1; i < (int)aReachable.size() && iCount < 3; ++i )
+        {
+            int k = ( i < 0 ) ? iBest : i;
+            if ( k < 0 || ( i >= 0 && i == iBest ) )
+                continue;
+            TWaypointId wFrom = bInto ? aReachable[k].first : w, wTo = bInto ? w : aReachable[k].first;
+            if ( CWaypoints::AddPath( wFrom, wTo, aDistance[k], aReachable[k].second ) )
+                ++iCount;
+        }
+        return iCount;
+    }
+
+    // Same, through a new waypoint 160 to 320 units away when no waypoint is reachable in a straight line
+    // (tls_lockdown's SGC gate: its ramp has rails, and the gate room's waypoints are beside the ramp).
+    int ConnectLinkEnd( TWaypointId w, bool bInto, TWaypointId wOther, int& iCreated )
+    {
+        int iCount = ConnectDirect( w, bInto, wOther );
+        if ( iCount != 0 )
+            return iCount < 0 ? 0 : iCount;
+        const Vector vEnd = CWaypoints::Get( w ).vOrigin;
+        for ( float fDist = 160.0f; fDist <= 320.0f; fDist += 80.0f )
+            for ( int a = 0; a < 8; ++a )
+            {
+                float fAngle = a * 3.14159265f / 4.0f;
+                Vector vVia = GroundEye( vEnd + Vector( cos( fAngle ), sin( fAngle ), 0.0f ) * fDist );
+                if ( fabs( vVia.z - vEnd.z ) > 160.0f )
+                    continue;
+                Vector vFrom = bInto ? vVia : vEnd, vTo = bInto ? vEnd : vVia;
+                bool bCrouch = false;
+                TReach iReach = CUtil::GetReachableInfoFromTo( vFrom, vTo, bCrouch, 0, 1e9f, false );
+                if ( iReach == EReachNotReachable || iReach == EReachFallDamage || bCrouch )
+                    continue;
+                TWaypointId wVia = CWaypoints::Add( vVia );
+                iCount = ConnectDirect( wVia, bInto, w );
+                if ( iCount <= 0 )
+                {
+                    CWaypoints::Remove( wVia, false );
+                    continue;
+                }
+                ++iCreated;
+                TPathFlags iFlags = ( iReach == EReachNeedJump ) ? FPathJump : FPathNone;
+                FLAG_SET( FPathKeep, iFlags );
+                CWaypoints::AddPath( bInto ? wVia : w, bInto ? w : wVia, fDist, iFlags );
+                return iCount;
+            }
+        return 0;
+    }
+}
