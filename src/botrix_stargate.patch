+//----------------------------------------------------------------------------------------------------------------
+const char* CBot::ShotCheck() const
+{
+    // Where a shot fired now goes, with the angles sent this frame, relative to the current enemy's body.
+    // Stargate mods: the game adds the view punch (recoil) to the shot.
+    QAngle angShot = m_cCmd.viewangles;
+#if defined(BOTRIX_SGTLS) || defined(BOTRIX_SGTC2)
+    angShot += sgtls::PunchAngle( m_pEdict );
+#endif
+    Vector vDir;
+    AngleVectors( angShot, &vDir );
+    Vector vCenter;
+    m_pCurrentEnemy->GetCenter( vCenter );
+    Vector vTo( vCenter );
+    vTo -= m_vHead;
+    float fAlong = vTo.Dot( vDir );
+    if ( fAlong <= 0.0f )
+        return "off aim";
+
+    // Beside the body (32 x 72 hull): still turning, or aiming where the enemy was going.
+    Vector vClosest = m_vHead + vDir * fAlong;
+    if ( vClosest.AsVector2D().DistTo( vCenter.AsVector2D() ) > 24.0f || fabs( vClosest.z - vCenter.z ) > 40.0f )
+        return "off aim";
+
+    // A wall, a prop or a team mate in front of the enemy (its own hull starts 16 units before its center).
+    if ( CUtil::ShotClearDistance( m_pEdict, m_vHead, vDir, fAlong ) < fAlong - 40.0f )
+        return "blocked";
+
+    // Explosive blasts leave the weapon lower and to the right of the eye, and have a size: a ledge or a door frame
+    // the eye sees over makes them blow up in the shooter's face.
+    if ( CWeapons::IsValid(m_iWeapon) && m_aWeapons[m_iWeapon].GetBaseWeapon()->fMinDistanceSqr[0] > 0.0f )
+    {
+        Vector vForward, vRight, vUp;
+        AngleVectors( angShot, &vForward, &vRight, &vUp );
+        Vector vMuzzle = m_vHead + vRight * 8.0f - vUp * 10.0f;
+        Vector vMuzzleDir = vCenter - vMuzzle;
+        float fMuzzleDist = VectorNormalize( vMuzzleDir );
+        if ( CUtil::ShotClearDistance( m_pEdict, vMuzzle, vMuzzleDir, fMuzzleDist, 4.0f ) < fMuzzleDist - 40.0f )
+            return "blocked";
+    }
+    return "on target";
+}
