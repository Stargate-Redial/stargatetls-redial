+//----------------------------------------------------------------------------------------------------------------
+void CWaypoints::RemoveMany( const bool* aRemove )
+{
+    // Remove() is linear in the graph size: rebuild the graph once instead.
+    CPlayers::InvalidatePlayersWaypoints();
+    int iSize = Size();
+    good::vector<TWaypointId> aNewId;
+    aNewId.reserve( iSize );
+    TWaypointId iNext = 0;
+    for ( TWaypointId id = 0; id < iSize; ++id )
+        aNewId.push_back( aRemove[id] ? EWaypointIdInvalid : iNext++ );
+
+    WaypointGraph cGraph;
+    for ( TWaypointId id = 0; id < iSize; ++id )
+        if ( !aRemove[id] )
+            cGraph.add_node( m_cGraph[id].vertex );
+    for ( TWaypointId id = 0; id < iSize; ++id )
+    {
+        if ( aRemove[id] )
+            continue;
+        WaypointNode& cNode = m_cGraph[id];
+        for ( WaypointArcIt it = cNode.neighbours.begin(); it != cNode.neighbours.end(); ++it )
+            if ( !aRemove[it->target] )
+                cGraph.add_arc( aNewId[id], aNewId[it->target], it->edge );
+    }
+    m_cGraph = cGraph;
+
+    ClearLocations();
+    for ( TWaypointId id = 0; id < Size(); ++id )
+        AddLocation( id, m_cGraph[id].vertex.vOrigin );
+    m_aUnreachablePaths.clear();
+    m_aVisTable.clear();
+    bValidVisibilityTable = false;
+}
