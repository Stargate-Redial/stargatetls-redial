+    bool WriteCode( void* pAddress, const void* pData, int iSize );
+#endif
+
+    /// Offset of a network property (searched recursively in the send table of the entity's server class),
+    /// -1 if not found. Cached per (server class, property).
+    int PropOffset( edict_t* pEdict, const char* szProp );
+
+    /// The player holds at least one weapon (true if that can't be read).
+    bool HasWeapon( edict_t* pEdict );
+
+    /// Read a network property as int / float / vector component. Return iDefault if missing.
+    int GetInt( edict_t* pEdict, const char* szProp, int iDefault = -1 );
+    float GetFloat( edict_t* pEdict, const char* szProp, float fDefault = 0.0f );
+
+    /// Server class name of an entity ("CTLSPlayer"...), "" if none.
+    const char* ServerClassName( edict_t* pEdict );
+
+    /// StargateTC 2: press a DHD button (bfl_dhdbutton) for a player. False if not a DHD button.
+    bool UseEntity( edict_t* pEdict, edict_t* pActivator );
+
+    /// Both mods ship the SDK test bot code (hl2mp_bot_temp): it also drives every fake client, Botrix's bots
+    /// included, and its bot_attack defaults to 1, so it pressed attack for them (bots firing at walls, Kull blasts
+    /// in their face). Set its cvars to neutral. Called at each map load.
+    void NeutralizeSdkBots();
+
+    /// Turn the SDK test bots' Bot_RunAll() off (plugin load) / back on (unload): even with neutral cvars it sends
+    /// a second usercmd per frame to every bot (standing still when hurt).
+    void DisableSdkBotThink();
+    void EnableSdkBotThink();
+
+    /// Shot audit (<prefix>_visaudit): while on, every frame a bot fires at its enemy is checked with a strict
+    /// trace (eye to head and to center, everything but players blocks), and the hidden ones are counted.
+    extern bool bVisAudit;
+
+    /// Scale of the bots' recoil control (<prefix>_recoil, 1 by default, 0 = none).
+    extern float fRecoilControl;
+
+    /// Bots with a blast weapon (minimum range) keep their distance (<prefix>_keepdist, on by default).
+    extern bool bKeepDistance;
+    /// SGTLS: attackers that spawned far wait for teammates before attacking (CBot_SGTLS::Regroup).
+    extern bool bRegroup;
+
+    /// View punch (recoil) of a player, which the game adds to its shots. Zero if unknown.
+    QAngle PunchAngle( edict_t* pEdict );
+    void AuditShot( CPlayer* pShooter, CPlayer* pEnemy );
+    /// Every attack press, counted by reason.
+    void AuditPress( CPlayer* pShooter, const char* szReason );
+    /// " <500", " 500-1000"... for the audits.
+    const char* DistanceBucket( float fDistance );
+    /// Damage done to an enemy (player_hurt), summed by attacker team and weapon.
+    void AuditDamage( CPlayer* pAttacker, CPlayer* pVictim, const char* szWeapon, int iDamage );
+}
