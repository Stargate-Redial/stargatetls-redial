--- /dev/null
+++ b/mods/sgtls/mod_sgtls.cpp
@@ -0,0 +1,47 @@
+#ifdef BOTRIX_SGTLS
+
+#include <stdlib.h>
+
+#include <good/string_buffer.h>
+
+#include "mods/sgtls/bot_sgtls.h"
+#include "mods/sgtls/mod_sgtls.h"
+#include "mods/sgtls/sgtls_util.h"
+
+#include "iplayerinfo.h"
+
+
+extern char* szMainBuffer;
+extern int iMainBufferSize;
+
+
+//----------------------------------------------------------------------------------------------------------------
+// Optional parameter: the class id (1..4 Tau'ri, 5..8 Goa'uld), e.g. "botrix bot add ... 6".
+CPlayer* CModSGTLS::AddBot( const char* szName, TBotIntelligence iIntelligence, TTeam iTeam,
+                            TClass /*iClass*/, int iParamsCount, const char **aParams )
+{
+    int iClassId = -1;
+    if ( iParamsCount > 1 || ( iParamsCount == 1 && ( iClassId = atoi( aParams[0] ) ) < 1 ) || iClassId > 8 )
+    {
+        good::string_buffer sb( szMainBuffer, iMainBufferSize, false );
+        sb << "Invalid parameter: " << aParams[0] << " (class id 1..8 expected).";
+        m_sLastError = sb;
+        return NULL;
+    }
+
+    if ( !sgtls::HasSpawnPoints() )
+    {
+        m_sLastError = "No spawn point yet (round restarting), will retry.";
+        return NULL;
+    }
+
+    edict_t* pEdict = CBotrixPlugin::pBotManager->CreateBot( szName );
+    if ( !pEdict )
+    {
+        m_sLastError = "Error, couldn't add bot (no map or server full?).";
+        return NULL;
+    }
+    return new CBot_SGTLS( pEdict, iIntelligence, iTeam, iClassId );
+}
+
+#endif // BOTRIX_SGTLS
