+//----------------------------------------------------------------------------------------------------------------
+void CBot_SGTLS::CrossDoorway( const Vector& vOrigin )
+{
+    if ( !sgtls::Feature( sgtls::FeatDoorPair ) )
+    {
+        m_iCrossDoor = -1;
+        return;
+    }
+    // tls_omega_b1: the Daedalus doors are pairs of leaves sliding into the walls; open, a hull passes only within a few
+    // units of the seam, and the paths (made through the closed leaves) run 20 units off it: bots stood against the
+    // frame until the watchdog (15 in 6 minutes).
+    if ( m_iCrossDoor < 0 || m_iCrossDoor >= (int)sgtls::ButtonDoors().size() || CBotrixPlugin::fTime > m_fCrossDoorEnd ||
+         m_pCurrentEnemy )
+    {
+        m_iCrossDoor = -1;
+        return;
+    }
+    const sgtls::CButtonDoor& d = sgtls::ButtonDoors()[m_iCrossDoor];
+    int a = d.iAxis, o = 1 - a;
+    float fPlane = ( d.pDoor->vMins[a] + d.pDoor->vMaxs[a] ) * 0.5f;
+    float fDepth = ( vOrigin[a] - fPlane ) * m_fCrossDoorSide; // > 0: still on the side the bot came from.
+    if ( fDepth < -40.0f )
+    {
+        m_iCrossDoor = -1; // Through.
+        return;
+    }
+    float fMiddle = ( d.vDoorwayMins[o] + d.vDoorwayMaxs[o] ) * 0.5f;
+    Vector vDir( 0.0f, 0.0f, 0.0f );
+    vDir[a] = -m_fCrossDoorSide;
+    float fLat = fMiddle - vOrigin[o];
+    // Line up first when close to the frame, then straight through.
+    vDir[o] = clamp( fLat / ( fDepth > 24.0f ? fDepth : 24.0f ), -1.5f, 1.5f );
+    if ( fabs( fLat ) > 6.0f && fDepth > 0.0f && fDepth < 40.0f )
+        vDir[a] *= 0.3f;
+    float fYaw = atan2f( vDir.y, vDir.x ) * 180.0f / 3.14159265f - m_cCmd.viewangles.y;
+    fYaw *= 3.14159265f / 180.0f;
+    m_cCmd.forwardmove = 1000.0f * cosf( fYaw );
+    m_cCmd.sidemove = -1000.0f * sinf( fYaw );
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+void CBot_SGTLS::StepOffDoor()
+{
+    // tls_stargate_atlantis_fixed: a leaf of the Abschnitt1 pair slides at 95 degrees, 5 units sideways into the
+    // doorway's edge. A bot that pressed the panel standing against the leaf was in its way: the leaf went back
+    // (forceclosed 0), and the bot pressed again and again until it gave up or the watchdog (195 -> 196, in most
+    // 10-minute runs). While the door opens, out of its leaf's way, back on the bot's side.
+    if ( !sgtls::Feature( sgtls::FeatDoorClear ) || !m_pPlayerInfo )
+        return;
+    const std::vector<sgtls::CButtonDoor>& aDoors = sgtls::ButtonDoors();
+    Vector vMins, vMaxs;
+    if ( m_iDoor < 0 || m_iDoor >= (int)aDoors.size() || !sgtls::CObjectives::DoorWorldBox( m_iDoor, vMins, vMaxs ) )
+        return;
+    Vector vOrigin = m_pPlayerInfo->GetAbsOrigin();
+    const float fMargin = 16.0f + 10.0f; // Half a hull and a little.
+    if ( vOrigin.x < vMins.x - fMargin || vOrigin.x > vMaxs.x + fMargin || vOrigin.y < vMins.y - fMargin ||
+         vOrigin.y > vMaxs.y + fMargin || vOrigin.z + 72.0f < vMins.z || vOrigin.z > vMaxs.z )
+        return;
+    const sgtls::CButtonDoor& d = aDoors[m_iDoor];
+    int a = d.iAxis;
+    float fPlane = ( d.pDoor->vMins[a] + d.pDoor->vMaxs[a] ) * 0.5f; // Where it stands closed.
+    Vector vAway( 0.0f, 0.0f, 0.0f );
+    vAway[a] = ( vOrigin[a] > fPlane ) ? 1.0f : -1.0f;
+    m_vDestination = m_vHead + vAway * 40.0f;
+    iNextWaypoint = EWaypointIdInvalid;
+    m_bUseNavigatorToMove = m_bDestinationChanged = false;
+    m_bNeedMove = true;
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+void CBot_SGTLS::KeepOffFires()
+{
+    if ( !sgtls::Feature( sgtls::FeatFires ) )
+        return;
+    Vector2D vFire;
+    // Standing still (fighting, waiting, regrouping) in any fire's box: out of it. tls_hatak's 109 torches on pillars
+    // (damagescale 0) still burn 1 hp a second; once the Goa'uld left their spawn by the rings, about 2 bots in 10
+    // minutes died by a torch they stood at. Paths ignore those torches (avoiding them made a maze of the halls).
+    if ( !m_bNeedMove )
+    {
+        if ( sgtls::InAnyFireBox( m_vHead, 4.0f, vFire ) )
+        {
+            Vector vOut( m_vHead.x - vFire.x, m_vHead.y - vFire.y, 0.0f );
+            if ( vOut.NormalizeInPlace() < 0.1f )
+                vOut.Init( 1.0f, 0.0f, 0.0f );
+            float fYawOut = atan2f( vOut.y, vOut.x ) * 180.0f / 3.14159265f - m_cCmd.viewangles.y;
+            fYawOut *= 3.14159265f / 180.0f;
+            m_cCmd.forwardmove = 1000.0f * cosf( fYawOut );
+            m_cCmd.sidemove = -1000.0f * sinf( fYawOut );
+        }
+        return;
+    }
+    // tls_stargate_atlantis_fixed: the Goa'uld DHD stands 36 units from a torch that burns (damagescale 1); bots
+    // walking straight to the DHD burned there (12 in 12 minutes). Path moves keep their own fire handling (the
+    // paths within reach are costly; tls_lockdown's corridor must be crossed).
+    if ( m_bUseNavigatorToMove )
+        return;
+    if ( !sgtls::FireInReach( m_vHead, vFire ) )
+        return;
+    Vector vAway( m_vHead.x - vFire.x, m_vHead.y - vFire.y, 0.0f );
+    if ( vAway.NormalizeInPlace() < 0.1f )
+        vAway.Init( 1.0f, 0.0f, 0.0f );
+    float fYaw = atan2f( vAway.y, vAway.x ) * 180.0f / 3.14159265f - m_cCmd.viewangles.y;
+    fYaw *= 3.14159265f / 180.0f;
+    m_cCmd.forwardmove = 1000.0f * cosf( fYaw );
+    m_cCmd.sidemove = -1000.0f * sinf( fYaw );
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+void CBot_SGTLS::KeepOffLasers( const Vector& vOrigin )
+{
+    if ( !sgtls::Feature( sgtls::FeatLasers ) )
+        return;
+    // tls_p4x-639_a1: 4 bots in 3 minutes walked through the beams across the time machine's hall.
+    const std::vector<sgtls::CLaser>& aLasers = sgtls::DamagingLasers();
+    if ( aLasers.empty() )
+        return;
+    float fYaw = m_cCmd.viewangles.y * 3.14159265f / 180.0f;
+    Vector vForward( cosf( fYaw ), sinf( fYaw ), 0.0f ), vRight( sinf( fYaw ), -cosf( fYaw ), 0.0f );
+    Vector vWish = vForward * m_cCmd.forwardmove + vRight * m_cCmd.sidemove;
+    bool bChanged = false;
+    for ( size_t i = 0; i < aLasers.size(); ++i )
+    {
+        const sgtls::CLaser& l = aLasers[i];
+        // Nearest point of the beam to the bot's body (feet to head, sampled), horizontal distance.
+        Vector vSeg = l.vEnd - l.vStart;
+        float fLen2 = vSeg.LengthSqr();
+        if ( fLen2 < 1.0f )
+            continue;
+        float fBest = 1e9f;
+        Vector vAway( 0.0f, 0.0f, 0.0f );
+        for ( int k = 0; k < 4; ++k )
+        {
+            Vector vBody = vOrigin + Vector( 0.0f, 0.0f, 8.0f + k * 20.0f );
+            float t = clamp( ( vBody - l.vStart ).Dot( vSeg ) / fLen2, 0.0f, 1.0f );
+            Vector vNear = l.vStart + vSeg * t;
+            Vector vDiff = vBody - vNear;
+            if ( fabs( vDiff.z ) > 40.0f )
+                continue;
+            vDiff.z = 0.0f;
+            float fDist = vDiff.Length();
+            if ( fDist < fBest )
+            {
+                fBest = fDist;
+                vAway = Vector( -vSeg.y, vSeg.x, 0.0f );
+                if ( fDist > 0.1f )
+                    vAway = vDiff / fDist;
+                else
+                    vAway.NormalizeInPlace();
+            }
+        }
+        if ( fBest > 64.0f || !sgtls::LaserOn( i ) )
+            continue;
+        if ( fBest < 24.0f + 16.0f )
+            vWish = vAway * 400.0f; // Out of it.
+        else if ( vWish.Dot( vAway ) < 0.0f )
+            vWish -= vAway * vWish.Dot( vAway ); // Not closer.
+        else
+            continue;
+        bChanged = true;
+    }
+    if ( bChanged )
+    {
+        m_cCmd.forwardmove = vWish.Dot( vForward );
+        m_cCmd.sidemove = vWish.Dot( vRight );
+    }
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+void CBot_SGTLS::Swim( const Vector& vOrigin )
+{
+    if ( !sgtls::Feature( sgtls::FeatSwim ) )
+        return;
+    // tls_gateinwater_rc3: the far gate lies at the bottom of a lake. The bots that came through rose to the surface
+    // and stayed there, 200 units above the waypoints of the lake bottom, until the watchdog (26 suicides in 6 min).
+    // Then, following the lake bottom, they drowned (8 in 4 minutes). After 7 s with the eyes under water, up for air,
+    // but only where there is air straight above with nothing solid in between: part of the lake is under a ceiling
+    // (z 6779), where 12 bots drowned when they went straight up anywhere.
+    if ( CBotrixPlugin::pEngineTrace->GetPointContents( m_vHead ) & CONTENTS_WATER )
+    {
+        if ( m_fUnderwaterSince == 0.0f )
+            m_fUnderwaterSince = CBotrixPlugin::fTime;
+        if ( CBotrixPlugin::fTime > m_fUnderwaterSince + 7.0f )
+        {
+            if ( CBotrixPlugin::fTime > m_fAirCheckTime + 0.5f )
+            {
+                m_fAirCheckTime = CBotrixPlugin::fTime;
+                m_bAirAbove = false;
+                Vector vUp = m_vHead;
+                for ( int k = 0; k < 16 && !m_bAirAbove; ++k )
+                {
+                    Vector vNext = vUp + Vector( 0.0f, 0.0f, 32.0f );
+                    Ray_t ray;
+                    ray.Init( vUp, vNext );
+                    trace_t tr;
+                    CTraceFilterWorldOnly cWorld;
+                    CBotrixPlugin::pEngineTrace->TraceRay( ray, MASK_PLAYERSOLID, &cWorld, &tr );
+                    if ( tr.fraction < 1.0f )
+                        break; // A ceiling.
+                    vUp = vNext;
+                    m_bAirAbove = !( CBotrixPlugin::pEngineTrace->GetPointContents( vUp ) & CONTENTS_WATER );
+                }
+            }
+            if ( m_bAirAbove )
+            {
+                m_cCmd.viewangles.x = -80.0f;
+                m_cCmd.forwardmove = 1000.0f;
+                m_cCmd.sidemove = 0.0f;
+                FLAG_SET( IN_JUMP, m_cCmd.buttons );
+                FLAG_CLEAR( IN_DUCK, m_cCmd.buttons );
+                return;
+            }
+        }
+    }
+    else
+        m_fUnderwaterSince = 0.0f;
+    if ( !m_bNeedMove || !CWaypoint::IsValid( iNextWaypoint ) || m_pCurrentEnemy )
+        return;
+    if ( !( CBotrixPlugin::pEngineTrace->GetPointContents( vOrigin + Vector( 0.0f, 0.0f, 36.0f ) ) & CONTENTS_WATER ) )
+        return;
+    Vector vTo = CWaypoints::Get( iNextWaypoint ).vOrigin - m_vHead;
+    if ( fabs( vTo.z ) < 32.0f )
+        return;
+    QAngle angTo;
+    VectorAngles( vTo, angTo );
+    m_cCmd.viewangles = angTo;
+    m_cCmd.forwardmove = 1000.0f;
+    m_cCmd.sidemove = 0.0f;
+    FLAG_CLEAR( IN_JUMP | IN_DUCK | IN_BACK | IN_MOVELEFT | IN_MOVERIGHT, m_cCmd.buttons );
+    if ( vTo.z > 32.0f && vTo.Length2D() < 64.0f )
+        FLAG_SET( IN_JUMP, m_cCmd.buttons ); // Straight up.
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+void CBot_SGTLS::UsePropDoor()
+{
+    if ( !sgtls::Feature( sgtls::FeatPropDoors ) )
+        return;
+    // tls_outpost_17_b1_032: door_a11 / door_a12 open with +use only (Botrix's own +use on a door it is stuck at
+    // didn't come: the bots pushed against them until the 30-second watchdog).
+    if ( !m_bNeedMove || !m_bUseNavigatorToMove || !CWaypoint::IsValid( iNextWaypoint ) ||
+         CBotrixPlugin::fTime < m_fPropDoorUseTime + 1.5f )
+        return;
+    Vector vDir = CWaypoints::Get( iNextWaypoint ).vOrigin - m_vHead;
+    vDir.z = 0.0f;
+    if ( vDir.NormalizeInPlace() < 1.0f )
+        return;
+    int iSelf = CBotrixPlugin::pEngineServer->IndexOfEdict( m_pEdict );
+    CNotSelfFilter cFilter( iSelf );
+    for ( int k = 0; k < 2; ++k )
+    {
+        Vector vStart = m_vHead;
+        vStart.z -= k ? 36.0f : 8.0f;
+        Ray_t ray;
+        ray.Init( vStart, vStart + vDir * 96.0f );
+        trace_t tr;
+        CBotrixPlugin::pEngineTrace->TraceRay( ray, MASK_PLAYERSOLID, &cFilter, &tr );
+        if ( tr.fraction >= 1.0f || !tr.m_pEnt )
+            continue;
+        int iHit = reinterpret_cast<IHandleEntity*>( tr.m_pEnt )->GetRefEHandle().GetEntryIndex();
+        edict_t* pHit = CBotrixPlugin::pEngineServer->PEntityOfEntIndex( iHit );
+        if ( !pHit || pHit->IsFree() || !pHit->GetClassName() || strcmp( pHit->GetClassName(), "prop_door_rotating" ) != 0 )
+            continue;
+        // Look at it this frame (+use takes what the eyes point at) and press.
+        Vector vTo = tr.endpos - m_vHead;
+        QAngle angTo;
+        VectorAngles( vTo, angTo );
+        m_cCmd.viewangles = angTo;
+        FLAG_SET( IN_USE, m_cCmd.buttons );
+        m_fPropDoorUseTime = CBotrixPlugin::fTime;
+        BLOG_I( "%s -> +use on a model door.", GetName() );
+        return;
+    }
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+void CBot_SGTLS::KeepOffRings( const Vector& vOrigin )
+{
+    if ( !sgtls::Feature( sgtls::FeatRingGuard ) )
+        return;
+    // tls_sandfort_beta3: the floor of both stations slides open 0.2 s after the press, the rings rise from 1.9 s,
+    // send at 5.3 s, go down and the floor closes about 8 s after the press. Bots that walked off on arrival, or onto
+    // the platform late, were crushed (func_train, dmg 1000) 40 to 100 units from the axis.
+    const std::vector<sgtls::CButtonTeleporter>& aDefs = sgtls::ButtonTeleporters();
+    for ( size_t i = 0; i < aDefs.size(); ++i )
+    {
+        const sgtls::CButtonTeleporter& d = aDefs[i];
+        if ( !d.bRing || d.aRingParts.empty() )
+            continue;
+        // Its station, or the other one (its destination: the platform's middle, feet level).
+        const Vector& vMins = d.pTeleporter->vMins;
+        const Vector& vMaxs = d.pTeleporter->vMaxs;
+        Vector vTo = vOrigin - ( vMins + vMaxs ) * 0.5f;
+        vTo.z = 0.0f;
+        float fRadius = vTo.Length();
+        bool bHere = fRadius <= 160.0f && vOrigin.z >= vMins.z - 48.0f && vOrigin.z <= vMaxs.z + 16.0f;
+        if ( !bHere )
+        {
+            const Vector& vDest = d.pDestination->vOrigin;
+            vTo = vOrigin - vDest;
+            vTo.z = 0.0f;
+            fRadius = vTo.Length();
+            bHere = fRadius <= 160.0f && fabs( vOrigin.z - vDest.z ) < 64.0f;
+        }
+        if ( !bHere || !sgtls::CObjectives::RingsActive( (int)i ) )
+            continue;
+        FLAG_CLEAR( IN_DUCK | IN_JUMP | IN_FORWARD | IN_BACK | IN_MOVELEFT | IN_MOVERIGHT, m_cCmd.buttons );
+        if ( fRadius < 22.0f )
+        {
+            m_cCmd.forwardmove = m_cCmd.sidemove = 0.0f; // Inside the rings: wait.
+            return;
+        }
+        if ( m_iTeleporter == (int)i && m_fTeleporterPressed > 0.0f && CBotrixPlugin::fTime < m_fTeleporterPressed + 1.8f )
+            return; // Its own press: in before the rings rise.
+        // The rings (props on the trains, about 60 units in radius) crush a hull 40 to 80 units from the axis. To the
+        // axis from within 90 units: tls_stargate_beta1's platform has walls at its edge (64 units), bots sent out
+        // stayed against them, in the rings' way (16 crushed in 4 minutes).
+        Vector vOut = vTo / fRadius;
+        Vector vDir;
+        if ( fRadius < 90.0f )
+            vDir = -vOut; // To the axis.
+        else if ( fRadius < 130.0f )
+            vDir = vOut; // Out of the sweep.
+        else
+        {
+            // Outside: no step in.
+            float fYaw = m_cCmd.viewangles.y * 3.14159265f / 180.0f;
+            Vector vForward( cosf( fYaw ), sinf( fYaw ), 0.0f ), vRight( sinf( fYaw ), -cosf( fYaw ), 0.0f );
+            Vector vWish = vForward * m_cCmd.forwardmove + vRight * m_cCmd.sidemove;
+            float fIn = -vWish.Dot( vOut );
+            if ( fIn > 0.0f )
+            {
+                vWish += vOut * fIn;
+                m_cCmd.forwardmove = vWish.Dot( vForward );
+                m_cCmd.sidemove = vWish.Dot( vRight );
+            }
+            return;
+        }
+        float fYaw = atan2f( vDir.y, vDir.x ) * 180.0f / 3.14159265f - m_cCmd.viewangles.y;
+        fYaw *= 3.14159265f / 180.0f;
+        m_cCmd.forwardmove = 1000.0f * cosf( fYaw );
+        m_cCmd.sidemove = -1000.0f * sinf( fYaw );
+        return;
+    }
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+void CBot_SGTLS::KeepOffPlanes( const Vector& vOrigin )
+{
+    if ( !sgtls::Feature( sgtls::FeatPlanes ) )
+        return;
+    // The plane of the ready gate on the path is crossed (CrossGate times it); its incoming kill plane has the same box.
+    int iReady = sgtls::CObjectives::ReadyGate( iCurrentWaypoint, iNextWaypoint );
+    const sgtls::CBspEntity* pAllowed = ( iReady >= 0 ) ? sgtls::ButtonTeleporters()[iReady].pTeleporter : NULL;
+    float fYaw = m_cCmd.viewangles.y * 3.14159265f / 180.0f;
+    Vector vForward( cosf( fYaw ), sinf( fYaw ), 0.0f ), vRight( sinf( fYaw ), -cosf( fYaw ), 0.0f );
+    Vector vWish = vForward * m_cCmd.forwardmove + vRight * m_cCmd.sidemove;
+    bool bChanged = false;
+    const std::vector<const sgtls::CBspEntity*>& aPlanes = sgtls::TeleportPlanes();
+    for ( size_t i = 0; i < aPlanes.size(); ++i )
+    {
+        const sgtls::CBspEntity& p = *aPlanes[i];
+        int a = ( p.vMaxs.x - p.vMins.x < p.vMaxs.y - p.vMins.y ) ? 0 : 1, o = 1 - a;
+        // The ready gate's own planes: its travel plane, its incoming kill plane (the same or 1 unit off) and its back
+        // plane (23 units behind: tls_gateinwater_rc3, the guard stopped bots a unit short of the travel plane).
+        if ( pAllowed && fabs( ( p.vMins[a] + p.vMaxs[a] ) - ( pAllowed->vMins[a] + pAllowed->vMaxs[a] ) ) * 0.5f < 40.0f &&
+             p.vMins[o] < pAllowed->vMaxs[o] && p.vMaxs[o] > pAllowed->vMins[o] &&
+             p.vMins.z < pAllowed->vMaxs.z && p.vMaxs.z > pAllowed->vMins.z )
+            continue;
+        float fOff = vOrigin[a] - ( p.vMins[a] + p.vMaxs[a] ) * 0.5f;
+        float fDist = fabs( fOff ) - ( p.vMaxs[a] - p.vMins[a] ) * 0.5f - 16.0f; // From the hull.
+        if ( fDist > 40.0f || fDist < -16.0f || vOrigin[o] < p.vMins[o] - 20.0f || vOrigin[o] > p.vMaxs[o] + 20.0f ||
+             vOrigin.z > p.vMaxs.z || vOrigin.z + 72.0f < p.vMins.z )
+            continue;
+        float fAway = ( fOff > 0.0f ) ? 1.0f : -1.0f;
+        if ( fDist < 24.0f )
+            vWish[a] = fAway * 400.0f; // Back off: also brakes a bot running at it.
+        else if ( vWish[a] * fAway < 0.0f )
+            vWish[a] = 0.0f;
+        else
+            continue;
+        bChanged = true;
+    }
+    if ( bChanged )
+    {
+        m_cCmd.forwardmove = vWish.Dot( vForward );
+        m_cCmd.sidemove = vWish.Dot( vRight );
+    }
+    // A flat one just below the feet (tls_gateinwater_rc3: the bots that came through arrived in the lake right above
+    // the far gate's incoming plane and sank into it, the killbox: 24 in 4 minutes): swim up.
+    const std::vector<const sgtls::CBspEntity*>& aFlat = sgtls::FlatTeleportPlanes();
+    for ( size_t i = 0; i < aFlat.size(); ++i )
+    {
+        const sgtls::CBspEntity& p = *aFlat[i];
+        if ( pAllowed && p.vMins.AsVector2D().DistToSqr( pAllowed->vMins.AsVector2D() ) < 64.0f * 64.0f &&
+             fabs( p.vMins.z - pAllowed->vMins.z ) < 40.0f )
+            continue;
+        if ( vOrigin.x < p.vMins.x - 20.0f || vOrigin.x > p.vMaxs.x + 20.0f || vOrigin.y < p.vMins.y - 20.0f ||
+             vOrigin.y > p.vMaxs.y + 20.0f || vOrigin.z < p.vMaxs.z - 4.0f || vOrigin.z > p.vMaxs.z + 48.0f )
+            continue;
+        FLAG_SET( IN_JUMP, m_cCmd.buttons );
+        FLAG_CLEAR( IN_DUCK, m_cCmd.buttons );
+        break;
+    }
+}
