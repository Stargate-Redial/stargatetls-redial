+bool sgtls::LaserOn( size_t i )
+{
+    const std::vector<CLaser>& aLasers = DamagingLasers();
+    if ( i >= aLasers.size() )
+        return false;
+    edict_t*& pEdict = m_aLaserEdicts[i];
+    if ( !pEdict || pEdict->IsFree() || !pEdict->GetClassName() || strcmp( pEdict->GetClassName(), "env_laser" ) != 0 )
+    {
+        pEdict = NULL;
+        IVEngineServer* pEngine = CBotrixPlugin::pEngineServer;
+        for ( int e = 1; e < pEngine->GetEntityCount() && !pEdict; ++e )
+        {
+            edict_t* p = pEngine->PEntityOfEntIndex( e );
+            if ( p && !p->IsFree() && p->GetClassName() && strcmp( p->GetClassName(), "env_laser" ) == 0 &&
+                 p->GetCollideable() && p->GetCollideable()->GetCollisionOrigin().DistToSqr( aLasers[i].vStart ) < 16.0f )
+                pEdict = p;
+        }
+        if ( !pEdict )
+            return false;
+    }
+    int iEffects = sgtls::GetInt( pEdict, "m_fEffects", -1 );
+    return iEffects >= 0 && !( iEffects & 0x020 ); // EF_NODRAW while off.
+}
