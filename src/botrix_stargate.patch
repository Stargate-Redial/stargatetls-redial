diff --git a/mods/sgtls/objectives_sgtls.cpp b/mods/sgtls/objectives_sgtls.cpp
new file mode 100644
index 0000000..eeecb3d
--- /dev/null
+++ b/mods/sgtls/objectives_sgtls.cpp
@@ -0,0 +1,1398 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <algorithm>
+#include <map>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "mod.h"
+#include "players.h"
+#include "server_plugin.h"
+#include "source_engine.h"
+#include "waypoint.h"
+#include "mods/sgtls/objectives_sgtls.h"
+#include "mods/sgtls/sgtls_map.h"
+#include "mods/sgtls/sgtls_util.h"
+
+#include "eiface.h"
+#include "edict.h"
+#include "engine/IEngineTrace.h"
+#include "gametrace.h"
+#include "iservernetworkable.h"
+#include "iserverunknown.h"
+#include "iserverentity.h"
+
+// memdbgon must be the last include file in a .cpp file!!!
+#include "tier0/memdbgon.h"
+
+
+namespace
+{
+    // A place bots fight for: a capture area (objective type 0) or a hold button (type 2).
+    struct CSpot
+    {
+        edict_t* pEdict;                   // trigger_tls_capture_area or func_hold_button.
+        edict_t* pObjective;               // info_tls_objective of the spot, can be NULL for a capture area.
+        bool bButton;
+        Vector vMins, vMaxs, vCenter;
+        std::vector<TWaypointId> aInside;  // Capture area: waypoints inside. Button: waypoints in use range.
+        std::vector<TWaypointId> aNear;    // Waypoints around: where defenders wait.
+        std::vector< std::vector<TWaypointId> > aWatch; // Button: per place of aInside, the guard spots that see it.
+    };
+
+    std::vector<CSpot> m_aSpots;
+    std::string m_sMap;
+    int m_iWaypoints = -1;
+
+    // Button-operated teleporters (sgtls::ButtonTeleporters, same order), with their entities and waypoints.
+    struct CTeleporter
+    {
+        edict_t* pTeleporter;              // trigger_teleport.
+        edict_t* pButton;                  // func_button.
+        TWaypointId wEntry, wExit;         // The link, invalid if the waypoints don't have it.
+        TWaypointId wButton;               // Waypoint next to the button.
+        TWaypointId wButtonSafe;           // The nearest one out of the burning fires' reach.
+        float fOnSince;                    // When it was seen turning on, -1 while off.
+        float fNextPress;
+        // Rings: the station's func_trains, where each was last seen, when it last moved, since when it is still,
+        // and where it rests (still for 10 seconds there).
+        std::vector<edict_t*> aRingParts;
+        std::vector<Vector> aPartLast, aPartHome;
+        std::vector<float> aPartMoved, aPartStill;
+        std::vector<int> aPartState; // 0 not seen yet, 1 seen, 2 home known.
+        float fRingsChecked;
+        bool bRingsActive;
+        int iButtonChoice;                 // Index in sgtls::CButtonTeleporter::aButtons, -1 = its pButton.
+        int iChoiceWaypoints;              // Waypoint count when chosen.
+    };
+
+    // A waypoint path from w to wTo (breadth-first, stops when found).
+    bool Reaches( TWaypointId w, TWaypointId wTo )
+    {
+        int n = CWaypoints::Size();
+        if ( w < 0 || w >= n || wTo < 0 || wTo >= n )
+            return false;
+        std::vector<char> aSeen( n, 0 );
+        std::vector<TWaypointId> aQueue;
+        aQueue.push_back( w );
+        aSeen[w] = 1;
+        good::vector<TWaypointId> aOut;
+        for ( size_t i = 0; i < aQueue.size(); ++i )
+        {
+            if ( aQueue[i] == wTo )
+                return true;
+            aOut.clear();
+            CWaypoints::GetPathTargets( aQueue[i], aOut );
+            for ( int k = 0; k < aOut.size(); ++k )
+                if ( aOut[k] >= 0 && aOut[k] < n && !aSeen[ aOut[k] ] )
+                {
+                    aSeen[ aOut[k] ] = 1;
+                    aQueue.push_back( aOut[k] );
+                }
+        }
+        return false;
+    }
+    std::vector<CTeleporter> m_aTeleporters;
+
+    // Doors that bots open (sgtls::ButtonDoors, same order), with their entities.
+    struct CDoor
+    {
+        CDoor(): pDoor( NULL ), fNextPress( 0.0f ), fLastZ( 0.0f ), fLastZTime( -1.0f ), bGoingDown( false ) {}
+        edict_t* pDoor;                    // func_door / func_door_rotating.
+        std::vector<edict_t*> aButtons;    // Its panels (func_button).
+        float fNextPress;
+        float fLastZ, fLastZTime;          // Its bottom when last measured, and when.
+        bool bGoingDown;                   // Its bottom went down since the measure before.
+    };
+    std::vector<CDoor> m_aDoors;
+
+    // World box of an entity as it is now (its collision bounds).
+    void WorldBox( edict_t* pEdict, Vector& vMins, Vector& vMaxs )
+    {
+        ICollideable* pColl = pEdict->GetCollideable();
+        pColl->WorldSpaceSurroundingBounds( &vMins, &vMaxs );
+    }
+
+    // The point of a box nearest v, at most 4 units inside it.
+    Vector NearestInside( const Vector& v, const Vector& vMins, const Vector& vMaxs )
+    {
+        Vector vResult;
+        for ( int i = 0; i < 3; ++i )
+        {
+            float fMargin = ( vMaxs[i] - vMins[i] ) * 0.5f;
+            if ( fMargin > 4.0f )
+                fMargin = 4.0f;
+            vResult[i] = clamp( v[i], vMins[i] + fMargin, vMaxs[i] - fMargin );
+        }
+        return vResult;
+    }
+
+    float DistanceToBox( const Vector& v, const Vector& vMins, const Vector& vMaxs )
+    {
+        Vector vNearest;
+        for ( int i = 0; i < 3; ++i )
+            vNearest[i] = clamp( v[i], vMins[i], vMaxs[i] );
+        return v.DistTo( vNearest );
+    }
+
+    // A disabled trigger has no FSOLID_TRIGGER (CBaseTrigger::Enable / Disable).
+    bool IsOn( CTeleporter& t )
+    {
+        ICollideable* pColl = ( t.pTeleporter && !t.pTeleporter->IsFree() ) ? t.pTeleporter->GetCollideable() : NULL;
+        bool bOn = pColl && ( pColl->GetSolidFlags() & FSOLID_TRIGGER );
+        if ( !bOn )
+            t.fOnSince = -1.0f;
+        else if ( t.fOnSince < 0.0f )
+            t.fOnSince = CBotrixPlugin::fTime;
+        return bOn;
+    }
+
+    const float fNearDistance = 1000.0f;
+    // Hold buttons: the defenders' guard spots, waypoints that see the button from this close (indoors, 1000 units
+    // took them to other rooms and floors: tls_lockdown's Tau'ri won every bots-only round, 2026-11-03).
+    const float fButtonGuardDistance = 700.0f;
+    const float fButtonUseDistance = 90.0f; // From the eye to the button center: waypoints of the spot.
+    // From the eye to the nearest point of the button: start walking to it and holding +use. The game takes +use
+    // within 80 units (PLAYER_USE_RADIUS, horizontal distance); tls_lockdown's bomb buttons are long strips on a desk
+    // whose waypoints are ~82 units away.
+    const float fButtonApproachDistance = 130.0f;
+
+    int GetByte( edict_t* pEdict, const char* szProp )
+    {
+        int iOffset = sgtls::PropOffset( pEdict, szProp );
+        if ( iOffset < 0 || !pEdict->GetUnknown() )
+            return -1;
+        return *( (unsigned char*)pEdict->GetUnknown()->GetBaseEntity() + iOffset );
+    }
+
+    // Team that attacks the spot (2 Tau'ri, 3 Goa'uld), -1 if none.
+    int Attackers( const CSpot& c )
+    {
+        if ( c.bButton )
+            return c.pObjective && !c.pObjective->IsFree() ? sgtls::GetInt( c.pObjective, "m_iTeamFilter", -1 ) : -1;
+        if ( GetByte( c.pEdict, "m_bTeam2CanCap" ) == 1 )
+            return 2;
+        if ( GetByte( c.pEdict, "m_bTeam3CanCap" ) == 1 )
+            return 3;
+        return -1;
+    }
+
+    bool IsActive( const CSpot& c )
+    {
+        if ( c.pEdict->IsFree() )
+            return false;
+        int iAttackers = Attackers( c );
+        if ( iAttackers < 0 )
+            return false;
+        if ( !c.bButton && sgtls::GetInt( c.pEdict, "m_iNetOwnerTeam", 0 ) == iAttackers )
+            return false;
+        return !c.pObjective || c.pObjective->IsFree() || GetByte( c.pObjective, "m_bEnabled" ) == 1;
+    }
+
+    int Order( const CSpot& c )
+    {
+        return c.pObjective && !c.pObjective->IsFree() ? sgtls::GetInt( c.pObjective, "m_iOrder", 0 ) : 0;
+    }
+
+    Vector Origin( edict_t* pEdict )
+    {
+        ICollideable* pColl = pEdict->GetCollideable();
+        return pColl ? pColl->GetCollisionOrigin() : Vector( 0, 0, 0 );
+    }
+
+    void Bounds( edict_t* pEdict, CSpot& c )
+    {
+        ICollideable* pColl = pEdict->GetCollideable();
+        c.vMins = pColl->GetCollisionOrigin() + pColl->OBBMins();
+        c.vMaxs = pColl->GetCollisionOrigin() + pColl->OBBMaxs();
+        c.vCenter = ( c.vMins + c.vMaxs ) * 0.5f;
+    }
+
+    // Spots whose objective is enabled (or capture areas without objective), weighted: the lowest order twice.
+    void ActiveSpots( std::vector<int>& aWeighted )
+    {
+        std::vector<int> aActive;
+        int iMinOrder = 1 << 30;
+        for ( size_t a = 0; a < m_aSpots.size(); ++a )
+            if ( IsActive( m_aSpots[a] ) )
+            {
+                aActive.push_back( (int)a );
+                if ( Order( m_aSpots[a] ) < iMinOrder )
+                    iMinOrder = Order( m_aSpots[a] );
+            }
+        for ( size_t i = 0; i < aActive.size(); ++i )
+        {
+            aWeighted.push_back( aActive[i] );
+            if ( Order( m_aSpots[aActive[i]] ) == iMinOrder )
+                aWeighted.push_back( aActive[i] );
+        }
+    }
+
+    // Guard spots of each hold button, by button bounds, for the current map and waypoints (the traces are done once).
+    struct CGuardSpots
+    {
+        std::vector<TWaypointId> aNear;
+        std::vector< std::vector<TWaypointId> > aWatch;
+    };
+    std::map<std::string, CGuardSpots> m_aGuardCache;
+    // Per button (same key), the place of aInside where the last attacker held it from.
+    std::map<std::string, int> m_aLastPlace;
+
+    // The waypoints of the biggest strongly connected part (each one reaches all the others), for the current map and
+    // waypoints. Guards are kept in it: on tls_lockdown the gate exit jumps into two pockets beside the ramp (their
+    // waypoints toward the floor removed with the kawoosh's deadly volume) that have no way out, and guards sent
+    // there stayed until the watchdog killed them (31 suicides in a batch, 2026-11-04).
+    std::vector<char> m_aMainPart;
+    std::string m_sMainPartKey;
+
+    const std::vector<char>& MainPart()
+    {
+        int n = CWaypoints::Size();
+        char szKey[160];
+        snprintf( szKey, sizeof( szKey ), "%s %d", CBotrixPlugin::instance->sMapName.c_str(), n );
+        if ( m_sMainPartKey == szKey )
+            return m_aMainPart;
+        m_sMainPartKey = szKey;
+
+        // Kosaraju: finishing order on the graph, then components on the reversed graph in reverse finishing order.
+        std::vector<int> aOrder;
+        aOrder.reserve( n );
+        std::vector<char> aSeen( n, 0 );
+        std::vector< std::pair<int, int> > aStack;
+        for ( int s = 0; s < n; ++s )
+        {
+            if ( aSeen[s] )
+                continue;
+            aSeen[s] = 1;
+            aStack.push_back( std::make_pair( s, 0 ) );
+            while ( !aStack.empty() )
+            {
+                int u = aStack.back().first;
+                int& i = aStack.back().second;
+                const CWaypoints::WaypointNode& node = CWaypoints::GetNode( u );
+                if ( i < (int)node.neighbours.size() )
+                {
+                    int v = node.neighbours[i++].target;
+                    if ( v >= 0 && v < n && !aSeen[v] )
+                    {
+                        aSeen[v] = 1;
+                        aStack.push_back( std::make_pair( v, 0 ) );
+                    }
+                }
+                else
+                {
+                    aOrder.push_back( u );
+                    aStack.pop_back();
+                }
+            }
+        }
+        std::vector< std::vector<int> > aRev( n );
+        for ( int u = 0; u < n; ++u )
+        {
+            const CWaypoints::WaypointNode& node = CWaypoints::GetNode( u );
+            for ( int i = 0; i < (int)node.neighbours.size(); ++i )
+                if ( node.neighbours[i].target >= 0 && node.neighbours[i].target < n )
+                    aRev[ node.neighbours[i].target ].push_back( u );
+        }
+        std::vector<int> aComp( n, -1 ), aSize;
+        std::vector<int> aQueue;
+        for ( int k = n - 1; k >= 0; --k )
+        {
+            int s = aOrder[k];
+            if ( aComp[s] >= 0 )
+                continue;
+            int iComp = (int)aSize.size();
+            aSize.push_back( 0 );
+            aComp[s] = iComp;
+            aQueue.assign( 1, s );
+            while ( !aQueue.empty() )
+            {
+                int u = aQueue.back();
+                aQueue.pop_back();
+                ++aSize[iComp];
+                for ( size_t i = 0; i < aRev[u].size(); ++i )
+                    if ( aComp[ aRev[u][i] ] < 0 )
+                    {
+                        aComp[ aRev[u][i] ] = iComp;
+                        aQueue.push_back( aRev[u][i] );
+                    }
+            }
+        }
+        int iBest = 0;
+        for ( int c = 1; c < (int)aSize.size(); ++c )
+            if ( aSize[c] > aSize[iBest] )
+                iBest = c;
+        m_aMainPart.assign( n, 0 );
+        for ( int u = 0; u < n; ++u )
+            m_aMainPart[u] = ( aComp[u] == iBest ) ? 1 : 0;
+        return m_aMainPart;
+    }
+
+    std::string ButtonKey( const CSpot& c )
+    {
+        char szKey[128];
+        snprintf( szKey, sizeof( szKey ), "%d %.0f %.0f %.0f %.0f %.0f %.0f", CWaypoints::Size(), c.vMins.x, c.vMins.y,
+                  c.vMins.z, c.vMaxs.x, c.vMaxs.y, c.vMaxs.z );
+        return szKey;
+    }
+
+    // Guard spots of a hold button: for each place attackers hold it from (aInside), the waypoints near it that see
+    // that place as bots see (walls and props, not players): CSpot::aWatch, and all of them in CSpot::aNear. Chosen
+    // before with a line through the walls only to the button: on tls_lockdown the guards stood behind the bomb device
+    // (a prop on the desk) 135-190 units from the Tau'ri holding the button on the other side, without seeing them
+    // (59 of 66 blocked lines; the bomb fell in about a minute, 2026-11-04). A defender watches one place
+    // (PickWaypoint). Fewer than 3 spots: the old rule.
+    void GuardSpots( CSpot& c, bool bSameMap )
+    {
+        if ( !bSameMap )
+        {
+            m_aGuardCache.clear();
+            m_aLastPlace.clear();
+        }
+        std::string sKey = ButtonKey( c );
+        std::map<std::string, CGuardSpots>::const_iterator it = m_aGuardCache.find( sKey );
+        if ( it != m_aGuardCache.end() )
+        {
+            if ( it->second.aNear.size() >= 3 )
+            {
+                c.aNear = it->second.aNear;
+                c.aWatch = it->second.aWatch;
+            }
+            return;
+        }
+
+        CGuardSpots g;
+        g.aWatch.resize( c.aInside.size() );
+        std::vector<TWaypointId> aMost, aSome, aWalls;
+        const std::vector<char>& aMain = MainPart();
+        for ( TWaypointId w = 0; w < CWaypoints::Size(); ++w )
+        {
+            const Vector& v = CWaypoints::Get( w ).vOrigin;
+            if ( v.DistToSqr( c.vCenter ) > fButtonGuardDistance * fButtonGuardDistance ||
+                 v.DistToSqr( c.vCenter ) < fButtonUseDistance * fButtonUseDistance || !aMain[w] )
+                continue;
+            int iSeen = 0;
+            for ( size_t i = 0; i < c.aInside.size(); ++i )
+                if ( CUtil::IsVisible( v, CWaypoints::Get( c.aInside[i] ).vOrigin, EVisibilityBots, false ) )
+                {
+                    ++iSeen;
+                    g.aWatch[i].push_back( w );
+                }
+            if ( !c.aInside.empty() && iSeen * 4 >= (int)c.aInside.size() * 3 )
+                aMost.push_back( w );
+            if ( iSeen > 0 )
+                aSome.push_back( w );
+
+            Vector vTarget;
+            for ( int i = 0; i < 3; ++i )
+                vTarget[i] = clamp( v[i], c.vMins[i], c.vMaxs[i] );
+            Ray_t ray;
+            ray.Init( v, vTarget );
+            trace_t tr;
+            CTraceFilterWorldOnly cFilter;
+            CBotrixPlugin::pEngineTrace->TraceRay( ray, MASK_PLAYERSOLID, &cFilter, &tr );
+            if ( tr.fraction >= 0.99f || tr.endpos.DistToSqr( vTarget ) < 24.0f * 24.0f )
+                aWalls.push_back( w );
+        }
+        if ( aSome.size() >= 3 )
+            g.aNear = aSome;
+        else
+        {
+            g.aNear = aWalls;
+            g.aWatch.clear();
+        }
+        std::string sPlaces;
+        for ( size_t i = 0; i < c.aInside.size(); ++i )
+        {
+            const Vector& v = CWaypoints::Get( c.aInside[i] ).vOrigin;
+            char sz[64];
+            snprintf( sz, sizeof( sz ), " %d (%.0f %.0f %.0f): %d", c.aInside[i], v.x, v.y, v.z,
+                      i < g.aWatch.size() ? (int)g.aWatch[i].size() : 0 );
+            sPlaces += sz;
+        }
+        Msg( "[Botrix] %s: guard spots of the button at %.0f %.0f %.0f: %d (seeing most of its places %d, walls only %d); "
+             "guards per place:%s.\n", CBotrixPlugin::instance->sMapName.c_str(), c.vCenter.x, c.vCenter.y, c.vCenter.z,
+             (int)g.aNear.size(), (int)aMost.size(), (int)aWalls.size(), sPlaces.c_str() );
+        m_aGuardCache[sKey] = g;
+        if ( g.aNear.size() >= 3 )
+        {
+            c.aNear = g.aNear;
+            c.aWatch = g.aWatch;
+        }
+    }
+
+    // The place of a button a defender watches: the one nearest to an attacker within 1000 units of the button (the
+    // side they come from; from farther, a straight line says nothing: tls_lockdown's Tau'ri come round to the bomb
+    // from the south, their spawn is north of it), else the place of the last attempt at this button, else any.
+    int PlaceToWatch( const CSpot& c, int iAttackers )
+    {
+        int iPlace = -1;
+        float fBest = 1000.0f * 1000.0f;
+        for ( int p = 0; p < CPlayers::Size(); ++p )
+        {
+            CPlayer* pPlayer = CPlayers::Get( p );
+            if ( !pPlayer || !pPlayer->IsAlive() || pPlayer->GetTeam() != iAttackers ||
+                 pPlayer->GetHead().DistToSqr( c.vCenter ) > fBest )
+                continue;
+            for ( size_t i = 0; i < c.aInside.size() && i < c.aWatch.size(); ++i )
+            {
+                float fDist = pPlayer->GetHead().DistToSqr( CWaypoints::Get( c.aInside[i] ).vOrigin );
+                if ( !c.aWatch[i].empty() && fDist < fBest )
+                {
+                    fBest = fDist;
+                    iPlace = (int)i;
+                }
+            }
+        }
+        if ( iPlace < 0 )
+        {
+            std::map<std::string, int>::const_iterator it = m_aLastPlace.find( ButtonKey( c ) );
+            if ( it != m_aLastPlace.end() && it->second < (int)c.aWatch.size() && !c.aWatch[it->second].empty() )
+                iPlace = it->second;
+        }
+        if ( iPlace < 0 && !c.aWatch.empty() )
+        {
+            iPlace = rand() % c.aWatch.size();
+            if ( c.aWatch[iPlace].empty() )
+                iPlace = -1;
+        }
+        return iPlace;
+    }
+}
