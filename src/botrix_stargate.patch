+//----------------------------------------------------------------------------------------------------------------
+bool CBot_SGTLS::KeepGoingThrough() const
+{
+    // tls_lockdown's fire corridor is a lane one player and a half wide with the flames along it: a bot behind a
+    // teammate stepped aside (as for a player coming the other way) into the wall corner and burned there; 64 % of
+    // the bots seen stuck in the fire had a teammate within 80 units (2026-11-04).
+    // Measured: without the side step two bots face to face in the lane stayed there and burned (603 Tau'ri fire
+    // deaths instead of 60 in 8 servers x 40 min): only in mode 1, for tests.
+    return sgtls::iFireCross == 1 && m_bAlive && sgtls::InFire( m_vHead );
+}
+
+
+bool CBot_SGTLS::SideStepLeft() const
+{
+    // Botrix steps right for a player in the way. tls_lockdown's fire lane runs north with the flames on its west
+    // side: southbound bots stepped into them (<prefix>_firecross 3: away from the nearest fire in reach).
+    Vector2D vFire;
+    if ( ( sgtls::iFireCross != 3 && sgtls::iFireCross != 4 ) || !m_bAlive || !sgtls::FireInReach( m_vHead, vFire ) )
+        return false;
+    Vector2D vForward = ( m_vDestination - m_vHead ).AsVector2D();
+    Vector2D vRight( vForward.y, -vForward.x );
+    return vRight.Dot( vFire - m_vHead.AsVector2D() ) > 0.0f;
+}
+
+
+bool CBot_SGTLS::FollowRatherThanStep( const CPlayer* pOther ) const
+{
+    // In the fire lane a bot behind a teammate going the same way stepped aside as for one coming the other way
+    // (64 % of the bots seen stuck in the fire had a teammate within 80 units): follow it instead.
+    // Mode 4 only: with it the followers piled up at the lane's north end (waypoint 444), 84 watchdog suicides
+    // instead of 38 in 12 servers x 40 min, for 65 fewer fire deaths.
+    return sgtls::iFireCross == 4 && m_bAlive && pOther && pOther->GetTeam() == GetTeam() &&
+           CWaypoint::IsValid( iNextWaypoint ) && pOther->iNextWaypoint == iNextWaypoint && sgtls::InFire( m_vHead );
+}
+
+
+bool CBot_SGTLS::ShouldEngage()
+{
+    // In a fire (<prefix>_firecross 1 or 2): shoot while walking on, don't stop there to fight.
+    if ( ( sgtls::iFireCross == 1 || sgtls::iFireCross == 2 ) && m_bAlive && sgtls::InFire( m_vHead ) )
+        return false;
+    // Stopping (and chasing) for every enemy seen across tls_abydos's valley, 2000+ units away, stalled the attack
+    // on area 1 for 10 minutes. On the way to the area it attacks, a bot stops to fight only the enemies within 500
+    // units, and anything once within 800 units of the area (to clear it); it shoots at the others while walking.
+    // With 1000 units, tls_erebus's attackers stopped in the open below the first checkpoint, where the defenders'
+    // staffs outranged their P90s, and never reached it (8 kills to 48).
+    if ( !sgtls::CObjectives::IsAttacking( GetTeam(), m_pSpot ) )
+    {
+        // A defender farther than <prefix>_defreach from the spot it goes to defend (per map, 0 = off) does the same:
+        // on tls_abydos the Tau'ri stopped to fight Goa'uld seen across the valley, 1500 units from the pyramid,
+        // and half of the attempts on the pyramid started with no defender within 1500 units (2026-11-04).
+        if ( sgtls::fDefenderReach > 0.0f && m_pSpot && sgtls::CObjectives::IsDefending( GetTeam(), m_pSpot ) &&
+             sgtls::CObjectives::DistanceToSpot( m_pSpot, m_vHead ) > sgtls::fDefenderReach )
+            return m_fDistanceSqrToEnemy < 500.0f * 500.0f;
+        return true;
+    }
+    return m_fDistanceSqrToEnemy < 500.0f * 500.0f || sgtls::CObjectives::DistanceToSpot( m_pSpot, m_vHead ) < 800.0f;
+}
