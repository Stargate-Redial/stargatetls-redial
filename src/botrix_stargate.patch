+bool CUtil::IsSeeThrough( edict_t* pEdict )
+{
+    const char* szClassName = pEdict->GetClassName();
+    if ( strncmp( szClassName, "weapon_", 7 ) == 0 || strncmp( szClassName, "item_", 5 ) == 0 ||
+         strstr( szClassName, "blast" ) || strstr( szClassName, "projectile" ) || strstr( szClassName, "grenade" ) ||
+         strstr( szClassName, "rocket" ) || strstr( szClassName, "bolt" ) )
+        return true;
+    // Other small things in flight.
+    ICollideable* pCollide = pEdict->GetCollideable();
+    if ( pCollide )
+    {
+        Vector vSize = pCollide->OBBMaxs() - pCollide->OBBMins();
+        if ( vSize.x < 12.0f && vSize.y < 12.0f && vSize.z < 12.0f )
+            return true;
+    }
+    return false;
+}
