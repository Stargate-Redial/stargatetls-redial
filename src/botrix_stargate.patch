+bool sgtls::IsForbidden( const Vector& vEye )
+{
+    const std::vector<const CBspEntity*>& aBoxes = ForbiddenBoxes();
+    Vector vFeet = vEye;
+    vFeet.z -= CMod::GetVar( EModVarPlayerEye ) - 4.0f;
+    for ( size_t k = 0; k < aBoxes.size(); ++k )
+        if ( InsideDeadly( vEye, *aBoxes[k] ) || InsideDeadly( vFeet, *aBoxes[k] ) )
+            return true;
+    return false;
+}
