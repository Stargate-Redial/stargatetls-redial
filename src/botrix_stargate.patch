+//----------------------------------------------------------------------------------------------------------------
+TTeam CBot_SGTLS::ChooseTeam() const
+{
+    if ( m_iWantedTeam != -1 )
+        return m_iWantedTeam;
+    int iTauri = CountPlayers( ETeamTauri, -1, m_pEdict );
+    int iGoauld = CountPlayers( ETeamGoauld, -1, m_pEdict );
+    if ( iTauri != iGoauld )
+        return iTauri < iGoauld ? ETeamTauri : ETeamGoauld;
+    return ( rand() & 1 ) ? ETeamTauri : ETeamGoauld;
+}
+
+
+//----------------------------------------------------------------------------------------------------------------
+int CBot_SGTLS::ChooseClass( TTeam iTeam, int iExclude ) const
+{
+    int iFirst = FirstClassOfTeam( iTeam );
+    if ( m_iWantedClassId >= iFirst && m_iWantedClassId < iFirst + 4 && m_iWantedClassId != iExclude )
+        return m_iWantedClassId;
+
+    // The class furthest below its share of the team (aClassChances), so that classes and weapons are spread;
+    // one Team Leader per team at most. Random start: equals are picked at random.
+    int iTeamSize = CountPlayers( iTeam, -1, m_pEdict ) + 1;
+    int iStart = rand() % 4, iBest = 0;
+    float fBestDeficit = -1e9f;
+    for ( int k = 0; k < 4; ++k )
+    {
+        int i = ( iStart + k ) % 4;
+        int iCount = CountPlayers( iTeam, iFirst + i, m_pEdict );
+        if ( ( i == 3 && iCount > 0 ) || iFirst + i == iExclude )
+            continue;
+        // Kull Warriors (class 7) capped for bots (<prefix>_kullmax): their Kull blaster and energy armor won most
+        // fights (tls_erebus: the Goa'uld won all 192 rounds of the public server, 2026-10-28 to 11-03).
+        if ( iFirst + i == 7 && sgtls::iKullMax >= 0 && iCount >= sgtls::iKullMax )
+            continue;
+        float fDeficit = aClassChances[i] * iTeamSize / 100.0f - iCount;
+        if ( fDeficit > fBestDeficit )
+        {
+            fBestDeficit = fDeficit;
+            iBest = i;
+        }
+    }
+    return iFirst + iBest;
+}
+
