+
+const std::vector<sgtls::CButtonDoor>& sgtls::ButtonDoors()
+{
+    const std::vector<CBspEntity>& aEnts = BspEntities();
+    if ( m_sButtonDoorsMap == m_sEntitiesMap )
+        return m_aButtonDoors;
+    m_sButtonDoorsMap = m_sEntitiesMap;
+    m_aButtonDoors.clear();
+
+    std::string sTarget, sInput, sParam;
+    for ( size_t i = 0; i < aEnts.size(); ++i )
+    {
+        const CBspEntity& e = aEnts[i];
+        const char* szClass = e.Get( "classname" );
+        // Also sliding doors made of a func_movelinear (tls_revelation_a6's sgc_d1: two buttons toggle it).
+        bool bLinear = strcmp( szClass, "func_movelinear" ) == 0;
+        if ( !e.bBrush || ( strcmp( szClass, "func_door" ) != 0 && strcmp( szClass, "func_door_rotating" ) != 0 && !bLinear ) )
+            continue;
+        // Upright only: tls_stargate_atlantis's jumper bay floor (Jumperdoorbas, 6 units thick) is a ceiling of the
+        // gate room; a path through it would go through a floor.
+        Vector vSize = e.vMaxs - e.vMins;
+        if ( vSize.z < 48.0f || vSize.z < MIN2( vSize.x, vSize.y ) )
+            continue;
+        int iFlags = bLinear ? 0 : atoi( e.Get( "spawnflags", "0" ) ); // A func_movelinear's flags mean other things.
+        if ( iFlags & 2048 ) // Starts locked.
+            continue;
+        CButtonDoor d;
+        d.pDoor = &e;
+        d.fOpenDelay = 0.0f;
+        d.bUseOpens = ( iFlags & 256 ) != 0;
+        d.bTouchOpens = ( iFlags & 1024 ) != 0;
+        d.iAxis = ( vSize.x < vSize.y ) ? 0 : 1;
+        std::string sName = e.Get( "targetname" );
+        Vector vCenter = ( e.vMins + e.vMaxs ) * 0.5f;
+        // Panels within 512 units (tls_stargate_atlantis's prison: the one inside is 320 units from the door), and
+        // trigger_multiple / trigger_once over the doorway that open it (its conference room doors): a touch door.
+        for ( size_t b = 0; b < aEnts.size() && !sName.empty(); ++b )
+        {
+            const CBspEntity& cOpener = aEnts[b];
+            const char* szOpener = cOpener.Get( "classname" );
+            bool bButton = strcmp( szOpener, "func_button" ) == 0;
+            bool bTrigger = strcmp( szOpener, "trigger_multiple" ) == 0 || strcmp( szOpener, "trigger_once" ) == 0;
+            if ( !cOpener.bBrush || ( !bButton && !bTrigger ) )
+                continue;
+            if ( bButton && ( ( cOpener.vMins + cOpener.vMaxs ) * 0.5f ).DistTo( vCenter ) > 512.0f )
+                continue;
+            if ( bTrigger && DistanceToBox( vCenter, cOpener.vMins, cOpener.vMaxs ) > 64.0f )
+                continue;
+            if ( bButton ? OpensDoor( cOpener, "OnPressed", sName, 1 )
+                         : ( OpensDoor( cOpener, "OnStartTouch", sName, 1 ) || OpensDoor( cOpener, "OnTrigger", sName, 1 ) ) )
+            {
+                if ( bButton )
+                {
+                    d.aButtons.push_back( &cOpener );
+                    float fDelay = OpenDelay( cOpener, "OnPressed", sName );
+                    if ( fDelay > d.fOpenDelay )
+                        d.fOpenDelay = fDelay;
+                }
+                else
+                    d.bTouchOpens = true;
+            }
+        }
+        d.vDoorwayMins = e.vMins;
+        d.vDoorwayMaxs = e.vMaxs;
+        if ( !d.aButtons.empty() || d.bUseOpens || d.bTouchOpens )
+            m_aButtonDoors.push_back( d );
+    }
+    // Doorways: the leaves that touch each other in the same plane and open with the same panel.
+    for ( size_t i = 0; i < m_aButtonDoors.size(); ++i )
+    {
+        CButtonDoor& d = m_aButtonDoors[i];
+        int a = d.iAxis, o = 1 - a;
+        for ( size_t k = 0; k < m_aButtonDoors.size(); ++k )
+        {
+            const CBspEntity& f = *m_aButtonDoors[k].pDoor;
+            // Opened together: a panel in common (tls_stargate_atlantis_fixed has independent doors side by side).
+            bool bShared = false;
+            for ( size_t p = 0; p < d.aButtons.size() && !bShared; ++p )
+                bShared = std::find( m_aButtonDoors[k].aButtons.begin(), m_aButtonDoors[k].aButtons.end(), d.aButtons[p] ) !=
+                          m_aButtonDoors[k].aButtons.end();
+            if ( k == i || !bShared || m_aButtonDoors[k].iAxis != a ||
+                 fabs( ( f.vMins[a] + f.vMaxs[a] ) - ( d.pDoor->vMins[a] + d.pDoor->vMaxs[a] ) ) * 0.5f > 8.0f ||
+                 f.vMins[o] > d.pDoor->vMaxs[o] + 4.0f || f.vMaxs[o] < d.pDoor->vMins[o] - 4.0f ||
+                 f.vMins.z > d.pDoor->vMaxs.z || f.vMaxs.z < d.pDoor->vMins.z )
+                continue;
+            for ( int c = 0; c < 3; ++c )
+            {
+                d.vDoorwayMins[c] = MIN2( d.vDoorwayMins[c], f.vMins[c] );
+                d.vDoorwayMaxs[c] = MAX2( d.vDoorwayMaxs[c], f.vMaxs[c] );
+            }
+        }
+    }
+    return m_aButtonDoors;
+}
